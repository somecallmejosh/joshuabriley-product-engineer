{
  "permissions": {
    "allow": [
      "Bash(npx astro *)",
      "Bash(lsof -ti:4321)",
      "Bash(xargs kill -9)",
      "Bash(node ./_shot.mjs)",
      "Bash(npx playwright *)"
    ],
    "additionalDirectories": [
      "/tmp",
      "/private/tmp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/design-context.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
