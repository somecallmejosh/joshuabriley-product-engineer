---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import Recommendation from '~/components/patterns/Recommendation.astro';

const sorted = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
const featured = sorted.find(entry => entry.data.featured) ?? sorted[0];
const themes = [
  { id: 'design', title: 'Design & accessibility', orders: [1, 8, 15, 16, 17] },
  { id: 'delivery', title: 'Ownership & delivery', orders: [2, 3, 4, 5, 7, 9, 13] },
  { id: 'collaboration', title: 'Collaboration', orders: [] as number[] },
];
// Editorial grouping leaves every recommendation intact and displayed once.
const groups = themes.map(theme => ({
  ...theme,
  entries: sorted.filter(entry => entry.id !== featured?.id &&
    (themes.find(group => group.orders.includes(entry.data.order))?.id ?? 'collaboration') === theme.id),
})).filter(group => group.entries.length > 0);
const description = `Recommendations from ${sorted.length} clients and colleagues on Joshua Briley’s design systems work, accessibility, delivery, and collaboration.`;
---
<BaseLayout title="Testimonials | Joshua Briley" description={description}>
  <section class="calm-open">
    <Container>
      <p class="calm-label hero-in hero-in-1">Testimonials</p>
      <h1 class="calm-title hero-in hero-in-2">What it’s like to work with me.</h1>
      <p class="calm-lede hero-in hero-in-3">Recommendations from {sorted.length} clients and colleagues on design quality, reliable delivery, and working across teams.</p>
      <nav class="calm-jumps hero-in hero-in-4" aria-label="Browse recommendations">
        {groups.map(group => <a href={`#${group.id}`}>{group.title} <span aria-hidden="true" data-link-arrow="down">↓</span></a>)}
        <a href="https://www.linkedin.com/in/joshuabriley/" target="_blank" rel="noopener noreferrer">LinkedIn profile <span aria-hidden="true" data-link-arrow="up-right">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
      </nav>
    </Container>
  </section>

  {featured && <section class="calm-section testimonials-feature" aria-label="Featured recommendation">
    <Container><Recommendation testimonial={featured} featured /></Container>
  </section>}

  {groups.map(group => <section id={group.id} class="calm-section testimonial-section" aria-labelledby={`${group.id}-title`}>
    <Container>
      <h2 id={`${group.id}-title`} class="calm-heading">{group.title}.</h2>
      <div class="testimonial-collection" data-reveal-stagger>
        {group.entries.map(entry => <Recommendation testimonial={entry} />)}
      </div>
    </Container>
  </section>)}
</BaseLayout>
<style>
  .testimonials-feature { padding-top: clamp(2rem, 5vw, 4rem); }
  .testimonial-section { scroll-margin-top: 4rem; }
  .testimonial-collection { display: grid; gap: 3.5rem 4rem; margin-top: clamp(2.5rem, 5vw, 4rem); min-width: 0; }
  @media (min-width: 768px) {
    .testimonial-collection { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
