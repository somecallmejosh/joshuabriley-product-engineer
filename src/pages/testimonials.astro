---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';

const all = await getCollection('testimonials');
const sorted = all.sort((a, b) => a.data.order - b.data.order);

const description = `Testimonials from ${sorted.length} clients and colleagues, at companies including Apple, HubSpot, and Berkshire Hathaway Specialty Insurance, about working with Joshua Briley.`;
---

<BaseLayout title="Testimonials | Joshua Briley | Design Systems & UI Platform Engineer" description={description}>

  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="max-w-4xl">
        <Heading level={1} visual="display-xl" class="hero-in hero-in-2">
          Testimonials
        </Heading>
        <Text size="lg" tone="muted" class="hero-in hero-in-3 mt-7 max-w-2xl">
          What {sorted.length} clients and colleagues say about working with me, from teams at
          Apple, HubSpot, Berkshire Hathaway Specialty Insurance, America's Test Kitchen, and
          other companies.
        </Text>

        <div class="hero-in hero-in-4 mt-9 flex flex-wrap items-center gap-3">
          <Button variant="primary" size="lg" href="/contact/" iconRight="ph:arrow-right" class="js-magnetic">
            Contact me
          </Button>
          <Button
            variant="ghost"
            size="lg"
            href="https://www.linkedin.com/in/joshuabriley/"
            rel="noopener noreferrer"
            target="_blank"
            iconRight="ph:arrow-up-right"
          >
            Connect on LinkedIn
          </Button>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default">
    <Container width="wide">
      <h2 class="sr-only">All testimonials</h2>
      <div class="columns-1 [column-gap:2.5rem] sm:columns-2 lg:columns-3 lg:[column-gap:3rem]" data-reveal-stagger>
        {sorted.map((t) => (
          <figure class="mb-12 break-inside-avoid lg:mb-14">
            <blockquote>
              <p class="font-display text-lg leading-snug tracking-[-0.01em] text-ink">
                {t.data.quote}
              </p>
            </blockquote>
            <figcaption class="mt-5 flex items-center gap-3">
              {t.data.image ? (
                <img
                  src={t.data.image}
                  alt=""
                  loading="lazy"
                  class="h-9 w-9 rounded-full border border-line object-cover"
                />
              ) : (
                <span class="flex h-9 w-9 items-center justify-center rounded-full border border-line bg-raised font-mono text-[0.7rem] font-medium text-ink-muted" aria-hidden="true">
                  {t.data.initials}
                </span>
              )}
              <div class="">
                <p class="font-display text-sm font-medium tracking-tight text-ink">{t.data.name}</p>
                <p class="mt-0.5 font-mono text-[0.6rem] uppercase tracking-[0.1em] text-ink-muted">{t.data.role} · {t.data.company}</p>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </Container>
  </Section>
</BaseLayout>
