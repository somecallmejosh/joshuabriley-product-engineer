---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import ContactForm from '~/components/islands/ContactForm.astro';
---
<BaseLayout title="Contact | Joshua Briley" description="Talk to Joshua Briley about a design systems or UI engineering role, a project, or a shared interface challenge. Send a message or email directly.">
  <section class="page-opener">
    <Container width="wide">
      <p class="role-line hero-in hero-in-1">Contact</p>
      <h1 class="page-type hero-in hero-in-2">Tell me what<br />your team is <em>building.</em></h1>
      <p class="page-lede hero-in hero-in-3">Hiring for design systems or UI engineering? Share the role and the problems you need help solving. I’m happy to talk through where my experience fits.</p>
    </Container>
  </section>
  <section class="editorial-section">
    <Container width="wide">
      <div class="approach-layout contact-layout">
        <div>
          <h2 class="section-type">Let’s <em>talk.</em></h2>
          <p class="section-intro">A role description, a project, or a question is a good place to start. I read every message myself.</p>
          <a class="editorial-link mt-6" href="mailto:josh@thebrileys.com">josh@thebrileys.com <span aria-hidden="true">↗</span></a>
          <p class="mt-6 text-sm text-ink-muted">Based in Barkhamsted, Connecticut.</p>
          <div class="mt-8"><a class="editorial-link" href="https://www.linkedin.com/in/joshuabriley/" target="_blank" rel="noopener noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span></a></div>
        </div>
        <div><h2 class="mb-8 text-2xl font-semibold tracking-tight">Send a message</h2><ContactForm /></div>
      </div>
    </Container>
  </section>
</BaseLayout>
