const redesignShots = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/projects/logatot/redesign/*.png',
  { eager: true },
);
const rd = (slug: string) => redesignShots[`../../assets/projects/logatot/redesign/${slug}.png`].default;

