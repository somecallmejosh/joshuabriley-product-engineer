---
import ProjectLayout from '~/layouts/ProjectLayout.astro';
import ProjectHero from '~/components/patterns/ProjectHero.astro';
import ProjectNext from '~/components/patterns/ProjectNext.astro';
import GalleryLink from '~/components/patterns/GalleryLink.astro';
import CaseReview from '~/components/patterns/CaseReview.astro';
import Tldr from '~/components/patterns/Tldr.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import Metric from '~/components/patterns/Metric.astro';
import Plate from '~/components/patterns/Plate.astro';
import ScrollShot from '~/components/patterns/ScrollShot.astro';
import CaseSection from '~/components/patterns/case/CaseSection.astro';
import CaseProse from '~/components/patterns/case/CaseProse.astro';
import CaseCards from '~/components/patterns/case/CaseCards.astro';
import CaseFindings from '~/components/patterns/case/CaseFindings.astro';
import CaseResults from '~/components/patterns/case/CaseResults.astro';
import CaseQuote from '~/components/patterns/case/CaseQuote.astro';
import CaseLimitations from '~/components/patterns/case/CaseLimitations.astro';
import CasePersonas from '~/components/patterns/case/CasePersonas.astro';
import CaseFor from '~/components/patterns/case/CaseFor.astro';
import CaseJourney from '~/components/patterns/case/CaseJourney.astro';
import { logatotPersonas, logatotJourney } from '~/lib/case-research';
import HeuristicScores from '~/components/patterns/case/HeuristicScores.astro';
import { logatotSummary as tldr } from '~/lib/project-summaries';
import type { ImageMetadata } from 'astro';

// Section order and ids follow .claude/skills/portfolio/SKILL.md.

const title = 'Logatot | Joshua Briley';
const description =
  "Case study: a voice-controlled app that lets home child care providers log the day hands-free and generates their paperwork from it.";

const jumpLinks = [
  { href: '#tldr', label: 'Summary' },
  { href: '#context', label: 'Audience' },
  { href: '#research', label: 'Research' },
  { href: '#decisions', label: 'Design decisions' },
  { href: '#outcomes', label: 'Results' },
  { href: '#process', label: 'Build process' },
  { href: '#edges', label: 'Limitations' },
];

// Three separate regulatory regimes, all of which are visible in the data model.
const regimes = [
  { icon: 'ph:fork-knife', title: 'CACFP', body: 'Reimburses a meal only if it met the age group’s food requirements, with proof.' },
  { icon: 'ph:certificate', title: 'State licensing', body: 'Signed attendance, fire drill and shelter-in-place logs, and allergy and medication rosters.' },
  { icon: 'ph:calculator', title: 'Tax', body: 'The IRS time-space percentage, which needs business hours and square footage.' },
];

// Why 8pm-from-memory is a product problem and not a habit problem.
const problems = [
  { icon: 'ph:brain', title: 'Memory isn’t reliable', body: 'A nap logged at 8pm is a guess, and those are the records that matter most legally.' },
  { icon: 'ph:door-open', title: 'Providers leave the work', body: 'Many providers leave the work because of the paperwork.' },
  { icon: 'ph:clock-countdown', title: 'Errors are found too late', body: 'A lunch missing a vegetable is found at month end, when it can’t be fixed.' },
];

// The two findings from the provider/CACFP/influencer video calls that changed
// what shipped. Not every idea from these calls made it in this early; some
// were logged and picked up once the more urgent fix was live.
const research = [
  { icon: 'ph:waveform', title: 'Accents were getting misheard', body: 'Transcription got names wrong before the app could parse them. Each child now has a list of likely mishearings.' },
  { icon: 'ph:receipt', title: 'Providers needed better proof for claims', body: 'Reimbursement processors found gaps in the claim evidence. The reports were reworked to close them.' },
];

// The design decisions that only hold because they were built once, in the system.
const structural = [
  { icon: 'ph:function', label: 'Attendance calculated from check-in history' },
  { icon: 'ph:calendar-check', label: 'Enrolment status derived from dates' },
  { icon: 'ph:trash-simple', label: 'Deleted records are hidden and kept' },
];

// The real service boundaries behind the voice product.
const integrations = [
  { icon: 'ph:waveform', name: 'Picovoice Porcupine', role: 'Custom wake word, WebAssembly, on-device' },
  { icon: 'ph:microphone', name: 'Web Speech API', role: 'Transcription, silence-timer endpointing' },
  { icon: 'ph:sparkle', name: 'OpenAI', role: 'Phonetic name variants, at child creation' },
  { icon: 'ph:broadcast', name: 'Pusher', role: 'Per-account channels for live board updates' },
  { icon: 'ph:queue', name: 'Sidekiq', role: '29 jobs, 4 scheduled reminder workers' },
  { icon: 'ph:credit-card', name: 'Stripe + union API', role: 'Direct billing and association membership' },
];

const quotes = [
  {
    body: 'It is truly remarkable to be completing a physical task and talking to the voice assistant to record it simultaneously! Now I do not have to do my data entry outside of business hours. Each day I am saving over 2 hours on data entry!!!',
    name: 'President',
    role: 'CSEA/VOICE Local 100A',
  },
  {
    body: 'I never realized how much time I had to spend filling in paperwork until I didn’t have to. Logatot has given me my evenings back.',
    name: 'Margaret Balko',
    role: 'Home-based provider',
  },
];

// The edges, stated plainly. A case study that only lists wins is a brochure.
const edges = [
  { icon: 'ph:users-three', title: 'We assumed everyone spoke English', body: 'We knew some providers were bilingual, but we had no idea that some homes didn’t speak English at all. We missed Marisol in our initial research and persona development. Conversations with agencies like CACFP focused on what providers had to do and too little on the people doing it. I’d focus more on the users themselves and start with internationalization, which is significantly easier than adding it later.' },
  { icon: 'ph:list-magnifying-glass', title: 'Screen-reader support on the busiest screen', body: 'The Voiceboard’s expand and collapse controls don’t announce their state. It’s the first thing I’d fix.' },
  { icon: 'ph:device-tablet', title: 'No tablet layout', body: 'The layout has one breakpoint, so tablets, including the kiosk, get a poor fit.' },
  { icon: 'ph:cloud-slash', title: 'No offline mode', body: 'The pieces exist but were never finished. For homes with unreliable WiFi, it’s the most valuable missing feature.' },
];

// The sheets render from src/ so Astro can actually process them (anything under
// public/ is copied verbatim, never optimized). Sources are 2x headless-Chrome
// PNGs; `<Image>` emits sized WebP from these at build time.
const sheets = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/projects/logatot/wires-and-flows/*.png',
  { eager: true },
);
const sheet = (slug: string) =>
  sheets[`../../assets/projects/logatot/wires-and-flows/${slug}.png`].default;

// The review screen carries the argument, so it gets a full mount. The note is the
// claim the sheet is making, not a fresh gloss on the picture.
const keyScreens = [
  {
    slug: '04-logged-events',
    index: '04',
    title: 'Logged events: review and repair',
    note: 'Tapping the right word adds it to that child’s name variants.',
    alt: 'Annotated wireframe of the logged-events review screen: a queue of failed voice captures, each showing the raw utterance as selectable word chips, the partially understood fields, and the retained audio, with callouts explaining the two diagnostic flags and how a correction improves recognition permanently.',
  },
];


const flows = [
  {
    slug: '11-flow-voice-logging',
    title: 'Voice event logging',
    note: 'From speech to a saved event, with the failure path drawn in full.',
    alt: 'Flow diagram of voice event logging. An on-device wake word opens transcription, which runs through a ladder of phrase matchers and roster name matching, forking into a single-child inline write, a multi-child background job, or a failed parse that lands in the repair queue with its audio attached.',
  },
  {
    slug: '14-flow-parent-access',
    title: 'Parent access',
    note: 'Email-link sign-in and a daily summary email that brings parents back.',
    alt: 'Flow diagram of parent access: a passwordless magic-link request that returns an identical screen for known and unknown addresses, a fifteen-minute single-use token, role resolution at the shared sign-in, and the automatic end-of-day summary email that drives the daily loop.',
  },
  {
    slug: '15-flow-food-program',
    title: 'Food program',
    note: 'Plan, serve, and claim, with menus checked against the rules while they’re planned.',
    alt: 'Flow diagram of the CACFP food program: building a menu validated per meal against the age-group component matrix, duplicating a week, generating a shopping list, serving meals through the shared event pipeline, and reconciling the month-end claim from records that already exist.',
  },
];

// Screenshots of the shipped app, captured from the seeded demo account at
// 1440×900 @2x in light mode, recaptured after the feedback round.
// Captions say only what is on screen.
const appShots = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/projects/logatot/app/app-*.png',
  { eager: true },
);
const app = (slug: string) => appShots[`../../assets/projects/logatot/app/app-${slug}.png`].default;

// Screens and flows are placed beside the argument they support rather than
// collected into one gallery, so these look them up by slug at the point of use.
const screen = (slug: string) => keyScreens.find((s) => s.slug === slug)!;
const flowSet = (...slugs: string[]) => slugs.map((s) => flows.find((f) => f.slug === s)!);

// Captured from the seeded demo account with headless Chrome:
// desktop 1440×900 @2x, phone 390×844 @2x, kiosk 1180×820 @2x. Provider =
// provider@example.com, family = a seeded parent signed in by email link.
// Day views are set to the last full day in the seed data. Spanish
// captures switch the user's language setting, which is how the app chooses.
const redesignShots = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/projects/logatot/redesign/*.png',
  { eager: true },
);
const rd = (slug: string) => redesignShots[`../../assets/projects/logatot/redesign/${slug}.png`].default;

// What the front-end audit found before any screen was touched.
// Source: log_a_tot tasks/heuristics-audit.md.
const systemAudit = [
  { value: '0', label: 'forms guarded against double submits', note: 'Out of about fifty.' },
  { value: '0', label: 'confirm prompts that worked', note: '“Cancel my account” deleted the account on the first click.' },
  { value: '4', label: 'different ways to delete', note: 'htmx, Rails buttons, Alpine fetch calls, and inline handlers.' },
  { value: '14', label: 'index pages with hand-built headers', note: 'Titles, actions, and spacing differed from page to page.' },
];

// The decisions that shaped the new look. Each is a rule the whole app follows,
// written down in the project's lessons file so later screens keep to it.
const redesignDecisions = [
  { icon: 'ph:palette', title: 'Pastels that pass contrast', body: 'Each module has a soft hue, generated and checked for WCAG AA in light and dark mode.' },
  { icon: 'ph:cursor-click', title: 'Buttons, tabs, and filters look different', body: 'Actions are filled pills, navigation is a segmented control, and filters are checkbox chips.' },
  { icon: 'ph:stack', title: 'One raised surface per page', body: 'The page’s main content sits on a white card. Everything else sits in recessed panels.' },
  { icon: 'ph:shapes', title: 'Never color alone', body: 'Every color-coded category also has an icon or a label.' },
  { icon: 'ph:cube', title: 'Logo blocks show loading, empty, and error states', body: 'The toy blocks stack while loading, lose the top block when empty, and teeter on error pages.' },
  { icon: 'ph:rows', title: 'A Voiceboard that fits on one screen', body: 'A compact view took a full day from 3,849 to 1,318 pixels tall.' },
];

// Who sees what. Derived from the app's role checks (User#host?,
// #admin_menu_access?, #caregiver?) and confirmed by signing in as each.
const roles = [
  { icon: 'ph:lifebuoy', name: 'Logatot staff', access: 'Everything a provider sees, plus every account for support, and the blog.', signIn: 'Password' },
  { icon: 'ph:user-focus', name: 'Provider and employees', access: 'The full app.', signIn: 'Password' },
  { icon: 'ph:users', name: 'Families', access: 'Their own children only, in a family channel. Staff pages redirect back to it.', signIn: 'Email link' },
  { icon: 'ph:identification-badge', name: 'Authorized pickups', access: 'No account. A PIN shows only the children they may check in or out.', signIn: 'Kiosk PIN' },
];

// Nielsen heuristics, scored 0–10 before the fixes. Source: tasks/heuristics-audit.md
// The "fix" column lists the changes made;
// a re-score has not been done yet, so no "after" number is claimed here.
const heuristics = [
  { n: 1, name: 'Visibility of system status', before: 5, fix: 'Busy states on every form, and failed background saves show a message.' },
  { n: 2, name: 'Match with the real world', before: 6, fix: '“Logged Events” became the Activity log, opening on Needs review instead of “Failed.”' },
  { n: 3, name: 'User control and freedom', before: 5, fix: 'Sign-in lands on the Voiceboard, and deleted events can be restored.' },
  { n: 4, name: 'Consistency and standards', before: 6, fix: 'One confirm dialog and one page header everywhere.' },
  { n: 5, name: 'Error prevention', before: 3, fix: '“Cancel my account” asks first, and every form blocks double submits.' },
  { n: 6, name: 'Recognition over recall', before: 6, fix: 'Reports open with every active child selected, and the calendar’s warning icon has a legend.' },
  { n: 7, name: 'Flexibility and efficiency', before: 4, fix: 'Press / to search from any page, CSV export on reports, and bulk actions on documents.' },
  { n: 8, name: 'Aesthetic and minimalist', before: 7, fix: 'One raised surface per page, the compact Voiceboard, and recessed filters.' },
  { n: 9, name: 'Recovering from errors', before: 3, fix: 'Inline errors announced to screen readers, and a crashing sidebar page fixed.' },
  { n: 10, name: 'Help and documentation', before: 4, fix: 'An empty Voiceboard teaches the voice commands. Help moved into the sidebar.' },
];

// The phone set. Captions describe what is on screen.
const phones = [
  { slug: 'phone-provider-voiceboard', title: 'Voiceboard', note: 'Date, counts, and children stack in one column.', alt: 'The Voiceboard on a phone: the Ready to listen panel with the example “Logatot, Ava woke up,” a date control for Friday, October 30 with a Today button, count pills for 0 here, 12 expected, 11 picked up, and 1 absent, then the Children heading with the Compact and Detailed switch, an Add event button, and Ava Johnson’s tile.' },
  { slug: 'phone-provider-nav', title: 'Provider menu', note: 'Twelve destinations in three groups.', alt: 'The provider’s navigation drawer on a phone: Voiceboard highlighted, Children, Activity log, Meals, a Modules group with Calendar, Chat, Documents, and Expenses, and a Resources group with Photo gallery, Reports, Video learning library, and Help.' },
  { slug: 'phone-parent-nav', title: 'Family menu', note: 'A parent sees three links and the dark mode switch.', alt: 'A parent’s navigation drawer on a phone: Little Acorns Home Daycare, then only My children, Chat, Reports, and a Dark mode switch.' },
  { slug: 'phone-provider-child', title: 'Child profile', note: 'Health details become full-width tiles.', alt: 'Liam Carter’s profile on a phone: a large photo, his name, pronoun, birth date and age, an Active badge, Archive child and Edit buttons, then Health tiles for allergies, medications, and diapers.' },
  { slug: 'phone-provider-repair', title: 'Needs review', note: 'The misheard sentence first, then the fields to fix it.', alt: 'A failed voice entry on a phone: Name not heard and Event not recognized tags, the time, the quote “Log a diaper change for, um, the little one in the blue shirt,” a hint to tap the word that was the child’s name, and Child and What happened selects.' },
  { slug: 'phone-provider-menu-calendar', title: 'Menu calendar', note: 'The month grid becomes a list by day and meal.', alt: 'The menu calendar on a phone: Month and Week controls, a legend item for a missing required food component, then Sunday the 1st and Monday the 2nd as lists of breakfast, morning snack, lunch, and dinner, with a warning icon on two breakfasts.' },
  { slug: 'phone-parent-dashboard', title: 'Family channel', note: 'The provider’s welcome note, then the child’s day.', alt: 'The family channel on a phone: a Show filters button, the provider’s thank-you note, and October 30th activities for Liam Carter with a date filter and a timeline starting with Check-out and Activity.' },
  { slug: 'phone-public-sign-in', title: 'Provider login', note: 'Families get their own link at the bottom.', alt: 'The provider login on a phone: email and password fields, Remember me, a Login button, Register and Forgot your password links, and a “Family member? Family login” button.' },
];

// What the redesign left open. Each was seen in the captures for this page
// or is recorded in the project's task notes.
const redesignEdges = [
  { icon: 'ph:globe-hemisphere-west', title: 'Recurring time zone bugs', body: 'Most recent updates were time zone fixes, and the underlying cause remains.' },
  { icon: 'ph:house-line', title: 'The family channel is behind', body: 'It still uses the old layout, and its welcome note is nearly unreadable in dark mode. It’s the next screen to rebuild.' },
  { icon: 'ph:arrows-clockwise', title: 'Family menu links loop back', body: 'My children, Chat, and Reports are staff-only, so each redirects a parent to the family channel.' },
  { icon: 'ph:translate', title: 'Spanish isn’t complete', body: 'Spanish is missing 67 of 2,313 entries, and the home page demo cards stay in English.' },
  { icon: 'ph:chart-line-up', title: 'No re-score yet', body: 'Every heuristic has fixes, but I haven’t re-scored the app. The 4.9 average from before the fixes is the only measured score.' },
];

// What changed, built only from claims already made elsewhere on this page
// (the summary, the flow notes, the services list, and the testimonials).
const results = [
  {
    label: 'For providers like Renee, Tanya, and Marisol',
    items: [
      'Records logged in the moment, hands-free, instead of from memory at 8pm',
      'Menus checked against CACFP rules while they’re planned',
      'Significantly fewer voice logging complaints after adding Spanish, though we didn’t formally measure it',
    ],
  },
  {
    label: 'For families',
    items: [
      'The day’s events for one child, in one place',
      'Email-link sign-in instead of a password',
      'A daily summary by email',
    ],
  },
  {
    label: 'For the business',
    items: [
      'Shipped as a paid product',
      'Sold directly and through child care associations',
    ],
  },
];
---

<ProjectLayout title={title} description={description}>

  <ProjectHero project="logatot" />

  <CaseReview links={jumpLinks} />

  <Tldr problem={tldr.problem} decision={tldr.decision} evidence={tldr.evidence} />

  <CaseSection id="context" title="Audience">
    <CaseProse>
      <p>
        A home daycare provider is caregiver, cook, and record-keeper through a
        twelve-hour day, answering to three sets of rules. Logatot moves the
        record-keeping from 8pm into the moment, hands-free. Providers say what happened and it appears on the Voiceboard, the app’s main screen. <a href="#persona-renee" class="hero-link">Renee, Tanya, and Marisol</a> show how that plays out for different providers.
      </p>
    </CaseProse>

    <CaseCards label="Three sets of rules" items={regimes} />

    <CaseCards label="Problems with logging from memory" items={problems} />
  </CaseSection>

  <CaseSection id="research" title="Research">
    <CaseProse>
      <Heading level={3} visual="h2">Requirements gathering</Heading>
      <p>
        I was hired to bring UX design and research to what was still a prototype. Its design
        decisions had come from hunches or followed the database, so screens were laid out the
        way the data was stored.
      </p>
      <p>
        The team knew the market existed. Its picture of these providers didn’t go much further
        than what an accounting ledger could show. Everyone agreed that providers were exhausted
        and overworked. My job was to reduce their workload.
      </p>
      <p>
        To replace the guesses with evidence, I interviewed three providers separately. I also
        spoke with food-program administrators and child care influencers.
      </p>
    </CaseProse>

    <CaseCards label="Changes from the research calls" items={research} />

    <figure class="my-12 border-l-2 border-accent pl-6">
      <blockquote class="font-display text-2xl md:text-3xl tracking-tight text-ink leading-snug">
        &ldquo;I would want to review it. Names can be difficult. A system
        may misunderstand a child&rsquo;s name or a Spanish word. It should
        show me what it heard and let me approve or correct it.&rdquo;
      </blockquote>
      <figcaption class="mono-label mt-5">
        Yari, on trusting voice entry for official records
      </figcaption>
    </figure>

    <CaseProse>
      <p class="text-sm">
        Interviews:
        <a href="/projects/interview-notes/logatot/angie/" class="hero-link">Angie</a>,
        <a href="/projects/interview-notes/logatot/deborah/" class="hero-link">Deborah</a>,
        <a href="/projects/interview-notes/logatot/yari/" class="hero-link">Yari</a>, and the
        <a href="/projects/interview-notes/logatot/interview-analysis/" class="hero-link">cross-interview theme analysis</a>.
      </p>
    </CaseProse>

    <CaseProse class="mt-12">
      <Heading level={3} visual="h2">Watching customers use voice logging</Heading>
      <p>
        Some customers complained that voice logging didn’t work, though it worked well for
        many others. I replied to them by email and watched Hotjar sessions, and we
        worked through the usual troubleshooting: browser, browser version, operating system,
        and device.
      </p>
      <p>
        We found the cause by sitting down and watching them use it. Many of the people having
        trouble were <strong class="text-ink font-semibold">Spanish speakers who spoke very little
        English</strong>, the group Marisol represents. The system couldn’t understand their
        accents. Yari’s interview, quoted above, came after we found this.
      </p>
      <p>
        What people say in questionnaires and conversations doesn’t always match what they do.
        Watching them work showed where they ran into trouble.
      </p>
    </CaseProse>

    <CaseProse class="mt-12">
      <p>
        The screens around the voice workflow had drifted: two icon sets, colors picked page by
        page, and controls that looked alike but did different things. I ran a front-end audit
        and kept the brand and every route.
      </p>
    </CaseProse>

    <CaseFindings title="Front-end audit findings" items={systemAudit} />

    <CaseProse class="mt-12">
      <p>
        The audit also found leftover scaffold pages that could show data across accounts. I
        removed them first, and a test now checks every page for server errors.
      </p>
    </CaseProse>

      <CaseProse class="mt-12">
        <Heading level={3} visual="h2">Heuristic audit</Heading>
        <p>
          I scored all 119 pages against Nielsen’s ten heuristics, tying every finding
          to a file and line. The lowest scores had one cause. Rails confirm prompts and
          double-submit guards need Turbo, and the app loads htmx, so none of them worked.
          One shared fix covered every page.
        </p>
      </CaseProse>

          <div class="mt-8 grid grid-cols-2 gap-8 py-8">
            <Metric value="4.9" label="average score before" caption="across ten heuristics and 119 page captures" />
            <Metric value="3" label="lowest scores" caption="error prevention and recovering from errors" />
          </div>

          <HeuristicScores level={4} items={heuristics} caption="Each heuristic’s score before the fixes and the change made." />

    <CaseProse class="mt-12">
      <p>
        All three providers asked for the same fix: <strong class="text-ink font-semibold">capture
        entries by voice in the moment and review them later</strong>.
      </p>
    </CaseProse>

    <Fragment slot="media">
      <Container width="wide" class="mt-16">
        <CasePersonas items={logatotPersonas} />
      </Container>

      <Container width="wide" class="mt-16">
        <CaseJourney title="Journey map: a provider’s day" stages={logatotJourney} />
      </Container>
    </Fragment>
  </CaseSection>

  <CaseSection id="decisions" title="A Voiceboard that shows where every child is">
    <CaseFor project="logatot" personas={["renee"]} stage="day" />
    <CaseProse>
      <p>
        Providers check the Voiceboard most often to see where every child is and whether each
        has had the basics today. Each child gets <strong class="text-ink font-semibold">one
        compact tile</strong> with a status and an icon chip for each kind of moment logged today.
      </p>
      <p>
        A missing chip stands out. A child with no nap chip in the afternoon is easy to spot.
        Compact is the default. Detailed is one tap away and is used to write the end-of-day report.
      </p>
    </CaseProse>

    <Fragment slot="media">
      <Container width="wide" class="mt-16">
        <Plate
          title="Voiceboard, Compact"
          caption="One compact tile per child, with a chip for each kind of moment."
          src={rd('provider-voiceboard')}
          alt="The Voiceboard for Friday, October 30, signed in as the provider: a sidebar with Voiceboard, Children, Activity log, and Meals, then Modules and Resources groups and a Dark mode switch. The main area has a Ready to listen panel with a microphone and the example “Logatot, Ava woke up,” count pills for 0 here, 12 expected, 11 picked up, and 1 absent, a date control, and a Children heading with a Compact and Detailed switch above a three-column grid of child tiles, each with a photo, the pickup time, and colored moment chips."
        />
      </Container>

      <Container width="wide" class="mt-16">
        <Plate
          title="Voiceboard, Detailed"
          caption="Each child’s day so far, grouped by event type, for writing up the end-of-day report."
          src={app('voiceboard-children')}
          alt="Child cards on the Logatot Voiceboard. Each card shows a photo, the child’s name, their check-in time, and a list of the day’s events with times, such as a 7:08 am health check, a 12:29 pm wet diaper change, a 12:37 pm nap, lunch at 11:45 am, and outdoor play."
        />
      </Container>
    </Fragment>
  </CaseSection>

  <CaseSection id="decision-review" title="A review step for misheard entries">
    <CaseFor project="logatot" personas={["renee","marisol"]} stage="evening" />
    <CaseProse>
      <p>
        Providers asked to capture by voice in the moment and review later. When the
        app can’t match an entry to a child or an event, it sends the entry to review.
      </p>
      <p>
        A failed entry is saved with its words, translation, recording, and whatever
        the app partly understood. Tapping the word that was the child’s name adds
        that mishearing to the child’s name variants.
      </p>
      <p>
        Out loud, the app says <em>&ldquo;processing unknown event for
        unrecognized child&rdquo;</em> instead of announcing a failure to a room of
        children.
      </p>
    </CaseProse>

    <Fragment slot="media">
      <Container width="wide" class="mt-16">
        <Plate
          title={screen('04-logged-events').title}
          caption={screen('04-logged-events').note}
          src={sheet('04-logged-events')}
          alt={screen('04-logged-events').alt}
        />
      </Container>

      <Container width="wide" class="mt-16">
        <Plate
          title="Activity log: needs review"
          caption="What Logatot heard on the left, the fields to fix it on the right."
          src={rd('provider-repair')}
          alt="The Activity log with the Needs review tab selected, showing 2, beside Logged 819, Processing, and Recently deleted. Two failed entries, each with Name not heard and Event not recognized tags and a time, a large quote such as “Log a diaper change for, um, the little one in the blue shirt,” a hint to tap the word that was the child’s name, and on the right Child and What happened selects, an Edit transcript or time link, a Delete link, and a Save event button."
        />
      </Container>

      <CaseProse continued>
        <Heading level={3} visual="h2">Spanish</Heading>
        <p>
          Yari said: <em>&ldquo;A translated button is not enough. We
          need the instructions, warnings, support, and official documents to be
          clear too.&rdquo;</em> All of it ships in English and Spanish.
        </p>
        <p>
          After researching best practices and prototyping Spanish support, I convinced the
          team that internationalization was worth the work. Speech turned out to be simpler
          than we expected: changing
          <span class="font-mono text-sm text-ink">lang="en"</span> to
          <span class="font-mono text-sm text-ink">lang="es-us"</span> told the browser how to
          interpret what the customer said.
        </p>
        <p>
          The wording took more care. Google Translate was an acceptable starting point, but
          its translations weren’t culturally or contextually accurate. We hired a contractor
          to make sure the language made sense to Spanish-speaking providers. The work also
          prepared the app for Russian and Ukrainian, which smaller groups of customers speak.
        </p>
        <p>
          Every new label, hint, and error was written in English and Spanish together.
          Layouts were checked in Spanish at phone width.
        </p>
      </CaseProse>

      <Container width="wide" class="mt-16">
        <Plate
          title="Tablero de voz"
          caption="The Voiceboard with the provider’s language set to Spanish."
          src={rd('es-provider-voiceboard')}
          alt="The Voiceboard in Spanish: a sidebar with Tablero de voz, Niños, Registro de actividades, and Comidas, the panel Lista para escuchar with “Di ‘Logatot’ para registrar un momento” and the example “Logatot, Ava se despertó,” counts reading 0 presentes, 12 esperados, 11 recogidos, and 1 ausentes, the date Viernes, Octubre 30, and the Niños heading with Compacto and Detallado above child tiles reading “Recogido a las 4:55 pm.”"
        />
      </Container>

      <Container width="wide" class="mt-16">
        <Plate
          title="Registro de actividades"
          caption="Labels are translated. The quote stays as heard."
          src={rd('es-provider-repair')}
          alt="The Needs review screen in Spanish: tabs Por revisar 2, Registrados 819, Procesando, and Eliminados recientemente, entries tagged No se escuchó el nombre and Evento no reconocido, the hint “Toque la palabra que era el nombre del niño,” Niño and Tipo de evento selects, and Eliminar and Guardar evento buttons."
        />
      </Container>
    </Fragment>
  </CaseSection>

  <CaseSection id="decision-kiosk" title="A kiosk that shows a parent only their own child">
    <CaseFor project="logatot" personas={["tanya"]} stage="arrive" />
    <CaseProse>
      <p>
        Kiosk mode signs the provider out first, so a parent holding the tablet can
        reach only their own child.
      </p>
    </CaseProse>

    <Fragment slot="media">
      <Container width="wide" class="mt-16">
        <div class="grid grid-cols-1 gap-x-8 gap-y-14 lg:grid-cols-2">
          <Plate
            size="half"
            title="Kiosk: enter a PIN"
            caption="The PIN field is the only control."
            src={rd('kiosk-pin')}
            alt="The check-in kiosk on a tablet: a single white card with the Logatot logo, the heading Check In/Out, “Enter your PIN for Little Acorns Home Daycare,” and a large PIN field."
          />
          <Plate
            size="half"
            title="Kiosk: after the PIN"
            caption="Only this person’s children, then a signature."
            src={rd('kiosk-children')}
            alt="The kiosk after the PIN 0317 is entered: Liam Carter with a Check In checkbox, a signature pad labeled Signature for Megan Carter, and Clear Signature and Continue buttons."
          />
        </div>
      </Container>

      <CaseProse continued>
        <p>
          Families use the app about a dozen times a year, so they sign in with an email link
          instead of a password. They see the provider’s events for their own child and have
          nothing to manage. The family channel adds no work to the provider’s day.
        </p>
      </CaseProse>

      <Container width="wide" class="mt-16">
        {flowSet('14-flow-parent-access').map((flow) => (
          <Plate title={flow.title} caption={flow.note} src={sheet(flow.slug)} alt={flow.alt} />
        ))}
      </Container>

      <Container width="wide" class="mt-16">
        <div class="grid grid-cols-1 gap-x-8 gap-y-14 lg:grid-cols-2">
          <Plate
            size="half"
            title="Provider: a child’s profile"
            caption="The whole record, editable."
            src={rd('provider-child')}
            alt="Liam Carter’s profile signed in as the provider: the full sidebar, a raised header card with his photo, name, pronoun, birth date, age, an Active badge, Archive child and Edit buttons, and Health tiles for allergies, medications, diapers, and diet restrictions. Below, recessed panels list Legal guardians Megan and Ryan Carter with an Add legal guardian button, a Monday-to-Friday attendance strip, and Billing of $275.00 every two weeks."
          />
          <Plate
            size="half"
            title="Family: the same child"
            caption="Liam’s day and details, with no editing tools."
            src={rd('parent-dashboard')}
            alt="The family channel signed in as Megan Carter: a top bar with the daycare name and her name, a Family channel heading, a panel greeting her with a choice of child, the provider’s thank-you note, then October 30th activities for Liam Carter as a table of times and activities from Lunch to Check-out, and a Child details panel with tuition, allergies, medications, and Authorized pickups listing Tyler Carter."
          />
        </div>
      </Container>

      <CaseProse continued>
        <Heading level={3} visual="h2">Roles and access</Heading>
        <p>
          Four kinds of people use Logatot. Each signs in differently and sees a
          different set of screens built from the same components.
        </p>
      </CaseProse>

      <Container width="content" class="mt-12">
        <div class="case-layout-cont">
          <ul class="border-t border-line">
            {roles.map((r) => (
              <li class="flex gap-4 border-b border-line py-4">
                <Icon name={r.icon} size={22} class="mt-0.5 shrink-0 text-ink-muted" />
                <div class="min-w-0 flex-1">
                  <p class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <span class="font-medium text-ink leading-snug">{r.name}</span>
                    <span class="font-mono text-xs text-ink-muted">Sign-in: {r.signIn}</span>
                  </p>
                  <p class="mt-1 text-sm text-ink-muted leading-relaxed">{r.access}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </Container>
    </Fragment>
  </CaseSection>

  <CaseSection id="decision-menus" title="Menus checked against CACFP rules while they’re planned">
    <CaseFor project="logatot" personas={["renee","tanya"]} stage="claim" />
    <CaseProse>
      <p>
        A lunch missing a vegetable used to be found at month end, when it couldn’t be fixed.
        Menus are now checked per meal against the age group’s food requirements while they’re
        planned, and the month-end claim comes from records that already exist.
      </p>
    </CaseProse>

    <Fragment slot="media">
      <Container width="wide" class="mt-16">
        {flowSet('15-flow-food-program').map((flow) => (
          <Plate title={flow.title} caption={flow.note} src={sheet(flow.slug)} alt={flow.alt} />
