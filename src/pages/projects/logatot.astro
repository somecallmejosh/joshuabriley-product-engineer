// Source: log_a_tot tasks/heuristics-audit.md (2026-11-03).
const systemAudit = [
  { value: '0', label: 'forms guarded against double submits', note: 'Out of about fifty. A slow connection and a second tap could save the same record twice.' },
  { value: '4', label: 'different ways to delete', note: 'htmx requests, Rails buttons, Alpine fetch calls, and inline form handlers, each behaving a little differently.' },
  { value: '14', label: 'index pages with hand-built headers', note: 'Instead of the shared page header, so titles, actions, and spacing drifted from page to page.' },
  { value: 'None', label: 'of the confirm prompts worked', note: 'Turbo and rails-ujs weren’t loaded, so every “Are you sure?” was skipped. “Cancel my account” deleted the account on the first click.' },
];

// The decisions that shaped the new look. Each is a rule the whole app follows,
// written down in the project's lessons file so later screens keep to it.
const redesignDecisions = [
  { icon: 'ph:palette', title: 'Pastels that pass contrast', body: 'Each module has its own soft hue, generated with a script that checks WCAG AA contrast in light and dark mode. Text on a colored fill is always a dark ink of that hue, never white.' },
  { icon: 'ph:cursor-click', title: 'Buttons, tabs, and filters look different', body: 'Actions are filled pills. Navigation is a segmented control. Filters are checkbox chips. Before, all three were similar rounded buttons, so it wasn’t clear which one did what.' },
  { icon: 'ph:stack', title: 'One raised surface per page', body: 'The thing you came to the page for sits on a white card with a soft shadow. Filters, forms, and supporting details sit in recessed panels. Grouping comes from fills and spacing, not borders.' },
  { icon: 'ph:shapes', title: 'Never color alone', body: 'Every color-coded category also has an icon or a label. The menu calendar’s meal colors got meal icons and a written legend after I caught that the first version relied on color.' },
  { icon: 'ph:cube', title: 'The logo’s blocks do real work', body: 'The three toy blocks from the logo are the loading state (they drop and stack), the empty state (the top block is missing), and the error pages (the top block teeters).' },
  { icon: 'ph:rows', title: 'A Voiceboard that fits on one screen', body: 'A new compact view shows one tile per child with a chip for each kind of moment. On a full day it took the page from 3,849 to 1,386 pixels tall, and the choice is remembered.' },
];

// Who sees what. Derived from the app's role checks (User#host?,
// #admin_menu_access?, #caregiver?) and confirmed by signing in as each.
const roles = [
  { icon: 'ph:lifebuoy', name: 'Logatot staff', access: 'Everything a provider sees, plus the support list of every account, signing in as an account to help, and editing the blog.', signIn: 'Password' },
  { icon: 'ph:user-focus', name: 'Provider and employees', access: 'The full app: Voiceboard, children, activity log, meals, calendar, chat, documents, expenses, photos, reports, and help.', signIn: 'Password' },
  { icon: 'ph:users', name: 'Families', access: 'Their own children only. A family channel with the day’s timeline, child details, authorized pickups, and a message box. Any staff page redirects back to it.', signIn: 'Email link' },
  { icon: 'ph:identification-badge', name: 'Authorized pickups', access: 'No account. A four-digit PIN at the kiosk shows only the children that person is allowed to check in or out, then asks for a signature.', signIn: 'Kiosk PIN' },
];

// Nielsen heuristics, scored 0–10 before the fixes. Source: tasks/heuristics-audit.md
// (2026-11-03). The "fix" column lists changes that are in the redesign branch;
// a re-score has not been done yet, so no "after" number is claimed here.
const heuristics = [
  { n: 1, name: 'Visibility of system status', before: 5, fix: 'Every form shows a busy state while saving. A failed background save shows a message instead of failing silently.' },
  { n: 2, name: 'Match with the real world', before: 6, fix: '“Logged Events”, which opened on a tab called “Failed”, is now the Activity log, with tabs for Needs review, Logged, and Processing.' },
  { n: 3, name: 'User control and freedom', before: 5, fix: 'Signing in lands on the Voiceboard instead of a dead-end “Switchboard” page. Deleted events have a Recently deleted tab and can be restored.' },
  { n: 4, name: 'Consistency and standards', before: 6, fix: 'One confirm dialog for every destructive action, and the shared page header on every index page.' },
  { n: 5, name: 'Error prevention', before: 3, fix: '“Cancel my account” asks first. Every form is guarded against a double submit.' },
  { n: 6, name: 'Recognition over recall', before: 6, fix: 'Reports open with every active child selected instead of an empty result. The menu calendar’s warning icon has a written legend.' },
  { n: 7, name: 'Flexibility and efficiency', before: 4, fix: 'Press / to search children, documents, and expenses from any page. CSV export on reports, and bulk actions on documents.' },
  { n: 8, name: 'Aesthetic and minimalist', before: 7, fix: 'One raised surface per page, the compact Voiceboard, and recessed filters.' },
  { n: 9, name: 'Recovering from errors', before: 3, fix: 'Errors appear next to the field that caused them and are announced to screen readers. A sidebar page that crashed now loads.' },
  { n: 10, name: 'Help and documentation', before: 4, fix: 'An empty Voiceboard teaches the voice commands with real examples. Help moved into the sidebar.' },
];

// The phone set. Captions describe what is on screen.
const phones = [
  { slug: 'phone-provider-voiceboard', title: 'Voiceboard', note: 'Date, counts, and children stack in one column.', alt: 'The Voiceboard on a phone: the Ready to listen panel with the example “Logatot, Ava woke up,” a date control for Friday, October 30 with a Today button, count pills for 0 here, 12 expected, 11 picked up, and 1 absent, then the Children heading with the Compact and Detailed switch, an Add event button, and Ava Johnson’s tile.' },
  { slug: 'phone-provider-voiceboard-dark', title: 'Voiceboard, dark', note: 'The same screen with the dark theme on.', alt: 'The same phone Voiceboard in dark mode: navy surfaces, light text, and the same counts and child tile.' },
  { slug: 'es-phone-provider-voiceboard', title: 'Voiceboard, Spanish', note: 'Longer Spanish labels wrap without breaking the layout.', alt: 'The phone Voiceboard in Spanish: Lista para escuchar, Prueba a decir “Logatot, Ava se despertó,” Vie, Oct 30, Hoy, counts reading 0 presentes, 12 esperados, 11 recogidos, 1 ausentes, and the Niños heading with Compacto and Detallado.' },
  { slug: 'phone-provider-nav', title: 'Provider menu', note: 'Twelve destinations in three groups.', alt: 'The provider’s navigation drawer on a phone: Voiceboard highlighted, Children, Activity log, Meals, a Modules group with Calendar, Chat, Documents, and Expenses, and a Resources group with Photo gallery, Reports, Video learning library, and Help.' },
  { slug: 'phone-parent-nav', title: 'Family menu', note: 'A parent sees three links and the dark mode switch.', alt: 'A parent’s navigation drawer on a phone: Little Acorns Home Daycare, then only My children, Chat, Reports, and a Dark mode switch.' },
  { slug: 'phone-provider-child', title: 'Child profile', note: 'Health details become full-width tiles.', alt: 'Liam Carter’s profile on a phone: a large photo, his name, pronoun, birth date and age, an Active badge, Archive child and Edit buttons, then Health tiles for allergies, medications, and diapers.' },
  { slug: 'phone-provider-repair', title: 'Needs review', note: 'The misheard sentence first, then the fields to fix it.', alt: 'A failed voice entry on a phone: Name not heard and Event not recognized tags, the time, the quote “Log a diaper change for, um, the little one in the blue shirt,” a hint to tap the word that was the child’s name, and Child and What happened selects.' },
  { slug: 'phone-provider-menu-calendar', title: 'Menu calendar', note: 'The month grid becomes a list by day and meal.', alt: 'The menu calendar on a phone: Month and Week controls, a legend item for a missing required food component, then Sunday the 1st and Monday the 2nd as lists of breakfast, morning snack, lunch, and dinner, with a warning icon on two breakfasts.' },
  { slug: 'phone-parent-dashboard', title: 'Family channel', note: 'The provider’s welcome note, then the child’s day.', alt: 'The family channel on a phone: a Show filters button, the provider’s thank-you note, and October 30th activities for Liam Carter with a date filter and a timeline starting with Check-out and Activity.' },
  { slug: 'phone-public-home', title: 'Home', note: 'The hero plays a live voice demo under the headline.', alt: 'The Logatot home page on a phone: the headline “Child Care’s Only Voice-Controlled Assistant,” Register and Request a demo buttons, and a live preview of the listening panel above Ava Johnson’s card of the day’s moments.' },
  { slug: 'phone-public-home-es', title: 'Home, Spanish', note: 'The same page with the ES switch.', alt: 'The Spanish home page on a phone: “El único asistente de cuidado infantil controlado por voz,” Regístrate and Solicita una demostración buttons, and the listening panel reading Lista para escuchar.' },
  { slug: 'phone-public-sign-in', title: 'Provider login', note: 'Families get their own link at the bottom.', alt: 'The provider login on a phone: email and password fields, Remember me, a Login button, Register and Forgot your password links, and a “Family member? Family login” button.' },
];

// What the redesign left open. Each was seen in the captures for this page
// or is recorded in the project's task notes.
const redesignEdges = [
  { icon: 'ph:house-line', title: 'The family channel is behind', body: 'It got the new colors and fonts but not the new layout, so it still uses bordered cards. In dark mode, the provider’s welcome note is close to unreadable. It is the next page to redesign.' },
  { icon: 'ph:arrows-clockwise', title: 'Family menu links loop back', body: 'A parent’s menu offers My children, Chat, and Reports, but each of those pages is staff-only and redirects to the family channel. The links should either go somewhere useful or not be there.' },
  { icon: 'ph:translate', title: 'Spanish isn’t complete', body: 'The Spanish files are missing 67 of the 2,313 English entries. The home page’s demo cards also stay in English on the Spanish site, so a Spanish speaker sees “Ava played outside on the climber.”' },
  { icon: 'ph:chart-line-up', title: 'No re-score yet', body: 'The fixes for every heuristic are in, but I haven’t scored the app again. Until I do, the 4.9 is the only number I can stand behind.' },
];

// The TLDR digest. "Alternatives" and "Decision" restate the AI-in-the-loop
// call already argued in the #pipeline step; "Reflection" restates the edges
// section below rather than inventing a new critique — see
// notes/interview-notes/tldr.md.
const tldr = {
  problem: `Three separate provider interviews all pointed to the same problem: a job that demands constant attention leaves no time for paperwork, so providers filled it in from memory at night, and those memory-based records were the ones inspectors and food-program auditors cared about most.`,
  alternativeA: {
    name: 'Let an AI model guess what was said',
    body: `More flexible with unusual phrasing, but it can guess wrong with confidence, logging a nap that never happened into a record a parent or inspector might read.`,
  },
  alternativeB: {
    name: 'Match speech against a known list, use AI ahead of time',
    body: `What's said is checked against a fixed list of known phrases. AI is used earlier, to guess how a child's name might sound in different accents, before anyone ever speaks it.`,
  },
  decision: `I chose <strong class="text-ink font-semibold">matching against a known list</strong> in the moment, and using AI to prepare ahead of time instead. A record someone might use to check compliance can't afford a confident guess.`,
  implementation: `Every voice entry is logged, even the ones the system can't fully understand. Unclear entries go to a review queue where a provider taps the correct word, which teaches the system that name for good.`,
  evidence: `One provider said she saved over two hours a day on paperwork. Attendance, meal, and safety records now come from the same entries logged during the day, so reviewing them takes minutes instead of an evening.`,
  reflection: `The busiest screen doesn't announce its state to a screen reader the way the rest of the app does, and the layout only adjusts at one screen size, which leaves tablets, the exact device this runs on, poorly served. Both are on my list to fix.`,
};
---

<ProjectLayout title={title} description={description}>

  <ProjectHero project="logatot" />

  <CaseReview links={[{ href: '#tldr', label: 'Summary' }, { href: '#research', label: 'Research' }, { href: '#failure', label: 'Interaction design' }, { href: '#outcomes', label: 'Results' }, { href: '#pipeline', label: 'Engineering' }, { href: '#redesign', label: '2026 redesign' }, { href: '#roles', label: 'Provider vs. family' }, { href: '#spanish', label: 'Spanish' }, { href: '#dark-mode', label: 'Dark mode' }, { href: '#heuristics', label: 'Heuristic audit' }, { href: '#mobile', label: 'Mobile' }, { href: '#public-site', label: 'Public site' }, { href: '#edges', label: 'What I’d improve' }]} />

  <Tldr
    problem={tldr.problem}
    alternativeA={tldr.alternativeA}
    alternativeB={tldr.alternativeB}
    decision={tldr.decision}
    implementation={tldr.implementation}
    evidence={tldr.evidence}
    reflection={tldr.reflection}
  />

  <Section tone="paper" padding="tight" aria-label="Scope and results" class="project-scope">
    <Container width="content">
      <p class="mono-label mb-8">Scope and results</p>
      <dl class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {proof.map((group) => (
          <div class="pt-4">
            <dt class="mono-label mb-3">{group.label}</dt>
            <dd>
              <ul class="space-y-1.5">
                {group.items.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-ink-muted leading-relaxed">
                    <Icon name="ph:check" size={14} class="mt-0.5 shrink-0 text-accent" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="hands" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Who the app is for</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              A home daycare provider is one person: caregiver, cook, and record-keeper,
              often holding a toddler through a twelve-hour day. She also has to answer to
              three separate sets of rules, all reflected in how the app is built.
            </p>
            <p>
              None of those rules get followed at a desk, so the paperwork used to happen
              after the fact, at 8pm, from memory. The whole app exists to move that
              record-keeping into the moment, hands-free, so the required records come
              from those entries instead of being written up later.
            </p>
          </div>

          <div class="mt-12">
            <p class="mono-label mb-6">Three sets of rules</p>
            <ol class="grid gap-x-8 gap-y-8 sm:grid-cols-2">
              {regimes.map((r) => (
                <li class="pt-5">
                  <div class="mb-3 flex items-center gap-3">
                    <Icon name={r.icon} size={20} class="text-ink-muted" />
                  </div>
                  <Heading level={3} visual="h3" tone="ink" class="mb-1.5">{r.title}</Heading>
                  <Text size="sm" tone="muted">{r.body}</Text>
                </li>
              ))}
            </ol>
          </div>

          <div class="mt-12">
            <p class="mono-label mb-6">Problems with logging from memory</p>
            <ul class="grid gap-x-8 gap-y-8 sm:grid-cols-2">
              {problems.map((p) => (
                <li class="pt-5">
                  <Icon name={p.icon} size={24} class="mb-3 text-ink-muted" />
                  <Heading level={3} visual="h3" tone="ink" class="mb-1.5">{p.title}</Heading>
                  <Text size="sm" tone="muted">{p.body}</Text>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-12">
            <p class="mono-label mb-6">Four types of users</p>
            <ul class="grid gap-x-10 gap-y-1 md:grid-cols-2">
              {users.map((u) => (
                <li class="flex gap-3.5 py-4">
                  <Icon name={u.icon} size={22} class="mt-0.5 shrink-0 text-ink-muted" />
                  <div>
                    <p class="font-medium text-ink leading-snug">{u.name}</p>
                    <p class="mt-0.5 text-sm text-ink-muted leading-snug">{u.role}</p>
                  </div>
                </li>
              ))}
            </ul>
            <Text size="sm" tone="muted" class="mt-5 measure">
              All four sign in through the same account system, which attaches each
              person's role, such as employee or authorized pickup, to their account.
            </Text>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="research" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Talking to providers first</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Before any screen on this page existed, I interviewed three home-based
              providers separately: Angie, Deborah, and Yari. I also talked with the
              administrators who process food-program reimbursements, and with
              childcare influencers who talk to that audience online.
            </p>
            <p>
              All three providers, without hearing each other, described the same
              problem: watching children all day leaves no attention left for the
              paperwork it also requires. And they described the same fix: capture
              it by voice in the moment, then review it later, instead of trying to
              remember it at night. That's what the Voiceboard and the review queue
              described below are built around.
            </p>
          </div>

          <div class="mt-12">
            <p class="mono-label mb-6">Changes from the research calls</p>
            <ul class="grid gap-x-8 gap-y-8 sm:grid-cols-2">
              {research.map((r) => (
                <li class="pt-5">
                  <Icon name={r.icon} size={24} class="mb-3 text-ink-muted" />
                  <Heading level={3} visual="h3" tone="ink" class="mb-1.5">{r.title}</Heading>
                  <Text size="sm" tone="muted">{r.body}</Text>
                </li>
              ))}
            </ul>
          </div>

          <figure class="my-12 border-l-2 border-accent pl-6">
            <blockquote class="font-display text-2xl md:text-3xl tracking-tight text-ink leading-snug">
              &ldquo;I would want to review it. Names can be difficult. A system
              may misunderstand a child&rsquo;s name or a Spanish word. It should
              show me what it heard and let me approve or correct it.&rdquo;
            </blockquote>
            <figcaption class="mt-3 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-muted">
              Yari, on trusting voice entry for official records, before a line of the parser existed
            </figcaption>
          </figure>

          <div class="measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p class="text-base">
              Source interviews, lightly edited for length:
              <a href="/projects/interview-notes/logatot/angie/" class="hero-link">Angie</a>,
              <a href="/projects/interview-notes/logatot/deborah/" class="hero-link">Deborah</a>,
              <a href="/projects/interview-notes/logatot/yari/" class="hero-link">Yari</a>, and the
              <a href="/projects/interview-notes/logatot/interview-analysis/" class="hero-link">cross-interview theme analysis</a>.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="shapes" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Provider and parent views</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              The main screen is the Voiceboard: one row per child, one column per event
              type, for a single day. A provider scanning twelve children needs the rows
              to <strong class="text-ink font-semibold">scroll left and right together</strong>,
              so they stay lined up on the same point in time. Otherwise each row scrolls
              on its own and the times stop lining up.
            </p>
          </div>

          <div class="mt-10 rounded-lg border border-line p-6 md:p-8">
            <p class="mono-label mb-4">How these sheets were made</p>
            <div class="space-y-4 text-ink-muted leading-relaxed">
              <p>
                Every screen went through three passes: a rough sketch to work out the
                shape, a clean wireframe to fix it, and that same wireframe with the
                reasoning written onto it. The decisions themselves came from the
                provider calls described above, made while the app was being built. The
                sheets were drawn afterward, to document that reasoning for this case
                study.
              </p>
            </div>
          </div>

        </div>
      </div>
    </Container>

    <Container width="wide" class="mt-16">
      <p class="mono-label mb-6">From sketch to annotated wireframe</p>
      <FidelityBand
        title={screen('01-voiceboard').title}
        sketch={art('01-voiceboard-sketch.svg')}
        wire={art('01-voiceboard.svg')}
        annotated={sheet('01-voiceboard')}
        annotatedAlt={screen('01-voiceboard').alt}
        caption="The Voiceboard as a sketch, a clean wireframe, and an annotated wireframe. The annotations record why rows scroll horizontally in sync and why empty rows are pre-rendered so live updates have somewhere to land."
      />
    </Container>

    <Container width="wide" class="mt-16">
      <Plate
        title={screen('01-voiceboard').title}
        caption={screen('01-voiceboard').note}
        src={sheet('01-voiceboard')}
        alt={screen('01-voiceboard').alt}
      />
    </Container>

    <Container width="wide" class="mt-16">
      <p class="mono-label mb-6">The Voiceboard in the app</p>
      <div class="grid gap-x-8 gap-y-14 md:grid-cols-2">
        <Plate
          size="half"
          title="Ready to listen"
          caption="The listening panel with an example phrase, and the day’s counts of children here, expected, picked up, and absent."
          src={app('voiceboard')}
          alt="The top of the Logatot Voiceboard: a Ready to listen panel with a microphone, the prompt “Say Logatot to record a moment,” the example “Logatot, Ava just checked in,” counts reading 11 here, 0 expected, 0 picked up, and 1 absent, and a date picker set to Sunday, November 1. Below, the Children heading with a Compact and Detailed switch, and the first rows of compact child tiles."
        />
        <Plate
          size="half"
          title="One card per child"
          caption="Each child’s day so far, grouped by event type: health checks, diaper changes, naps, meals, and activities."
          src={app('voiceboard-children')}
          alt="Child cards on the Logatot Voiceboard. Each card shows a photo, the child’s name, their check-in time, and a list of the day’s events with times, such as a 7:08 am health check, a 12:29 pm wet diaper change, a 12:37 pm nap, lunch at 11:45 am, and outdoor play."
        />
      </div>
    </Container>

    <Container width="content" class="mt-16">
      <div class="case-layout-cont measure space-y-5 leading-relaxed text-ink-muted text-lg">
        <p>
          The parent portal shows exactly the same events as a
          <strong class="text-ink font-semibold">timeline</strong>: time down the left,
          one child at a time. The provider is scanning twelve children at once, so the
          provider gets a grid. A parent is reading about one child in order, so the
          parent gets a chronology. The only thing a parent can send from the portal is
          a message to the provider, because every extra way to submit something would
          be one more thing for the provider to handle during the day.
        </p>
      </div>
    </Container>

    <Container width="wide" class="mt-16">
      <Plate
        title={screen('06-parent-portal').title}
        caption={screen('06-parent-portal').note}
        src={sheet('06-parent-portal')}
        alt={screen('06-parent-portal').alt}
      />
    </Container>

  </Section>

  <Section tone="paper" padding="default">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Handing the tablet to a parent</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Check-in is the one moment the provider's own tablet leaves her hands.
              Kiosk mode signs the provider out completely first, so a parent holding
              the tablet has nowhere to go and no record to reach besides their own
              child's. Parents sign in with a link sent to their email instead of a
              password, since most families only use the app a dozen times a year.
            </p>
          </div>

        </div>
      </div>
    </Container>

    <Container width="wide" class="mt-16">
      <Plate
        title={screen('05-checkin-kiosk').title}
        caption={screen('05-checkin-kiosk').note}
        src={sheet('05-checkin-kiosk')}
        alt={screen('05-checkin-kiosk').alt}
      />
    </Container>

    <Container width="wide" class="mt-16">
      <Plate
        title="Check-in kiosk in the app"
        caption="Once the provider has signed out, the tablet shows only the daycare’s name and a PIN field."
        src={app('kiosk')}
        alt="The Logatot check-in kiosk: a single white card on a plain background with the Logatot logo, the heading Check In/Out, the prompt “Enter your PIN for Little Acorns Home Daycare,” and a large PIN field. There is no navigation."
      />
    </Container>

    <Container width="wide" class="mt-16">
      <div class="space-y-16">
        {flowSet('13-flow-checkin', '14-flow-parent-access').map((flow) => (
          <Plate
            title={flow.title}
            caption={flow.note}
            src={sheet(flow.slug)}
            alt={flow.alt}
          />
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="failure" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Fixing misheard entries</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              When the app can't understand what was said, it saves the attempt
              instead of throwing it away, along with the raw words, a translation,
              and the recording. A badge shows how many are waiting for review.
            </p>
            <p>
              On the review screen, the words appear as clickable chips. Tapping the
              one that was the child's name teaches the app that name, and the same
              mishearing gets recognized correctly every time after.
            </p>
            <p>
              The app also shows what it partly understood instead of discarding it,
              so a provider only fills in the missing piece. And instead of announcing
              a failure out loud in a room full of children, the spoken reply just says
              <em>&ldquo;processing unknown event for unrecognized child&rdquo;</em>,
              while it waits for review.
            </p>
          </div>

        </div>
      </div>
    </Container>

    <Container width="wide" class="mt-16">
      <Plate
        title={screen('04-logged-events').title}
        caption={screen('04-logged-events').note}
        src={sheet('04-logged-events')}
        alt={screen('04-logged-events').alt}
      />
    </Container>

    <Container width="wide" class="mt-16">
      <Plate
        title="The review queue in the app"
        caption="Two failed entries, each labeled with what went wrong: the name wasn’t heard, the event wasn’t recognized, or both. The provider picks the child and the event, then saves."
        src={app('repair-queue')}
        alt="The Failed tab of Logged events in Logatot, with a badge showing 2. Each failed entry shows the transcript, such as “Log a diaper change for, um, the little one in the blue shirt,” Name not heard and Event not recognized tags, the time, a hint to tap the word that was the child’s name, Child and Event Type dropdowns, a Delete link, and a Save event button."
      />
    </Container>

    <Container width="content" class="mt-16">
      <figure class="case-layout-cont border-l-2 border-accent pl-6">
        <blockquote class="font-display text-2xl md:text-3xl tracking-tight text-ink leading-snug">
          We couldn&rsquo;t spot the child&rsquo;s name in this event. Help us by
          selecting a word below that sounds like the name. If there&rsquo;s no match,
          no worries, just ignore this step!
        </blockquote>
        <figcaption class="mono-label mt-5">Text from the repair screen</figcaption>
      </figure>
    </Container>
  </Section>

  <Section tone="paper" padding="default">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Accessibility and Spanish support</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Voice helps a provider holding a child, and it helps anyone who can't
              comfortably type mid-task. But it can't be voice-only: everything
              capturable by speech can also be entered by hand, so a failed recognition
              always has a manual way through. Every button shows a visible outline when
              focused with a keyboard, status changes get read aloud to a screen reader
              as they happen, and printed reports always come out in plain black text,
              even if the provider's screen is set to dark mode.
            </p>
            <p>
              Translation goes further than swapping button labels, because Yari said so
              directly in her interview: <em>&ldquo;A translated button is not enough. We
              need the instructions, warnings, support, and official documents to be
              clear too.&rdquo;</em> English and Spanish are fully supported, including
              instructions, warnings, and official documents, and Spanish speech is
              translated before the app tries to match it against a known phrase.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="outcomes" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">What changed for providers</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Attendance records, signed releases, food-program claims, and safety logs
              now come from events captured during the day, so month end is a quick
              review instead of an evening of catching up. The app shipped as a paid
              product, sold directly and through child care associations.
            </p>
          </div>

          <div class="mt-12 grid grid-cols-2 gap-8 py-8">
            <Metric value="2+ hrs" label="less data entry per day" caption="reported by a provider association president" />
            <Metric value="~1,100" label="of the project's 1,939 commits" caption="lead front-end on a three-developer team" />
          </div>

        </div>
      </div>
    </Container>

    <Container width="wide" class="mt-16">
      <div class="space-y-16">
        {flowSet('12-flow-onboarding', '15-flow-food-program').map((flow) => (
          <Plate
            title={flow.title}
            caption={flow.note}
            src={sheet(flow.slug)}
            alt={flow.alt}
          />
        ))}
      </div>
    </Container>

    <Container width="wide" class="mt-16">
      <div class="grid gap-x-8 gap-y-14 md:grid-cols-2">
        <Plate
          size="half"
          title="Menu calendar"
          caption="The month’s planned meals and snacks as one-line chips in meal-time order. A red warning marks a meal that doesn’t meet CACFP rules."
          src={app('menu-calendar')}
          alt="The Logatot menu calendar for November 2026: one month grid where each day lists one-line meal chips in meal-time order, such as toast and bananas, apples and cheese, turkey wraps, and pasta and meatballs, each with a meal-type icon. A legend shows breakfast, snack, lunch, and dinner icons, repeated snacks show ×2, today is tinted, and breakfast chips carry red warning triangles. Tabs above read My Meals, Menu Calendar, and Shopping List."
        />
        <Plate
          size="half"
          title="Reports"
          caption="Reports for children (allergies, attendance, daily activity, medications) and for the provider and facility (fire drills, provider time, timeclock, shelter in place)."
          src={app('reports')}
          alt="The Logatot Reports page, with Child Reports cards for Allergies, Attendance, Daily Activity, and Medications, and Provider/Facility Reports cards for Fire Drills, Provider Time, Timeclock, and Shelter in Place."
        />
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default">
    <Container width="content">
      <p class="mono-label mb-10">Testimonials</p>
      <div class="grid gap-10 md:grid-cols-2 lg:gap-16">
        {quotes.map((q) => (
          <figure>
            <Icon name="ph:quotes" size={40} class="mb-5 text-accent opacity-25" />
            <blockquote class="font-display text-xl md:text-2xl tracking-tight leading-snug text-ink">
              {q.body}
            </blockquote>
            <figcaption class="mt-6 pt-4">
              <p class="font-display font-semibold text-ink">{q.name}</p>
              <p class="mt-1 text-sm text-ink-muted leading-snug">{q.role}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </Container>
  </Section>

  <section id="feedback" class="surface-denim scroll-mt-24">
    <Container width="content">
      <Heading level={2} visual="h2" tone="paper" class="mb-3">What users asked us to fix after launch</Heading>
      <p class="measure mb-6 text-lg leading-relaxed">
        A follow-up questionnaire led to a readable menu calendar, one white card per page,
        a compact voiceboard, and shared components that are the only option.
      </p>
      <a href="/projects/logatot/feedback/" class="editorial-link editorial-link--light">
        Read the follow-up case study <span aria-hidden="true" data-link-arrow="right">→</span>
      </a>
    </Container>
  </section>

  <Section tone="paper" padding="default" id="pipeline" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">How it’s built</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              A wake-word detector runs directly on the device, always listening for
              "log a tot", so no audio ever leaves the device just to hear that phrase.
              With a live microphone in a room full of other people's children, that
              was the first question every provider asked.
            </p>
            <p>
              Turning speech into a saved record runs on a fixed set of rules, with no
              AI guessing in that step. What's said is checked against a list of known
              phrases, and names are matched against the class roster. An AI model
              making that call live would be slower and could confidently guess wrong,
              logging a nap that never happened. The rule-based system either finds a
              match or sends it to a person to review, and a non-match is an expected
              outcome.
            </p>
            <p>
              AI is used earlier instead. When a child is added, it generates a list of
              ways that name is likely to be mispronounced or misheard, and the app
              checks new recordings against that list. Toddler names are short and
              similar to each other, so getting them right is the app's hardest
              problem. Corrections a provider makes in the review queue get added to
              that same list, so the system keeps improving.
            </p>
            <p>
              Spanish speech gets translated to English before the app tries to match
              it, so one set of phrases covers both languages. A single child mentioned
              updates the screen right away; several children at once take a moment
              longer in the background, so the response never slows down.
            </p>
          </div>

        </div>
      </div>
    </Container>

    <Container width="wide" class="mt-16">
      {flowSet('11-flow-voice-logging').map((flow) => (
        <Plate
          title={flow.title}
          caption={flow.note}
          src={sheet(flow.slug)}
          alt={flow.alt}
        />
      ))}
    </Container>

    <Container width="content" class="mt-16">
      <div class="case-layout-cont">
        <div class="rounded-lg border border-line p-6 md:p-8">
          <p class="mono-label mb-6">Services</p>
          <ul class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
            {integrations.map((svc) => (
              <li class="flex gap-3.5">
                <Icon name={svc.icon} size={22} class="mt-0.5 shrink-0 text-ink-muted" />
                <div>
                  <p class="font-medium text-ink leading-snug">{svc.name}</p>
                  <p class="mt-0.5 text-sm text-ink-muted leading-snug">{svc.role}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>

    <Container width="content" class="mt-16">
      <div class="case-layout-cont">
        <div class="measure space-y-5 leading-relaxed text-ink-muted text-lg">
          <p>
            Underneath the provider and parent views, whether a child is checked in isn't stored as a
            simple yes-or-no flag. It's worked out fresh each time from the full
            history of check-ins and check-outs, so it can never drift out of sync
            with what actually happened, no matter which of the ways a check gets
            logged, voice, tablet, or the shared board. A wrong headcount is a
            licensing problem, so it was worth the extra work.
          </p>
