            {item.label}
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-12">
      <CodeBlock
        filename="logged_event.rb"
        lang="ruby"
        code={modelSnippet}
        caption="Every write path shares the event log, including failure diagnostics for repair."
      />
    </div>

