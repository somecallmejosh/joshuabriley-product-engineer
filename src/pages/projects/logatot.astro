  { icon: 'ph:users', name: 'Parents', role: 'Use the app about a dozen times a year, usually on a phone at pickup time, so they sign in with an email link instead of a password.' },
  { icon: 'ph:identification-badge', name: 'Authorized pickups', role: 'Each has their own PIN and their own list of children they can pick up, so the app enforces custody rules.' },
  { icon: 'ph:clock-user', name: 'Employees', role: 'In accounts with staff, employees clock in and out through the same event log as everything else.' },
];

// The design decisions that only hold because they were built once, in the system.
const structural = [
