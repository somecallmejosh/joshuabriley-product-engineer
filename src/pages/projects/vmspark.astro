---
import ProjectLayout from '~/layouts/ProjectLayout.astro';
import ProjectHero from '~/components/patterns/ProjectHero.astro';
import ProjectNext from '~/components/patterns/ProjectNext.astro';
import GalleryLink from '~/components/patterns/GalleryLink.astro';
import CaseReview from '~/components/patterns/CaseReview.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import SiteShot from '~/components/patterns/SiteShot.astro';
import ScrollShot from '~/components/patterns/ScrollShot.astro';
import Plate from '~/components/patterns/Plate.astro';
import FidelityBand from '~/components/patterns/FidelityBand.astro';
import Tldr from '~/components/patterns/Tldr.astro';
import { vmsparkSummary as tldr } from '~/lib/project-summaries';
import type { ImageMetadata } from 'astro';

const title = 'VMSpark | Joshua Briley';
const description =
  'Case study: redesigning the VMSpark admin app after auditing about 350 templates, without changing the data pipeline.';

// Copy throughout comes from notes/vm-spark.md (Josh's write-up).
const findings = [
  'Five ways of rendering forms',
  'Three modal conventions that broke when one modal opened another',
  'Three tooltip systems, one using Bootstrap 4 attributes that do nothing in Bootstrap 5',
  'A semantic color token file that about 40 views bypassed with raw hex values',
  'Dead files and debug code still being shipped',
];

const sorting = [
  { label: 'Cosmetic', text: 'fix during the redesign' },
  { label: 'Structural', text: 'decide first' },
  { label: 'Out of scope', text: 'too close to the pipeline' },
];

// Real screens from the app before the redesign.
const beforeShots = [
  {
    src: '/images/projects/vmspark/before-manual-jobs.png',
    alt: 'VMSpark Manual Jobs screen before the redesign. Three buttons sit side by side in the top bar: a filled orange Add New, an outlined Edit Selected, and an outlined Copy Selected. Labels sit below each search input.',
    caption: '<strong class="text-ink font-semibold">Manual Jobs.</strong> Three buttons, three treatments, and labels below the inputs.',
  },
  {
    src: '/images/projects/vmspark/before-ats-professions.png',
    alt: 'VMSpark ATS Professions screen before the redesign. Five search inputs use their label text as placeholders inside the fields.',
    caption: '<strong class="text-ink font-semibold">ATS Professions.</strong> Labels used as placeholders.',
  },
];

const directions = [
  { name: 'Command Shell', from: 'Linear', body: 'Icon rail, dense type, and a ⌘K palette.', note: 'Fast for power users, but stark.', icon: 'ph:terminal-window' },
  { name: 'Atlassian Platform', from: 'Jira', body: 'Product rail, contextual panel, page headers, and a slide-over inspector.', note: 'Familiar to most enterprise users.', icon: 'ph:users-three', chosen: true },
  { name: 'Modern Workspace', from: 'Notion', body: 'Soft sidebar, generous spacing, and no top bar.', note: 'Calm, but too light for a dense operations tool.', icon: 'ph:warning' },
];

const phases = [
  { label: 'Visual baseline', icon: 'ph:ruler', body: 'One shared page header. Pointing the old heading partial at it updated about 30 pages without editing them.' },
  { label: 'The shell', icon: 'ph:sidebar', body: 'A product rail plus a panel that changes with each section. The server picks the open section, so nothing shifts after load.' },
  { label: '⌘K search', icon: 'ph:magnifying-glass', body: 'Read-only search within the current account, grouped by type, in a native <code>&lt;dialog&gt;</code>. Page filters stay as they were.' },
  { label: 'Polish', icon: 'ph:sparkle', body: 'A saved density setting, a <code>?</code> shortcut overlay, a slide-over inspector, and skeleton loaders that respect reduced motion.' },
];

const reviewFixes = [
  'Header icons match the navigation icons',
  'Shortcuts work on Mac and Windows (⌘K and Ctrl+K)',
  'Density applies to the whole interface',
  'The shortcut overlay is hidden on phones',
];

const tableTools = [
  'Resizable, pinned, and reorderable columns, remembered per user',
  'Saved searches',
  'A row inspector that opens a listing without leaving the filtered list',
  'Inspector fields grouped by source, so operators can trace a failed value',
];

const results = [
  { label: 'For operators', items: ['Data, filters, and workflows unchanged on release day', 'The old sidebar is one setting away', 'Density, column layouts, and saved searches follow each user'] },
  { label: 'For the team', items: ['One page header, modal pattern, and table toolkit', 'An in-app style guide with dos and don’ts', 'Written records of the rejected directions'] },
  { label: 'For the business', items: ['An admin app ready to show investors', 'No changes to the pipeline, rule engine, or integrations'] },
];

// Screenshots of the local app (1440px wide at 2x). The workspace name and the
// signed-in email were replaced in the DOM before capture.
const shots = import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/vmspark/*.png', { eager: true });
const shot = (slug: string) => shots[`../../assets/projects/vmspark/${slug}.png`].default;

// Wireframe and flow sheets render from src/ so Astro can process them.
const sheetFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/vmspark/wires-and-flows/*.png', { eager: true });
const sheet = (slug: string) => sheetFiles[`../../assets/projects/vmspark/wires-and-flows/${slug}.png`].default;
// The sketch and clean-wireframe passes are SVG and need no processing.
const art = (file: string) => `/images/projects/vmspark/wires-and-flows/${file}`;

const edges = [
  {
    icon: 'ph:users-three',
    title: 'Feedback came from reviews, not observed use',
    body: 'I didn’t watch operators use the new shell, so I can’t claim it’s faster.',
  },
  {
    icon: 'ph:ruler',
    title: 'No baseline metrics',
    body: 'The results show what didn’t break. Next time I’d time a few tasks on the old shell first.',
  },
];
---

<ProjectLayout title={title} description={description}>

  <ProjectHero project="vmspark" />

  <CaseReview links={[{ href: '#tldr', label: 'Summary' }, { href: '#method', label: 'Audit' }, { href: '#directions', label: 'Directions' }, { href: '#sheets', label: 'Wireframes and flows' }, { href: '#outcomes', label: 'Results' }, { href: '#engineering', label: 'Engineering' }, { href: '#edges', label: 'Limitations' }]} />

  <Tldr
    problem={tldr.problem}
    decision={tldr.decision}
    evidence={tldr.evidence}
  />

  <Section tone="paper" padding="default" id="method" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Template audit</Heading>
        </div>
        <div class="case-layout__body">
          <Text size="lg" tone="muted" class="mt-8 measure">
            Before designing anything, I audited about 350 templates and 11,800 lines of view code.
            The audit found:
          </Text>

          <ul class="mt-6 space-y-3">
            {findings.map((item) => (
              <li class="flex items-start gap-3 leading-relaxed text-ink-muted">
                <Icon name="ph:dot-outline" size={18} class="mt-1 shrink-0 text-accent" />
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div class="mt-10 rounded-lg border border-line p-6 md:p-8">
            <p class="mono-label mb-5">Each finding was sorted as</p>
            <ul class="space-y-3">
              {sorting.map((s) => (
                <li class="flex items-start gap-3 text-ink-muted">
                  <Icon name="ph:check" size={16} class="mt-1 shrink-0 text-accent" />
                  <span><strong class="font-medium text-ink">{s.label}:</strong> {s.text}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Container>

    <Container width="wide" class="mt-16">
      <ul class="grid gap-x-8 gap-y-14 md:grid-cols-2">
        {beforeShots.map((img) => (
          <li>
            <figure>
              <div class="overflow-hidden rounded-lg border border-line">
                <img src={img.src} alt={img.alt} class="w-full h-auto block" loading="lazy" decoding="async" />
              </div>
              <figcaption class="mt-4 text-sm text-ink-muted leading-relaxed" set:html={img.caption} />
            </figure>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="directions" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Design directions</Heading>
        </div>
        <div class="case-layout__body">
          <Text size="lg" tone="muted" class="mt-8 measure">
            I wrote up three directions, each modeled on a product operators might already know.
          </Text>

          <ol class="mt-10 grid gap-6 sm:grid-cols-3 items-stretch">
            {directions.map((d) => (
              <li class:list={['rounded-lg border p-6', d.chosen ? 'border-accent' : 'border-line']}>
                {d.chosen && <p class="mono-label !text-accent mb-2">Chosen</p>}
                <p class="mono-label mb-1">{d.from}</p>
                <Heading level={3} visual="h4" tone="ink" class="mb-3">{d.name}</Heading>
                <Text size="sm" tone="muted">{d.body}</Text>
                <p class="mt-4 flex items-start gap-2 text-sm text-ink-muted">
                  <Icon name={d.icon} size={15} class="mt-0.5 shrink-0 text-accent" />
                  <span>{d.note}</span>
                </p>
              </li>
            ))}
          </ol>

          <Text size="lg" tone="muted" class="mt-10 measure">
            Operators use this tool all day, and a familiar pattern earns trust faster than a new one.
            I left out Jira’s global Create button, though: most VMSpark records come from feeds, not
            people.
          </Text>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="phases" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Four phases</Heading>
        </div>
        <div class="case-layout__body">
          <Text size="lg" tone="muted" class="mt-8 measure">
            Each phase shipped to production on its own.
          </Text>

          <ol class="mt-12 grid md:grid-cols-2 gap-x-8 gap-y-10">
            {phases.map((ph, i) => (
              <li class="pt-5">
                <p class="mono-label">Phase {i + 1}</p>
                <div class="mt-3 mb-3 flex items-center gap-2">
                  <Icon name={ph.icon} size={22} class="text-ink-muted" />
                  <Heading level={3} visual="h3" tone="ink">{ph.label}</Heading>
                </div>
                <Text tone="muted"><Fragment set:html={ph.body} /></Text>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </Container>

    <Container width="wide" class="mt-16">
      <Plate title="The two-tier shell" caption="The product rail, job listings panel, and shared page header." src={shot('app-shell')} alt="The redesigned VMSpark admin app: a dark product rail and a Job Listings side panel on the left, a top bar with the workspace name and a ⌘K button, and the Job Listings page with its header, All, Processed and Skipped tabs, and the listings table." />
    </Container>

    <Container width="wide" class="mt-16">
      <ul class="grid gap-x-8 gap-y-14 md:grid-cols-2">
        <li>
          <Plate size="half" title="⌘K search" caption="Results for the current account, grouped by type." src={shot('command-search')} alt="The ⌘K search dialog over the job listings page, with the query “windsor” and a list of matching facilities with their city and state." />
        </li>
        <li>
          <Plate size="half" title="Shortcut overlay" caption="Press ? outside a text field." src={shot('shortcuts')} alt="The keyboard shortcuts overlay, listing shortcuts for navigation, the view, the inspector, and the search palette." />
        </li>
      </ul>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="feedback" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Review feedback</Heading>
        </div>
        <div class="case-layout__body">
          <Text size="lg" tone="muted" class="mt-8 measure">
            Stakeholders said long-time users knew the old sidebar by heart, so I added a per-user
            setting to switch back. I also shipped every fix from that review:
          </Text>

          <ul class="mt-6 space-y-3">
            {reviewFixes.map((item) => (
              <li class="flex items-start gap-3 leading-relaxed text-ink-muted">
                <Icon name="ph:check" size={16} class="mt-1 shrink-0 text-accent" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>

    <Container width="wide" class="mt-16">
      <Plate title="The legacy sidebar" caption="Each user picks a sidebar in their account menu." src={shot('legacy-sidebar')} alt="The legacy sidebar open over the job listings page, with grouped sections for job listings, data mapping with unmapped counts, and advanced customization." />
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="tables" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Table tools</Heading>
        </div>
        <div class="case-layout__body">
          <Text size="lg" tone="muted" class="mt-8 measure">
            Operators spend most of their time in the job listings table, so later work focused there:
          </Text>

          <ul class="mt-6 space-y-3">
            {tableTools.map((item) => (
              <li class="flex items-start gap-3 leading-relaxed text-ink-muted">
                <Icon name="ph:check" size={16} class="mt-1 shrink-0 text-accent" />
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <Text size="lg" tone="muted" class="mt-8 measure">
            Every table now uses the same column controls.
          </Text>
        </div>
      </div>
    </Container>

    <Container width="wide" class="mt-16">
      <Plate title="Row inspector" caption="One listing’s details over the filtered list." src={shot('row-inspector')} alt="The row inspector open over the job listings table, showing one listing’s title, status, facility, location, shift, rate and dates, a field filter, and the Position group of fields." />
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="brand" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Matching the marketing site</Heading>
        </div>
        <div class="case-layout__body">
          <Text size="lg" tone="muted" class="mt-8 measure">
            The app had drifted from the marketing site’s brand. I pointed five existing tokens at its
            colors and added three more, so every screen updated without markup changes.
          </Text>

          <div class="mt-10">
            <SiteShot
              src="/images/projects/vmspark/vmspark-live.webp"
              alt="The VMSpark marketing site, the source of the brand colors the admin app’s tokens were pointed at"
              href="https://vmspark.com/"
              label="vmspark.com"
              index="01"
            />
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="sheets" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <Heading level={2} visual="display-md" tone="ink" class="mb-6">Wireframes and flows</Heading>
      <Text size="lg" tone="muted" class="measure">
        I documented 11 screens and 5 flows, each taken from sketch to wireframe to annotated sheet.
        The rest are in the <a href="/projects/vmspark/gallery/" class="hero-link">VMSpark gallery</a>.
      </Text>
    </Container>

    <Container width="wide" class="mt-14">
      <FidelityBand
        title="Application shell"
        sketch={art('01-app-shell-sketch.svg')}
        wire={art('01-app-shell.svg')}
        annotated={sheet('01-app-shell')}
        annotatedAlt="Annotated design sheet of the VMSpark application shell: a two-tier sidebar, workspace context, and global search."
        caption="Sketch, wireframe, and annotated sheet."
      />
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="outcomes" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Results</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 grid gap-x-8 gap-y-10 sm:grid-cols-3">
            {results.map((group) => (
              <div class="pt-4">
                <p class="mono-label mb-3">{group.label}</p>
                <ul class="space-y-2">
                  {group.items.map((item) => (
                    <li class="flex items-start gap-2 text-sm text-ink-muted leading-relaxed">
                      <Icon name="ph:check" size={14} class="mt-1 shrink-0 text-accent" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default">
    <Container width="content">
      <figure class="grid gap-x-10 gap-y-10 md:grid-cols-12 md:items-start lg:gap-x-16">
        <figcaption class="md:col-span-4">
          <p class="mono-label mb-6">What Jon said</p>
          <div class="flex items-center gap-4 md:flex-col md:items-start md:gap-5">
            <img
              src="/images/testimonials/jon-sturm.jpeg"
              alt="Jon Sturm"
              class="h-14 w-14 rounded-full border border-line object-cover md:h-16 md:w-16"
              loading="lazy"
              decoding="async"
            />
            <div>
              <p class="font-display font-semibold text-ink">Jon Sturm</p>
              <p class="mt-1 text-sm text-ink-muted leading-snug">Director of Product &amp; Customer Success &middot; VMSpark</p>
            </div>
          </div>
        </figcaption>
        <blockquote class="md:col-span-8">
          <Icon name="ph:quotes" size={48} class="mb-5 text-accent opacity-25" />
          <p class="max-w-[46ch] font-display text-2xl md:text-3xl tracking-tight leading-snug text-ink">
            Josh inventoried 350 ERB templates before writing a line of new CSS, then turned that audit into a phased
            rollout we could ship behind no flags. The shell finally reads like the enterprise product the pipeline always
            was, and operators didn't lose a single piece of muscle memory in the move.
          </p>
        </blockquote>
      </figure>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="engineering" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Engineering</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              New behavior lives in small Stimulus controllers or server-rendered HTMX, with no jQuery
              or inline scripts. The only model change is three user columns for density and sidebar
              preferences.
            </p>
            <p>
              A color audit script rejects raw hex, RGB, and HSL values in changed files.
            </p>
          </div>
        </div>
      </div>
    </Container>

    <Container width="content" class="mt-16">
      <Heading level={3} visual="h3" tone="ink" class="mb-3">In-app style guide</Heading>
      <Text tone="muted" class="measure">
        Each component shown with dos and don’ts.
      </Text>
    </Container>

    <Container width="wide" class="mt-10">
      <div class="space-y-16">
        <ScrollShot
          src="/images/projects/vmspark/playground-overview.webp"
          alt="The VMSpark style guide overview, linking to each section of the guide"
          label="Style guide: overview"
          index="01"
        />
        <ScrollShot
          src="/images/projects/vmspark/playground-buttons.webp"
          alt="The VMSpark style guide’s buttons page: variants, sizes, and states"
          label="Buttons"
          index="02"
        />
        <ScrollShot
          src="/images/projects/vmspark/playground-tables.webp"
          alt="The VMSpark style guide’s tables page: header style, density, and pagination"
          label="Tables"
          index="03"
        />
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="edges" class="scroll-mt-24">
    <Container width="content">
      <Heading level={2} visual="h2" tone="ink" class="mb-10">Limitations</Heading>
      <ul class="grid gap-x-10 gap-y-10 md:grid-cols-2">
        {edges.map((e) => (
          <li class="pt-5">
            <Icon name={e.icon} size={24} class="mb-3 text-ink-muted" />
            <Heading level={3} visual="h3" tone="ink" class="mb-1.5">{e.title}</Heading>
            <Text size="sm" tone="muted">{e.body}</Text>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  <GalleryLink project="vmspark" />

  <ProjectNext project="vmspark" />

</ProjectLayout>
