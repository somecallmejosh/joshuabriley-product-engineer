          caption="One header style, one spacing rule, one page-navigation control, standardized across every table."
          index="04"
        />
      </div>
    </Container>
  </Section>

  <Section id="sheets" tone="paper" padding="default" class="scroll-mt-24 border-t border-line">
    <Container width="content">
      <p class="mono-label mb-3">Screens and flows</p>
      <Heading level={2} visual="display-md" tone="ink" class="mb-6">What actually got built</Heading>
      <Text size="lg" tone="muted" class="measure">
        Eleven screens and five flows, with the reasoning written onto each one.
        These are reconstructions, drawn afterward to document the decisions.
      </Text>
    </Container>

    <Container width="wide" class="mt-14">
      <p class="mono-label mb-6">How a screen got built</p>
      <FidelityBand
        title={keyScreens[0].title}
        sketch={art(`${keyScreens[0].slug}-sketch.svg`)}
        wire={art(`${keyScreens[0].slug}.svg`)}
        annotated={sheet(keyScreens[0].slug)}
        annotatedAlt={keyScreens[0].alt}
        caption="The passes run left to right: a rough sketch, a wireframe, then the real screen in color, since arriving at one visual language was the whole point of this project."
      />
    </Container>

    <Container width="wide" class="mt-16">
      <div class="space-y-16">
        {keyScreens.map((s) => (
          <Plate
            index={s.index}
            title={s.title}
            caption={s.note}
            src={sheet(s.slug)}
            alt={s.alt}
          />
        ))}
      </div>
    </Container>

    <Container width="wide" class="mt-20">
      <div class="border-t border-line pt-10">
        <p class="mono-label mb-3">The rest of the system</p>
        <Text tone="muted" class="measure mb-10">
          Seven more screens, ending with the inventory that replaced eight button
          styles, ten form styles, and six table conventions with one of each.
        </Text>
        <ul class="grid gap-x-8 gap-y-14 md:grid-cols-2">
          {restOfSystem.map((s) => (
            <li>
              <Plate
                size="half"
                title={s.title}
                src={sheet(s.slug)}
                alt={`Annotated design sheet of the ${s.title.toLowerCase()} screen.`}
              />
            </li>
          ))}
        </ul>
      </div>
    </Container>

    <Container width="wide" class="mt-20">
      <div class="border-t border-line pt-10">
        <p class="mono-label mb-3">User flows</p>
        <Text tone="muted" class="measure mb-10">
          Five flows covering the paths the screens sit on, each one splitting what
          a person does from what the system does with it.
        </Text>
        <div class="space-y-16">
          {flows.map((f, i) => (
            <Plate
              title={f.title}
              caption={f.note}
              src={sheet(f.slug)}
              alt={`User flow diagram: ${f.title.toLowerCase()}. ${f.note}`}
            />
          ))}
        </div>
      </div>
    </Container>
  </Section>

  <Section id="outcome" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 04</p>
          <Heading level={2} visual="display-md" tone="ink">What changed after launch</Heading>
