  ],
  'autofocus': [
    { file: 'app/views/shared/_form_errors.html.erb', lang: 'erb', code: `<% if model.errors.any? %>
  <% prefix = model.model_name.param_key rescue nil %>
  <div class="error-summary" role="alert" tabindex="-1"<%= " autofocus" if local_assigns.fetch(:focus, true) %>>
    <h2 class="error-summary__title"><%= icon(:error) %><span><%= model.errors.count == 1 ? "This couldn't be saved. Fix the problem below:" : "This couldn't be saved. Fix the #{model.errors.count} problems below:" %></span></h2>
    <ul>
      <% model.errors.each do |error| %>
        <li>
          <% if prefix && error.attribute != :base %>
            <a href="#<%= prefix %>_<%= error.attribute %>"><%= error.full_message %></a>
          <% else %>
            <%= error.full_message %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>` },
  ],
  'toasts': [
    { file: 'app/helpers/toaster_helper.rb', lang: 'ruby', code: `module ToasterHelper
  TOASTER_ID = "toaster".freeze

  def ui_toaster(notice: nil)
    toast = content_tag(:div, class: "toast") do
      content_tag(:p, nil, class: "toast__body") +
