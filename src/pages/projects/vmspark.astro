  ],
  'copy': [
    { file: 'app/helpers/copy_helper.rb', lang: 'ruby', code: `module CopyHelper
  def ui_copy_button(text = "Copy", value: nil, aria_label: nil, variant: :secondary, size: :sm, **opts)
    source = opts.delete(:for)
    raise ArgumentError, "ui_copy_button needs for: (an element id) or value:" if source.blank? && value.nil?

    content_tag("vm-copy", { for: source, value: }.compact) do
      ui_button(text, icon: :copy, variant:, size:, label: aria_label, **opts)
    end
  end
end` },
  ],
  'tabs': [
    { file: 'app/helpers/tabs_helper.rb', lang: 'ruby', code: `module TabsHelper
  class TabsBuilder
    def initialize(view, id:, label:, value:)
      @view, @id, @label, @selected = view, id, label, value&.to_s
    end

    def tab_id(key) = "#{@id}-tab-#{key}"
    def panel_id(key) = "#{@id}-panel-#{key}"

    def list(tabs, **attrs)
      @selected ||= tabs.first&.first.to_s
      buttons = tabs.map do |key, label, count|
        on = key.to_s == @selected
        @view.content_tag(:button, @view.safe_join([label, (@view.content_tag(:span, count, class: "tabs__count") unless count.nil?)].compact, " "),
                          type: "button", class: "tabs__tab", role: "tab", id: tab_id(key), value: key,
                          "aria-controls": panel_id(key), "aria-selected": on.to_s, tabindex: on ? 0 : -1)
      end
      @view.content_tag(:div, @view.safe_join(buttons), { class: ["tabs", attrs.delete(:class)].compact.join(" "), role: "tablist", "aria-label": @label }.merge(attrs))
    end

    def panel(key, **attrs, &block)
      @view.content_tag(:div, @view.capture(&block),
                        { role: "tabpanel", id: panel_id(key), "aria-labelledby": tab_id(key), tabindex: 0,
                          hidden: (key.to_s != @selected) }.merge(attrs))
    end

    def value = @selected
  end

  def ui_tabs(id:, label:, value: nil, **attrs, &block)
    builder = TabsBuilder.new(self, id:, label:, value:)
    body = capture(builder, &block)
    content_tag("vm-tabs", body, { value: builder.value }.merge(attrs))
  end
end` },
  ],
  'filters': [
    { file: 'app/helpers/filter_bar_helper.rb', lang: 'ruby', code: `module FilterBarHelper
  class FilterBarBuilder
    def initialize(view)
      @view = view
      @more_values = nil
    end

    def search(name, label, **opts)
      input(name, label, grow: true, search_icon: true, **opts)
    end

    def input(name, label, type: "search", value: :param, hint: nil, id: nil, grow: false, search_icon: false, **attrs)
      id ||= field_id(name)
      value = param_value(name) if value == :param
      control = @view.tag.input(class: "input", type:, id:, name:, value:, autocomplete: "off",
                                "aria-describedby": (hint_id(id) if hint), **attrs)
      control = @view.content_tag(:div, @view.icon(:search) + control, class: "search") if search_icon
      field(id, label, control, value, hint:, grow:)
    end

    def select(name, label, choices, selected: :param, hint: nil, id: nil, **attrs)
      id ||= field_id(name)
      selected = param_value(name) if selected == :param
      control = @view.content_tag(:select, @view.options_for_select(choices, selected),
                                  class: "select", id:, name:, "aria-describedby": (hint_id(id) if hint), **attrs)
      field(id, label, control, selected, hint:)
    end

    def more(label = "More filters", &block)
      @more_values = []
      body = @view.capture(&block)
      open = @more_values.any?(&:present?)
      @more_values = nil
      @view.content_tag(:details, class: "disclosure w-full", open: open || nil) do
        @view.content_tag(:summary, @view.icon(:expand, size: :sm) + label) +
          @view.content_tag(:div, body, class: "disclosure__body filter-bar")
      end
    end

    private

    def field(id, label, control, value, hint:, grow: false)
      @more_values&.push(value)
      parts = [@view.label_tag(id, label, class: "field__label"), control,
               (@view.content_tag(:p, hint, class: "field__hint", id: hint_id(id)) if hint)]
      @view.content_tag(:div, @view.safe_join(parts.compact), class: ["field", ("field--grow" if grow)].compact.join(" "))
    end

    def hint_id(id) = "#{id}-hint"

    # search[last_name] -> search_last_name (what Rails' *_tag helpers generate)
    def field_id(name) = name.to_s.gsub(/\\]\\[|[^-a-zA-Z0-9:.]/, "_").delete_suffix("_")

    def param_value(name)
      value = @view.params.dig(*name.to_s.scan(/[^\\[\\]]+/))
      value.is_a?(String) ? value : nil
    rescue TypeError, NoMethodError
      nil
    end
  end

  def ui_filter_bar(url:, aria_label:, target: nil, clear: nil, submit: "Search", **attrs, &block)
    body = capture(FilterBarBuilder.new(self), &block)
    buttons = [ui_button(submit, type: :submit),
               (ui_button_link("Clear filters", clear, variant: :quiet, icon: :clear) if clear)]
    actions = content_tag(:div, safe_join(buttons.compact), class: "filter-bar__actions")
    in_place = target ? { "hx-get": url, "hx-target": target, "hx-swap": "outerHTML", "hx-push-url": "true" } : {}
    form_attrs = { class: ["filter-bar", attrs.delete(:class)].compact.join(" "), role: "search",
                   "aria-label": aria_label, action: url, method: "get" }.merge(in_place).merge(attrs)
    ui_autosubmit(live: target.present?) { content_tag(:form, body + actions, form_attrs) }
  end
end` },
