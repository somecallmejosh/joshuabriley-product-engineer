---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Link from '~/components/primitives/Link.astro';
import Icon from '~/components/primitives/Icon.astro';
import Metric from '~/components/patterns/Metric.astro';
import SiteShot from '~/components/patterns/SiteShot.astro';
import ScrollShot from '~/components/patterns/ScrollShot.astro';
import Plate from '~/components/patterns/Plate.astro';
import FidelityBand from '~/components/patterns/FidelityBand.astro';
import Tldr from '~/components/patterns/Tldr.astro';
import type { ImageMetadata } from 'astro';

const title = 'VMSpark | Joshua Briley';
const description =
  "Case study: VMSpark's admin app sat on top of a sophisticated system serving many client companies at once, but looked like an unfinished prototype from 2018. As product design engineer, I audited the interface sprawl, chose a design direction, and rebuilt the shell in four shippable phases without touching the systems underneath.";

interface Finding {
  count: string;
  title: string;
  body: string; // raw HTML
}

const findings: Finding[] = [
  {
    count: '8+',
    title: 'Button styles competing for attention',
    body:
      'Primary, secondary, danger, and ghost variants, each implemented two or three different ways. Some leaned on Bootstrap utility classes, others on per-view custom CSS, a few were inline-styled anchors pretending to be buttons. A <em>Save</em> on one screen didn’t match a <em>Save</em> two clicks away.',
  },
  {
    count: '10+',
    title: 'Form element styles, all at once',
    body:
      'Plain Rails helpers sat next to Bootstrap <code class="font-mono text-[0.85em] bg-ink/[0.04] text-ink px-1 rounded-[4px]">form-control</code> inputs, Select2 widgets, and hand-rolled dropdowns. Border radius, padding, focus rings, and disabled treatments all diverged. The same concept (<em>pick one from a list</em>) rendered five different ways across the app.',
  },
  {
    count: '5',
    title: 'Form-rendering patterns, coexisting',
    body:
      '<code class="font-mono text-[0.85em] bg-ink/[0.04] text-ink px-1 rounded-[4px]">form_with(model:)</code>, legacy <code class="font-mono text-[0.85em] bg-ink/[0.04] text-ink px-1 rounded-[4px]">form_for</code>, <code class="font-mono text-[0.85em] bg-ink/[0.04] text-ink px-1 rounded-[4px]">form_with(url:)</code>, bare <code class="font-mono text-[0.85em] bg-ink/[0.04] text-ink px-1 rounded-[4px]">&lt;form&gt;</code> + HTMX, and HTMX-only with <code class="font-mono text-[0.85em] bg-ink/[0.04] text-ink px-1 rounded-[4px]">hx-include</code>.',
  },
  {
    count: '6+',
    title: 'Tables with no shared convention',
    body:
      'Row striping in some, not in others. Headers styled four ways: dark fill, light fill, borderless, and all-caps. Pagination rendered with Kaminari on one screen and a bespoke HTMX block on the next. Density jumped from compressed to roomy between adjacent views with no underlying logic.',
  },
  {
    count: '4+',
    title: 'Labeling strategies, all coexisting',
    body:
      'Sentence case, Title Case, ALL CAPS, and placeholder-as-label all appeared across the app. Required indicators were sometimes asterisks, sometimes parenthetical <em>(required)</em>, sometimes absent. The same field concept carried different names on different screens (<em>Bill Rate</em>, <em>Rate</em>, <em>Pay Rate</em>).',
  },
  {
    count: '~40',
    title: 'Views bypassing the token system',
    body:
      'A semantic color-token system already existed in <code class="font-mono text-[0.85em] bg-ink/[0.04] text-ink px-1 rounded-[4px]">_color_tokens.scss</code>, but dozens of views bypassed it with inline styles, hardcoded hex literals, and raw colors in view-level <code class="font-mono text-[0.85em] bg-ink/[0.04] text-ink px-1 rounded-[4px]">&lt;style&gt;</code> blocks.',
  },
  {
    count: '☠',
    title: 'Dead code in production',
    body:
      'A zero-byte <code class="font-mono text-[0.85em] bg-ink/[0.04] text-ink px-1 rounded-[4px]">_empty.html.erb</code>, an <code class="font-mono text-[0.85em] bg-ink/[0.04] text-ink px-1 rounded-[4px]">X</code>-prefixed dead index file (101 lines), an <code class="font-mono text-[0.85em] bg-ink/[0.04] text-ink px-1 rounded-[4px]">ASDKAJSHDJHASD</code> debug string committed to production, and a sticky table header with hardcoded <code class="font-mono text-[0.85em] bg-ink/[0.04] text-ink px-1 rounded-[4px]">background-color: red</code> from an abandoned debug session.',
  },
];

interface SprawlImg {
  src: string;
  alt: string;
  caption: string; // raw HTML
}

const sprawlImages: SprawlImg[] = [
  {
    src: '/images/projects/vmspark/before-manual-jobs.png',
    alt: 'VMSpark Manual Jobs screen. Three buttons sit side by side in the top bar: a filled orange Add New, an outlined Edit Selected, and an outlined Copy Selected. Search inputs appear above the table with labels placed below each field.',
    caption:
      '<strong class="text-ink font-semibold">Manual Jobs.</strong> Three buttons in one row, three different treatments. Labels sit below inputs.',
  },
  {
    src: '/images/projects/vmspark/before-ats-professions.png',
    alt: 'VMSpark ATS Professions screen. Five search inputs use their label text as placeholders inside the fields. A Sync with ATS outlined button sits at the top right.',
    caption:
      '<strong class="text-ink font-semibold">ATS Professions.</strong> Labels are now placeholders inside the inputs. Different page, different rule.',
  },
  {
    src: '/images/projects/vmspark/before-announcements.png',
    alt: 'VMSpark Announcements screen. Each row ends with a dark gray pencil edit icon next to a solid red trash icon. A filled orange New Announcement button sits in the top right.',
    caption:
      '<strong class="text-ink font-semibold">Announcements.</strong> Yet another icon-button pattern: dark gray paired with solid red, nothing like the blue outlines elsewhere.',
  },
  {
    src: '/images/projects/vmspark/before-openai-usage.png',
    alt: 'VMSpark OpenAI Usage dashboard. A data table with a solid dark-navy header bar, right-aligned numeric columns, and underlined orange account names.',
    caption:
      '<strong class="text-ink font-semibold">OpenAI Usage.</strong> A solid dark-navy table header. Every other table in the app uses a light gray one.',
  },
];

const outcomeStats = [
  {
    icon: 'ph:shield-check',
    title: 'Zero pipeline regressions',
    body: 'No regressions reported against the ingest or fan-out paths after cutover.',
  },
  {
    icon: 'ph:users',
    title: 'Operator confidence',
    body: 'Operators use a tool that looks like one product, not ten. The UI stopped fighting them at every screen.',
  },
  {
    icon: 'ph:presentation-chart',
    title: 'Investor confidence',
    body: 'Demos open with the product, not with caveats about the surface it lives on.',
  },
  {
    icon: 'ph:gauge',
    title: 'No new JS on hot paths',
    body: 'Palette and inspector load on demand. First paint got lighter, not heavier.',
  },
];

const proof = [
  { label: 'Skills proven', items: ['Design-system audit', 'UI/UX design direction', 'Accessible component APIs', 'Frontend architecture', 'Style-guide documentation', 'Product decisions'] },
  { label: 'Stack', items: ['Ruby on Rails', 'Stimulus.js', 'Design tokens', 'Modern CSS'] },
  { label: 'Quality', items: ['Keyboard operability', 'Focus management', 'ARIA semantics', 'Token contrast checks'] },
  { label: 'Outcomes', items: ['Zero pipeline regressions', 'No operator retraining', 'One token layer, app and brand', 'No new JS on hot paths'] },
];

const docket = [
  { href: '#inventory', icon: 'ph:clipboard-text', label: 'Inventory before invention' },
  { href: '#directions', icon: 'ph:signpost', label: 'Three directions, one chosen' },
  { href: '#rollout', icon: 'ph:stack', label: 'Phased rollout' },
  { href: '#sheets', icon: 'ph:squares-four', label: 'Screens and flows' },
  { href: '#outcome', icon: 'ph:trend-up', label: 'What shipping it changed' },
];

// Sheets render from src/ so Astro can process them — anything under public/ is
// copied verbatim and never optimized. Sources are 2x headless-Chromium PNGs.
const sheetFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/projects/vmspark/wires-and-flows/*.png',
  { eager: true },
);
const sheet = (slug: string) =>
  sheetFiles[`../../assets/projects/vmspark/wires-and-flows/${slug}.png`].default;

// The sketch and clean-wireframe passes are SVG and need no processing.
const art = (file: string) => `/images/projects/vmspark/wires-and-flows/${file}`;

// Four screens went through all three fidelities. The ladder ends in colour
// here rather than greyscale, because arriving at one coherent visual language
// is what the project was.
const keyScreens = [
  {
    slug: '01-app-shell',
    index: '01',
    title: 'App shell',
    note: 'One shell applied to every authenticated screen. The sprawl came from every view having somewhere of its own to decide.',
    alt: 'Annotated design sheet of the VMSpark app shell: icon rail, nav sidebar, workspace switcher, command palette and impersonation control, with callouts explaining why tenant identity lives in the chrome and why the token path had to be the shortest one.',
  },
  {
    slug: '02-job-listings',
    index: '02',
    title: 'Job listings',
    note: 'The primary triage surface. Status is a tab count, and a failed row stays in the list rather than being exiled to another screen.',
    alt: 'Annotated design sheet of the job listings grid: per-column filter inputs, status tabs carrying queue depth, and a tinted failed row among the healthy ones, with callouts on queued reprocessing and per-user column persistence.',
  },
  {
    slug: '03-inspector',
    index: '03',
    title: 'Inspector',
    note: 'Why one listing ended up in the state it did. Raw payload beside mapped result, so a failure is self-explaining rather than a support ticket.',
    alt: 'Annotated design sheet of the listing inspector: an overlay opening over the filtered grid, showing the mapped result beside the raw VMS payload with the unresolved facility field marked on both sides, plus a timestamped process history.',
  },
  {
    slug: '04-data-mapping',
    index: '04',
    title: 'Data mapping',
    note: 'The operational centre. Unmapped values are a revenue problem, not a tidiness problem, so the queue is built to visibly empty.',
    alt: 'Annotated design sheet of the data mapping screen: entity-type tabs carrying unmapped counts, and two-column resolution cards pairing each inbound VMS value with its ATS candidates, with callouts on auto-mapping, focus advance, and why Ignore is a real decision.',
  },
];

const restOfSystem = [
  { slug: '05-custom-rules', title: 'Custom rules' },
  { slug: '06-candidate-profiles', title: 'Candidate profiles' },
  { slug: '07-applications-matches', title: 'Applications & matches' },
  { slug: '08-settings', title: 'Settings' },
  { slug: '09-candidate-portal', title: 'Candidate portal' },
  { slug: '10-ai-usage', title: 'AI usage' },
  { slug: '11-design-system', title: 'The design system' },
];

// The edges — honest, not exhaustive. Both are gaps a manual, page-by-page
// audit cannot reliably catch: patterns that only exist on interaction, not
// on a screen you can scan or screenshot.
const edges = [
  {
    icon: 'ph:app-window',
    title: 'Pop-up dialogs the inventory did not catch',
    body: 'The audit counted button styles, form patterns, and table conventions because those repeat across a grid you can scan by eye. Pop-up dialogs do not: each one only appears when triggered. Every pop-up dialog in the app turned out to be built completely differently from every other one, sharing no common structure and each with its own custom code. Tooltips had the same problem, split between two different tools, with nobody having fully finished switching away from the older one. Both got folded into the rebuild, but neither was in the original ~700-line inventory.',
  },
  {
    icon: 'ph:robot',
    title: 'Finding the rest of the sprawl took a tool, not just eyes',
    body: "A manual pass through 350 page templates finds the patterns that repeat often enough to notice. It does not reliably find the ones that do not: a one-off pop-up dialog or an abandoned tooltip approach can hide in a screen that only gets opened once a month. I built a small AI-assisted tool that scans the app for what each piece of the interface is trying to do, rather than just its raw code, plus a plan matching every old pattern to the new version that should replace it, and that is what actually surfaced the dialogs and tooltips the manual audit missed. Both are shipped and running in the app now. Next audit, that tool runs first, not as something I reach for after a manual pass comes up short.",
  },
];

const flows = [
  {
    slug: 'flow-01-ingestion',
    title: 'Ingestion',
    note: 'The pipeline the redesign was forbidden from touching. Processed, failed and skipped are all first-class outcomes.',
  },
  {
    slug: 'flow-02-mapping-resolution',
    title: 'Mapping resolution & fan-out',
    note: 'What an operator does to clear one unmapped facility, and what that single save costs downstream.',
  },
  {
    slug: 'flow-03-rule-engine',
    title: 'Rule engine',
    note: 'Per-account rules as the escape hatch that keeps client special cases out of a shared pipeline.',
  },
  {
    slug: 'flow-04-candidate-match',
    title: 'Candidate matching',
    note: 'The system proposes, a recruiter disposes. Submission is the only externally visible step, so it is the only one that asks.',
  },
  {
    slug: 'flow-05-journeys',
    title: 'User journeys',
    note: 'Three people with opposite needs, one shell, and a mapping queue upstream of all of them.',
  },
];

// The TLDR digest. "Alternatives" and "Decision" restate the three-directions
// call already argued in the #directions step (narrowed to the two most
// credible); "Reflection" restates the edges section below rather than
// inventing a new critique — see src/pages/projects/interview-notes/tldr.md.
const tldr = {
  situation: `VMSpark's backend pulls in thousands of job listings a day and fans them out to more than a dozen recruiting systems. As product design engineer, I owned the admin app operators lived in all day and investors judged in the first thirty seconds of a demo, without touching the pipeline underneath.`,
  problem: `The interface hadn't kept pace with the system it sat on: eight-plus competing button styles, ten form-element treatments, and roughly 40 views bypassing the existing color-token system, so the product read like an unfinished 2018 prototype in front of an enterprise-grade pipeline.`,
  alternativeA: {
    name: 'Command Shell',
    body: `A dense, keyboard-first 56px icon rail with a command palette as the centerpiece. Signals "scales to power users," but asks operators to learn a pattern none of them had used before.`,
  },
  alternativeB: {
    name: 'Two-Tier Platform',
    body: `A 48px product rail plus a 260px project nav, the enterprise pattern operators had already used at a previous job. Familiar, at the cost of being less novel.`,
  },
  decision: `I chose <strong class="text-ink font-semibold">the Two-Tier Platform</strong> over the more sophisticated Command Shell, because operators worked across many client accounts daily, and the lowest-risk path to both user and investor trust was a layout they had already seen before, not a new one.`,
  implementation: `The rebuild shipped in four independently deployable phases: a shared page-header component rolled out to about 30 existing pages, the two-tier shell itself, a scoped command palette, then density and shortcut polish, with the color-token layer re-pointed at the same five brand colors the public marketing site already used.`,
  evidence: `Zero regressions were reported against the ingest or fan-out paths after cutover. Operators stopped mentally filtering out visual noise between screens, and leadership stopped opening investor demos with caveats about the interface.`,
  reflection: `The manual audit caught anything visible on a static screen, but every pop-up dialog in the app turned out to be built differently from every other one, and that only surfaced once I built a small AI-assisted tool to scan for intent rather than code. Next audit, that tool runs first, not as a follow-up once a manual pass comes up short.`,
};
---

<BaseLayout title={title} description={description}>

  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <nav class="hero-in hero-in-1 mb-12 flex items-center gap-2 text-sm text-ink-muted" aria-label="Breadcrumb">
        <a href="/projects/" class="transition-colors hover:text-accent">Projects</a>
        <Icon name="ph:caret-right" size={12} />
        <span class="text-ink">VMSpark</span>
      </nav>

      <div class="hero-grid">
        <div class="hero-main">
          <div class="hero-in hero-in-2 mb-7 flex items-center gap-3">
            <img src="/images/logos/vmspark.svg" alt="VMSpark logo" class="h-12 w-auto" />
            <span class="h-4 w-px bg-line-strong" aria-hidden="true"></span>
            <p class="mono-label">Case study</p>
          </div>

          <Heading level={1} visual="display-xl" tone="ink" class="hero-in hero-in-3">
            The pipeline was enterprise-grade. The app <em class="ink-wink font-normal italic">in front of it</em> wasn't.
          </Heading>

          <Text size="lg" tone="muted" class="hero-in hero-in-4 mt-8 max-w-xl">
            VMSpark's backend pulls in thousands of job listings a day from client hiring platforms and automatically sends them out to more than a dozen different recruiting systems companies use to manage applications. The admin app in front of all that, the screen operators work in all day and investors judge in the first thirty seconds of a demo, still looked like an unfinished prototype from 2018. I owned the audit, the design direction, and the phased rebuild that closed that gap, without touching the systems underneath.
          </Text>
        </div>

        <aside class="hero-in hero-in-5 hero-rail" aria-label="Project details">
          <dl>
            <div>
              <dt>Role</dt>
              <dd>Product Design Engineer</dd>
            </div>
            <div>
              <dt>Client</dt>
              <dd>VMSpark</dd>
            </div>
            <div>
              <dt>Stack</dt>
              <dd>Rails &middot; Hotwire</dd>
            </div>
            <div>
              <dt>Focus</dt>
              <dd>Shell &middot; Tokens</dd>
            </div>
          </dl>
        </aside>
      </div>
    </Container>
  </Section>

  <Tldr
    situation={tldr.situation}
    problem={tldr.problem}
    alternativeA={tldr.alternativeA}
    alternativeB={tldr.alternativeB}
    decision={tldr.decision}
    implementation={tldr.implementation}
    evidence={tldr.evidence}
    reflection={tldr.reflection}
  />

  <Section tone="paper" padding="tight" aria-label="Project receipts">
    <Container width="content">
      <p class="mono-label mb-8">Receipts</p>
      <dl class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {proof.map((group) => (
          <div class="border-t border-line pt-4">
            <dt class="mono-label mb-3">{group.label}</dt>
            <dd>
              <ul class="space-y-1.5">
                {group.items.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-ink-muted leading-relaxed">
                    <Icon name="ph:check" size={14} class="mt-0.5 shrink-0 text-accent" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </Container>
  </Section>

  <Section tone="paper" padding="tight">
    <Container width="content">
      <p class="mono-label mb-5">Table of contents</p>
      <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
        {docket.map((item, i) => (
          <li>
            <a href={item.href} class="group inline-flex items-center gap-3 text-ink transition-colors hover:text-accent">
              {item.icon && (
                <Icon name={item.icon} size={16} class="shrink-0 text-ink-muted transition-colors group-hover:text-accent" />
              )}
              <span class="font-medium">{item.label}</span>
              <Icon name="ph:arrow-right" size={15} class="shrink-0 transition-transform group-hover:translate-x-1" />
            </a>
          </li>
        ))}
      </ul>

      <Text size="lg" tone="muted" class="mt-10 measure">
        VMSpark takes in thousands of job listings a day, runs them through rules
        specific to each client account, and sends them out to whichever recruiting
        system that customer has signed up with. The product works. The screens it
        lived in did not look like it. Leadership was scheduling investor demos, and
        the admin app, the screen those conversations lived inside, felt like an
        unfinished prototype from 2018. Operators noticed it daily. Investors noticed
        it in the first thirty seconds of a demo.
      </Text>
      <Text size="lg" tone="muted" class="mt-5 measure">
        The brief I gave myself:
        <strong class="text-ink font-semibold">make the admin app read as a modern,
        enterprise-grade product that matches the sophistication of the systems
        underneath</strong>, without touching those systems, the client-specific
        rules, or anything an operator had muscle memory for. That meant owning it as
        one job: the design-system audit, the product calls about what to build and
        what to drop, and the engineering to ship it.
      </Text>
    </Container>
  </Section>

  <Section id="inventory" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 01</p>
          <Heading level={2} visual="display-md" tone="ink">Inventory before invention</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5">
            <Text size="lg" tone="muted">
              Sprawl this wide can't be fixed one screen at a time. Restyle the buttons on
              Manual Jobs and seven other button treatments are still waiting elsewhere, with
              no way to know you've found them all. So before changing a single style, I
              cataloged what was there: a
              <strong class="text-ink font-semibold">~700-line design inventory</strong>
              covering every one of the 350 page templates (roughly 11,800 lines) across the app.
            </Text>
            <Text size="lg" tone="muted">
              More than anything, the audit worked as a map. It told me which problems were
              cosmetic (fixable during the redesign), which were structural (needed architectural
              decisions), and which were out of scope (pipeline-adjacent, don't touch). Most of
              what I found was UI sprawl: the same interaction rendered a dozen different ways
              across the app, each screen a small argument against the one before it.
            </Text>
          </div>

          <div class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-6 border-y border-line py-8">
            <Metric value="350" label="ERB templates inventoried" />
            <Metric value="8+" label="button styles, one concept" />
            <Metric value="10+" label="form-element styles" />
            <Metric value="~40" label="views bypassing the tokens" />
          </div>

          <div class="mt-10 rounded-lg border border-line p-7">
            <p class="mono-label mb-4">A few of the findings</p>
            <div>
              {findings.map((f) => (
                <div class="flex items-start gap-4 py-4 border-b border-line last:border-0">
                  <span class="font-mono text-sm text-accent shrink-0 w-12" aria-hidden="true">{f.count}</span>
                  <div>
                    <Heading level={3} visual="h4" tone="ink" class="mb-1">{f.title}</Heading>
                    <Text size="sm" tone="muted" set:html={f.body} />
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="mt-16">
        <p class="mono-label mb-3">What the sprawl actually looked like</p>
        <Text tone="muted" class="mb-10 max-w-2xl">
          Four screens pulled from the same app, on the same day. Each one makes its own
          decisions about buttons, inputs, labels, and tables. None of them agree with
          the others.
        </Text>

        <div class="grid gap-8">
          {sprawlImages.map((img) => (
            <figure>
              <div class="overflow-hidden rounded-lg border border-line">
                <img src={img.src} alt={img.alt} class="w-full h-auto block" loading="lazy" />
              </div>
              <figcaption class="mt-4 text-sm text-ink-muted leading-relaxed" set:html={img.caption} />
            </figure>
          ))}
        </div>
      </div>

      <Text size="lg" tone="muted" class="mt-12 measure">
        The inventory is what made a root fix possible instead of a screen-by-screen one.
        Every finding above resolved to a single decision applied once, and because the
        semantic token layer already existed, each of those decisions cascaded across
        dozens of views. The remaining work was routing the views through it.
      </Text>
    </Container>
  </Section>

  <Section id="directions" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 02</p>
          <Heading level={2} visual="display-md" tone="ink">Three directions, one chosen</Heading>
        </div>
        <div class="case-layout__body">
          <Text size="lg" tone="muted" class="mt-8 measure">
            Rather than design in a vacuum, I wrote up three different possible directions,
            each with its own honest tradeoffs. Writing the options down, with their reasons
            and risks, is what lets the choice get overturned later by evidence, not by
            preference.
          </Text>

          <div class="mt-10 grid md:grid-cols-3 gap-6 items-stretch">
            <div class="rounded-lg border border-line p-6">
              <div class="mb-2 flex items-center gap-2">
                <span class="font-mono text-[0.75rem] text-accent">A</span>
                <span class="font-heading text-xs font-semibold uppercase tracking-wider text-ink">Command Shell</span>
              </div>
              <Text size="sm" tone="muted" class="mb-3">Dense &middot; Keyboard-first</Text>
              <Text size="sm" tone="muted">
                56 px icon rail, tight 13/14 px type, hairline borders,
                <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 rounded-[4px]">⌘K</code> palette as the centerpiece,
                orange reserved for exactly one thing per screen.
              </Text>
              <p class="mt-4 flex items-start gap-2 text-sm text-ink-muted">
                <Icon name="ph:target" size={15} class="mt-0.5 shrink-0 text-accent" />
                <span>Signals &ldquo;scales to power users.&rdquo;</span>
              </p>
            </div>

            <div class="relative rounded-lg border border-accent p-6">
              <p class="mono-label !text-accent mb-2">Chosen</p>
              <div class="mb-2 flex items-center gap-2">
                <span class="font-mono text-[0.75rem] text-accent">B</span>
                <span class="font-heading text-xs font-semibold uppercase tracking-wider text-ink">Two-Tier Platform</span>
              </div>
              <Text size="sm" tone="muted" class="mb-3">Enterprise-familiar</Text>
              <Text size="sm" tone="muted">
                48 px product rail plus 260 px project nav, the real two-tier pattern.
                App-switcher waffle, breadcrumbed page headers, right-side inspector panel. Brand
                orange on active rail state, soft navy-tinted elevation.
              </Text>
              <p class="mt-4 flex items-start gap-2 text-sm text-ink-muted">
                <Icon name="ph:users-three" size={15} class="mt-0.5 shrink-0 text-accent" />
                <span>Every enterprise buyer has used this pattern before.</span>
              </p>
            </div>

            <div class="rounded-lg border border-line p-6">
              <div class="mb-2 flex items-center gap-2">
                <span class="font-mono text-[0.75rem] text-accent">C</span>
                <span class="font-heading text-xs font-semibold uppercase tracking-wider text-ink">Modern Workspace</span>
              </div>
              <Text size="sm" tone="muted" class="mb-3">Spacious &middot; Document-forward</Text>
              <Text size="sm" tone="muted">
                270 px soft sidebar, no persistent top bar,
                <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 rounded-[4px]">⌘K</code> by shortcut only, generous spacing.
              </Text>
              <p class="mt-4 flex items-start gap-2 text-sm text-ink-muted">
                <Icon name="ph:warning" size={15} class="mt-0.5 shrink-0 text-accent" />
                <span>Risk: reads as lightweight for a dense ops tool.</span>
              </p>
            </div>
          </div>

          <div class="mt-10 measure space-y-5">
            <Text size="lg" tone="muted">
              I chose B. C was prettier. A was more sophisticated. But the product's users
              worked across many different client accounts every day, and the lowest-risk
              path to both user and investor trust was the layout pattern those operators
              had already used at every previous job.
            </Text>
            <Text size="lg" tone="muted">
              I also <strong class="text-ink font-semibold">dropped</strong> a feature I'd
              originally planned to include: a global "Create" button. Most new listings in
              this product arrive automatically from the incoming data feed; people rarely
              create one by hand. Adding a "Create" button would have been copying a familiar
              pattern without it actually earning a place here.
            </Text>
          </div>

          <figure class="my-12 border-l-2 border-accent pl-6">
            <blockquote class="font-display text-2xl md:text-3xl tracking-tight text-ink leading-snug">
              Familiarity beat novelty here. Operators had already seen this layout, at other jobs.
            </blockquote>
          </figure>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="rollout" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 03</p>
          <Heading level={2} visual="display-md" tone="ink">Phased rollout</Heading>
        </div>
        <div class="case-layout__body">
          <Text size="lg" tone="muted" class="mt-8 measure">
            This was a live product serving many different client companies at once, with
            operators in it every working day. An all-at-once redesign that broke muscle
            memory, or that needed a plan to undo it if something broke, was never on the
            table. Each phase was instead
            <strong class="text-ink font-semibold">shippable on its own</strong>, with the
            previous phase's work still intact if I needed to back it out.
          </Text>

          <div class="mt-12 grid md:grid-cols-2 gap-6">
            <div class="border-t border-line pt-5">
              <p class="mono-label">Phase 1 &middot; Baseline</p>
              <div class="mt-3 mb-3 flex items-center gap-2">
                <Icon name="ph:ruler" size={22} class="text-ink-muted" />
                <Heading level={3} visual="h3" tone="ink">Visual baseline</Heading>
              </div>
              <Text tone="muted">
                Built one reusable page-header component that every screen could use for
                its title, tabs, and buttons, then quietly rolled it out across roughly 30
                existing pages without anyone needing to touch each page by hand. Also
                added a badge in the top bar showing which environment and which client
                account you're in, so it's obvious at a glance.
              </Text>
            </div>

            <div class="border-t border-line pt-5">
              <p class="mono-label">Phase 2 &middot; The shell</p>
              <div class="mt-3 mb-3 flex items-center gap-2">
                <Icon name="ph:sidebar" size={22} class="text-ink-muted" />
                <Heading level={3} visual="h3" tone="ink">Two-tier shell</Heading>
              </div>
              <Text tone="muted">
                Replaced one large, always-open sidebar with a slim icon rail plus a second
                panel that automatically shows the options relevant to whatever section
                you're in. Crucially, the page already knows
                <strong class="text-ink font-semibold">which section is highlighted the
                instant it loads</strong>. There's no flash or delay while extra code
                figures that out afterward.
              </Text>
            </div>

            <div class="border-t border-line pt-5">
              <p class="mono-label">Phase 3 &middot; ⌘K</p>
              <div class="mt-3 mb-3 flex items-center gap-2">
                <Icon name="ph:magnifying-glass" size={22} class="text-ink-muted" />
                <Heading level={3} visual="h3" tone="ink">Command palette</Heading>
              </div>
              <Text tone="muted">
                A search box you can summon from anywhere with a keyboard shortcut,
                scoped to whichever client account you're currently working in, with
                results grouped into categories (custom rules, rate plans, facilities,
                accounts, jump-to) and updating smoothly as you type. Deliberate
                constraint: the palette
                <strong class="text-ink font-semibold">does not replace the search box
                already on each page</strong>. It's an extra option, not a replacement.
              </Text>
            </div>

            <div class="border-t border-line pt-5">
              <p class="mono-label">Phase 4 &middot; Polish</p>
              <div class="mt-3 mb-3 flex items-center gap-2">
                <Icon name="ph:sparkle" size={22} class="text-ink-muted" />
                <Heading level={3} visual="h3" tone="ink">Density, shortcuts, inspector</Heading>
              </div>
              <ul class="space-y-2">
                <li class="flex items-start gap-2 text-ink-muted leading-relaxed">
                  <Icon name="ph:check-circle" size={18} class="mt-0.5 shrink-0 text-accent" />
                  <span>A compact-or-roomy layout setting, saved to your account and applied
                    before the page even finishes loading, so there's no visible jump.</span>
                </li>
                <li class="flex items-start gap-2 text-ink-muted leading-relaxed">
                  <Icon name="ph:check-circle" size={18} class="mt-0.5 shrink-0 text-accent" />
                  <span>A shortcut cheat-sheet (press "?") that only appears when you're not
                    currently typing in a form field.</span>
                </li>
                <li class="flex items-start gap-2 text-ink-muted leading-relaxed">
                  <Icon name="ph:check-circle" size={18} class="mt-0.5 shrink-0 text-accent" />
                  <span>A slide-out detail panel built to match the look and feel of the rest
                    of the app.</span>
                </li>
                <li class="flex items-start gap-2 text-ink-muted leading-relaxed">
                  <Icon name="ph:check-circle" size={18} class="mt-0.5 shrink-0 text-accent" />
                  <span>Loading placeholders that respect a visitor's "reduce motion"
                    setting, so they don't shimmer or pulse for anyone who's asked their
                    device to limit animation.</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="content">
      <p class="mono-label mb-3">What it looks like now</p>
      <Heading level={2} visual="display-md" tone="ink" class="mb-6">One system, documented in the app</Heading>
      <Text size="lg" tone="muted" class="measure mb-4">
        Buttons collapsed down to one consistent set of styles instead of eight
        competing ones. Text fields, dropdowns, and labels moved onto shared building
        blocks with consistent spacing, focus outlines, and required-field markers.
        Tables settled on one header style, one page-navigation control, one spacing
        rule.
      </Text>
      <Text size="lg" tone="muted" class="measure">
        All of it lives in an admin-only style guide that ships with the app, so the
        next person to build a screen inherits those decisions instead of
        re-litigating them. These are whole-page captures, so each one opens to its
        full height in place.
      </Text>
    </Container>

    <Container width="wide" class="mt-14">
      <div class="space-y-16">
        <ScrollShot
          src="/images/projects/vmspark/playground-overview.webp"
