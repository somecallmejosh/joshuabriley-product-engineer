---
import ProjectLayout from '~/layouts/ProjectLayout.astro';
import ProjectHero from '~/components/patterns/ProjectHero.astro';
import ProjectNext from '~/components/patterns/ProjectNext.astro';
import GalleryLink from '~/components/patterns/GalleryLink.astro';
import CaseReview from '~/components/patterns/CaseReview.astro';
import Tldr from '~/components/patterns/Tldr.astro';
import Container from '~/components/layout/Container.astro';
import Metric from '~/components/patterns/Metric.astro';
import Plate from '~/components/patterns/Plate.astro';
import ScrollShot from '~/components/patterns/ScrollShot.astro';
import SiteShot from '~/components/patterns/SiteShot.astro';
import CaseSection from '~/components/patterns/case/CaseSection.astro';
import CaseProse from '~/components/patterns/case/CaseProse.astro';
import CaseCards from '~/components/patterns/case/CaseCards.astro';
import CaseResults from '~/components/patterns/case/CaseResults.astro';
import CaseQuote from '~/components/patterns/case/CaseQuote.astro';
import CaseLimitations from '~/components/patterns/case/CaseLimitations.astro';
import CasePersonas from '~/components/patterns/case/CasePersonas.astro';
import CaseFor from '~/components/patterns/case/CaseFor.astro';
import CaseJourney from '~/components/patterns/case/CaseJourney.astro';
import { vmsparkPersonas, vmsparkJourney } from '~/lib/case-research';
import HeuristicScores from '~/components/patterns/case/HeuristicScores.astro';
import { vmsparkSummary as tldr } from '~/lib/project-summaries';
import type { ImageMetadata } from 'astro';

// Section order and ids follow .claude/skills/portfolio/SKILL.md.

const title = 'VMSpark | Joshua Briley';
const description =
  'Case study: rebuilding the VMSpark admin app on a from-scratch design system, so staffing operators can fix feeds faster and the business can show, maintain, and trust it.';

// Sources: tasks/heuristics-audit.md, tasks/redesign-plan.md and
// tasks/ui-components.md in the vm_admin repo, plus notes/vm-spark.md.

// Screenshots of the local app, captured from a production-copy
// database with a temporary login. Desktop 1440×900 @2x, phone 390×844 @2x.
// The workspace name and signed-in email were replaced before capture; pages
// that list real people or customer accounts were left out.
const appShots = import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/vmspark/app/*.png', { eager: true });
const shot = (slug: string) => appShots[`../../assets/projects/vmspark/app/${slug}.png`].default;

const jumpLinks = [
  { href: '#tldr', label: 'Summary' },
  { href: '#context', label: 'Who it’s for' },
  { href: '#research', label: 'Research' },
  { href: '#decisions', label: 'Design decisions' },
  { href: '#outcomes', label: 'Results' },
  { href: '#process', label: 'How it was built' },
  { href: '#edges', label: 'Limitations' },
];

// Who the product has to work for. The redesign only counts if a decision
// holds up for both columns.
const audiences = [
  {
    icon: 'ph:users-three',
    title: 'Operators at staffing agencies',
    body: 'They live in the app all day. Their job is to make sure every hospital job from every feed maps correctly and reaches their applicant tracking system, so recruiters can fill it.',
    needs: ['Know what needs fixing without hunting', 'See why a job failed, in words', 'Undo-proof actions that touch thousands of jobs', 'A screen they can read for eight hours'],
  },
  {
    icon: 'ph:buildings',
    title: 'VMSpark, the business',
    body: 'The pipeline is the product. The interface decides whether customers trust it, whether support hears about it, and whether investors see a finished company.',
    needs: ['Fewer “why didn’t this job sync?” tickets', 'No accidental reprocessing across a whole account', 'A demo that matches the marketing site', 'An interface the team can change without breaking'],
  },
];

// Nielsen heuristics, scored 0–10 from the code before the redesign. Each
// row names the evidence and the change that answered it.
const heuristics = [
  { n: 1, name: 'Visibility of system status', before: 4, after: 8, fix: 'Every page gets its own title and a next-step line where there is work. “Sync with ATS” became “Import from Bullhorn”, disables while it runs, and confirms with a message.', left: 'Most HTMX failures still fail silently.' },
  { n: 2, name: 'Match with the real world', before: 3, after: 8, fix: 'Titles like “AtsPayloads#show” and values like not_nil became plain words. Conditions read as sentences.', left: 'VMS and ATS are never spelled out.' },
  { n: 3, name: 'User control and freedom', before: 3, after: 7, fix: 'Every confirm works, Esc and a click outside close every dialog, and a failed reorder rolls back with a message.', left: 'There is still no undo, only confirmation.' },
  { n: 4, name: 'Consistency and standards', before: 3, after: 8, fix: 'Two sidebars, four variants, and three icon sets became one labeled sidebar, one icon family, and one table component.', left: 'A few “Sync” labels and scaffold flash messages remain.' },
  { n: 5, name: 'Error prevention', before: 2, after: 8, fix: 'Deletes with a working confirmation went from 10 of 43 to all 28. Reprocess and feed rebuilds confirm too.', left: 'Reprocess all doesn’t state how many listings it touches.' },
  { n: 6, name: 'Recognition over recall', before: 4, after: 8, fix: 'About 33 popovers and 65 hover titles went to zero. Failure reasons sit on the row.', left: 'Icon-only row buttons have no visible label.' },
  { n: 7, name: 'Flexibility and efficiency', before: 7, after: 7, fix: 'Kept the command palette, shortcuts, saved views, and resizable columns, and added a keyboard step for resizing.', left: 'The density setting dropped out of the new menus. No bulk mapping yet.' },
  { n: 8, name: 'Aesthetic and minimalist', before: 4, after: 7, fix: 'Tables holding two-row lists became simple lists. Popovers that repeated the cell were deleted.', left: 'Some dead scaffold views are still routed.' },
  { n: 9, name: 'Recovering from errors', before: 3, after: 7, fix: '“Prohibited this record from being saved” went from 11 forms to none. Errors sit under their field and are linked to it.', left: 'Adding manual jobs can lose typed rows on failure.' },
  { n: 10, name: 'Help and documentation', before: 2, after: 7, fix: 'Index pages without an empty state went from 35 to 2. Page subtitles went from 1 to 102.', left: 'No glossary or in-app docs.' },
];

// Foundations: each one is a decision about the operator, not a style choice.
const foundations = [
  { icon: 'ph:text-aa', title: 'Type made for legibility', body: 'Atkinson Hyperlegible, designed with the Braille Institute, at a 16px base. A matching mono face sets IDs, dates, and rates so they line up.' },
  { icon: 'ph:cursor-click', title: 'Color has a job', body: 'Navy is structure, brand blue is anything you can click, Spark orange is only the brand. Red, amber, and green appear only for state.' },
  { icon: 'ph:shapes', title: 'State is a word and an icon', body: '“Processed”, “Failed”, “Skipped”: every status pairs a glyph with a word, so color is never the only signal.' },
  { icon: 'ph:hand-pointing', title: 'Nothing important on hover', body: 'No tooltips for information. If an operator needs it, it is on the page, in a note, or in the details drawer.' },
  { icon: 'ph:moon', title: 'Light and dark from one set of tokens', body: 'The theme follows the system setting and can be changed per person. Both themes pass the same contrast checks.' },
  { icon: 'ph:signpost', title: 'One job per page, said first', body: 'Every page header has a title, one sentence of purpose, and at most one primary action. When there is work, a next-step line says what to do.' },
];

// The three token tiers. The structure is what lets a brand change land
// everywhere at once without anyone touching markup.
const tiers = [
  { icon: 'ph:circle', title: 'Primitive', body: 'Raw values with no meaning, such as <code>--blue-510</code>. Read only by the semantic tier.' },
  { icon: 'ph:target', title: 'Semantic', body: 'What a value is for, such as <code>--color-accent</code>. Light, dark, and the navy chrome map it differently.' },
  { icon: 'ph:puzzle-piece', title: 'Component', body: 'One component’s palette, such as <code>--button-bg</code>. Variants change tokens, never CSS.' },
];

// Screens used in more than one place.
const pairs = [
  {
    slug: 'desktop-needs-mapping',
    title: 'Needs mapping',
    note: 'A new page: one inbox for every unmapped value, sorted by how much work it holds.',
    alt: 'The Needs mapping page: a header that reads “Values from your VMS feeds that aren’t mapped to your ATS yet. Job listings that use them can’t be fully processed until they’re mapped.”, the count 2,614 unmapped values across 8 lists, the next step “Start with facilities: 2,495 values need a value in your ATS.”, then a plain list of facilities, professions, specialties, shift details, departments, shift types, VMS sources, job types, and job statuses, each with its unmapped count and an arrow.',
  },
  {
    slug: 'desktop-job-listings',
    title: 'Job listings',
    note: 'The busiest screen. One sentence of purpose, the last import time, and the table operators already knew.',
    alt: 'The Job listings page: a header saying every job from the VMS feeds and manual jobs appears here after mapping and rules run, 1,976 listings and the last import time, Email CSV export and Reprocess all buttons, All, Processed, and Skipped tabs, and a table with view, reprocess, and open actions, notes, job status, start date, facility name, city, and state.',
  },
  {
    slug: 'desktop-inspector',
    title: 'Job details drawer',
    note: 'Opens over the filtered list. The facts first, then every field, then the raw feed.',
    alt: 'The job details drawer open over the job listings table: a Processed status, the title CNA Certified Nursing Assistant, facility, schedule, hours, bill rate of $37.60 an hour, dates and job ID, then Overview, All fields, and Raw data tabs above the job description, with Close and Reprocess buttons at the bottom.',
  },
];

// The phone set, alternating themes. Captions describe what is on screen.
const phones = [
  { slug: 'phone-nav-dark', title: 'Navigation', note: 'The same labeled sidebar, as a drawer.', alt: 'The navigation drawer on a phone in dark mode: Jobs, Candidates, and Mapping groups, with Needs mapping selected and unmapped counts beside Facilities, Professions, Specialties, and the other lists.' },
  { slug: 'phone-needs-mapping-light', title: 'Needs mapping', note: 'Counts stay on the same line as each list.', alt: 'The Needs mapping page on a phone in light mode: the purpose sentence, 2,614 unmapped values across 8 lists, the next step to start with facilities, and the list of mapping areas with their unmapped counts.' },
  { slug: 'phone-job-listings-light', title: 'Job listings', note: 'The table scrolls inside its frame. The page never does.', alt: 'The Job listings page on a phone in light mode: the purpose sentence, listing count and last import, Email CSV export and Reprocess all buttons, tabs, and the start of the table with its action buttons.' },
  { slug: 'phone-custom-rules-dark', title: 'Custom rules', note: 'Arrow buttons work where dragging doesn’t.', alt: 'The Custom rules page on a phone in dark mode: a New custom rule button, filter fields for name, status, and changed field, the drag-or-arrows note, and the first two rules with up and down buttons and Active switches.' },
];

// Mistakes that cost both sides. Each one protects an operator and the business at once.
const safety = [
  { icon: 'ph:warning-circle', title: 'Confirmations that say what happens', body: 'Turbo and rails-ujs were off, so every confirm in the codebase silently did nothing. One shared dialog now handles them. Each message asks a specific question, which becomes the dialog’s title, then says what happens next. The written rules ban “Are you sure?”.' },
  { icon: 'ph:arrows-clockwise', title: 'Reprocess all states its reach', body: 'One click re-runs mapping, rules, and the ATS sync for every open job in the account. The confirm now says so, including that it runs in the background and takes minutes, and the button disables while it posts. That protects the queue as much as the operator.' },
  { icon: 'ph:download-simple', title: 'Buttons say which way data moves', body: '“Sync with ATS” actually imported values from the ATS. Renaming it “Import from Bullhorn” removed a question operators had been sending to support.' },
];

// What keeps the system honest after I leave.
const checks = [
  { icon: 'ph:list-checks', title: 'bin/ui_lint', body: 'Fails on unknown classes, inline styles and scripts, tooltips, Bootstrap leftovers, dashes in copy, and primitives read outside tier 2.' },
  { icon: 'ph:palette', title: 'bin/color_audit', body: 'Fails on any hex, RGB, or HSL value outside the token file.' },
  { icon: 'ph:circle-half', title: 'bin/contrast_check', body: 'Checks every text and control pairing against WCAG AA, in both themes.' },
  { icon: 'ph:book-open', title: 'Style guide spec', body: 'Fails if a listed token, icon, or illustration stops rendering.' },
];

const results = [
  { label: 'For operators like Nadia', items: ['One inbox for everything that needs mapping', 'Failure reasons in words, on the row', 'Every destructive action confirms first', 'Light, dark, and phone layouts'] },
  { label: 'For the team', items: ['One component library and one style guide', 'Checks that fail the build on drift', 'Bootstrap, jQuery, and page-level scripts removed', 'About 13,000 fewer lines of view code'] },
  { label: 'For investors like Graham and the business', items: ['A demo that matches vmspark.com', 'Fewer ways to reprocess an account by accident', 'Routes, params, and integrations unchanged', 'Two security holes closed'] },
];

const edges = [
  {
    icon: 'ph:users-three',
    title: 'Not yet watched in real use',
    body: 'Both scores come from the code and the reviews came from stakeholders. I haven’t watched operators like Nadia work in the new interface, so I can’t claim it’s faster.',
  },
  {
    icon: 'ph:wifi-slash',
    title: 'Failures that still go quiet',
    body: 'When a save fails on the server, most inline actions show nothing. One shared listener that says “Couldn’t save. Try again.” would lift visibility and error recovery together.',
  },
  {
    icon: 'ph:arrow-counter-clockwise',
    title: 'Confirmation instead of undo',
    body: 'Every delete asks first, but none can be undone. For mappings, where one change touches thousands of listings, undo is the next step.',
  },
  {
    icon: 'ph:device-mobile',
    title: 'Wide tables on phones',
    body: 'Job listings keeps its full table on small screens and scrolls it sideways. A card view for phones needs a decision on which columns matter most.',
  },
];
---

<ProjectLayout title={title} description={description}>

  <ProjectHero project="vmspark" />

  <CaseReview links={jumpLinks} />

  <Tldr problem={tldr.problem} decision={tldr.decision} evidence={tldr.evidence} />

  <CaseSection id="context" title="Who it’s for">
    <CaseProse>
      <p>
        VMSpark takes job feeds from the vendor management systems hospitals use, maps each
        listing to a staffing agency’s own vocabulary, runs the agency’s rules, and sends it to
        their applicant tracking system. When a value doesn’t map, the job stalls, and a nurse
        doesn’t hear about a shift.
      </p>
      <p>
        The people fixing those values and the company selling the pipeline want the same
        thing from the interface. I held every decision to <strong class="text-ink font-semibold">both
        columns below</strong>: if it helped one side and cost the other, it wasn’t done.
      </p>
      <p>
        The main audience for this work was venture capitalists and angel investors like
        <a href="#persona-graham" class="hero-link">Graham</a>, because the goal was to make the
        case for the business.
      </p>
    </CaseProse>

    <CaseCards items={audiences} />

    <Fragment slot="media">
      <Container width="wide" class="mt-16">
        <Plate title="Job listings" caption={pairs[1].note} src={shot('desktop-job-listings-light')} alt={pairs[1].alt} />
      </Container>
    </Fragment>
  </CaseSection>

  <CaseSection id="research" title="Research">
    <CaseProse>
      <h3 class="mono-label">How requirements were gathered</h3>
      <p>
        The admin app looked unfinished just as VMSpark began showing it to investors. It had
        started as a Bootstrap project and lost its way, and the team knew it. They paid for a
        design and usability audit first, agreed with what it found, and hired me to do the work,
        which we ran from Monday.com at their request.
      </p>
      <p>
        We had no opportunity to research VMSpark’s customers, so the evidence had to come from
        the app and from established best practices. I audited about 350 templates, then scored
        the whole app against Nielsen’s ten heuristics, with a file and line for every finding.
      </p>
      <p>
        After the redesign the app was re-scored with the same rubric, from the code, by a
        reviewer that hadn’t seen my notes: an AI agent given only the original audit and the
        repo. It had to verify every fix in the code rather than take the plan’s word for it.
      </p>
    </CaseProse>

    <div class="mt-12 grid grid-cols-2 gap-8 py-8">
      <Metric value="3.5 → 7.5" label="average score out of 10" caption="before and after, same rubric, scored from the code" />
      <Metric value="2 → 8" label="error prevention" caption="the lowest score before the redesign" />
    </div>

    <HeuristicScores items={heuristics} caption="Before → after, the change that moved it, and what still keeps it from a 10. The design decisions below explain the changes." />

    <CaseProse class="mt-12">
      <p>
        The audit also turned up a SQL injection in a search allowlist and feed text rendered
        unescaped in popovers and emails. Both were fixed before any styling work.
      </p>
      <p>
        The pattern behind most of the low scores was the same: <strong class="text-ink font-semibold">the
        information an operator needed existed, but only on hover</strong>. The app’s own old style
        guide said “don’t hide required information behind a tooltip”. The app did it about a
        hundred times.
      </p>
    </CaseProse>

    <Fragment slot="media">
      <Container width="wide" class="mt-16">
        <CasePersonas items={vmsparkPersonas} />
      </Container>

      <Container width="wide" class="mt-16">
        <CaseJourney title="Journey map: an investor’s demo" stages={vmsparkJourney} />
      </Container>
    </Fragment>
  </CaseSection>

  <CaseSection id="decisions" title="A design system built from scratch">
    <CaseFor project="vmspark" personas={["graham","nadia"]} stage="tour" />
      <CaseProse>
        <p>
          Re-theming Bootstrap would have kept five ways to render a form. I replaced it with a
          small library in plain CSS: one partial or helper per component, one CSS block, and one
          live entry in the style guide. If it isn’t in the library, a page can’t use it.
        </p>
      </CaseProse>

      <CaseCards label="Foundations" items={foundations} />

      <CaseCards label="Three tiers of tokens" items={tiers} />

      <CaseProse class="mt-12">
        <p>
          Dark mode is a second mapping of the semantic tier, not a second stylesheet. Matching the
          marketing site meant changing a handful of semantic tokens, and every screen followed.
        </p>
        <p>
          I didn’t design or work on the marketing site. It already existed, and I borrowed its style.
          Investors like Graham see the marketing site first and the app second, so they should feel like one
          company. The app borrows its navy, its blue, the Spark bolt, and its two-tone line drawings,
          and uses them only in those places. The personality comes from consistency, not decoration.
        </p>
      </CaseProse>

      <Fragment slot="media">
        <Container width="wide" class="mt-16">
          <ScrollShot
            src="/images/projects/vmspark/styleguide-tokens-light.webp"
            alt="The style guide’s Foundations section: the three token tiers explained with an example of each, then the full primitive palette of slate, navy, blue, orange, green, amber, and red swatches, each labeled with its token name and hex value."
            label="/admin/ui_playground"
            kind="Style guide"
            caption="Every primitive, named by lightness, so a darker step is always a higher number."
          />
        </Container>
        <Container width="wide" class="mt-16">
          <SiteShot
            src="/images/projects/vmspark/vmspark-live.webp"
            alt="The existing VMSpark marketing site, which I didn’t design or build. It’s the source of the app’s navy, brand blue, and Spark orange."
            href="https://vmspark.com/"
            label="vmspark.com"
            kind="Existing site, not my work"
            index="01"
          />
        </Container>
        <Container width="wide" class="mt-16">
          <Plate
            title="Sign in"
          caption="The first screen borrows the marketing site’s navy and its feeds-to-ATS drawing."
          src={shot('desktop-signin-light')}
          alt="The sign-in page in light mode: a navy brand panel on the left with the VMS Spark logo, the line “VMS to ATS workflow”, a sentence saying jobs from every VMS are cleaned up and sent to your ATS, and a line drawing of three feed cards flowing through a lightning bolt into a stack of cards. On the right, a Sign in card with email and password fields, Show password, Forgot your password, Keep me signed in, and a Sign in button."
          />
        </Container>
      </Fragment>
    </CaseSection>

  <CaseSection id="decision-inbox" title="One inbox for work that needs mapping">
    <CaseFor project="vmspark" personas={["nadia","graham"]} stage="failure" />
    <CaseProse>
      <p>
        The old navigation listed 14 mapping pages with a count on each, and operators opened
        them one by one to find work. I added <strong class="text-ink font-semibold">Needs
        mapping</strong>, one inbox sorted by how much is waiting, with a next step at the top.
      </p>
      <p>
        For the business this is the same list as “jobs that can’t reach a customer’s ATS”, so
        clearing it is the most valuable thing an operator can do.
      </p>
    </CaseProse>

    <Fragment slot="media">
      <Container width="wide" class="mt-16">
        <Plate
          title="Needs mapping"
          caption="One sentence of purpose, the total, and where to start. Lists with nothing to do are dimmed, not hidden."
          src={shot('desktop-needs-mapping-light')}
          alt={pairs[0].alt}
        />
      </Container>

      <CaseProse continued>
        <p>
          Each mapping page works like a ledger: what came in from the feed on the left, the value in
          the ATS on the right, and a Save on every row. “Ignore” sits beside it with a hint that says
          exactly what ignoring does.
        </p>
      </CaseProse>

      <Container width="wide" class="mt-16">
        <Plate
          title="Professions"
          caption="What came in, what it should be, and what Ignore does, on every row."
          src={shot('desktop-professions-light')}
          alt="The Professions mapping page: “47 professions need a value in your ATS. Pick one and save each row.”, Unmapped 47 and Mapped tabs, a search field with a Search button, a hint explaining what Ignore and new values do, then rows pairing a profession title from the VMS feeds with a profession picker, an optional new ATS value, an Ignore switch, a Save button, and a delete button."
        />
      </Container>

      <CaseProse continued>
        <p>
          A failed job used to show its reason as a raw Ruby hash in a hover title. Now the reason is
          a sentence on the row.
        </p>
        <p>
          The details drawer opens over the filtered list, so an operator doesn’t lose their place.
          Fields are grouped by where they came from, ending with the raw feed, which is where a bad
          value is usually traced.
        </p>
      </CaseProse>

      <Container width="wide" class="mt-16">
        <Plate title="Job details drawer" caption={pairs[2].note} src={shot('desktop-inspector-light')} alt={pairs[2].alt} />
      </Container>
    </Fragment>
  </CaseSection>

  <CaseSection id="decision-safety" title="Confirmations that say what will happen">
    <CaseFor project="vmspark" personas={["nadia","graham"]} stage="risk" />
    <CaseProse>
      <p>
        In this app a misclick doesn’t just annoy someone. Deleting a mapping can unmap
        thousands of listings, and reprocessing an account queues work for every open job in it.
        The operator loses their afternoon, and the business pays for the compute and the
        support call.
      </p>
    </CaseProse>

    <CaseCards items={safety} />

    <CaseProse class="mt-12">
      <p>
        Forms follow the same idea: label above, hint under the label, and the error under the
        field it belongs to, linked for screen readers. The heading over a failed form says how
        many fields to fix, in plain words.
      </p>
    </CaseProse>

    <Fragment slot="media">
      <Container width="wide" class="mt-16">
        <div class="grid grid-cols-1 gap-x-8 gap-y-14 lg:grid-cols-2">
          <Plate
            size="half"
            title="Reprocess all, light"
            caption="The question is the title, the consequence is the body, and the button repeats the verb."
            src={shot('desktop-confirm-reprocess-light')}
            alt="The confirm dialog over the job listings page, titled “Reprocess every open job listing in this account?”, with the body “Mapping and rules run again on each one and changes sync to your ATS. This runs in the background and can take several minutes.” and Cancel and Reprocess buttons."
          />
          <Plate
            size="half"
            title="Reprocess all, dark"
            caption="One dialog for every confirmation in the app, so they all read the same way."
            src={shot('desktop-confirm-reprocess-dark')}
            alt="The same Reprocess all confirm dialog in dark mode."
          />
        </div>
      </Container>
    </Fragment>
  </CaseSection>

  <CaseSection id="decision-themes" title="Light, dark, and phone layouts">
    <CaseFor project="vmspark" personas={["graham","nadia"]} stage="signin" />
    <CaseProse>
      <p>
        Operators keep this app open through a full shift, often beside other dark tools. The
        theme follows their system setting, and each person can override it from the account
        menu. A small script applies the choice before first paint, so pages never flash.
      </p>
      <p>
        Dark mode isn’t an inverted light mode. Each semantic token gets its own dark value, and
        brand blue steps up in lightness so links and buttons stay readable on navy. A script checks
        all <strong class="text-ink font-semibold">178 text and control pairings</strong> in both
        themes against WCAG AA.
      </p>
    </CaseProse>

    <Fragment slot="media">
      <Container width="wide" class="mt-16">
        <Plate
          title="Needs mapping, dark"
          caption="The same page as above, with each token mapped for dark."
          src={shot('desktop-needs-mapping-dark')}
          alt={`${pairs[0].alt} Shown in dark mode.`}
        />
      </Container>

      <CaseProse continued>
        <p>
          Most mapping happens at a desk, but failed-listing alerts arrive by email, and an
          operator should be able to check one from a phone. The main screens were checked at 390
          pixels wide with no sideways page scroll. Layouts collapse to one column below 640
          pixels, and every target is at least 24 pixels, 40 for primary actions.
        </p>
        <p>
          Drag-to-reorder doesn’t work well with a thumb or a keyboard, so rules and rate plans
          also have up and down buttons.
        </p>
      </CaseProse>

      <Container width="wide" class="mt-16">
        <ul class="grid grid-cols-2 gap-x-5 gap-y-10 md:grid-cols-4">
          {phones.map((p) => (
