---
import ProjectLayout from '~/layouts/ProjectLayout.astro';
import ProjectHero from '~/components/patterns/ProjectHero.astro';
import ProjectNext from '~/components/patterns/ProjectNext.astro';
import GalleryLink from '~/components/patterns/GalleryLink.astro';
import CaseReview from '~/components/patterns/CaseReview.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import SiteShot from '~/components/patterns/SiteShot.astro';
import ScrollShot from '~/components/patterns/ScrollShot.astro';
import Plate from '~/components/patterns/Plate.astro';
import FidelityBand from '~/components/patterns/FidelityBand.astro';
import Tldr from '~/components/patterns/Tldr.astro';
import { vmsparkSummary as tldr } from '~/lib/project-summaries';
import type { ImageMetadata } from 'astro';

const title = 'VMSpark | Joshua Briley';
const description =
  'Case study: redesigning the VMSpark admin app shell and the screens operators use most, after auditing about 350 templates, without changing how the data pipeline works.';

// Copy throughout comes from notes/vm-spark.md (Josh's write-up).
const proof = [
  { label: 'Design · owned', items: ['Audit of roughly 350 ERB templates', 'Three written design directions and a recorded decision', 'Wireframes for 11 screens and diagrams for 5 flows'] },
  { label: 'Front end · owned', items: ['New app shell: product rail, contextual side panel, page headers, ⌘K search', 'Job listing table tools: resizable, sticky, and reorderable columns, saved searches, and a row inspector', 'In-app style guide covering buttons, forms, tables, cards, popovers, tooltips, icons, and type'] },
  { label: 'Not in scope', items: ['The ingestion pipeline', 'The rule engine', 'The ATS integrations', 'Account-level data access'] },
];

const findings = [
  'Five different ways of rendering forms',
  'Three modal conventions that didn’t coordinate with each other, so opening one modal from inside another was a bug waiting to happen',
  'Three tooltip systems running at the same time, one of which used Bootstrap 4 attributes that do nothing in Bootstrap 5',
  'A semantic color token file that already existed, but that about 40 views bypassed with inline colors and raw hex values',
  'Leftover debug code and dead files that were still being shipped',
];

const sorting = [
  { label: 'Cosmetic', text: 'fix during the redesign' },
  { label: 'Structural', text: 'needs a decision first' },
  { label: 'Out of scope', text: 'too close to the pipeline to touch' },
];

// Real screens from the app before the redesign.
const beforeShots = [
  {
    src: '/images/projects/vmspark/before-manual-jobs.png',
    alt: 'VMSpark Manual Jobs screen before the redesign. Three buttons sit side by side in the top bar: a filled orange Add New, an outlined Edit Selected, and an outlined Copy Selected. Labels sit below each search input.',
    caption: '<strong class="text-ink font-semibold">Manual Jobs.</strong> Three buttons in one row, three different treatments. Labels sit below the inputs.',
  },
  {
    src: '/images/projects/vmspark/before-ats-professions.png',
    alt: 'VMSpark ATS Professions screen before the redesign. Five search inputs use their label text as placeholders inside the fields.',
    caption: '<strong class="text-ink font-semibold">ATS Professions.</strong> Here the labels are placeholders inside the inputs.',
  },
];

const directions = [
  { name: 'Command Shell', from: 'Linear', body: 'A narrow icon rail, dense type, hairline borders, and a ⌘K palette at the center.', note: 'Built for power users, but it can feel stark.', icon: 'ph:terminal-window' },
  { name: 'Atlassian Platform', from: 'Jira', body: 'A product rail plus a contextual project panel, breadcrumbed page headers, and a slide-over inspector.', note: 'Familiar to almost every enterprise user.', icon: 'ph:users-three', chosen: true },
  { name: 'Modern Workspace', from: 'Notion', body: 'A soft sidebar, generous spacing, and no persistent top bar.', note: 'The calmest of the three, and the most likely to feel too light for a dense operations tool.', icon: 'ph:warning' },
];

const phases = [
  { label: 'Visual baseline', icon: 'ph:ruler', body: 'A shared page header with slots for metadata, tabs, and actions. I made the old heading partial call the new one, so about 30 pages picked up the new header without being edited.' },
  { label: 'The shell', icon: 'ph:sidebar', body: 'A two-tier layout: a narrow product rail plus a contextual panel whose contents depend on where you are in the app. The server decides which section is open, so nothing shifts after the page loads.' },
  { label: '⌘K search', icon: 'ph:magnifying-glass', body: 'A read-only search limited to the current account, with results grouped by type and opened in a native <code>&lt;dialog&gt;</code>. It doesn’t replace any page’s own filters. It’s another way to get around, not a new way to filter.' },
  { label: 'Polish', icon: 'ph:sparkle', body: 'A comfortable/compact density setting saved on the user’s account, a <code>?</code> overlay that lists keyboard shortcuts (it ignores <code>?</code> while you’re typing in a field), an inspector that slides over the list, and skeleton loaders that respect reduced-motion settings.' },
];

const reviewFixes = [
  'Page header icons now match the navigation icons',
  'Keyboard shortcuts work on both Mac and Windows (⌘K and Ctrl+K)',
  'Density applies to the whole interface, not only the sidebar',
  'The shortcut overlay is hidden on phones, which have no keyboard',
];

const tableTools = [
  'Columns can be resized, pinned in place, and reordered, and each user’s layout is remembered',
  'Searches can be saved and reused',
  'A row inspector opens a listing’s details without leaving the filtered list behind it',
  'The inspector groups fields into position, description, dates, source sync, and raw VMS data, so operators can see where a value came from when something fails',
];

const stack = [
  { name: 'Rails 7, Ruby 3.2, PostgreSQL', role: 'The existing app. The model changes only add columns.' },
  { name: 'Stimulus and HTMX', role: 'Turbo is turned off in this app on purpose.' },
  { name: 'Bootstrap 5 and SCSS', role: 'On a semantic color token layer.' },
];

const results = [
  { label: 'For operators', items: ['On release day, data, filters, and workflows were all where operators left them', 'People who preferred the old sidebar can still switch back to it', 'Density, column layouts, and saved searches follow each user'] },
  { label: 'For the team', items: ['One page header, one modal pattern, and one table toolkit instead of several', 'An in-app style guide that shows each component with dos and don’ts', 'Written records of the design directions and the sidebar variants that weren’t chosen, so the next designer has a starting point'] },
  { label: 'For the business', items: ['An admin app the company can show investors without apologizing for it first', 'No changes to the pipeline, rule engine, or integrations, so the redesign didn’t put the product’s core at risk'] },
];

// Screenshots of the local app (1440px wide at 2x). The workspace name and the
// signed-in email were replaced in the DOM before capture.
const shots = import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/vmspark/*.png', { eager: true });
const shot = (slug: string) => shots[`../../assets/projects/vmspark/${slug}.png`].default;

// Wireframe and flow sheets render from src/ so Astro can process them.
const sheetFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/vmspark/wires-and-flows/*.png', { eager: true });
const sheet = (slug: string) => sheetFiles[`../../assets/projects/vmspark/wires-and-flows/${slug}.png`].default;
// The sketch and clean-wireframe passes are SVG and need no processing.
const art = (file: string) => `/images/projects/vmspark/wires-and-flows/${file}`;

const edges = [
  {
    icon: 'ph:users-three',
    title: 'Feedback came from review meetings, not observed sessions',
    body: 'My feedback came from stakeholder and client review meetings. I didn’t watch operators work through real tasks in the new shell, so I can’t claim it’s faster to use. It looks more coherent, and the review fixes came from real complaints, but I haven’t measured whether it saves operators time.',
  },
  {
    icon: 'ph:ruler',
    title: 'Results are judged by what didn’t break',
    body: 'I didn’t set baseline metrics before the redesign, so the results above are about safety: nothing broke and nothing was taken away. I didn’t measure task time, errors, or satisfaction. If I did this again, I would record a few task timings on the old shell first so the new one had something to be compared against.',
  },
];
---

<ProjectLayout title={title} description={description}>

  <ProjectHero project="vmspark" />

  <CaseReview links={[{ href: '#tldr', label: 'Summary' }, { href: '#method', label: 'Design decisions' }, { href: '#sheets', label: 'Wireframes and flows' }, { href: '#outcomes', label: 'Results' }, { href: '#engineering', label: 'Engineering' }, { href: '#edges', label: 'What I’d improve' }]} />

  <Tldr
    problem={tldr.problem}
    alternativeA={tldr.alternativeA}
    alternativeB={tldr.alternativeB}
    alternativeC={tldr.alternativeC}
    decision={tldr.decision}
    implementation={tldr.implementation}
    evidence={tldr.evidence}
    reflection={tldr.reflection}
  />

  <Section tone="paper" padding="tight" aria-label="Scope" class="project-scope">
    <Container width="content">
      <p class="mono-label mb-8">Scope</p>
      <dl class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {proof.map((group) => (
          <div class="pt-4">
            <dt class="mono-label mb-3">{group.label}</dt>
            <dd>
              <ul class="space-y-1.5">
                {group.items.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-ink-muted leading-relaxed">
                    <Icon name={group.label === 'Not in scope' ? 'ph:minus' : 'ph:check'} size={14} class="mt-0.5 shrink-0 text-accent" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
      <Text size="sm" tone="muted" class="mt-10 measure">
        Other engineers own the pipeline, the rule engine, the ATS integrations, and account-level
        data access, and I didn’t change them.
      </Text>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="method" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Inventory before invention</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              I wanted to know what already existed before deciding what to change. The audit turned
              into a design inventory of about 700 lines, covering roughly 350 templates and 11,800
              lines of view code.
            </p>
            <p>It turned up a lot of quiet duplication:</p>
          </div>

          <ul class="mt-6 space-y-3">
            {findings.map((item) => (
              <li class="flex items-start gap-3 leading-relaxed text-ink-muted">
                <Icon name="ph:dot-outline" size={18} class="mt-1 shrink-0 text-accent" />
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div class="mt-10 rounded-lg border border-line p-6 md:p-8">
            <p class="mono-label mb-5">Every finding went into one of three groups</p>
            <ul class="space-y-3">
              {sorting.map((s) => (
                <li class="flex items-start gap-3 text-ink-muted">
                  <Icon name="ph:check" size={16} class="mt-1 shrink-0 text-accent" />
                  <span><strong class="font-medium text-ink">{s.label}:</strong> {s.text}</span>
                </li>
              ))}
            </ul>
          </div>

          <figure class="my-12 border-l-2 border-accent pl-6">
            <blockquote class="font-display text-2xl md:text-3xl tracking-tight text-ink leading-snug">
              That sorting did more to shape the project than any visual idea I started with.
            </blockquote>
          </figure>
        </div>
      </div>
    </Container>

    <Container width="wide" class="mt-4">
      <ul class="grid gap-x-8 gap-y-14 md:grid-cols-2">
        {beforeShots.map((img) => (
          <li>
            <figure>
              <div class="overflow-hidden rounded-lg border border-line">
                <img src={img.src} alt={img.alt} class="w-full h-auto block" loading="lazy" decoding="async" />
              </div>
              <figcaption class="mt-4 text-sm text-ink-muted leading-relaxed" set:html={img.caption} />
            </figure>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="directions" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Three directions, one choice</Heading>
        </div>
        <div class="case-layout__body">
          <Text size="lg" tone="muted" class="mt-8 measure">
            I wrote up three directions. Each one named the product it borrowed from and was honest
            about the risks.
          </Text>

          <ol class="mt-10 grid gap-6 sm:grid-cols-3 items-stretch">
            {directions.map((d) => (
              <li class:list={['rounded-lg border p-6', d.chosen ? 'border-accent' : 'border-line']}>
                {d.chosen && <p class="mono-label !text-accent mb-2">Chosen</p>}
                <p class="mono-label mb-1">{d.from}</p>
                <Heading level={3} visual="h4" tone="ink" class="mb-3">{d.name}</Heading>
                <Text size="sm" tone="muted">{d.body}</Text>
                <p class="mt-4 flex items-start gap-2 text-sm text-ink-muted">
                  <Icon name={d.icon} size={15} class="mt-0.5 shrink-0 text-accent" />
                  <span>{d.note}</span>
                </p>
              </li>
            ))}
          </ol>

          <div class="mt-10 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              I chose the Atlassian direction. Notion was prettier and Linear was sharper, but
              operators run this tool all day, and a pattern they already know builds trust faster
              than a new one. I wrote the reasoning down so the decision could be revisited on
              evidence rather than taste.
            </p>
            <p>
              I also dropped something I had planned. Jira has a global “Create” button, but in
              VMSpark most records come in from feeds, not from people. Adding that button would have
              copied the pattern without the reason behind it.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="phases" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Shipping in phases</Heading>
        </div>
        <div class="case-layout__body">
          <Text size="lg" tone="muted" class="mt-8 measure">
            I split the work so each phase could ship and stand on its own.
          </Text>

          <ol class="mt-12 grid md:grid-cols-2 gap-x-8 gap-y-10">
            {phases.map((ph, i) => (
              <li class="pt-5">
                <p class="mono-label">Phase {i + 1}</p>
                <div class="mt-3 mb-3 flex items-center gap-2">
                  <Icon name={ph.icon} size={22} class="text-ink-muted" />
                  <Heading level={3} visual="h3" tone="ink">{ph.label}</Heading>
                </div>
                <Text tone="muted"><Fragment set:html={ph.body} /></Text>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </Container>

    <Container width="wide" class="mt-16">
      <Plate title="The two-tier shell" caption="The product rail and the job listings panel, with the shared page header above the table." src={shot('app-shell')} alt="The redesigned VMSpark admin app: a dark product rail and a Job Listings side panel on the left, a top bar with the workspace name and a ⌘K button, and the Job Listings page with its header, All, Processed and Skipped tabs, and the listings table." />
    </Container>

    <Container width="wide" class="mt-16">
      <ul class="grid gap-x-8 gap-y-14 md:grid-cols-2">
        <li>
          <Plate size="half" title="⌘K search" caption="Results for the current account, grouped by type." src={shot('command-search')} alt="The ⌘K search dialog over the job listings page, with the query “windsor” and a list of matching facilities with their city and state." />
        </li>
        <li>
          <Plate size="half" title="Shortcut overlay" caption="Press ? anywhere outside a text field." src={shot('shortcuts')} alt="The keyboard shortcuts overlay, listing shortcuts for navigation, the view, the inspector, and the search palette." />
        </li>
      </ul>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="feedback" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Listening to the people who use it</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              At an April review, stakeholders pointed out that long-time users knew the old sidebar
              by heart. Instead of arguing for the new one, I added a per-user setting to switch
              between them. It took a preference column and a partial swap, which was a small price
              for not forcing a change on people mid-workflow.
            </p>
            <p>The same review produced a short list of fixes, and I shipped all of them:</p>
          </div>

          <ul class="mt-6 space-y-3">
            {reviewFixes.map((item) => (
              <li class="flex items-start gap-3 leading-relaxed text-ink-muted">
                <Icon name="ph:check" size={16} class="mt-1 shrink-0 text-accent" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>

    <Container width="wide" class="mt-16">
      <Plate title="The legacy sidebar, still available" caption="Each user picks the new or the old sidebar in their account menu." src={shot('legacy-sidebar')} alt="The legacy sidebar open over the job listings page, with grouped sections for job listings, data mapping with unmapped counts, and advanced customization." />
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="tables" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Tables operators can shape</Heading>
        </div>
        <div class="case-layout__body">
          <Text size="lg" tone="muted" class="mt-8 measure">
            Operators spend most of their time in the job listings table, so after two rounds of
            client review I put most of the later work there:
          </Text>

          <ul class="mt-6 space-y-3">
            {tableTools.map((item) => (
              <li class="flex items-start gap-3 leading-relaxed text-ink-muted">
                <Icon name="ph:check" size={16} class="mt-1 shrink-0 text-accent" />
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <Text size="lg" tone="muted" class="mt-8 measure">
            Every table in the app now uses the same column controls, so a habit learned on one
            screen works on all of them.
          </Text>
        </div>
      </div>
    </Container>

    <Container width="wide" class="mt-16">
      <Plate title="Row inspector" caption="One listing’s details over the filtered list, grouped so an operator can see where each value came from." src={shot('row-inspector')} alt="The row inspector open over the job listings table, showing one listing’s title, status, facility, location, shift, rate and dates, a field filter, and the Position group of fields." />
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="brand" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Matching the marketing site</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Partway through, I noticed that the app and the public marketing site had drifted
              apart. I took the marketing site’s brand colors and pointed five of the app’s existing
              tokens at them, plus three new tokens. The token system kept its structure, and every
              screen picked up the new look without touching its markup.
            </p>
            <p>
              Two brand details carried over. Primary buttons shift from orange to steel blue on
              hover instead of darkening, and links go near-black on hover. I added a quieter button
              variant for dense tables, where thirty buttons changing color would feel jittery.
            </p>
          </div>

          <div class="mt-10">
            <SiteShot
              src="/images/projects/vmspark/vmspark-live.webp"
              alt="The VMSpark marketing site, the source of the brand colors the admin app’s tokens were pointed at"
              href="https://vmspark.com/"
              label="vmspark.com"
              index="01"
            />
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="sheets" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <Heading level={2} visual="display-md" tone="ink" class="mb-6">Wireframes and flows</Heading>
      <Text size="lg" tone="muted" class="measure">
        To document the system for the team, I drew 11 screen wireframes and 5 flow diagrams. Each screen went
        from a rough sketch to a wireframe to an annotated sheet, like the shell below. The rest are in
        the <a href="/projects/vmspark/gallery/" class="hero-link">VMSpark gallery</a>.
      </Text>
    </Container>

    <Container width="wide" class="mt-14">
      <FidelityBand
        title="Application shell"
        sketch={art('01-app-shell-sketch.svg')}
        wire={art('01-app-shell.svg')}
        annotated={sheet('01-app-shell')}
        annotatedAlt="Annotated design sheet of the VMSpark application shell: a two-tier sidebar, workspace context, and global search."
        caption="The application shell as a rough sketch, a wireframe, and an annotated sheet."
      />
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="outcomes" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Results</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 grid gap-x-8 gap-y-10 sm:grid-cols-3">
            {results.map((group) => (
              <div class="pt-4">
                <p class="mono-label mb-3">{group.label}</p>
                <ul class="space-y-2">
                  {group.items.map((item) => (
                    <li class="flex items-start gap-2 text-sm text-ink-muted leading-relaxed">
                      <Icon name="ph:check" size={14} class="mt-1 shrink-0 text-accent" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default">
    <Container width="content">
      <figure class="grid gap-x-10 gap-y-10 md:grid-cols-12 md:items-start lg:gap-x-16">
        <figcaption class="md:col-span-4">
          <p class="mono-label mb-6">What Jon said</p>
          <div class="flex items-center gap-4 md:flex-col md:items-start md:gap-5">
            <img
              src="/images/testimonials/jon-sturm.jpeg"
              alt="Jon Sturm"
              class="h-14 w-14 rounded-full border border-line object-cover md:h-16 md:w-16"
              loading="lazy"
              decoding="async"
            />
            <div>
              <p class="font-display font-semibold text-ink">Jon Sturm</p>
              <p class="mt-1 text-sm text-ink-muted leading-snug">Director of Product &amp; Customer Success &middot; VMSpark</p>
            </div>
          </div>
        </figcaption>
        <blockquote class="md:col-span-8">
          <Icon name="ph:quotes" size={48} class="mb-5 text-accent opacity-25" />
          <p class="max-w-[46ch] font-display text-2xl md:text-3xl tracking-tight leading-snug text-ink">
            Josh inventoried 350 ERB templates before writing a line of new CSS, then turned that audit into a phased
            rollout we could ship behind no flags. The shell finally reads like the enterprise product the pipeline always
            was, and operators didn't lose a single piece of muscle memory in the move.
          </p>
        </blockquote>
      </figure>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="engineering" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Engineering</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              All new behavior is in small Stimulus controllers or server-rendered HTMX. I added no
              jQuery and no inline scripts. The new controllers only read data or save user
              preferences, and the search is limited to the current account like the rest of the app.
            </p>
            <p>
              The model changes only add things: three columns on the user record for density,
              sidebar collapse, and sidebar choice. A small script in the page head reads the density
              setting before the first paint, so the layout doesn’t jump when it applies.
            </p>
            <p>
              A color audit script checks changed files for raw hex, RGB, or HSL values, so new
              styles have to use the semantic tokens.
            </p>
          </div>

          <div class="mt-10 rounded-lg border border-line p-6 md:p-8">
            <p class="mono-label mb-6">Stack</p>
            <ul class="grid gap-x-8 gap-y-5 sm:grid-cols-3">
              {stack.map((item) => (
                <li>
                  <p class="font-medium text-ink leading-snug">{item.name}</p>
                  <p class="mt-0.5 text-sm text-ink-muted leading-snug">{item.role}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Container>

    <Container width="content" class="mt-16">
      <Heading level={3} visual="h3" tone="ink" class="mb-3">The in-app style guide</Heading>
      <Text tone="muted" class="measure">
        Buttons, forms, tables, cards, popovers, tooltips, icons, and type, each shown with dos and
        don’ts.
      </Text>
    </Container>

    <Container width="wide" class="mt-10">
      <div class="space-y-16">
        <ScrollShot
          src="/images/projects/vmspark/playground-overview.webp"
          alt="The VMSpark style guide overview, linking to each section of the guide"
          label="Style guide: overview"
          index="01"
        />
        <ScrollShot
          src="/images/projects/vmspark/playground-buttons.webp"
          alt="The VMSpark style guide’s buttons page: variants, sizes, and states"
          label="Buttons"
          index="02"
        />
        <ScrollShot
          src="/images/projects/vmspark/playground-tables.webp"
          alt="The VMSpark style guide’s tables page: header style, density, and pagination"
          label="Tables"
          index="03"
        />
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="edges" class="scroll-mt-24">
