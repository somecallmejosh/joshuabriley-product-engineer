// Section order and ids follow .claude/skills/portfolio/SKILL.md.

const title = 'VMSpark | Joshua Briley';
const description =
  'Case study: rebuilding the VMSpark admin app on a from-scratch design system, so staffing operators can find and fix feed errors and the business can demo, maintain, and trust it.';

// Sources: tasks/heuristics-audit.md, tasks/redesign-plan.md and
// tasks/ui-components.md in the vm_admin repo, plus notes/vm-spark.md.

// Screenshots of the local app, captured from a production-copy
// database with a temporary login. Desktop 1440×900 @2x, phone 390×844 @2x.
// The workspace name and signed-in email were replaced before capture; pages
// that list real people or customer accounts were left out.
// The elements-* plates come from the migration's browser checks: the real
// Rails partials and the app's CSS, rendered without the rest of the page.
// The status table is from the before/after log kept during the migration.
const appShots = import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/vmspark/app/*.png', { eager: true });
const shot = (slug: string) => appShots[`../../assets/projects/vmspark/app/${slug}.png`].default;

const jumpLinks = [
  { href: '#tldr', label: 'Summary' },
  { href: '#context', label: 'Audience' },
  { href: '#research', label: 'Research' },
  { href: '#decisions', label: 'Design decisions' },
  { href: '#process', label: 'Engineering' },
  { href: '#outcomes', label: 'Results' },
  { href: '#edges', label: 'Limitations' },
];

// Who the product has to work for. The redesign only counts if a decision
// holds up for both columns.
const audiences = [
  {
    icon: 'ph:users-three',
    title: 'Operators at staffing agencies',
    body: 'They use the app all day. Their job is to make sure every hospital job from every feed maps correctly and reaches their applicant tracking system, so recruiters can fill it.',
    needs: ['Know what needs fixing without hunting', 'See why a job failed, in words', 'Safeguards on actions that touch thousands of jobs', 'A screen they can read for eight hours'],
  },
  {
    icon: 'ph:buildings',
    title: 'VMSpark, the business',
    body: 'VMSpark sells the pipeline, and the admin app is where people judge it. Customers decide whether to trust it there. Their questions go to support from there. Investors see it in demos.',
    needs: ['Fewer “why didn’t this job sync?” tickets', 'No accidental reprocessing across a whole account', 'A demo that matches the marketing site', 'An interface the team can change without breaking'],
  },
];

// Nielsen heuristics, scored 0–10 from the code before the redesign. Each
// row names the evidence and the change that answered it.
const heuristics = [
  { n: 1, name: 'Visibility of system status', before: 4, after: 8, fix: 'Every page gets its own title and a next-step line where there is work. “Sync with ATS” became “Import from Bullhorn”, disables while it runs, and confirms with a message.', left: 'Most HTMX failures still fail silently.' },
  { n: 2, name: 'Match with the real world', before: 3, after: 8, fix: 'Titles like “AtsPayloads#show” and values like not_nil became plain words. Conditions read as sentences.', left: 'VMS and ATS are never spelled out.' },
  { n: 3, name: 'User control and freedom', before: 3, after: 7, fix: 'Every confirm works, Esc and a click outside close every dialog, and a failed reorder rolls back with a message.', left: 'There is still no undo, only confirmation.' },
  { n: 4, name: 'Consistency and standards', before: 3, after: 8, fix: 'Two sidebars, four variants, and three icon sets became one labeled sidebar, one icon family, and one table component.', left: 'A few “Sync” labels and scaffold flash messages remain.' },
  { n: 5, name: 'Error prevention', before: 2, after: 8, fix: 'Deletes with a working confirmation went from 10 of 43 to all 28. Reprocess and feed rebuilds confirm too.', left: 'Reprocess all doesn’t state how many listings it touches.' },
  { n: 6, name: 'Recognition over recall', before: 4, after: 8, fix: 'About 33 popovers and 65 hover titles went to zero. Failure reasons sit on the row.', left: 'Icon-only row buttons have no visible label.' },
  { n: 7, name: 'Flexibility and efficiency', before: 7, after: 7, fix: 'Kept the command palette, shortcuts, saved views, and resizable columns, and added a keyboard step for resizing.', left: 'The density setting dropped out of the new menus. No bulk mapping yet.' },
  { n: 8, name: 'Aesthetic and minimalist', before: 4, after: 7, fix: 'Tables holding two-row lists became simple lists. Popovers that repeated the cell were deleted.', left: 'Some dead scaffold views are still routed.' },
  { n: 9, name: 'Recovering from errors', before: 3, after: 7, fix: '“Prohibited this record from being saved” went from 11 forms to none. Errors sit under their field and are linked to it.', left: 'Adding manual jobs can lose typed rows on failure.' },
  { n: 10, name: 'Help and documentation', before: 2, after: 7, fix: 'Index pages without an empty state went from 35 to 2. Page subtitles went from 1 to 102.', left: 'No glossary or in-app docs.' },
];

// Foundations: each one is a decision about the operator, not a style choice.
const foundations = [
  { icon: 'ph:text-aa', title: 'Legible type', body: 'The body face is Atkinson Hyperlegible, designed with the Braille Institute, at a 16px base. A matching mono face sets IDs, dates, and rates so they line up.' },
  { icon: 'ph:cursor-click', title: 'Color by role', body: 'Navy marks structure. Brand blue marks anything you can click. Spark orange appears only in the brand. Red, amber, and green appear only for state.' },
  { icon: 'ph:shapes', title: 'Status labels with icons', body: 'Every status, such as Processed, Failed, or Skipped, pairs an icon with a word. Color is never the only signal.' },
  { icon: 'ph:hand-pointing', title: 'No information in tooltips', body: 'Anything an operator needs is on the page, in a note, or in the details drawer.' },
  { icon: 'ph:moon', title: 'Light and dark from one set of tokens', body: 'The theme follows the system setting and can be changed per person. Both themes pass the same contrast checks.' },
  { icon: 'ph:signpost', title: 'Page headers', body: 'Every page header has a title, one sentence of purpose, and at most one primary action. When there is work, a next-step line says what to do.' },
];

// The three token tiers. The structure is what lets a brand change land
// everywhere at once without anyone touching markup.
const tiers = [
  { icon: 'ph:circle', title: 'Primitive', body: 'Raw values with no meaning, such as <code>--blue-510</code>. Read only by the semantic tier.' },
  { icon: 'ph:target', title: 'Semantic', body: 'What a value is for, such as <code>--color-accent</code>. Light, dark, and the navy chrome map it differently.' },
  { icon: 'ph:puzzle-piece', title: 'Component', body: 'One component’s palette, such as <code>--button-bg</code>. A variant only reassigns these tokens.' },
];

// Screens used in more than one place.
const pairs = [
  {
    slug: 'desktop-needs-mapping',
    title: 'Needs mapping',
    note: 'A new page that collects every unmapped value in one inbox, sorted by how much work each list holds.',
    alt: 'The Needs mapping page: a header that reads “Values from your VMS feeds that aren’t mapped to your ATS yet. Job listings that use them can’t be fully processed until they’re mapped.”, the count 2,614 unmapped values across 8 lists, the next step “Start with facilities: 2,495 values need a value in your ATS.”, then a plain list of facilities, professions, specialties, shift details, departments, shift types, VMS sources, job types, and job statuses, each with its unmapped count and an arrow.',
  },
  {
    slug: 'desktop-inspector',
    title: 'Job details drawer',
    note: 'The drawer opens over the filtered list. It shows the key facts, then every field, then the raw feed.',
    alt: 'The job details drawer open over the job listings table: a Processed status, the title CNA Certified Nursing Assistant, facility, schedule, hours, bill rate of $37.60 an hour, dates and job ID, then Overview, All fields, and Raw data tabs above the job description, with Close and Reprocess buttons at the bottom.',
  },
];

// The phone set, alternating themes. Captions describe what is on screen.
const phones = [
  { slug: 'phone-job-listings-light', title: 'Job listings', note: 'Only the table scrolls sideways.', alt: 'The Job listings page on a phone in light mode: the purpose sentence, listing count and last import, Email CSV export and Reprocess all buttons, tabs, and the start of the table with its action buttons.' },
  { slug: 'phone-custom-rules-dark', title: 'Custom rules', note: 'Up and down buttons reorder rules without dragging.', alt: 'The Custom rules page on a phone in dark mode: a New custom rule button, filter fields for name, status, and changed field, the drag-or-arrows note, and the first two rules with up and down buttons and Active switches.' },
];

// Mistakes that cost both sides. Each one protects an operator and the business at once.
const safety = [
  { icon: 'ph:warning-circle', title: 'Confirmations that say what happens', body: 'Turbo and rails-ujs were off, so every confirm in the codebase silently did nothing. One shared dialog now handles them. Each message asks a specific question, which becomes the dialog’s title. The body says what happens next. The written rules ban “Are you sure?”' },
  { icon: 'ph:arrows-clockwise', title: 'Reprocess all states its reach', body: 'One click re-runs mapping, rules, and the ATS sync for every open job in the account. The confirm now says so and says that it runs in the background and takes minutes. The button disables while the request posts.' },
  { icon: 'ph:download-simple', title: 'Buttons say which way data moves', body: '“Sync with ATS” actually imported values from the ATS. Renaming it “Import from Bullhorn” removed a question operators had been sending to support.' },
];

// What keeps the system honest after I leave.
const checks = [
  { icon: 'ph:list-checks', title: 'bin/ui_lint', body: 'Fails on unknown classes, inline styles and scripts, tooltips, Bootstrap leftovers, hand-written widget markup, dashes in copy, and primitives read outside tier 2.' },
  { icon: 'ph:palette', title: 'bin/color_audit', body: 'Fails on any hex, RGB, or HSL value outside the token file.' },
  { icon: 'ph:circle-half', title: 'bin/contrast_check', body: 'Checks every text and control pairing against WCAG AA, in both themes.' },
  { icon: 'ph:book-open', title: 'Style guide spec', body: 'Fails if a listed token, icon, or illustration stops rendering.' },
];

// Why the widgets moved into custom elements. Sources: tasks/web-components-inventory.md
// and tasks/component-stories.md in the vm_admin repo.
const elementReasons = [
  { icon: 'ph:package', title: 'Behavior travels with the markup', body: 'A Stimulus controller only works if every view wires it with the right data attributes, and a missed one fails silently. An element carries its behavior with its tag, so any markup that renders it works.' },
  { icon: 'ph:browser', title: 'The browser first', body: 'VMSpark is an internal admin app, so I could require current browsers and use native dialogs, popovers, invoker commands, and <code>autofocus</code>. They bring the keyboard and focus behavior people already expect, and nobody has to maintain them.' },
  { icon: 'ph:brackets-angle', title: 'Rendered by Rails, styled by the system', body: 'The elements are standard web components, but they don’t use shadow DOM or build their own markup. Rails renders the markup, the design system’s CSS styles it, and HTMX can swap it in. The element only adds behavior when it connects.' },
  { icon: 'ph:seal-check', title: 'One helper per element, enforced', body: 'Views call a helper such as <code>ui_status</code> or <code>ui_dialog</code>. <code>bin/ui_lint</code> fails on a hand-written <code>&lt;vm-*&gt;</code> tag and on the old wiring, so the markup can’t drift again.' },
];

const elementBenefits = [
  { icon: 'ph:user', title: 'Operators like Nadia', body: 'Every screen behaves the same way, and screen readers hear what changed.', needs: ['Inactive looks the same on every page', 'Alerts and toasts are read out, even in dialogs', 'Dialogs and the phone menu keep focus inside', 'Filters no longer reload while they type'] },
  { icon: 'ph:code', title: 'The team', body: 'A view author says what is true and lists the parts. The element does the rest.', needs: ['One vocabulary: tone, for, commandfor', 'No data-action strings to keep in step', 'Tests check meaning, such as state="on"', 'Lint fails on hand-written widgets'] },
  { icon: 'ph:buildings', title: 'VMSpark, the business', body: 'Fewer ways for a screen to break when someone adds the next one.', needs: ['Bugs found and fixed along the way', '23 Stimulus controllers deleted', 'Routes, params, and integrations unchanged'] },
];

// The helpers behind the after code, copied from app/helpers in the vm_admin
// repo without their header comments. Excerpts keep only the methods shown.
const elementHelpers: Record<string, { file: string; lang: 'ruby' | 'erb'; code: string }[]> = {
  'status': [
    { file: 'app/helpers/status_helper.rb', lang: 'ruby', code: `module StatusHelper
  STATES = {
    on: { tone: :success, icon: :active },          # switched on: Active, Live, Open, Can sign in
    off: { tone: :neutral, icon: :inactive },       # switched off: Inactive, Off, Expired
    done: { tone: :success, icon: :done },          # finished well: Done, Saved, Connected, Hired
    pending: { tone: :neutral, icon: :pending },    # not started yet: To do, Preparing, Scheduled
    in_progress: { tone: nil, icon: :next_step },   # underway: current step, Interviewing
    working: { tone: :neutral, icon: :processing }, # the system is on it: Importing, Processing
    attention: { tone: :warning, icon: :pending },  # waiting on a person: Paused, Needs mapping
    skipped: { tone: :neutral, icon: :skipped },    # passed over on purpose
    declined: { tone: :neutral, icon: :failed },    # ended without success, not an error: Not selected
    failed: { tone: :danger, icon: :failed }        # an error someone must fix
  }.freeze

  def ui_status(text = nil, state:, **opts, &block)
    spec = STATES.fetch(state.to_sym) do
      raise ArgumentError, "unknown status state #{state.inspect}; use one of: #{STATES.keys.join(', ')}"
    end
    attrs = { state: state.to_s.dasherize, tone: spec[:tone] }.compact.merge(opts)
    content_tag("vm-status", safe_join([icon(spec[:icon]), block ? capture(&block) : text]), attrs)
  end
end` },
  ],
  'alerts': [
    { file: 'app/helpers/alert_helper.rb', lang: 'ruby', code: `module AlertHelper
  TONES = {
    accent: { icon: :info, role: "note" },
    success: { icon: :success, role: "status" },
    warning: { icon: :warning, role: "note" },
    danger: { icon: :error, role: "alert" }
  }.freeze

  def ui_alert(title = nil, tone: :accent, **opts, &block)
    spec = TONES.fetch(tone.to_sym) do
      raise ArgumentError, "unknown alert tone #{tone.inspect}; use one of: #{TONES.keys.join(', ')}"
    end
    body = safe_join([(content_tag(:p, title, class: "alert__title") if title.present?), (capture(&block) if block)].compact)
    attrs = { tone: tone.to_s, role: spec[:role] }.merge(opts)
    content_tag("vm-alert", safe_join([icon(spec[:icon]), content_tag(:div, body, class: "alert__body")]), attrs)
  end
end` },
    { file: 'app/helpers/badge_helper.rb', lang: 'ruby', code: `module BadgeHelper
  TONES = %i[neutral accent success warning danger].freeze

  def ui_badge(text = nil, tone: :neutral, icon: nil, **opts, &block)
    tone = tone.to_sym
    raise ArgumentError, "unknown badge tone #{tone.inspect}; use one of: #{TONES.join(', ')}" unless TONES.include?(tone)

    label = block ? capture(&block) : text
    content_tag("vm-badge", safe_join([(icon(icon) if icon), label].compact), { tone: }.merge(opts))
  end

  # "N job failures" on a mapping row: shown only when some listings failed.
  def job_failures_badge(count)
    ui_badge pluralize(count, "job failure"), tone: :danger, icon: :warning if count.to_i.positive?
  end
end` },
  ],
  'dialogs': [
    { file: 'app/helpers/dialog_helper.rb (excerpt)', lang: 'ruby', code: `module DialogHelper
  SIZES = { md: nil, wide: "dialog--wide" }.freeze

  def ui_dialog(id:, size: :md, drawer: false, open: false, transient: false, return_focus: nil, swap_target: nil,
                **dialog_attrs, &block)
    raise ArgumentError, "unknown dialog size #{size.inspect}; use one of: #{SIZES.keys.join(', ')}" unless SIZES.key?(size.to_sym)

    classes = ["dialog", SIZES[size.to_sym], ("dialog--drawer" if drawer), dialog_attrs.delete(:class)].compact.join(" ")
    element_attrs = { open: open || nil, transient: transient || nil, "return-focus": return_focus, "swap-target": swap_target }.compact
    content_tag("vm-dialog", element_attrs) do
      content_tag(:dialog, capture(&block), { id:, class: classes, closedby: "any" }.merge(dialog_attrs))
    end
  end

  def ui_dialog_close(text = nil, label: "Close", variant: nil, **opts)
    target = opts.delete(:for) or raise ArgumentError, "ui_dialog_close needs for: (the dialog id)"
    attrs = { commandfor: target, command: "close" }.merge(opts)
    if text
      ui_button(text, variant: variant || :secondary, **attrs)
    else
      ui_button(nil, icon: :close, variant: variant || :quiet, size: :sm, label:, **attrs)
    end
  end
  # ...
end` },
  ],
  'menu': [
    { file: 'app/helpers/menu_helper.rb', lang: 'ruby', code: `module MenuHelper
  def ui_menu(trigger, id:, icon: :collapse, button_class: "button button--quiet", &block)
    button = content_tag(:button, safe_join([trigger, (icon(icon, size: :sm) if icon)].compact),
                         type: "button", class: button_class, popovertarget: id)
    list = content_tag(:ul, capture(&block), id:, class: "menu__list", role: "list", popover: "")
    content_tag("vm-menu", button + list)
  end

  def ui_menu_item(text, icon: nil, tone: nil, **attrs)
    classes = class_names("menu__item", attrs.delete(:class), "menu__item--danger": tone == :danger)
    content_tag(:button, safe_join([(icon(icon) if icon), content_tag(:span, text)].compact),
                type: "button", class: classes, **attrs)
  end
end` },
  ],
  'drawer': [
    { file: 'app/helpers/dialog_helper.rb (excerpt)', lang: 'ruby', code: `module DialogHelper
  # The app sidebar: a column at 1024px and up, a modal drawer from the start
  # edge below that. The same <vm-dialog> + <dialog> as ui_dialog, without the
  # .dialog box styles (the sidebar styles itself). Open it with
