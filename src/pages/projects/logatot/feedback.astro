---
import Breadcrumbs from '~/components/patterns/Breadcrumbs.astro';
import ProjectLayout from '~/layouts/ProjectLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import Metric from '~/components/patterns/Metric.astro';
import Plate from '~/components/patterns/Plate.astro';
import type { ImageMetadata } from 'astro';

/**
 * Companion to /projects/logatot/: the post-launch round, where an open-ended
 * questionnaire and a screen-by-screen audit turned into design rules.
 * Source write-up: notes/logatot/logatot.md. Before/after pairs were captured
 * with the same seed data at 1280–1440px.
 *
 * Respondent counts and quotes are deliberately absent until Josh supplies
 * real ones; don't add placeholder numbers or invented quotes.
 */

const title = 'Logatot: changes from user feedback | Joshua Briley';
const description =
  'How a Logatot user questionnaire led to a rebuilt menu calendar, a one-white-card-per-page rule, and a consistency pass.';

const shots = import.meta.glob<{ default: ImageMetadata }>(
  '../../../assets/projects/logatot/feedback/*.png',
  { eager: true },
);
const shot = (slug: string) => shots[`../../../assets/projects/logatot/feedback/${slug}.png`].default;

// General questions on purpose: nothing names a screen, so people could raise
// problems we didn't know to ask about.
const questions = [
  'What do you use Logatot for most in a typical week?',
  'What’s the most frustrating part of using it?',
  'Has anything on screen ever done something you didn’t expect?',
  'Is there anything you still check on paper or somewhere else, even though Logatot has it?',
  'If you could change one thing, what would it be?',
];

const themes = [
  { icon: 'ph:calendar-dots', title: 'The menu calendar was hard to read', body: 'Providers couldn’t tell what was being served or whether it met food-program rules.', href: '#menu' },
  { icon: 'ph:stack', title: 'Pages had no clear focus', body: 'Every panel was a white card, so everything carried the same weight.', href: '#surfaces' },
  { icon: 'ph:shapes', title: 'The interface was inconsistent', body: 'Screens had drifted from the component library, and filters looked like buttons.', href: '#components' },
];

const menuFound = [
  'Three lines per meal, so a normal day filled the screen',
  'An “approved” badge on every meal, so it meant nothing',
  'Snacks sorted before breakfast, so days didn’t line up',
  'Failing meals looked the same as approved ones',
  'Thirty-five “…” buttons always visible',
];

const menuChanged = [
  { icon: 'ph:warning', title: 'Only problems get a marker', body: 'A meal that fails CACFP rules gets a red warning. Approval moved into the meal detail.' },
  { icon: 'ph:sort-ascending', title: 'Fixed meal-time order', body: 'Every day lines up, breakfast through evening.' },
  { icon: 'ph:grid-four', title: 'The week is a board', body: 'Meal times down the side, days across the top. On phones, one list per day.' },
  { icon: 'ph:squares-four', title: 'The month is one compact grid', body: 'One-line chips, repeats collapsed to “×3,” past days dimmed.' },
  { icon: 'ph:egg', title: 'Meal type isn’t color alone', body: 'Each chip has a meal-type icon and screen-reader text.' },
  { icon: 'ph:cursor-click', title: 'Details in a dialog', body: 'Status, ingredients, and actions open on click. The “…” buttons appear only on hover or focus.' },
];

const tiers = [
  { name: 'Lifted', body: 'White with a soft shadow, for the page’s main content only.' },
  { name: 'Recessed', body: 'A tinted panel for filters, quick-add forms, and secondary details.' },
  { name: 'Canvas', body: 'The background, for headings and light controls.' },
];

const pages = [
  { page: 'Children', lifted: 'The roster', recessed: 'The quick-add form.' },
  { page: 'Expenses', lifted: 'The expense table', recessed: 'One totals strip, replacing three cards.' },
  { page: 'Calendar', lifted: 'The selected day’s agenda', recessed: 'The month picker and this week’s events.' },
  { page: 'Calendar event', lifted: 'Date, time, repeat, and child', recessed: 'Nothing; the title and actions moved into the page header.' },
  { page: 'Child profile', lifted: 'The header card, with health tiles inside it', recessed: 'Contacts, attendance, billing, and linked apps.' },
  { page: 'Account', lifted: 'The header with contact info', recessed: 'Team, billing, reminders, and sharing.' },
];

const controls = [
  { icon: 'ph:hand-pointing', name: 'Button', job: 'Does something', look: 'A filled pill.' },
  { icon: 'ph:arrow-square-right', name: 'Navigation', job: 'Goes somewhere', look: 'A segmented control.' },
  { icon: 'ph:funnel-simple', name: 'Filter', job: 'Narrows what you see', look: 'A checkbox chip.' },
];

const componentChanges = [
  { icon: 'ph:rows', title: 'One page structure', body: 'Back link, title and primary action, section navigation, filters, then content, enforced by the shared layout.' },
  { icon: 'ph:table', title: 'One table system', body: 'Typed columns format themselves, and rows stack into cards on phones.' },
  { icon: 'ph:textbox', title: 'One form field style', body: 'A soft border, white fill, and blue focus ring.' },
];

const a11y = [
  'Color-coded categories also get an icon and text',
  'Recessed-panel text moved from gray-500 (4.08:1) to gray-600 (6.37:1)',
  'Off-state filter chips moved from 4.37:1 to gray-600',
  'Filter state comes from real checkboxes and aria-pressed',
  'Dark-mode recessed panels got darker to stay distinct',
  'Links underline on hover and focus',
];

const lessons = [
  { title: 'Components aren’t a system until they’re the only option', body: 'What lasted was deleting the alternatives.' },
  { title: 'Open questions find problems a task test misses', body: 'We never asked about the calendar or the white cards. People raised them anyway.' },
  { title: 'Show exceptions, not every status', body: 'Removing the approved badge made the failing meal stand out.' },
  { title: 'Hierarchy needs a rule people can follow', body: '“One white card per page” helps the next person; “make it stand out” doesn’t.' },
];

const edges = [
  { icon: 'ph:ruler', title: 'Not measured with users yet', body: 'Height savings are measured; speed isn’t. Next is resending the questionnaire and timing one task before and after.' },
  { icon: 'ph:selection', title: 'Softer field borders on purpose', body: 'Field borders are about 1.5:1, below WCAG’s 3:1. Checkboxes keep 3:1 because their edge shows their state.' },
  { icon: 'ph:cookie', title: 'Snacks saved with the wrong meal time', body: 'The calendar sorts around it; the add-meal flow still needs the fix.' },
  { icon: 'ph:layout', title: 'Not every page is on the new tiers', body: 'The parent dashboard and the expense location and category pages still use the old all-white panels.' },
];
---

<ProjectLayout title={title} description={description}>

  <section class="project-opening">
    <Container width="wide">
      <Breadcrumbs items={[{ href: '/projects/', label: 'Projects' }, { href: '/projects/logatot/', label: 'Logatot' }]} current="User feedback" />
      <div class="project-identity"><p>Logatot</p><span>Follow-up · Changes from user feedback</span></div>
      <h1 class="project-title">What users told us after launch, <em>and what we changed.</em></h1>
      <div class="project-introduction">
        <p>
          An open-ended questionnaire surfaced three problems. I audited every affected
          screen and turned each fix into a written rule backed by a shared component.
        </p>
      </div>
      <dl class="project-facts">
        <div><dt>Method</dt><dd>Open-ended questionnaire, then a screen-by-screen audit</dd></div>
        <div><dt>When</dt><dd>November 2026</dd></div>
        <div><dt>My role</dt><dd>Design and front-end</dd></div>
      </dl>
      <dl class="project-figures">
        <div><dt>⅓</dt><dd>less height for two weeks of menus<span>About 820px to 540px at 1440 wide</span></dd></div>
        <div><dt>⅔</dt><dd>less scrolling on the voiceboard for a full day<span>3,849px to 1,318px at 1280 wide</span></dd></div>
      </dl>
    </Container>
  </section>

  <Section tone="paper" padding="default" id="questions" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">What we asked</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              No question named a screen, so people could raise problems we didn’t know about.
            </p>
          </div>

          <ol class="mt-10 space-y-4 measure">
            {questions.map((q, i) => (
              <li class="flex gap-4 text-lg leading-snug text-ink">
                <span class="font-mono text-sm text-ink-muted pt-1" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span>{q}</span>
              </li>
            ))}
          </ol>

          <div class="mt-10 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              For each theme, I captured every affected screen and listed what had gone wrong
              in the markup and tokens.
            </p>
          </div>

          <div class="mt-12">
            <Heading level={3} visual="h2" class="mb-6">Themes</Heading>
            <ul class="grid gap-x-8 gap-y-8 sm:grid-cols-2">
              {themes.map((t) => (
                <li class="pt-5">
                  <Icon name={t.icon} size={24} class="mb-3 text-ink-muted" />
                  <Heading level={4} visual="h3" tone="ink" class="mb-1.5"><a href={t.href} class="hero-link">{t.title}</a></Heading>
                  <Text size="sm" tone="muted">{t.body}</Text>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="menu" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Menu calendar</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              The calendar should show what’s being served and what will fail reimbursement.
              It showed neither.
            </p>
          </div>

          <div class="mt-12">
            <Heading level={3} visual="h2" class="mb-6">What the audit found</Heading>
            <ul class="measure space-y-3">
              {menuFound.map((item) => (
                <li class="flex items-start gap-3 text-ink-muted leading-relaxed">
                  <Icon name="ph:minus" size={14} class="mt-1.5 shrink-0 text-ink-muted" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-12">
            <Heading level={3} visual="h2" class="mb-6">What changed</Heading>
            <ul class="grid gap-x-8 gap-y-8 sm:grid-cols-2">
              {menuChanged.map((c) => (
                <li class="pt-5">
                  <Icon name={c.icon} size={24} class="mb-3 text-ink-muted" />
                  <Heading level={4} visual="h3" tone="ink" class="mb-1.5">{c.title}</Heading>
                  <Text size="sm" tone="muted">{c.body}</Text>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Container>

    <Container width="wide" class="mt-16">
      <div class="grid gap-x-8 gap-y-14 md:grid-cols-2">
        <Plate
          size="half"
          title="Week view, before"
          caption="Three lines per meal, snacks before breakfast."
          src={shot('menu-week-before')}
          alt="The old Logatot menu calendar week view: seven separate day cards, each listing meals in three lines with the name, the meal type such as Snack AM or Lunch, and a green award icon. Snacks appear above breakfast on most days."
        />
        <Plate
          size="half"
          title="Week view, after"
          caption="Failing breakfasts carry a red warning."
          src={shot('menu-week-after')}
          alt="The new week view: one grid with Breakfast, Morning snack, Lunch, and Dinner rows and Sunday to Saturday columns. Each meal is a one-line chip, repeated snacks show ×2 or ×3, today’s column is tinted, and every breakfast chip has a red warning triangle."
        />
        <Plate
          size="half"
          title="Month view, before"
          caption="Thirty-five cards, each with a “…” button."
          src={shot('menu-month-before')}
          alt="The old month view: a grid of separate white day cards, each listing meals in three lines with meal type and an award icon, and a “…” button on every day."
        />
        <Plate
          size="half"
          title="Month view, after"
          caption="One grid of one-line chips."
          src={shot('menu-month-after')}
          alt="The new month view: a single grid where each day lists one-line meal chips in meal-time order, each with a small meal-type icon. A legend shows breakfast, snack, lunch, and dinner icons. Past days are dimmed, today is tinted, and breakfasts carry red warning triangles."
        />
      </div>
    </Container>

    <Container width="content" class="mt-16">
      <div class="grid gap-8 py-8 sm:grid-cols-2">
        <Metric before="3 lines" value="1 line" label="per meal on the calendar" caption="Name only; status moved to the detail dialog" />
        <Metric before="~820px" value="~540px" label="height of the same two weeks of menus" caption="Measured at 1440 wide" />
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="surfaces" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">One focus per page</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Every panel had become a white card, so nothing stood out. The new rule: each
              page gets one white surface, for the thing the page is for.
            </p>
          </div>

          <dl class="mt-10 grid gap-x-8 gap-y-6 sm:grid-cols-3">
            {tiers.map((t) => (
              <div class="pt-4">
                <dt class="font-medium text-ink">{t.name}</dt>
                <dd class="mt-1 text-sm text-ink-muted leading-relaxed">{t.body}</dd>
              </div>
            ))}
          </dl>

          <div class="mt-12">
            <Heading level={3} visual="h2" class="mb-6">Applied page by page</Heading>
            <ul class="divide-y divide-line">
              {pages.map((p) => (
                <li class="py-4 grid gap-1 sm:grid-cols-3 sm:gap-6">
                  <p class="font-medium text-ink">{p.page}</p>
                  <p class="text-sm text-ink-muted leading-relaxed sm:col-span-2"><span class="text-ink">White card:</span> {p.lifted}. <span class="text-ink">Recessed:</span> {p.recessed}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Container>

    <Container width="wide" class="mt-16">
      <div class="grid gap-x-8 gap-y-14 md:grid-cols-2">
        <Plate
          size="half"
          title="Child profile, before"
          caption="Six white cards of equal weight."
          src={shot('child-profile-before')}
          alt="The old child profile for Ava Johnson: a white header card, then separate white cards for Health, Attendance, Billing, Legal Guardians, and Authorized Pickups."
        />
        <Plate
          size="half"
          title="Child profile, after"
          caption="Health in the header card, the rest recessed."
          src={shot('child-profile-after')}
          alt="The new child profile: one white header card holding the photo, name, and a row of four health tiles. Below it, Legal Guardians, Authorized Pickups, Attendance, and Billing sit on tinted recessed panels."
        />
        <Plate
          size="half"
          title="Expenses, before"
          caption="Three summary cards compete with the table."
          src={shot('expenses-before')}
          alt="The old Expenses page: three white cards for This month, This year, and Receipts above a white expense table."
        />
        <Plate
          size="half"
          title="Expenses, after"
          caption="One totals strip; the table is the only white surface."
          src={shot('expenses-after')}
          alt="The new Expenses page: This month, This year, and Receipts in a single tinted strip above the white expense table."
        />
        <Plate
          size="half"
          title="Calendar event, before"
          caption="Title buried in a card, actions behind “…”."
          src={shot('calendar-event-before')}
          alt="The old calendar event page: a back link, then a white card with the date and a row reading All Day, Sophia’s Birthday, Sophia Ramirez, and a “…” button."
        />
        <Plate
          size="half"
          title="Calendar event, after"
          caption="Title and actions in the page header."
          src={shot('calendar-event-after')}
          alt="The new calendar event page: the title Sophia’s Birthday as the page heading with Edit and Delete buttons beside it, then one white panel showing Nov 23rd, 2026, All day, and Sophia Ramirez."
        />
      </div>
    </Container>

  </Section>

  <Section tone="paper" padding="default" id="voiceboard" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Compact Voiceboard</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              With twelve children, a full day ran about four screens, but providers mostly
              ask where everyone is and whether each child has had the basics. I added a
              Compact and Detailed switch.
            </p>
          </div>

          <ul class="mt-12 grid gap-x-8 gap-y-8 sm:grid-cols-2">
            <li class="pt-5">
              <Icon name="ph:squares-four" size={24} class="mb-3 text-ink-muted" />
              <Heading level={3} visual="h3" tone="ink" class="mb-1.5">Compact tiles</Heading>
              <Text size="sm" tone="muted">Avatar, name, status, and one chip per type of moment logged today.</Text>
            </li>
            <li class="pt-5">
              <Icon name="ph:eye" size={24} class="mb-3 text-ink-muted" />
              <Heading level={3} visual="h3" tone="ink" class="mb-1.5">Missing chips are the signal</Heading>
              <Text size="sm" tone="muted">A child with no afternoon nap chip has a shorter row.</Text>
            </li>
            <li class="pt-5">
              <Icon name="ph:columns" size={24} class="mb-3 text-ink-muted" />
              <Heading level={3} visual="h3" tone="ink" class="mb-1.5">Three or four per row</Heading>
              <Text size="sm" tone="muted">Instead of two tall cards. Absent children get one recessed tile.</Text>
            </li>
            <li class="pt-5">
              <Icon name="ph:toggle-left" size={24} class="mb-3 text-ink-muted" />
              <Heading level={3} visual="h3" tone="ink" class="mb-1.5">Compact by default</Heading>
              <Text size="sm" tone="muted">Remembered per device. Detailed is one tap away.</Text>
            </li>
          </ul>
        </div>
      </div>
    </Container>

    <Container width="content" class="mt-16">
      <Heading level={3} visual="h2" class="mb-6">Same day, same twelve children, same scale</Heading>
      <div class="grid grid-cols-2 gap-x-6 sm:gap-x-10 items-start">
        <Plate
          size="half"
          title="Detailed"
          caption="3,849px tall at 1280 wide."
          src={shot('voiceboard-detailed')}
          alt="The detailed voiceboard for a full day: twelve tall child cards in two columns, each listing health check, diaper, nap, snack, and activity entries with times and notes, running about four screens long before Provider time and Employee shifts."
        />
        <Plate
          size="half"
          title="Compact"
          caption="1,318px tall."
          src={shot('voiceboard-compact')}
          alt="The compact voiceboard for the same day: twelve short tiles in three columns, each with an avatar, name, pickup time, and a row of small colored icon chips for the moments logged. Noah Patel appears as a single absent tile, and Provider time and Employee shifts panels sit just below."
        />
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="components" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Shared components</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              The components existed, but not every screen used them. Filters looked like
              navigation, and each report built its own table.
            </p>
          </div>

          <div class="mt-12">
            <Heading level={3} visual="h2" class="mb-6">Control types</Heading>
            <ul class="grid gap-x-8 gap-y-8 sm:grid-cols-3">
              {controls.map((c) => (
                <li class="pt-5">
                  <Icon name={c.icon} size={24} class="mb-3 text-ink-muted" />
                  <Heading level={4} visual="h3" tone="ink" class="mb-1">{c.name}</Heading>
                  <p class="text-sm text-ink mb-1.5">{c.job}</p>
                  <Text size="sm" tone="muted">{c.look}</Text>
                </li>
              ))}
            </ul>
            <Text size="sm" tone="muted" class="mt-6 measure">
              Every filter moved to one chip, and the old variants were deleted.
            </Text>
          </div>

          <ul class="mt-12 space-y-10">
            {componentChanges.map((c) => (
              <li class="pt-5">
                <Icon name={c.icon} size={24} class="mb-3 text-ink-muted" />
                <Heading level={3} visual="h3" tone="ink" class="mb-1.5">{c.title}</Heading>
                <Text size="sm" tone="muted" class="measure">{c.body}</Text>
              </li>
            ))}
          </ul>

          <div class="mt-12 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Typed cells exposed a bug the hand-built table had hidden: the attendance report
              sometimes showed an entry under the next child.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="accessibility" class="scroll-mt-24">
    <Container width="content">
      <Heading level={2} visual="h2" tone="ink" class="mb-3">Accessibility fixes</Heading>
      <Text size="lg" tone="muted" class="measure mb-10">
        The audit found these, mostly where the recessed surface changed contrast.
      </Text>
      <ul class="grid gap-x-10 gap-y-4 md:grid-cols-2">
        {a11y.map((item) => (
          <li class="flex items-start gap-2 text-sm text-ink-muted leading-relaxed">
            <Icon name="ph:check" size={14} class="mt-0.5 shrink-0 text-accent" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="lessons" class="scroll-mt-24">
    <Container width="content">
      <Heading level={2} visual="h2" tone="ink" class="mb-10">What I learned</Heading>
      <ul class="grid gap-x-10 gap-y-10 md:grid-cols-2">
        {lessons.map((l) => (
          <li class="pt-5">
            <Heading level={3} visual="h3" tone="ink" class="mb-1.5">{l.title}</Heading>
            <Text size="sm" tone="muted">{l.body}</Text>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="edges" class="scroll-mt-24">
    <Container width="content">
      <Heading level={2} visual="h2" tone="ink" class="mb-10">Limitations</Heading>
      <ul class="grid gap-x-10 gap-y-10 md:grid-cols-2">
        {edges.map((e) => (
          <li class="pt-5">
            <Icon name={e.icon} size={24} class="mb-3 text-ink-muted" />
            <Heading level={3} visual="h3" tone="ink" class="mb-1.5">{e.title}</Heading>
            <Text size="sm" tone="muted">{e.body}</Text>
          </li>
        ))}
      </ul>
      <div class="mt-16 flex flex-wrap gap-x-10 gap-y-4">
        <a href="/projects/logatot/" class="editorial-link">
          Back to the Logatot case study <span aria-hidden="true" data-link-arrow="up-left">↖</span>
        </a>
        <a href="/projects/logatot/gallery/" class="editorial-link">
          More before and after screens <span aria-hidden="true" data-link-arrow="right">→</span>
        </a>
      </div>
    </Container>
  </Section>

</ProjectLayout>
