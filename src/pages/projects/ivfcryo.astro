import type { ImageMetadata } from 'astro';

const title = 'IVFCRYO | Joshua Briley';
const description =
  "Case study: designing the app IVFCRYO uses to ship frozen embryos between clinics, and working with engineers on the tracking system behind it, so five different people can confirm they're ready before a shipment starts. Plus the 2026 redesign of the app and its public site, scored against Nielsen's heuristics on desktop and mobile.";


// Receipts split by ownership on purpose — two "owned" columns, one "partnered"
// column, one outcomes column — so the boundary reads at a glance.
const proof = [
  { label: 'Design · owned', items: ['Stakeholder research & synthesis', 'Five-party workflow modeling', 'Information architecture', 'Customer, staff, and public tracking views', 'Readiness check before scheduling'] },
  { label: 'Front end · owned', items: ['Accessible component system', 'Progressive enhancement', 'Forms that help people fix mistakes', 'Status shown with text and icons, not color alone'] },
  { label: 'Backend · partnered', items: ['Shaped the Rails domain model', 'Specced lifecycle + readiness states', 'Defined integration boundaries', 'Set telemetry + alert requirements'] },
  { label: 'Redesign · 2026', items: ['Front-end audit + design tokens', 'Shared components + style guide', 'Heuristic audit, 5.3 → 8.8', 'Desktop + phone, public + signed in', 'Public marketing site'] },
];


// The five independent organizations a single shipment has to line up. The
// interviews were unanimous: this — not the drive — is the hard part.
const parties = [
  { icon: 'ph:user', title: 'Patient', body: 'Authorizes the transfer, provides identity and records, completes forms and payment. The app keeps them from having to coordinate two labs themselves.' },
  { icon: 'ph:buildings', title: 'Sending clinic', body: 'Identifies, prepares, and releases the specimens, and names a responsible lab contact, not the front desk.' },
  { icon: 'ph:buildings', title: 'Receiving clinic', body: 'Confirms intake requirements, staffs qualified people, inspects, and accepts the specimens into storage.' },
  { icon: 'ph:airplane-tilt', title: 'Dedicated courier', body: 'Carries the sealed unit directly between facilities, no unrelated stops, with acknowledged chain-of-custody handoffs.' },
  { icon: 'ph:package', title: 'IVFCRYO', body: 'Provides the shipping unit and IVFCRYO-Sense monitoring, coordinates the logistics, and holds the case together.' },
];

// The physical chain of custody, with a named-contact acknowledgment at every
// handoff — "chain of custody does not end with a delivery scan at the front desk."
const custody = [
  { icon: 'ph:package', title: 'Prepare & release', body: 'IVFCRYO ships the unit with an IVFCRYO-Sense tracker inside; the sending lab loads the specimens and a named contact releases them.' },
  { icon: 'ph:airplane-tilt', title: 'Courier pickup', body: 'A dedicated medical courier accepts custody from the named lab contact and hand-carries the sealed unit. Both sides confirm the handoff.' },
  { icon: 'ph:thermometer', title: 'Delivery & inspection', body: 'The receiving lab inspects the unit and records a calibrated temperature at specimen-storage level before taking custody.' },
  { icon: 'ph:seal-check', title: 'Accept & close', body: 'Qualified staff accept the specimens into storage and the record closes on acknowledgment. A delivery scan alone does not close it.' },
];

// The readiness gate: each responsible party clears a checkpoint before a courier
// can be scheduled. All three interviewees named this as the #1 change to make.
const readinessGate = [
  { party: 'Patient', check: 'Authorizations, identity, and payment complete' },
  { party: 'Sending clinic', check: 'Release approved, specimens prepared, contact named' },
  { party: 'Receiving clinic', check: 'Acceptance approved, intake requirements confirmed, staff scheduled' },
  { party: 'Courier', check: 'Route and timing confirmed as feasible' },
  { party: 'Equipment', check: 'Shipping unit available and suitable for the duration' },
];

// The information architecture, forked by role off one shared home.
const customerFlow = [
  { label: 'Shipping list', note: 'Home. Active + past shipments, readiness + overdue alerts.' },
  { label: 'New shipment', note: 'Sender, receiver, specimen, live carrier pricing, CRYO Shield tier.' },
  { label: 'Readiness view', note: 'What each party still owes before it can be scheduled.' },
  { label: 'Active shipment', note: 'Read-only tracking and sensor telemetry.' },
  { label: 'Receiving customers', note: 'Saved delivery contacts.' },
  { label: 'Profile', note: 'Billing, address, cancel account.' },
];

const adminFlow = [
  { label: 'Shipping list', note: 'Every active + past shipment across clients, by readiness state.' },
  { label: 'Active shipment', note: 'Edit, cancel, change status, notify, open an incident.' },
  { label: 'Customer list', note: 'Filter, sort, open a client.' },
  { label: 'Customer detail', note: 'All orders for one client.' },
  { label: 'Equipment inventory', note: 'Units, monitoring, maintenance and replacement flags.' },
  { label: 'Add customer', note: 'Creates the account, emails credentials.' },
];

// Front-end design decisions that made the correct path easier than the wrong one.
const recovery = [
  { icon: 'ph:list-checks', label: 'Structured records over free text' },
  { icon: 'ph:map-pin', label: 'Geocoded address validation' },
  { icon: 'ph:warning-circle', label: 'Inline validation, recoverable errors' },
  { icon: 'ph:eye', label: 'Text, icon, and shape, never color alone' },
  { icon: 'ph:target', label: 'Focus managed on visibility change' },
  { icon: 'ph:megaphone', label: 'Live-region status announcements' },
  { icon: 'ph:handshake', label: 'Explicit acknowledgment at every handoff' },
  { icon: 'ph:camera', label: 'Immediate, structured incident capture' },
];

// The tiered alert model — a design requirement I handed engineering, and the fix
// for the alert fatigue Daryl and Sasha both named.
const alertTiers = [
  { level: 'Normal', tone: 'ok', body: 'Within expected range. Logged, surfaced quietly, no one paged.' },
  { level: 'Early warning', tone: 'warn', body: 'A trend moving toward a threshold. Closer monitoring, a call to the courier.' },
  { level: 'Required action', tone: 'warn', body: 'A defined threshold crossed. The owner is notified and must respond.' },
  { level: 'Emergency', tone: 'crit', body: 'A critical excursion. The pre-assigned escalation path fires.' },
];

// The integration boundaries we drew together, each isolated behind its own
// service object so vendor quirks never leaked into the interface I owned.
const integrations = [
  { icon: 'ph:thermometer-cold', name: 'IVFCRYO-Sense', role: 'GPS, internal + ambient temp, humidity, pressure' },
  { icon: 'ph:barcode', name: 'ShipEngine', role: 'Multi-carrier rates and labels' },
  { icon: 'ph:airplane-tilt', name: 'Dedicated courier', role: 'Direct medical hand-carry, no sorting hubs' },
  { icon: 'ph:envelope-simple', name: 'SendGrid', role: 'Tiered email notifications' },
  { icon: 'ph:device-mobile', name: 'Twilio', role: 'SMS alerts, off-screen' },
  { icon: 'ph:lock-key', name: 'Devise + 2FA', role: 'Auth for medical logistics' },
];

// The four-lens measurement frame Don and Daryl both described — the design's
// definition of success, not just a headline number.
const metricLenses = [
  { lens: 'Safety', items: ['Temperature excursions', 'Monitoring gaps', 'Chain-of-custody exceptions', 'Incomplete receiving records'] },
  { lens: 'Reliability', items: ['On-time pickups + deliveries', 'Rescheduled shipments', 'Shipments started without full readiness'] },
  { lens: 'Efficiency', items: ['Order-to-readiness time', 'Manual follow-ups per case', 'Exception resolution time'] },
  { lens: 'Experience', items: ['Status inquiries', 'Complaints', 'Stage-appropriate updates delivered'] },
];

// The edges — honest, not exhaustive. Both trace back to the same root cause:
// live telemetry from more than one source, polled continuously, with no
// shared cadence or labeling rule set early enough to prevent it.
const edges = [
  {
    icon: 'ph:speaker-high',
    title: 'Screen reader updates are too frequent',
    body: 'The tracker checks in every sixty seconds with temperature, location, humidity, and more. That is fine to look at quietly on screen. For someone using a screen reader, each update gets read aloud, and the next one starts before the last one finishes. There is a setting to slow it down, but a person has to find it first, and the fast pace is still the default. If I revisit this, I would change the default instead of just adding a setting.',
  },
  {
    icon: 'ph:tag',
    title: 'Carriers announced with the same label',
    body: 'Once a shipment used more than one carrier, both got announced with identical wording. A sighted user can tell them apart by where they sit on screen. Someone using a screen reader cannot tell which carrier currently has the shipment. That only surfaced because a screen reader user tested the multi-carrier path. First thing I would fix: name each carrier explicitly in that wording.',
  },
];

// The lifecycle model I specced with engineering. I defined the states, the
// readiness gate, and the alert severities the design required; engineering owned
// the Rails implementation. Showing it here is a record of that collaboration, not
// a claim that I wrote the backend.
const modelSnippet = `# app/models/shipment.rb  —  states + requirements I specced with engineering
# A shipment can't be scheduled until every party acknowledges readiness.
# That gate was the single change all three interviewees said they'd make first.
class Shipment < ApplicationRecord
  # "Requested" and "provisional" are NOT "confirmed." Conflating them is what
  # put couriers on the road before a clinic had released.
  enum status: { draft: 0, awaiting_readiness: 1, ready: 2,
                 scheduled: 3, in_transit: 4, delivered: 5,
                 accepted: 6, closed: 7, canceled: 8 }

  has_many :readiness_checks     # one per responsible party
  has_one  :cryo_shield_coverage # declared value + protection tier
  has_one  :shipment_tracker     # IVFCRYO-Sense: temp, GPS, humidity
  has_many :sensor_readings
  has_many :custody_events       # named contact + acknowledgment
  has_many :incidents
  has_many :notifications

  # Scheduling is gated, not assumed. "Sent" is not "approved."
  def schedulable?
    readiness_checks.all?(&:acknowledged?)
  end

  # Alerts are tiered so a normal fluctuation never pages like a critical
  # excursion — the office team stops trusting a channel that cries wolf.
  def record(reading)
    sensor_readings << reading
    case reading.severity          # :normal, :warning, :critical
    when :warning  then CryoAlertJob.perform_async(id, :warning)
    when :critical then CryoAlertJob.perform_async(id, :critical)
    end
  end
end`;

// The annotated wireframes render live in src/ so Astro can process them
// (anything under public/ is copied verbatim, never optimized). Source files are
// 3200px PNGs; `<Image>` emits sized WebP from these at build time.
const annotatedShots = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/projects/ivfcryo/wires-and-flows/*.png',
  { eager: true },
);
const annotated = (slug: string) =>
  annotatedShots[`../../assets/projects/ivfcryo/wires-and-flows/${slug}.png`].default;

// The bare sketch + wireframe SVGs stay in public/: Astro passes SVGs through
// untransformed either way, so moving them would buy nothing.
const art = (slug: string) => `/images/projects/ivfcryo/wires-and-flows/${slug}`;

// Four screens carry the argument, so they get full plates. The `note` is the
// subtitle written on the artwork itself, not a fresh gloss on it.
const plates = [
  {
    slug: '03-shipments-index',
    index: '03',
    title: 'Shipments index',
    note: 'The main workspace for staff, filtered first by readiness state.',
    alt: 'Annotated wireframe of the shipments index: a filter bar, status tabs, and a list of shipment cards, with six numbered callouts explaining why status lives in the URL and why cards replaced table rows.',
  },
  {
    slug: '04-new-shipment',
    index: '04',
    title: 'New shipment',
    note: 'A form with about forty fields, split into numbered sections, with a live price, declared value, and a way forward from every error.',
    alt: 'Annotated wireframe of the new-shipment form, broken into seven numbered sections from service selection to insurance, with a live price quote pinned beside it and six callouts covering quote recalculation, contact reuse, and notification defaults.',
  },
  {
    slug: '05-shipment-detail',
    index: '05',
    title: 'Shipment detail',
    note: 'Shows where the shipment is and whether it is still at the right temperature.',
    alt: 'Annotated wireframe of the shipment detail page: a live position map above sensor readings for temperature, humidity, and battery, then two parallel tracking timelines, with callouts explaining why telemetry outranks logistics and why the two legs stay unmerged.',
  },
  {
    slug: '06-public-tracking',
    index: '06',
    title: 'Public tracking',
    note: 'The unauthenticated view sent to recipients in notification email and SMS. No account, no sidebar, no raw telemetry.',
    alt: 'Annotated wireframe of the public tracking page: a plain-language status line, a four-step progress track, a live position map, and a staffed phone number in the footer, with callouts explaining why there is no login and why raw telemetry is withheld.',
  },
];


const flows = [
  {
    slug: '11-flow-authentication',
    title: 'Authentication and account recovery',
    note: 'Every failed step, such as a wrong verification code, offers a way to recover without calling support.',
    alt: 'Flow diagram of authentication and account recovery. A visitor branches on whether they have an account, through sign-in, admin activation, a user-chosen email or SMS verification channel, and six-digit code entry. A failed code offers resend, backup code, or password reset, and a final admin check routes to either the admin or client view. Five numbered design notes sit alongside, and password recovery runs as a separate track underneath.',
  },
  {
    slug: '12-flow-create-shipment',
    title: 'Creating a shipment',
    note: 'The highest-risk path in the product: nine sections and one submit, with validation that blocks bookings that cannot be fulfilled.',
    alt: 'Flow diagram of the shipment creation path. Service selection resolves a live price quote or a contact-for-quote branch, then runs through date, package, pickup and delivery contacts, notification preferences, insurance, and agreement. Failed validation returns to the offending field with form state preserved, and a successful submit forks into a confirmation email and the admin fulfillment queue. Six numbered design notes sit alongside.',
  },
];

// Plates and flows are placed beside the argument they support rather than
// collected into one gallery, so these look them up by slug at the point of use.
const plate = (slug: string) => plates.find((p) => p.slug === slug)!;
const flow = (slug: string) => flows.find((f) => f.slug === slug)!;

// ── 2026 redesign ────────────────────────────────────────────────────────────
// Screenshots of the redesigned app, captured from the seeded demo accounts
// (admin and clinic) on 2026-11-03. Desktop at 1440×900 @2x, phone at 390×844
// @2x. Long pages are cropped from the top; captions say only what is on screen.
const appShots = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/projects/ivfcryo/app/*.png',
  { eager: true },
);
const shot = (slug: string) => appShots[`../../assets/projects/ivfcryo/app/${slug}.png`].default;

// What the design-system audit found before any screen was touched.
const systemAudit = [
  { value: '30', label: 'button class combinations', note: 'Pill buttons, a hover underline, and white on orange at 2.6:1, which fails WCAG AA.' },
  { value: '4', label: 'ways to style an input', note: 'Plus 14 one-off input class strings, and date and select widgets with their own unstyled CSS.' },
  { value: '115', label: 'inline style attributes', note: 'And 7 style blocks inside views, 19 hand-drawn SVG icons, and a raster PDF icon.' },
  { value: 'Red', label: 'meant “pending”', note: 'A normal state looked like an error, and section headers came in navy, gray, and green.' },
];

// The decisions that shaped the new look. Each one traces back to the
// original research or to the accessibility work with a screen reader user.
const redesignDecisions = [
  { icon: 'ph:cursor-click', title: 'Navy means you can click it', body: 'Navy is now only for actions, links, and the current nav item, at 11:1 contrast. Orange stays as an accent for icons and indicators, so it is never text on a button again.' },
  { icon: 'ph:hash', title: 'Numbers line up', body: 'Geist for text and Geist Mono for readouts, with tabular figures everywhere. Temperatures, times, prices, and reference numbers sit in columns and can be compared at a glance.' },
  { icon: 'ph:shapes', title: 'Every status has a shape', body: 'Status chips carry a glyph for each stage as well as a color, carrying on the original rule of never using color alone. Pending moved from red to amber.' },
  { icon: 'ph:signpost', title: 'One primary action per page', body: 'Each page gets one navy button. Breadcrumbs on 27 nested pages replaced the scattered “Back” and “All …” buttons.' },
  { icon: 'ph:calendar-dots', title: 'A plan is never shown as a fact', body: 'The custody timeline labels planned times “Scheduled” or “Requested” and never shows them as actual times. This is the old “sent is not received” lesson, applied to time.' },
  { icon: 'ph:thermometer-hot', title: 'Keep the warmest reading', body: 'The temperature chart thins out readings by keeping the warmest one in each interval, so a short spike above the set-point can’t be averaged out of view.' },
];

// Nielsen heuristics, scored 0–10 on every flow before and after the fixes.
// "Lowest" is the worst score that heuristic got on any of the eight flows.
// Source: tasks/heuristics-audit.md + tasks/heuristics-audit-app.md.
const heuristics = [
  { n: 1, name: 'Visibility of system status', before: 4, after: 9, fix: 'Overdue pickups flagged on the row and the stage tile. Labels and quotes show a working, done, or failed state.' },
  { n: 2, name: 'Match with the real world', before: 5, after: 9, fix: 'One set of stage names everywhere (“Awaiting pickup”), replacing raw values like “Pending” and “Delete”.' },
  { n: 3, name: 'User control and freedom', before: 3, after: 9, fix: 'Archived contacts can be found and restored. Unsaved edits are guarded. Every filter can be cleared in one click.' },
  { n: 4, name: 'Consistency and standards', before: 4, after: 9, fix: 'Filters are a real form, so Enter works. One confirm dialog, one flash message, consistent names.' },
  { n: 5, name: 'Error prevention', before: 2, after: 9, fix: 'Status menu no longer offers “Delete” without a confirmation step. Package types in use can’t be deleted. Double-submit guard on every form.' },
  { n: 6, name: 'Recognition over recall', before: 6, after: 8, fix: 'Hidden filters show a count on “More”. Contacts added in a dialog can be picked right away.' },
  { n: 7, name: 'Flexibility and efficiency', before: 4, after: 8, fix: 'Press / to search from any list. The in-transit list makes one database query instead of one per row.' },
  { n: 8, name: 'Aesthetic and minimalist', before: 3, after: 8, fix: 'Public tracking shows status only: no names, addresses, or printable labels.' },
  { n: 9, name: 'Recovering from errors', before: 2, after: 9, fix: 'A failed booking keeps everything typed. Errors appear inline next to the field. Bad tracking links get a recovery page instead of a crash.' },
  { n: 10, name: 'Help and documentation', before: 5, after: 8, fix: 'Each stage’s empty state explains how shipments get there. Contextual hints under fields that need them.' },
];

// Average across the ten heuristics, per flow. Shipments list "before" is from
// the first, single-screen audit; every "after" is from the final re-score.
const flowScores = [
  { flow: 'Auth, shell, error pages', before: 5.4, after: 8.8 },
  { flow: 'Home, detail, public pages', before: 4.8, after: 8.9 },
  { flow: 'New shipment', before: 4.9, after: 8.9 },
  { flow: 'Admin shipment edit', before: 4.4, after: 8.7 },
  { flow: 'Address book, users, templates', before: 4.8, after: 8.9 },
  { flow: 'Inventory', before: 6.2, after: 8.8 },
  { flow: 'Settings, feedback', before: 6.2, after: 8.8 },
  { flow: 'Shipments list', before: 6.0, after: 8.8 },
];

// What the re-score left below 9, and what hasn't been checked yet. Straight
// from the "why the 8s aren't 9s" and "not assessed" notes in the audit.
const redesignEdges = [
  {
    icon: 'ph:lightning',
    title: 'No bulk actions or saved views',
    body: 'Press / to search works on every list, but staff still handle shipments one at a time. Bulk actions only make sense for a few admin queues, such as feedback review and device assignment, so they need a product decision before a design.',
  },
  {
    icon: 'ph:keyboard',
    title: 'Device IDs are still typed in',
    body: 'On the staff edit page, trackers and dry shippers are entered by ID. The ID is checked as you type, but a picker built on the availability data would be faster and harder to get wrong.',
  },
  {
    icon: 'ph:eye-slash',
    title: 'A real-browser accessibility pass',
    body: 'Phone layouts were checked at 390 pixels in automated captures. The public site still needs a keyboard and screen reader pass on real devices, ideally with the same customer who tested the original build.',
  },
];

// The phone set. Captions describe what is on screen and why it is laid out that way.
const phones = [
  { slug: 'phone-public-home', title: 'Home', note: 'The hero sentence shows a live sample temperature.', alt: 'The IVFCRYO home page on a phone: a 24/7 shipment desk phone bar, the headline “Your embryos are holding at −192.9 °C, 3h 05m into a trip we watch every minute,” two buttons, and a small live temperature chart.' },
  { slug: 'phone-public-tracking', title: 'Public tracking', note: 'Status only. The timeline turns vertical on a phone.', alt: 'The public tracking page on a phone: shipment title, an In transit chip and reference number, then a vertical custody timeline from Created to Delivered, followed by From and To clinic names and cities.' },
  { slug: 'phone-sign-in', title: 'Sign in', note: 'Full-width fields and the support number up front.', alt: 'The sign-in page on a phone: Welcome back, a note with the support phone number, email and password fields, a Forgot password link, Keep me signed in, and a full-width Log in button.' },
  { slug: 'phone-nav-drawer', title: 'Navigation', note: 'The drawer takes focus when it opens and gives it back when it closes.', alt: 'The signed-in app on a phone with the navigation drawer open: Shipments highlighted, Users, Shipment feedback, an Inventory group, and Settings pinned at the bottom.' },
  { slug: 'phone-list-active', title: 'Shipments', note: 'Stage tiles go two by two; filters stack full width.', alt: 'The shipments list on a phone: Export and New Shipment buttons, four stage tiles in a two-by-two grid with In transit selected, and stacked search and company filters.' },
  { slug: 'phone-detail', title: 'Shipment detail', note: 'The custody timeline runs top to bottom, then key facts in pairs.', alt: 'Shipment detail on a phone: breadcrumb, title, invoice and Edit buttons, a vertical custody timeline, then pickup, delivery, service, and quoted price in a two-column grid.' },
  { slug: 'phone-new-shipment', title: 'New shipment', note: 'Company pickers stack into one column, with the selected company marked.', alt: 'The new-shipment form on a phone: the Route section with a Ships from company picker, a selected company marked with an accent bar, local time zone, and pickup instructions.' },
  { slug: 'phone-clinic-list', title: 'Clinic view', note: 'A clinic sees only its own shipments, with the same layout.', alt: 'The My shipments page for a clinic user on a phone: stage tiles with the clinic’s own counts and the same search and filter controls as staff.' },
];

// The TLDR digest. "Alternatives" and "Decision" restate the two-apps-vs-one
// call already argued in the #flows step; "Reflection" restates the edges
// section below rather than inventing a new critique — see
// notes/interview-notes/tldr.md.

---

<ProjectLayout title={title} description={description}>

  <ProjectHero project="ivfcryo" />

  <CaseReview links={[{ href: '#tldr', label: 'Summary' }, { href: '#readiness', label: 'Design decisions' }, { href: '#outcomes', label: 'Results' }, { href: '#architecture', label: 'Engineering partnership' }, { href: '#redesign', label: '2026 redesign' }, { href: '#heuristics', label: 'Heuristic audit' }, { href: '#mobile', label: 'Mobile' }, { href: '#public-site', label: 'Public site' }, { href: '#edges', label: 'What I’d improve' }]} />

  <Tldr
    problem={tldr.problem}
    alternativeA={tldr.alternativeA}
    alternativeB={tldr.alternativeB}
    decision={tldr.decision}
    implementation={tldr.implementation}
    evidence={tldr.evidence}
    reflection={tldr.reflection}
  />

  <Section tone="paper" padding="tight" aria-label="Scope" class="project-scope">
    <Container width="content">
      <p class="mono-label mb-8">Scope</p>
      <dl class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {proof.map((group) => (
          <div class="pt-4">
            <dt class="mono-label mb-3">{group.label}</dt>
            <dd>
              <ul class="space-y-1.5">
                {group.items.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-ink-muted leading-relaxed">
                    <Icon name="ph:check" size={14} class="mt-0.5 shrink-0 text-accent" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="stakes" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Mapping who handles a shipment</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Before drawing a single screen, I mapped how a shipment actually moves: a
              fragile, temperature-controlled package changing hands across two clinics
              and a courier, on a tight medical deadline. A wrong label or a missed
              temperature drop isn't just an inconvenience here. It can mean losing
              someone's only remaining embryo.
            </p>
            <p>
              Don, the owner, put it simply: a shipment "looks like one transaction to
              the patient, but it is actually a chain of separate responsibilities",
              the patient, two clinics, a courier, and IVFCRYO, each with its own
              paperwork and approvals. So I started by mapping what each party had to
              do and who they handed the shipment to next.
            </p>
          </div>

