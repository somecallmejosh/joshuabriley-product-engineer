---
import ProjectLayout from '~/layouts/ProjectLayout.astro';
import Heading from '~/components/primitives/Heading.astro';
import ProjectHero from '~/components/patterns/ProjectHero.astro';
import ProjectNext from '~/components/patterns/ProjectNext.astro';
import GalleryLink from '~/components/patterns/GalleryLink.astro';
import CaseReview from '~/components/patterns/CaseReview.astro';
import Tldr from '~/components/patterns/Tldr.astro';
import Container from '~/components/layout/Container.astro';
import Icon from '~/components/primitives/Icon.astro';
import Metric from '~/components/patterns/Metric.astro';
import Plate from '~/components/patterns/Plate.astro';
import FidelityBand from '~/components/patterns/FidelityBand.astro';
import ScrollShot from '~/components/patterns/ScrollShot.astro';
import CaseSection from '~/components/patterns/case/CaseSection.astro';
import CaseProse from '~/components/patterns/case/CaseProse.astro';
import CaseCards from '~/components/patterns/case/CaseCards.astro';
import CaseFindings from '~/components/patterns/case/CaseFindings.astro';
import CaseResults from '~/components/patterns/case/CaseResults.astro';
import CaseQuote from '~/components/patterns/case/CaseQuote.astro';
import CaseLimitations from '~/components/patterns/case/CaseLimitations.astro';
import CasePersonas from '~/components/patterns/case/CasePersonas.astro';
import CaseFor from '~/components/patterns/case/CaseFor.astro';
import CaseJourney from '~/components/patterns/case/CaseJourney.astro';
import { ivfcryoPersonas, ivfcryoJourney } from '~/lib/case-research';
import HeuristicScores from '~/components/patterns/case/HeuristicScores.astro';
import { ivfcryoSummary as tldr } from '~/lib/project-summaries';
import type { ImageMetadata } from 'astro';

// Section order and ids follow .claude/skills/portfolio/SKILL.md.

const title = 'IVFCRYO | Joshua Briley';
const description =
  "Case study: designing the app IVFCRYO uses to ship frozen embryos between clinics, so five parties confirm they're ready before a shipment starts.";

const jumpLinks = [
  { href: '#tldr', label: 'Summary' },
  { href: '#context', label: 'Shipment parties' },
  { href: '#research', label: 'Research' },
  { href: '#decisions', label: 'Design decisions' },
  { href: '#outcomes', label: 'Results' },
  { href: '#process', label: 'Build and integrations' },
  { href: '#edges', label: 'Limitations' },
];

// What changed, grouped by who it changed for. Every line restates something
// the page already says (readiness check, flows, forms, alerts, custody).
// Timed with customers on the one-click prototype. Josh's own measurements;
// keep these apart from the post-launch support and shipping-error results.
const oneClickTimings = [
  { task: 'Setting up all the defaults', time: 'About 10 minutes' },
  { task: 'A shipment with no defaults set', time: 'About 30 seconds' },
  { task: 'A shipment where the defaults matched', time: 'About 10 seconds' },
  { task: 'A shipment where a default had to change', time: 'Over 2 minutes' },
];

const results = [
  {
    label: 'For patients like Priya and clinics like Lauren’s',
    items: [
      'See when both clinics have signed off',
      'A readiness view of what each party still owes',
      'Tracking by email or text, with no account',
      'Forms that let them fix mistakes without calling support',
    ],
  },
  {
    label: 'For IVFCRYO staff like Tessa',
    items: [
      'Email, fax, and phone notes gathered into one case',
      'Every client’s shipments, by readiness state',
      'Alert levels, each with an assigned responder',
      'A named contact acknowledges every handoff',
    ],
  },
  {
    label: 'For the business',
    items: [
      'No courier scheduled until every party confirms readiness',
      'Orders capture declared value for CRYO Shield claims',
      'Custody closes when staff accept the specimens',
      'Patients and staff always see the same status',
    ],
  },
];


// The five independent organizations a single shipment has to line up. The
// interviews were unanimous: this — not the drive — is the hard part.
const parties = [
  { icon: 'ph:user', title: 'Patient', body: 'Authorizes the transfer and completes forms, records, and payment.' },
  { icon: 'ph:buildings', title: 'Sending clinic', body: 'Prepares and releases the specimens through a named lab contact.' },
  { icon: 'ph:buildings', title: 'Receiving clinic', body: 'Confirms intake requirements, then inspects and accepts the specimens.' },
  { icon: 'ph:airplane-tilt', title: 'Dedicated courier', body: 'Hand-carries the sealed unit directly between facilities.' },
  { icon: 'ph:package', title: 'IVFCRYO', body: 'Provides the monitored shipping unit and coordinates the case.' },
];

// The physical chain of custody, with a named-contact acknowledgment at every
// handoff — "chain of custody does not end with a delivery scan at the front desk."
const custody = [
  { icon: 'ph:package', title: 'Prepare & release', body: 'The sending lab loads the tracked unit, and a named contact releases it.' },
  { icon: 'ph:airplane-tilt', title: 'Courier pickup', body: 'The courier takes custody, and both sides confirm the handoff.' },
  { icon: 'ph:thermometer', title: 'Delivery & inspection', body: 'The receiving lab records a calibrated temperature before taking custody.' },
  { icon: 'ph:seal-check', title: 'Accept & close', body: 'The record closes when staff accept the specimens.' },
];

// The readiness gate: each responsible party clears a checkpoint before a courier
// can be scheduled. All three interviewees named this as the #1 change to make.
const readinessGate = [
  { party: 'Patient', check: 'Authorizations, identity, and payment complete' },
  { party: 'Sending clinic', check: 'Release approved, specimens prepared, contact named' },
  { party: 'Receiving clinic', check: 'Acceptance approved, intake requirements confirmed, staff scheduled' },
  { party: 'Courier', check: 'Route and timing confirmed as feasible' },
  { party: 'Equipment', check: 'Shipping unit available and suitable for the duration' },
];

// The information architecture, forked by role off one shared home.
const customerFlow = [
  { label: 'Shipping list', note: 'Active and past shipments, with readiness and overdue alerts.' },
  { label: 'New shipment', note: 'Route, specimen, live pricing, and CRYO Shield shipping guarantee tier.' },
  { label: 'Readiness view', note: 'What each party still owes before it can be scheduled.' },
  { label: 'Active shipment', note: 'Read-only tracking and sensor telemetry.' },
  { label: 'Receiving customers', note: 'Saved delivery contacts.' },
  { label: 'Profile', note: 'Billing, address, cancel account.' },
];

const adminFlow = [
  { label: 'Shipping list', note: 'Every client’s shipments, by readiness state.' },
  { label: 'Active shipment', note: 'Edit, cancel, change status, notify, or open an incident.' },
  { label: 'Customer list', note: 'Filter, sort, open a client.' },
  { label: 'Customer detail', note: 'All orders for one client.' },
  { label: 'Equipment inventory', note: 'Units, monitoring, maintenance and replacement flags.' },
  { label: 'Add customer', note: 'Creates the account, emails credentials.' },
];

// Front-end design decisions that made the correct path easier than the wrong one.
const recovery = [
  { icon: 'ph:list-checks', label: 'Structured specimen records' },
  { icon: 'ph:map-pin', label: 'Geocoded address validation' },
  { icon: 'ph:warning-circle', label: 'Inline validation, recoverable errors' },
  { icon: 'ph:eye', label: 'Status shown by text, icon, and shape' },
  { icon: 'ph:target', label: 'Focus managed on visibility change' },
  { icon: 'ph:megaphone', label: 'Live-region status announcements' },
  { icon: 'ph:handshake', label: 'Explicit acknowledgment at every handoff' },
  { icon: 'ph:camera', label: 'Immediate, structured incident capture' },
];

// The tiered alert model — a design requirement I handed engineering, and the fix
// for the alert fatigue Daryl and Sasha both named.
const alertTiers = [
  { level: 'Normal', tone: 'ok', body: 'The reading is within the expected range. It is logged and shown quietly, and no one is paged.' },
  { level: 'Early warning', tone: 'warn', body: 'A reading is trending toward a threshold. Staff monitor it more closely and call the courier.' },
  { level: 'Required action', tone: 'warn', body: 'A reading crosses a defined threshold. The owner is notified and must respond.' },
  { level: 'Emergency', tone: 'crit', body: 'A reading shows a critical excursion. The pre-assigned escalation path starts.' },
];

// The integration boundaries we drew together, each isolated behind its own
// service object so vendor quirks never leaked into the interface I owned.
const integrations = [
  { icon: 'ph:thermometer-cold', name: 'IVFCRYO-Sense', role: 'GPS, internal and ambient temperature, humidity, and pressure' },
  { icon: 'ph:barcode', name: 'ShipEngine', role: 'Multi-carrier rates and labels' },
  { icon: 'ph:airplane-tilt', name: 'Dedicated courier', role: 'Direct medical hand-carry, no sorting hubs' },
  { icon: 'ph:envelope-simple', name: 'SendGrid', role: 'Tiered email notifications' },
  { icon: 'ph:device-mobile', name: 'Twilio', role: 'SMS alerts' },
  { icon: 'ph:lock-key', name: 'Devise + 2FA', role: 'Sign-in with two-factor authentication' },
];

// The four-lens measurement frame Don and Daryl both described — the design's
// definition of success, not just a headline number.
const metricLenses = [
  { lens: 'Safety', items: ['Temperature excursions', 'Monitoring gaps', 'Chain-of-custody exceptions', 'Incomplete receiving records'] },
  { lens: 'Reliability', items: ['On-time pickups and deliveries', 'Rescheduled shipments', 'Shipments started without full readiness'] },
  { lens: 'Efficiency', items: ['Order-to-readiness time', 'Manual follow-ups per case', 'Exception resolution time'] },
  { lens: 'Experience', items: ['Status inquiries', 'Complaints', 'Stage-appropriate updates delivered'] },
];

// The edges — honest, not exhaustive. Both trace back to the same root cause:
// live telemetry from more than one source, polled continuously, with no
// shared cadence or labeling rule set early enough to prevent it.
const edges = [
  {
    icon: 'ph:speaker-high',
    title: 'Screen reader updates are too frequent',
    body: 'The tracker updates every 60 seconds, so a screen reader starts each update before the last one finishes. A setting slows it down, but I’d change the default instead.',
  },
  {
    icon: 'ph:tag',
    title: 'Carriers announced with the same label',
    body: 'With two carriers, both were announced the same way, so a screen reader user couldn’t tell which had the shipment. I’d name each carrier explicitly.',
  },
];

// The annotated wireframes render live in src/ so Astro can process them
// (anything under public/ is copied verbatim, never optimized). Source files are
// 3200px PNGs; `<Image>` emits sized WebP from these at build time.
const annotatedShots = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/projects/ivfcryo/wires-and-flows/*.png',
  { eager: true },
);
const annotated = (slug: string) =>
  annotatedShots[`../../assets/projects/ivfcryo/wires-and-flows/${slug}.png`].default;

// The bare sketch + wireframe SVGs stay in public/: Astro passes SVGs through
// untransformed either way, so moving them would buy nothing.
const art = (slug: string) => `/images/projects/ivfcryo/wires-and-flows/${slug}`;

// Four screens carry the argument, so they get full plates. The `note` is the
// subtitle written on the artwork itself, not a fresh gloss on it.
const plates = [
  {
    slug: '03-shipments-index',
    index: '03',
    title: 'Shipments index',
    note: 'Staff’s main workspace, filtered by status.',
    alt: 'Annotated wireframe of the shipments index: a filter bar, status tabs, and a list of shipment cards, with six numbered callouts explaining why status lives in the URL and why cards replaced table rows.',
  },
  {
    slug: '04-new-shipment',
    index: '04',
    title: 'New shipment',
    note: 'About forty fields in numbered sections, with a live price and a way forward from every error.',
    alt: 'Annotated wireframe of the new-shipment form, broken into seven numbered sections from service selection to insurance, with a live price quote pinned beside it and six callouts covering quote recalculation, contact reuse, and notification defaults.',
  },
  {
    slug: '05-shipment-detail',
    index: '05',
    title: 'Shipment detail',
    note: 'Shows where the shipment is and whether it is still at the right temperature.',
    alt: 'Annotated wireframe of the shipment detail page: a live position map above sensor readings for temperature, humidity, and battery, then two parallel tracking timelines, with callouts explaining why telemetry outranks logistics and why the two legs stay unmerged.',
  },
];


const flows = [
  {
    slug: '11-flow-authentication',
    title: 'Authentication and account recovery',
    note: 'Every failed step offers a way to recover without calling support.',
    alt: 'Flow diagram of authentication and account recovery. A visitor branches on whether they have an account, through sign-in, admin activation, a user-chosen email or SMS verification channel, and six-digit code entry. A failed code offers resend, backup code, or password reset, and a final admin check routes to either the admin or client view. Five numbered design notes sit alongside, and password recovery runs as a separate track underneath.',
  },
  {
    slug: '12-flow-create-shipment',
    title: 'Creating a shipment',
    note: 'The highest-risk path: one submit, with validation that blocks bookings that can’t be fulfilled.',
    alt: 'Flow diagram of the shipment creation path. Service selection resolves a live price quote or a contact-for-quote branch, then runs through date, package, pickup and delivery contacts, notification preferences, insurance, and agreement. Failed validation returns to the offending field with form state preserved, and a successful submit forks into a confirmation email and the admin fulfillment queue. Six numbered design notes sit alongside.',
  },
];

// Plates and flows are placed beside the argument they support rather than
// collected into one gallery, so these look them up by slug at the point of use.
const plate = (slug: string) => plates.find((p) => p.slug === slug)!;
const flow = (slug: string) => flows.find((f) => f.slug === slug)!;

// Screenshots of the app, captured from the seeded demo accounts
// (admin and clinic). Desktop at 1440×900 @2x, phone at 390×844
// @2x. Long pages are cropped from the top; captions say only what is on screen.
const appShots = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/projects/ivfcryo/app/*.png',
  { eager: true },
);
const shot = (slug: string) => appShots[`../../assets/projects/ivfcryo/app/${slug}.png`].default;

// What the design-system audit found before any screen was touched.
const systemAudit = [
  { value: '30', label: 'button class combinations', note: 'Including white on orange at 2.6:1, which fails WCAG AA.' },
  { value: '4', label: 'ways to style an input', note: 'Plus 14 one-off input class strings.' },
  { value: '115', label: 'inline style attributes', note: 'Plus 7 style blocks in views and 19 hand-drawn SVG icons.' },
  { value: 'Red', label: 'meant “pending”', note: 'A normal state looked like an error.' },
];

// The decisions that shaped the new look. Each one traces back to the
// original research or to the accessibility work with a screen reader user.
const redesignDecisions = [
  { icon: 'ph:cursor-click', title: 'Navy means you can click it', body: 'Navy is only for actions, links, and the current nav item, at 11:1 contrast. Orange no longer appears as button text.' },
  { icon: 'ph:hash', title: 'Numbers line up', body: 'Readouts use Geist Mono with tabular figures, so temperatures, times, and prices compare at a glance.' },
  { icon: 'ph:shapes', title: 'Every status has a shape', body: 'Each status chip has a glyph as well as a color. Pending moved from red to amber.' },
  { icon: 'ph:signpost', title: 'One primary action per page', body: 'One navy button per page. Breadcrumbs on 27 nested pages replaced scattered “Back” buttons.' },
  { icon: 'ph:calendar-dots', title: 'Planned times are labeled', body: 'The custody timeline labels planned times “Scheduled” or “Requested” so they aren’t read as actual times.' },
  { icon: 'ph:thermometer-hot', title: 'Keep the warmest reading', body: 'The temperature chart keeps the warmest reading in each interval, so a short spike can’t be averaged away.' },
];

// Nielsen heuristics, scored 0–10 on every flow before and after the fixes.
// "Lowest" is the worst score that heuristic got on any of the eight flows.
// Source: tasks/heuristics-audit.md + tasks/heuristics-audit-app.md.
const heuristics = [
  { n: 1, name: 'Visibility of system status', before: 4, after: 9, fix: 'Overdue pickups are flagged, and labels and quotes show working, done, or failed.' },
  { n: 2, name: 'Match with the real world', before: 5, after: 9, fix: 'One set of stage names everywhere, replacing raw values like “Pending” and “Delete”.' },
  { n: 3, name: 'User control and freedom', before: 3, after: 9, fix: 'Archived contacts can be restored, unsaved edits are guarded, and filters clear in one click.' },
  { n: 4, name: 'Consistency and standards', before: 4, after: 9, fix: 'Filters are a real form, so Enter works. Every page uses the same confirm dialog and flash message.' },
  { n: 5, name: 'Error prevention', before: 2, after: 9, fix: '“Delete” needs confirmation, package types in use can’t be deleted, and forms block double-submits.' },
  { n: 6, name: 'Recognition over recall', before: 6, after: 8, fix: 'Hidden filters show a count. Contacts added in a dialog can be picked right away.' },
  { n: 7, name: 'Flexibility and efficiency', before: 4, after: 8, fix: 'Press / to search any list. The in-transit list makes one query instead of one per row.' },
  { n: 8, name: 'Aesthetic and minimalist', before: 3, after: 8, fix: 'Public tracking shows no names, addresses, or printable labels.' },
  { n: 9, name: 'Recovering from errors', before: 2, after: 9, fix: 'Failed bookings keep what was typed, errors appear inline, and bad tracking links get a recovery page.' },
  { n: 10, name: 'Help and documentation', before: 5, after: 8, fix: 'Empty states explain how shipments reach each stage, with hints under fields that need them.' },
];

// Average across the ten heuristics, per flow. Shipments list "before" is from
// the first, single-screen audit; every "after" is from the final re-score.
const flowScores = [
  { flow: 'Auth, shell, error pages', before: 5.4, after: 8.8 },
  { flow: 'Home, detail, public pages', before: 4.8, after: 8.9 },
  { flow: 'New shipment', before: 4.9, after: 8.9 },
  { flow: 'Admin shipment edit', before: 4.4, after: 8.7 },
  { flow: 'Address book, users, templates', before: 4.8, after: 8.9 },
  { flow: 'Inventory', before: 6.2, after: 8.8 },
  { flow: 'Settings, feedback', before: 6.2, after: 8.8 },
  { flow: 'Shipments list', before: 6.0, after: 8.8 },
];

// What the re-score left below 9, and what hasn't been checked yet. Straight
// from the "why the 8s aren't 9s" and "not assessed" notes in the audit.
const redesignEdges = [
  {
    icon: 'ph:lightning',
    title: 'No bulk actions or saved views',
    body: 'Staff still handle shipments one at a time. Bulk actions need a product decision about which admin queues get them.',
  },
  {
    icon: 'ph:keyboard',
    title: 'Device IDs are still typed in',
    body: 'Staff enter trackers and dry shippers by ID. A picker built on availability data would be faster and harder to get wrong.',
  },
  {
    icon: 'ph:eye-slash',
    title: 'No real-device accessibility pass',
    body: 'Phone layouts were checked only in automated captures. The public site still needs a keyboard and screen reader pass on real devices.',
  },
];

// The phone set. Captions describe what is on screen and why it is laid out that way.
const phones = [
  { slug: 'phone-public-tracking', title: 'Public tracking', note: 'A vertical timeline, then the two clinics.', alt: 'The public tracking page on a phone: shipment title, an In transit chip and reference number, then a vertical custody timeline from Created to Delivered, followed by From and To clinic names and cities.' },
  { slug: 'phone-list-active', title: 'Shipments', note: 'Stage tiles two by two, filters full width.', alt: 'The shipments list on a phone: Export and New Shipment buttons, four stage tiles in a two-by-two grid with In transit selected, and stacked search and company filters.' },
  { slug: 'phone-detail', title: 'Shipment detail', note: 'Vertical timeline, then key facts in pairs.', alt: 'Shipment detail on a phone: breadcrumb, title, invoice and Edit buttons, a vertical custody timeline, then pickup, delivery, service, and quoted price in a two-column grid.' },
  { slug: 'phone-clinic-list', title: 'Clinic view', note: 'A clinic sees only its own shipments.', alt: 'The My shipments page for a clinic user on a phone: stage tiles with the clinic’s own counts and the same search and filter controls as staff.' },
];

---

<ProjectLayout title={title} description={description}>

  <ProjectHero project="ivfcryo" />

  <CaseReview links={jumpLinks} />

  <Tldr problem={tldr.problem} decision={tldr.decision} evidence={tldr.evidence} />

  <CaseSection id="context" title="Shipment parties">
    <CaseProse>
      <p>
        IVFCRYO ships frozen embryos between clinics, and a missed temperature drop can cost someone their only remaining embryo. As Don, the
        owner, put it, a shipment “looks like one transaction to the patient, but it is actually
        a chain of separate responsibilities,” so I mapped each party and handoff first. <a href="#persona-priya" class="hero-link">Priya, Lauren, Tessa, and Martin</a> are the people on either side of those handoffs.
      </p>
    </CaseProse>

    <CaseCards label="The five parties" items={parties} />

    <CaseCards label="Chain of custody" items={custody} />

    <Fragment slot="media">
      <Container width="wide" class="mt-16">
        <Plate
          title="Shipment detail"
          caption="Custody status comes first, followed by key facts, the temperature trace, and the map."
          src={shot('app-detail')}
          alt="The shipment detail page: the title Hudson Valley Reproductive to IVFCRYO Lab, a four-step custody timeline with In transit current, a key-facts strip for pickup, delivery, service, and quoted price, then sensor data with a large −192.9 °C probe readout, a temperature chart below a dashed set-point line marked “All 12 below set-point”, ambient readings, and a live map. A side panel lists shipment details and staff comments."
        />
      </Container>
    </Fragment>
  </CaseSection>

  <CaseSection id="research" title="Research">
    <CaseProse>
      <Heading level={3} visual="h2">Requirements gathering</Heading>
      <p>
        IVFCRYO’s requirements reached me as photographs: printed Word pages listing everything
        they had to collect for a single shipment, and sample labels from their two couriers.
        They talked me through the process, then had me interview an existing customer so I could
        learn it from the customer’s side.
      </p>
      <p>
        I also sat down with the owner, COO, and office manager, and all three named the same
        first fix: a readiness check both clinics confirm before a courier is scheduled.
      </p>
    </CaseProse>

    <figure class="my-12 border-l-2 border-accent pl-6">
      <blockquote class="font-display tracking-tight text-ink leading-snug">
        “One of the worst operational patterns is scheduling first and hoping the remaining
        requirements are completed before pickup.”
      </blockquote>
      <figcaption class="mono-label mt-3">Daryl, COO, on scheduling</figcaption>
    </figure>

    <CaseProse>
      <p>
        From there I moved from notebook sketches to Figma designs and reviewed them with
        customers. Once we agreed on how it should work, we built high-clarity mocks in code.
        Tasks lived in GitHub Projects, where IVFCRYO could check
        status between our scheduled touchpoints.
      </p>
    </CaseProse>

    <CaseProse class="mt-12">
      <p>
        The app had grown to 226 views with no shared rules for buttons, inputs, or status, so I
        ran a front-end audit. I kept the brand, every route, and every form field name.
      </p>
    </CaseProse>

    <CaseFindings title="Audit findings" items={systemAudit} />

    <CaseProse class="mt-12">
      <p>
        The audit also found security holes: 14 leftover pages let any signed-in clinic edit
        every company and user, shipments opened by guessing an ID, and the list filter built
        queries from raw URL text. I fixed those first, with request specs to keep them closed.
      </p>
    </CaseProse>

    <div class="mt-16">
          <Heading level={3} visual="h2" class="mb-6">Heuristic audit</Heading>
          <div class="case-prose measure space-y-5">
            <p>
              I scored every flow 0–10 against Nielsen’s ten usability heuristics, citing a file and
              line for each finding. The bar was <strong class="text-ink font-semibold">8 or above
              everywhere</strong>, and fixes went into shared components first.
            </p>
          </div>

          <div class="mt-12 grid grid-cols-2 gap-8 py-8">
            <Metric value="8.8" label="average score after" caption="up from 5.3 across 8 flows and 10 heuristics" />
            <Metric value="2 → 9" label="lowest error-recovery score" caption="the weakest heuristic on three flows" />
          </div>

          <HeuristicScores level={4} items={heuristics} caption="Lowest score on any flow, before → after, and the change that moved it most." />

          <div class="mt-12">
            <Heading level={4} visual="h3" class="mb-6">Average score by flow</Heading>
            <ul class="space-y-3">
              {flowScores.map((f) => (
                <li class="flex flex-col gap-y-1.5 sm:flex-row sm:items-center sm:gap-x-4">
                  <span class="text-sm text-ink sm:w-56 sm:shrink-0">{f.flow}</span>
                  <span class="flex min-w-0 flex-1 items-center gap-3">
                    <span class="relative h-2 flex-1 rounded-full bg-line" aria-hidden="true">
                      <span class="absolute inset-y-0 left-0 rounded-full bg-ink-muted/40" style={`width:${f.before * 10}%`}></span>
                      <span class="absolute inset-y-0 left-0 rounded-full bg-accent mix-blend-multiply" style={`width:${f.after * 10}%; opacity:.85`}></span>
                    </span>
                    <span class="w-24 shrink-0 text-right font-mono text-xs text-ink-muted">
                      {f.before.toFixed(1)} → <span class="text-ink">{f.after.toFixed(1)}</span>
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
    </div>

    <CaseProse class="mt-12">
      <p>
        Every interview identified the same main problem: <strong class="text-ink font-semibold">getting
        all five parties ready before pickup</strong>.
      </p>
    </CaseProse>

    <Fragment slot="media">
      <Container width="wide" class="mt-16">
        <CasePersonas items={ivfcryoPersonas} />
      </Container>

      <Container width="wide" class="mt-16">
        <CaseJourney title="Journey map: one shipment" stages={ivfcryoJourney} />
      </Container>
    </Fragment>
  </CaseSection>

  <CaseSection id="decisions" title="A readiness check before a courier is scheduled">
    <CaseFor project="ivfcryo" personas={["tessa","lauren"]} stage="readiness" />
    <CaseProse>
      <p>
        I made readiness
        <strong class="text-ink font-semibold">a status the system checks</strong>, with
        requested, provisional, and confirmed kept as separate states. Each responsible party
        clears a checkpoint before a courier can be scheduled.
      </p>
    </CaseProse>

    <div class="mt-10 rounded-lg border border-line p-6 md:p-8">
      <Heading level={3} visual="h3" class="mb-6">Readiness checks before scheduling</Heading>
      <ul>
        {readinessGate.map((row) => (
          <li class="grid grid-cols-[18px_minmax(0,1fr)] items-start gap-x-4 gap-y-1 border-b border-line py-3.5 last:border-b-0 sm:grid-cols-[18px_9rem_minmax(0,1fr)]">
            <Icon name="ph:seal-check" size={18} class="shrink-0 text-accent" />
            <span class="font-medium text-ink">{row.party}</span>
            <span class="col-start-2 text-sm text-ink-muted leading-snug sm:col-start-3">{row.check}</span>
          </li>
        ))}
      </ul>
      <p class="mt-5 text-sm text-ink-muted leading-relaxed">
        A shipment moves from <span class="font-mono text-xs text-ink">awaiting_readiness</span>
        to <span class="font-mono text-xs text-ink">ready</span> only after every check is
        confirmed. Only a ready shipment can be scheduled.
      </p>
    </div>
  </CaseSection>

  <CaseSection id="decision-shared-record" title="One shipment record for customers and staff">
