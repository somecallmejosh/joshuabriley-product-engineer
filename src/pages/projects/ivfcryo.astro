---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Link from '~/components/primitives/Link.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';
import Metric from '~/components/patterns/Metric.astro';
import CodeBlock from '~/components/patterns/CodeBlock.astro';
import Plate from '~/components/patterns/Plate.astro';
import FidelityBand from '~/components/patterns/FidelityBand.astro';
import Tldr from '~/components/patterns/Tldr.astro';
import type { ImageMetadata } from 'astro';

const title = 'IVFCRYO | Joshua Briley';
const description =
  'Case study: leading the design and owning the front end of a self-service logistics platform for high-stakes fertility shipments, then partnering with engineering on the Rails domain model and the carrier, telemetry, and notification services beneath it. Stakeholder research showed the real problem was human: taking the coordination burden off an anxious patient and getting five parties provably ready before a specimen ever moves.';

// Ownership is stated plainly in the hero rail: design and front end were mine to
// own; the backend was a partnership. The rest of the page holds that line.
const meta = [
  { role: 'Role', value: 'Product Design Engineer' },
  { role: 'Owned', value: 'Design + front end' },
  { role: 'Partnered', value: 'Backend · Rails · Postgres' },
  { role: 'Domain', value: 'Fertility logistics' },
];

// Receipts split by ownership on purpose — two "owned" columns, one "partnered"
// column, one outcomes column — so the boundary reads at a glance.
const proof = [
  { label: 'Design · owned', items: ['Stakeholder research & synthesis', 'Five-party workflow modeling', 'Information architecture', 'Two-sided + public flows', 'Readiness as a formal state'] },
  { label: 'Front end · owned', items: ['Accessible component system', 'Progressive enhancement', 'Forms as a recovery system', 'Text/icon/shape, never color alone', 'Reusable accessible base'] },
  { label: 'Backend · partnered', items: ['Shaped the Rails domain model', 'Specced lifecycle + readiness states', 'Defined integration boundaries', 'Set telemetry + alert requirements'] },
  { label: 'Outcomes', items: ['Patients stopped chasing two clinics', '75% fewer support calls', '55% fewer shipping errors', 'Fewer transfer dates lost to delay'] },
];

const docket = [
  { href: '#stakes', icon: 'ph:share-network', label: 'Modeling a five-party workflow as a system' },
  { href: '#readiness', icon: 'ph:seal-check', label: 'The readiness gate before scheduling' },
  { href: '#flows', icon: 'ph:squares-four', label: 'Designing both sides, and the public view' },
  { href: '#recovery', icon: 'ph:shield-check', label: 'The interface as a recovery system' },
  { href: '#architecture', icon: 'ph:stack', label: 'Partnering on the system underneath' },
  { href: '#outcomes', icon: 'ph:trend-up', label: 'What shipping it changed' },
];

// The five independent organizations a single shipment has to line up. The
// interviews were unanimous: this — not the drive — is the hard part.
const parties = [
  { icon: 'ph:user', title: 'Patient', body: 'Authorizes the transfer, provides identity and records, completes forms and payment. Should never have to project-manage two labs.' },
  { icon: 'ph:buildings', title: 'Sending clinic', body: 'Identifies, prepares, and releases the specimens, and names a responsible lab contact, not the front desk.' },
  { icon: 'ph:buildings', title: 'Receiving clinic', body: 'Confirms intake requirements, staffs qualified people, inspects, and accepts the specimens into storage.' },
  { icon: 'ph:airplane-tilt', title: 'Dedicated courier', body: 'Carries the sealed unit directly between facilities, no unrelated stops, with acknowledged chain-of-custody handoffs.' },
  { icon: 'ph:package', title: 'IVFCRYO', body: 'Provides the shipping unit and IVFCRYO-Sense monitoring, coordinates the logistics, and holds the case together.' },
];

// The physical chain of custody, with a named-contact acknowledgment at every
// handoff — "chain of custody does not end with a delivery scan at the front desk."
const custody = [
  { icon: 'ph:package', title: 'Prepare & release', body: 'IVFCRYO ships the unit with an IVFCRYO-Sense tracker inside; the sending lab loads the specimens and a named contact releases them.' },
  { icon: 'ph:airplane-tilt', title: 'Courier pickup', body: 'A dedicated medical courier accepts custody from the named lab contact and hand-carries the sealed unit. The handoff is acknowledged, not assumed.' },
  { icon: 'ph:thermometer', title: 'Delivery & inspection', body: 'The receiving lab inspects the unit and records a calibrated temperature at specimen-storage level before taking custody.' },
  { icon: 'ph:seal-check', title: 'Accept & close', body: 'Qualified staff accept the specimens into storage and the record closes on acknowledgment. "Delivered" is not "accepted."' },
];

// The readiness gate: each responsible party clears a checkpoint before a courier
// can be scheduled. All three interviewees named this as the #1 change to make.
const readinessGate = [
  { party: 'Patient', check: 'Authorizations, identity, and payment complete' },
  { party: 'Sending clinic', check: 'Release approved, specimens prepared, contact named' },
  { party: 'Receiving clinic', check: 'Acceptance approved, intake requirements confirmed, staff scheduled' },
  { party: 'Courier', check: 'Route and timing confirmed as feasible' },
  { party: 'Equipment', check: 'Shipping unit available and suitable for the duration' },
];

// The information architecture, forked by role off one shared home.
const customerFlow = [
  { label: 'Shipping list', note: 'Home. Active + past shipments, readiness + overdue alerts.' },
  { label: 'New shipment', note: 'Sender, receiver, specimen, live carrier pricing, CRYO Shield tier.' },
  { label: 'Readiness view', note: 'What each party still owes before it can be scheduled.' },
  { label: 'Active shipment', note: 'Read-only tracking and sensor telemetry.' },
  { label: 'Receiving customers', note: 'Saved delivery contacts.' },
  { label: 'Profile', note: 'Billing, address, cancel account.' },
];

const adminFlow = [
  { label: 'Shipping list', note: 'Every active + past shipment across clients, by readiness state.' },
  { label: 'Active shipment', note: 'Edit, cancel, change status, notify, open an incident.' },
  { label: 'Customer list', note: 'Filter, sort, open a client.' },
  { label: 'Customer detail', note: 'All orders for one client.' },
  { label: 'Equipment inventory', note: 'Units, monitoring, maintenance and replacement flags.' },
  { label: 'Add customer', note: 'Creates the account, emails credentials.' },
];

// Front-end design decisions that made the correct path easier than the wrong one.
const recovery = [
  { icon: 'ph:list-checks', label: 'Structured records over free text' },
  { icon: 'ph:map-pin', label: 'Geocoded address validation' },
  { icon: 'ph:warning-circle', label: 'Inline validation, recoverable errors' },
  { icon: 'ph:eye', label: 'Text, icon, and shape, never color alone' },
  { icon: 'ph:target', label: 'Focus managed on visibility change' },
  { icon: 'ph:megaphone', label: 'Live-region status announcements' },
  { icon: 'ph:handshake', label: 'Explicit acknowledgment at every handoff' },
  { icon: 'ph:camera', label: 'Immediate, structured incident capture' },
];

// The tiered alert model — a design requirement I handed engineering, and the fix
// for the alert fatigue Daryl and Sasha both named.
const alertTiers = [
  { level: 'Normal', tone: 'ok', body: 'Within expected range. Logged, surfaced quietly, no one paged.' },
  { level: 'Early warning', tone: 'warn', body: 'A trend moving toward a threshold. Closer monitoring, a call to the courier.' },
  { level: 'Required action', tone: 'warn', body: 'A defined threshold crossed. The owner is notified and must respond.' },
  { level: 'Emergency', tone: 'crit', body: 'A critical excursion. The pre-assigned escalation path fires.' },
];

// The integration boundaries we drew together, each isolated behind its own
// service object so vendor quirks never leaked into the interface I owned.
const integrations = [
  { icon: 'ph:thermometer-cold', name: 'IVFCRYO-Sense', role: 'GPS, internal + ambient temp, humidity, pressure' },
  { icon: 'ph:barcode', name: 'ShipEngine', role: 'Multi-carrier rates and labels' },
  { icon: 'ph:airplane-tilt', name: 'Dedicated courier', role: 'Direct medical hand-carry, no sorting hubs' },
  { icon: 'ph:envelope-simple', name: 'SendGrid', role: 'Tiered email notifications' },
  { icon: 'ph:device-mobile', name: 'Twilio', role: 'SMS alerts, off-screen' },
  { icon: 'ph:lock-key', name: 'Devise + 2FA', role: 'Auth for medical logistics' },
];

const outcomes = [
  {
    icon: 'ph:phone-x',
    title: 'Patients stopped calling in the dark',
    body: 'The app answered the questions people used to phone in with real fear behind them: where are my specimens, are they still cold, did both clinics sign off. Support calls fell by three quarters.',
  },
  {
    icon: 'ph:seal-check',
    title: 'Fewer people hit by a preventable error',
    body: 'A readiness gate plus structured, geocoded, recoverable forms stopped mistakes at entry, before they could reach the irreplaceable material at the other end of the chain. Shipping errors fell by more than half.',
  },
  {
    icon: 'ph:calendar-check',
    title: 'Fewer transfer dates lost at the last minute',
    body: 'Because scheduling waited on acknowledged readiness, fewer couriers rolled before a clinic had really released, so fewer patients got a cancellation against a treatment deadline.',
  },
];

// The four-lens measurement frame Don and Daryl both described — the design's
// definition of success, not just a headline number.
const metricLenses = [
  { lens: 'Safety', items: ['Temperature excursions', 'Monitoring gaps', 'Chain-of-custody exceptions', 'Incomplete receiving records'] },
  { lens: 'Reliability', items: ['On-time pickups + deliveries', 'Rescheduled shipments', 'Shipments started without full readiness'] },
  { lens: 'Efficiency', items: ['Order-to-readiness time', 'Manual follow-ups per case', 'Exception resolution time'] },
  { lens: 'Experience', items: ['Status inquiries', 'Complaints', 'Stage-appropriate updates delivered'] },
];

// The edges — honest, not exhaustive. Both trace back to the same root cause:
// live telemetry from more than one source, polled continuously, with no
// shared cadence or labeling rule set early enough to prevent it.
const edges = [
  {
    icon: 'ph:speaker-high',
    title: 'One update speed, whether you wanted it or not',
    body: 'The tracker checked in every sixty seconds with temperature, location, humidity, battery level, and light exposure. Visually, that is fine sitting quietly in a browser tab. For someone using a screen reader, each update gets read aloud, and the next one started before the last one finished being read. We shipped a setting to slow it down, but a person has to go find it. The default is still the fast one, and a first-time user has to notice the noise before they know the control exists. If I revisit this, the fix is changing the default, not adding a second setting.',
  },
  {
    icon: 'ph:tag',
    title: 'Same label, different carrier',
    body: 'Once a shipment involved more than one carrier, our label-creation and transit-status announcements described both carriers with identical wording read aloud to a screen reader. A sighted user could tell them apart by where they sat on the screen. Someone using a screen reader testing the flow could not tell which carrier currently held the shipment. That is exactly the kind of confusion the whole product exists to prevent, and it only surfaced because someone who relies on a screen reader tested the multi-carrier path. First thing I would fix if I touched this flow again: name each carrier explicitly in that wording, so the confusion cannot happen again the next time a shipment adds a second carrier.',
  },
];

// The lifecycle model I specced with engineering. I defined the states, the
// readiness gate, and the alert severities the design required; engineering owned
// the Rails implementation. Showing it here is a record of that collaboration, not
// a claim that I wrote the backend.
const modelSnippet = `# app/models/shipment.rb  —  states + requirements I specced with engineering
# A shipment can't be scheduled until every party acknowledges readiness.
# That gate was the single change all three interviewees said they'd make first.
class Shipment < ApplicationRecord
  # "Requested" and "provisional" are NOT "confirmed." Conflating them is what
  # put couriers on the road before a clinic had released.
  enum status: { draft: 0, awaiting_readiness: 1, ready: 2,
                 scheduled: 3, in_transit: 4, delivered: 5,
                 accepted: 6, closed: 7, canceled: 8 }

  has_many :readiness_checks     # one per responsible party
  has_one  :cryo_shield_coverage # declared value + protection tier
  has_one  :shipment_tracker     # IVFCRYO-Sense: temp, GPS, humidity
  has_many :sensor_readings
  has_many :custody_events       # named contact + acknowledgment
  has_many :incidents
  has_many :notifications

  # Scheduling is gated, not assumed. "Sent" is not "approved."
  def schedulable?
    readiness_checks.all?(&:acknowledged?)
  end

  # Alerts are tiered so a normal fluctuation never pages like a critical
  # excursion — the office team stops trusting a channel that cries wolf.
  def record(reading)
    sensor_readings << reading
    case reading.severity          # :normal, :warning, :critical
    when :warning  then CryoAlertJob.perform_async(id, :warning)
    when :critical then CryoAlertJob.perform_async(id, :critical)
    end
  end
end`;

// The annotated wireframes render live in src/ so Astro can process them
// (anything under public/ is copied verbatim, never optimized). Source files are
// 3200px PNGs; `<Image>` emits sized WebP from these at build time.
const annotatedShots = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/projects/ivfcryo/wires-and-flows/*.png',
  { eager: true },
);
const annotated = (slug: string) =>
  annotatedShots[`../../assets/projects/ivfcryo/wires-and-flows/${slug}.png`].default;

// The bare sketch + wireframe SVGs stay in public/: Astro passes SVGs through
// untransformed either way, so moving them would buy nothing.
const art = (slug: string) => `/images/projects/ivfcryo/wires-and-flows/${slug}`;

// Four screens carry the argument, so they get full plates. The `note` is the
// subtitle written on the artwork itself, not a fresh gloss on it.
const plates = [
  {
    slug: '03-shipments-index',
    index: '03',
    title: 'Shipments index',
    note: 'The primary workspace. Readiness state is the top-level filter, not a column.',
    alt: 'Annotated wireframe of the shipments index: a filter bar, status tabs, and a list of shipment cards, with six numbered callouts explaining why status lives in the URL and why cards replaced table rows.',
  },
  {
    slug: '04-new-shipment',
    index: '04',
    title: 'New shipment',
    note: 'A forty-control form made survivable: numbered sections, live cost, declared value, and no dead ends.',
    alt: 'Annotated wireframe of the new-shipment form, broken into seven numbered sections from service selection to insurance, with a live price quote pinned beside it and six callouts covering quote recalculation, contact reuse, and notification defaults.',
  },
  {
    slug: '05-shipment-detail',
    index: '05',
    title: 'Shipment detail',
    note: 'One page that answers the only two questions anyone has: where is it, and is it still cold.',
    alt: 'Annotated wireframe of the shipment detail page: a live position map above sensor readings for temperature, humidity, and battery, then two parallel tracking timelines, with callouts explaining why telemetry outranks logistics and why the two legs stay unmerged.',
  },
  {
    slug: '06-public-tracking',
    index: '06',
    title: 'Public tracking',
    note: 'The unauthenticated view sent to recipients in notification email and SMS. No account, no sidebar, no raw telemetry.',
    alt: 'Annotated wireframe of the public tracking page: a plain-language status line, a four-step progress track, a live position map, and a staffed phone number in the footer, with callouts explaining why there is no login and why raw telemetry is withheld.',
  },
];

// The remaining screens round out the system without repeating the device.
const restOfSystem = [
  { slug: '01-landing', title: 'Landing' },
  { slug: '02-auth-two-factor', title: 'Auth + two-factor' },
  { slug: '07-address-book', title: 'Address book' },
  { slug: '08-users-admin', title: 'Users admin' },
  { slug: '09-equipment-inventory', title: 'Equipment inventory' },
  { slug: '10-admin-settings-feedback', title: 'Admin settings' },
];

const flows = [
  {
    slug: '11-flow-authentication',
    title: 'Authentication and account recovery',
    note: 'A security gate that must not become a support ticket. Every dead end has a way out.',
    alt: 'Flow diagram of authentication and account recovery. A visitor branches on whether they have an account, through sign-in, admin activation, a user-chosen email or SMS verification channel, and six-digit code entry. A failed code offers resend, backup code, or password reset, and a final admin check routes to either the admin or client view. Five numbered design notes sit alongside, and password recovery runs as a separate track underneath.',
  },
  {
    slug: '12-flow-create-shipment',
    title: 'Creating a shipment',
    note: 'The highest-consequence path in the product. Nine sections, one submit, no way to make an impossible booking.',
    alt: 'Flow diagram of the shipment creation path. Service selection resolves a live price quote or a contact-for-quote branch, then runs through date, package, pickup and delivery contacts, notification preferences, insurance, and agreement. Failed validation returns to the offending field with form state preserved, and a successful submit forks into a confirmation email and the admin fulfillment queue. Six numbered design notes sit alongside.',
  },
];

// Plates and flows are placed beside the argument they support rather than
// collected into one gallery, so these look them up by slug at the point of use.
const plate = (slug: string) => plates.find((p) => p.slug === slug)!;
const flow = (slug: string) => flows.find((f) => f.slug === slug)!;

// The TLDR digest. "Alternatives" and "Decision" restate the two-apps-vs-one
// call already argued in the #flows step; "Reflection" restates the edges
// section below rather than inventing a new critique — see
// src/pages/projects/interview-notes/tldr.md.
const tldr = {
  situation: `IVFCRYO ships cryogenically preserved embryos and reproductive tissue for fertility clinics. I led the design and owned the front end of a self-service logistics platform, for a patient who is often moving their last remaining embryo against a fixed clinical deadline.`,
  problem: `Stakeholder interviews with the owner, COO, and office manager showed the real friction wasn't the drive. It was getting five independent parties, patient, two clinics, courier, and IVFCRYO, provably ready before a shipment could move, on a paper process where "sent" and "received and approved" looked identical.`,
  alternativeA: {
    name: 'Two separate apps',
    body: `One for customers, one for the admin team, each simpler to build in isolation. Rejected: two apps means two records of one shipment, and the moment they drift apart the interface reintroduces the ambiguity the product exists to remove.`,
  },
  alternativeB: {
    name: 'One shared record, forked by role',
    body: `Two sitemaps off one shared home, a single shipment record underneath both the customer and admin experiences, plus a public, unauthenticated view for recipients.`,
  },
  decision: `I chose <strong class="text-ink font-semibold">one shared record forked by role</strong>, not two separate apps, because the whole point was to stop "sent" from ever being mistaken for "received and approved" again, and a second, drifting record would have reintroduced exactly that.`,
  implementation: `That decision is the Shipment lifecycle enum (draft through closed), gated by a <code class="font-mono text-[0.85em] bg-ink/[0.04] text-ink px-1 rounded-[4px]">schedulable?</code> method that only returns true once every party's readiness check is acknowledged, plus tiered alert jobs so a normal fluctuation never pages like a critical excursion.`,
  evidence: `Support calls fell 75% and shipping errors fell 55%. Patients could see both clinics had signed off instead of phoning to ask, and the readiness gate caught mistakes before a courier rolled.`,
  reflection: `A legally blind customer testing with a screen reader surfaced what I'd fix first: telemetry updates read aloud every sixty seconds at a pace that talks over itself by default, and once a shipment has two carriers, both get announced with identical wording. I'd change the default pace and name each carrier explicitly.`,
};
---

<BaseLayout title={title} description={description}>

  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <nav
        class="hero-in hero-in-1 mb-12 flex items-center gap-2 text-sm text-ink-muted"
        aria-label="Breadcrumb"
      >
        <a href="/projects/" class="transition-colors hover:text-accent">Projects</a>
        <Icon name="ph:caret-right" size={12} />
        <span class="text-ink">IVFCRYO</span>
      </nav>

      <div class="hero-grid">
        <div class="hero-main">
          <div class="hero-in hero-in-2 mb-7 flex items-center gap-3">
            <img src="/images/logos/ivfcryo.svg" alt="IVFCRYO logo" class="h-6 w-auto" />
            <span class="h-4 w-px bg-line-strong" aria-hidden="true"></span>
            <p class="mono-label">Case study</p>
          </div>

          <Heading level={1} visual="display-xl" class="hero-in hero-in-3">
            The box moves in a day. Getting five parties <em class="ink-wink font-normal italic">ready</em> is the work.
          </Heading>

          <Text size="lg" tone="muted" class="hero-in hero-in-4 mt-8 max-w-xl">
            A self-service platform for high-stakes fertility shipments. I led the
            design and owned the front end, then partnered with engineering on the
            software underneath it: the parts that track carriers, monitor
            temperature, and send notifications. The stakeholder research reframed the whole product around the person
            in the middle of it: a patient, often moving their only remaining embryo
            against a treatment deadline, left to project-manage two clinics and a
            courier no one had introduced. Tracking the truck was never the hard part. The
            real job was taking that burden off the patient and getting all five parties
            provably ready before a specimen left the lab.
          </Text>
        </div>

        <aside class="hero-in hero-in-5 hero-rail" aria-label="Project details">
          <dl>
            {meta.map((m) => (
              <div>
                <dt>{m.role}</dt>
                <dd set:html={m.value.replace(/·/g, '&middot;')}></dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </Container>
  </Section>

  <Tldr
    situation={tldr.situation}
    problem={tldr.problem}
    alternativeA={tldr.alternativeA}
    alternativeB={tldr.alternativeB}
    decision={tldr.decision}
    implementation={tldr.implementation}
    evidence={tldr.evidence}
    reflection={tldr.reflection}
  />

  <Section tone="paper" padding="tight" aria-label="Project receipts">
    <Container width="content">
      <p class="mono-label mb-8">Receipts</p>
      <dl class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {proof.map((group) => (
          <div class="border-t border-line pt-4">
            <dt class="mono-label mb-3">{group.label}</dt>
            <dd>
              <ul class="space-y-1.5">
                {group.items.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-ink-muted leading-relaxed">
                    <Icon name="ph:check" size={14} class="mt-0.5 shrink-0 text-accent" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </Container>
  </Section>

  <Section tone="paper" padding="tight">
    <Container width="content">
      <p class="mono-label mb-5">Table of contents</p>
      <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
        {docket.map((item, i) => (
          <li>
            <a href={item.href} class="group inline-flex items-center gap-3 text-ink transition-colors hover:text-accent">
              {item.icon && (
                <Icon name={item.icon} size={16} class="shrink-0 text-ink-muted transition-colors group-hover:text-accent" />
              )}
              <span class="font-medium">{item.label}</span>
              <Icon name="ph:arrow-right" size={15} class="shrink-0 transition-transform group-hover:translate-x-1" />
            </a>
          </li>
        ))}
      </ul>

      <Text size="lg" tone="muted" class="mt-10 measure">
        IVFCRYO ships cryogenically preserved embryos and reproductive tissue:
        material that is, quite literally, irreplaceable, sometimes a patient's last
        remaining embryo. I started with stakeholder research, interviewing the owner,
        the COO, and the office manager, and it changed how I framed the whole product.
        A shipment looks like one transaction to the patient, but it is a chain of
        separate responsibilities across five organizations that may never have worked
        together before. The person caught in that gap is the patient, already worn down
        by IVF, now carrying forms between two clinics and wondering whether anyone
        actually had the case. The driving takes a day; the coordination beforehand can
        take weeks. My job was to design a product that lifted that burden off the
        patient and gave the office team a case they could finally see, and to work
        closely enough with engineering that the system underneath could keep every
        promise the interface made.
      </Text>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="stakes" class="scroll-mt-24 border-t border-line">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 01</p>
          <Heading level={2} visual="display-md" tone="ink">Modeling a five-party workflow as a system</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Before a single screen, I mapped the shipping workflow as a system: a
              fragile, temperature-controlled specimen changing hands across two
              carriers and a courier, on a fixed clinical timeline. A mislabeled box,
              a missed temperature excursion, or an ambiguous status isn't a workflow
              annoyance here. It can be irreversible for someone's family.
            </p>
            <p>
              The research made the real shape clear. As Don, the owner, put it, a
              shipment "looks like one transaction to the patient, but it is actually a
              chain of separate responsibilities": patient, sending clinic, receiving
              clinic, courier, and IVFCRYO, each with its own systems, paperwork, and
              approvals. So the first design artifact wasn't a wireframe. It was a map of
              who owed what to whom, because the interface could only be as trustworthy as
              its model of what was actually happening to the box.
            </p>
          </div>

          <div class="mt-12">
            <p class="mono-label mb-6">Five independent parties, one shipment</p>
            <ol class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
              {parties.map((node, i) => (
                <li class="relative border-t border-line pt-5">
                  <div class="mb-3 flex items-center gap-3">
                    <Icon name={node.icon} size={20} class="text-ink-muted" />
                  </div>
                  <Heading level={3} visual="h3" tone="ink" class="mb-1.5">{node.title}</Heading>
