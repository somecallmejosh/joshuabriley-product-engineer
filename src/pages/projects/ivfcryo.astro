                    <p class="mt-0.5 text-sm text-ink-muted leading-snug">{svc.role}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-10">
            <p class="mono-label mb-6">Alert levels</p>
            <ul class="space-y-3">
              {alertTiers.map((t) => (
                <li class={`flex items-start gap-4 rounded-md border border-line py-4 pl-5 pr-5 border-l-2 ${t.tone === 'crit' ? 'border-l-[#C13A22]' : t.tone === 'warn' ? 'border-l-[#C7811E]' : 'border-l-[#3C7A4E]'}`}>
                  <span class="w-32 shrink-0 font-display font-semibold text-ink">{t.level}</span>
                  <span class="text-sm text-ink-muted leading-relaxed">{t.body}</span>
                </li>
              ))}
            </ul>
            <p class="mt-5 measure text-sm text-ink-muted leading-relaxed">
              Daryl's warning drove this: "if one device frequently generates false or
              unhelpful notifications, employees will eventually stop trusting it." With a
              single alert level, people learn to ignore alerts. Four levels, each with an
              assigned responder, keep minor readings from looking like emergencies.
            </p>
          </div>

          <div class="mt-10">
            <CodeBlock
              filename="shipment.rb"
              lang="ruby"
              code={modelSnippet}
              caption="The lifecycle model as a shared spec: scheduling gated on readiness, alerts tiered by severity. I defined the states and requirements; engineering owned the Rails implementation."
            />
          </div>
        </div>
      </div>
