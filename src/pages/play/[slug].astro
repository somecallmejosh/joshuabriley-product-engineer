---
import Breadcrumbs from '~/components/patterns/Breadcrumbs.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import GameIllustration from '~/components/patterns/GameIllustration.astro';
import GameStage from '~/components/patterns/GameStage.astro';
import { GAMES, type Game } from '~/lib/games';
import { hasGameIllustration } from '~/lib/game-illustrations';

export function getStaticPaths() {
  return GAMES.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

const { game } = Astro.props as { game: Game };
// The next game in the Play page's order, looping back to the first.
const next = GAMES[(GAMES.indexOf(game) + 1) % GAMES.length];
---

<BaseLayout title={`${game.title} | Play | Joshua Briley`} description={`${game.summary} A short accessibility game with no signup.`}>
  <section class="page-opener">
    <Container width="wide">
      <Breadcrumbs class="hero-in hero-in-1" items={[{ href: '/play/', label: 'Play' }]} current={game.title} />
      <div class="game-hero hero-split">
        <div class="hero-split-copy">
          <h1 class="page-type hero-in hero-in-2">{game.heading.lead} <em>{game.heading.emphasis}</em></h1>
          <p class="page-lede hero-in hero-in-3">{game.summary}</p>
        </div>
        {hasGameIllustration(game.slug) && <div class="game-hero-illustration hero-split-media hero-in hero-in-3"><GameIllustration game={game.slug} /></div>}
      </div>
    </Container>
  </section>

  <section class="editorial-section game-section">
    <Container width="wide">
      <div class="game-layout">
        <div class="game-stage">
          <GameStage game={game} />
        </div>

        <aside class="game-aside">
          <section class="learn surface-denim" aria-labelledby="game-learn-title">
            <h2 id="game-learn-title" class="aside-label">Lesson</h2>
            <p class="learn-text">{game.teaches}</p>
          </section>

          <section class="up-next" aria-labelledby="game-next-title">
            <h2 id="game-next-title" class="aside-label">Up next</h2>
            <a class="next-tile" href={`/play/${next.slug}/`}>
              {hasGameIllustration(next.slug) && <span class="next-art" aria-hidden="true"><GameIllustration game={next.slug} /></span>}
              <span class="next-title"><span>{next.title}</span> <span aria-hidden="true" class="title-arrow" data-link-arrow="up-right">↗</span></span>
              <span class="next-summary">{next.summary}</span>
            </a>
            <a class="editorial-link" href="/play/">All {GAMES.length} games <span aria-hidden="true" data-link-arrow="right">→</span></a>
          </section>
        </aside>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .game-hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .game-hero-illustration {
    min-width: 0;
    max-width: 36rem;
  }
  @media (min-width: 1024px) {
    .game-hero {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }
  .game-section {
    padding-top: 0;
  }
  .game-layout {
    display: grid;
    gap: var(--space-block);
  }
  @media (min-width: 1024px) {
    .game-layout {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      align-items: start;
      gap: 5rem;
    }
  }
  /* The aside follows the game down the page, like the site's section headings. */
  .game-aside { display: grid; gap: 1rem; }
  @media (min-width: 1024px) {
    .game-aside { position: sticky; top: 7rem; align-self: start; }
  }
  .aside-label { font-size: .86rem; font-weight: 500; color: var(--ink-muted); }

  .learn { padding: 2rem; background: var(--portfolio-blue); }
  .learn .aside-label { color: color-mix(in srgb, var(--paper) 82%, transparent); }
  .learn-text { margin-top: .75rem; font-size: clamp(1.2rem, 1.05rem + .5vw, 1.45rem); font-weight: 600; line-height: 1.4; letter-spacing: -.02em; color: var(--paper); text-wrap: pretty; }

  .up-next { display: grid; justify-items: start; gap: .75rem; padding-top: 1rem; }
  .next-tile { display: block; width: 100%; padding: 1.5rem; background: var(--portfolio-tint); color: var(--ink); }
  .next-art { display: block; margin-bottom: 1.25rem; }
  .next-art :global(.illustration) { --mat: 0rem; background: none; }
  .next-title { display: block; font-size: 1.4rem; font-weight: 800; line-height: 1.2; letter-spacing: -.04em; }
  .next-title > span:first-child { text-decoration: underline; text-decoration-color: var(--line-strong); text-decoration-thickness: 1px; text-underline-offset: 5px; transition: color .2s, text-decoration-color .2s; }
  .next-summary { display: block; margin-top: .5rem; font-size: .95rem; line-height: 1.55; color: var(--ink-muted); }
  /* Color and transform only, so nothing shifts on hover. */
  .next-tile:is(:hover, :focus-visible) .next-title > span:first-child { color: var(--accent); text-decoration-color: currentColor; }
  .next-tile:is(:hover, :focus-visible) :global(.illustration-drawing) { transform: rotate(0deg) scale(1.03); }
  .next-tile:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    .next-title > span:first-child { transition: none; }
    .next-tile:is(:hover, :focus-visible) :global(.illustration-drawing) { transform: rotate(var(--tilt)); }
  }
</style>
