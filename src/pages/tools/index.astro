---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import ToolIllustration from '~/components/patterns/ToolIllustration.astro';
import { TOTAL_ITEMS } from '~/lib/scorecard';

const tools = (await getCollection('tools', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = tools.find((tool) => tool.id === 'scorecard');
const rest = tools.filter((tool) => tool.id !== 'scorecard');
const uses: Record<string, { question: string; outcome: string }> = {
  'roi-calculator': { question: 'Making the case for shared UI?', outcome: 'A starting estimate for a planning or budget conversation. Every assumption is shown.' },
  'token-playground': { question: 'Explaining how tokens work?', outcome: 'A live example you can use to discuss shared decisions with designers and engineers.' },
  'audit-findings': { question: 'Deciding what to fix first?', outcome: 'Example findings with severity, the affected interface, and a specific fix.' },
};
---
<BaseLayout title="Free design system tools | Joshua Briley" description="Assess your design system, estimate UI rework costs, explore design tokens, and inspect sample audit findings. Four free browser tools, no signup required.">
  <section class="calm-open">
    <Container>
      <p class="calm-label hero-in hero-in-1">Design system tools <span aria-hidden="true">·</span> Free to use</p>
      <h1 class="calm-title hero-in hero-in-2">Tools for planning design system work.</h1>
      <p class="calm-lede hero-in hero-in-3">Shared UI should make your team’s work easier. These four tools help you assess what’s working, understand the cost of rework, and make the next decision.</p>
      <p class="calm-note tools-note hero-in hero-in-3">No signup or installation. Tool inputs stay in your browser; shared scorecard results and calculator settings are included in their links.</p>
      <nav class="calm-jumps hero-in hero-in-4" aria-label="Choose a tool">
        {tools.map((tool) => <a href={`/tools/${tool.id}/`}>{tool.data.kind} <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>)}
      </nav>
    </Container>
  </section>

  {featured && (
    <section class="scorecard-feature" aria-labelledby="scorecard-title">
      <Container width="wide">
        <div class="scorecard-layout" data-reveal>
          <div class="scorecard-copy">
            <p class="calm-label">Not sure where to start?</p>
            <h2 id="scorecard-title">Design system scorecard.</h2>
            <p>Take a structured look at your shared UI. Answer {TOTAL_ITEMS} prompts and get a breakdown of strengths, gaps, and suggested priorities for your team.</p>
            <a class="editorial-link" href="/tools/scorecard/">Take the assessment <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
            <p class="assessment-note">About ten minutes. Based on your answers; a starting point for review.</p>
          </div>
          <a class="scorecard-illustration" href="/tools/scorecard/" tabindex="-1" aria-hidden="true"><ToolIllustration tool="ScorecardEngine" /></a>
        </div>
      </Container>
    </section>
  )}

  <section class="calm-section tools-directory" aria-labelledby="other-tools-title">
    <Container width="wide">
      <h2 id="other-tools-title" class="calm-heading">Have a specific question?</h2>
      <p class="calm-intro">Estimate the effort, try a shared design decision, or see how an issue becomes an actionable finding.</p>
      <div class="tool-list" data-reveal-stagger>
        {rest.map((tool) => (
          <article class="tool-entry">
            <a class="tool-visual" href={`/tools/${tool.id}/`} tabindex="-1" aria-hidden="true"><ToolIllustration tool={tool.data.tool} /></a>
            <p class="work-card-kind">{uses[tool.id]?.question ?? tool.data.kind}</p>
            <h3 class="work-card-title"><a href={`/tools/${tool.id}/`}><strong>{tool.data.title}</strong></a></h3>
            <p class="work-card-result">{tool.data.description}</p>
            <p class="tool-outcome">{uses[tool.id]?.outcome ?? tool.data.takeaway}</p>
            <a class="editorial-link" href={`/tools/${tool.id}/`}>{tool.data.action} <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <section class="calm-section tools-evidence" aria-labelledby="tools-evidence-title">
    <Container>
      <h2 id="tools-evidence-title" class="calm-heading">See how I apply this.</h2>
      <p class="calm-intro">These tools make parts of my approach tangible. The work shows the context: what I owned, the tradeoffs, and the result.</p>
      <div class="calm-column resource-list">
        <a href="/personal-projects/rudiment-ui/"><span><strong>Explore a component system</strong><span>Rudiment UI: a personal reference project with tokens, component APIs, and live Storybook examples.</span></span><span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
        <a href="/projects/ivfcryo/"><span><strong>Follow an interface decision</strong><span>IVFCRYO: design alternatives, form behavior, and recovery paths in a product workflow.</span></span><span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
        <a href="/resume/#experience"><span><strong>Review my systems experience</strong><span>Enterprise design systems experience and twenty-plus years of production UI.</span></span><span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  /* The scorecard leads on paper: light display type beside its illustration,
     not a coloured slab. The other tools follow as an even three-up index. */
  .tools-note { max-width: 46ch; margin-inline: auto; }
  .scorecard-feature { padding: clamp(2rem, 5vw, 4rem) 0 clamp(3rem, 6vw, 5rem); }
  .scorecard-layout { display: grid; gap: 3rem; }
  .scorecard-copy h2 { max-width: 14ch; margin-top: 1rem; font-size: clamp(2.3rem, 4.4vw, 4rem); font-weight: 300; line-height: 1.05; letter-spacing: -.045em; text-wrap: balance; }
  .scorecard-copy > p:not([class]) { max-width: 44ch; margin-top: 1.5rem; font-size: 1.15rem; line-height: 1.6; color: var(--ink-muted); }
  .scorecard-copy .editorial-link { margin-top: 1.5rem; }
  .assessment-note { max-width: 43ch; margin-top: .5rem; font-size: .85rem; line-height: 1.6; color: var(--ink-muted); }
  .scorecard-illustration, .tool-visual { display: block; min-width: 0; }
  .tool-list { display: grid; gap: 4rem 3rem; margin-top: clamp(2.5rem, 5vw, 4rem); }
  .tool-entry { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  .tool-visual { align-self: stretch; }
  .tool-entry .work-card-title { font-size: clamp(1.35rem, 1.9vw, 1.6rem); }
  .tool-entry .work-card-result { font-size: 1rem; line-height: 1.6; }
  .tool-outcome { margin-top: .75rem; font-size: .875rem; line-height: 1.55; color: var(--ink-muted); }
  .tool-entry .editorial-link { margin-top: 1rem; }
  @media (min-width: 900px) {
    .tool-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .scorecard-layout { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 5rem; align-items: center; }
  }
</style>
