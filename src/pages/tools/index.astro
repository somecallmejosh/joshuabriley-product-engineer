---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import ToolBench from '~/components/islands/ToolBench.astro';

const tools = (await getCollection('tools', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---
<BaseLayout title="Free design system tools | Joshua Briley" description="Assess your design system, estimate UI rework costs, explore design tokens, and inspect sample audit findings. Four free browser tools, no signup required.">
  <section class="page-opener tools-opener">
    <Container width="wide">
      <p class="role-line hero-in hero-in-1">Design system tools <span aria-hidden="true">/</span> Free to use</p>
      <h1 class="page-type hero-in hero-in-2">Tools for planning <em>design system work.</em></h1>
      <p class="page-lede hero-in hero-in-3">Four free tools to assess your shared UI, estimate what its rework costs, and decide what to fix next. You can try a small piece of each one right here.</p>
    </Container>
  </section>

  <section class="tools-bench" aria-label="The tools">
    <Container width="wide">
      <ToolBench tools={tools} />
      <div class="tools-notes">
        <p>No signup or installation. Tool inputs stay in your browser; shared scorecard results and calculator settings are included in their links.</p>
        <p>Want something lighter? <a class="editorial-link" href="/play/">Try the accessibility games <span aria-hidden="true" data-link-arrow="right">→</span></a></p>
      </div>
    </Container>
  </section>

  <section class="editorial-section tools-evidence" aria-labelledby="tools-evidence-title">
    <Container width="wide">
      <div class="approach-layout">
        <div>
          <h2 id="tools-evidence-title" class="section-type">See how I <em>apply this.</em></h2>
          <p class="section-intro">These tools come from how I approach design system work. The case studies show that approach on real projects: what I owned, the tradeoffs, and the result.</p>
        </div>
        <div class="resource-list">
          <a href="/personal-projects/rudiment-ui/"><span><strong>Explore a component system</strong><span>Rudiment UI: a personal reference project with tokens, component APIs, and live Storybook examples.</span></span><span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
          <a href="/projects/ivfcryo/"><span><strong>Follow an interface decision</strong><span>IVFCRYO: design alternatives, form behavior, and recovery paths in a product workflow.</span></span><span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
          <a href="/resume/#experience"><span><strong>Review my systems experience</strong><span>Enterprise design systems experience and twenty-plus years of production UI.</span></span><span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .tools-opener .page-type { max-width: 19ch; }
  .tools-opener .page-lede { max-width: 53ch; }
  .tools-bench { padding-bottom: var(--space-section); }
  .tools-notes { display: grid; gap: 1rem; margin-top: 2rem; font-size: .85rem; line-height: 1.65; color: var(--ink-muted); }
  .tools-notes p { max-width: 58ch; }
  .tools-evidence { background: var(--portfolio-tint); }
  @media (min-width: 1024px) {
    .tools-notes { grid-template-columns: 1fr auto; gap: 4rem; align-items: center; }
  }
</style>
