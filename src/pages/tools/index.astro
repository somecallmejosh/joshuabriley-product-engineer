---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import ToolBench from '~/components/islands/ToolBench.astro';

const tools = (await getCollection('tools', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---
<BaseLayout title="Free design system tools | Joshua Briley" description="Assess your design system, estimate UI rework costs, explore design tokens, and inspect sample audit findings. All four tools are free and run in your browser without signup.">
  <section class="page-opener tools-opener">
    <Container width="wide">
      <h1 class="page-type hero-in hero-in-2">Tools for planning <em>design system work.</em></h1>
      <p class="page-lede hero-in hero-in-3">These tools assess a design system, estimate the cost of UI rework, demonstrate design tokens, and show sample audit findings. All four are free. Each one has a working sample on this page.</p>
    </Container>
  </section>

  <section class="tools-bench" aria-label="The tools">
    <Container width="wide">
      <ToolBench tools={tools} />
      <div class="tools-notes">
        <p>The tools need no signup or installation. Your inputs stay in your browser. A shared scorecard or calculator link stores its results or settings in the URL.</p>
        <p><a class="editorial-link" href="/play/">Play the accessibility games <span aria-hidden="true" data-link-arrow="right">→</span></a></p>
      </div>
    </Container>
  </section>

  <section class="editorial-section tools-evidence" aria-labelledby="tools-evidence-title">
    <Container width="wide">
      <div class="approach-layout">
        <div>
          <h2 id="tools-evidence-title" class="section-type">Related work</h2>
          <p class="section-intro">These tools are based on my approach to design system work. The links below show that approach in a reference project, a client case study, and my résumé.</p>
        </div>
        <div class="resource-list">
          <a href="/personal-projects/rudiment-ui/"><span><strong>Explore a component system</strong><span>Rudiment UI is a personal reference project with tokens, component APIs, and live Storybook examples.</span></span><span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
          <a href="/projects/ivfcryo/"><span><strong>Follow an interface decision</strong><span>The IVFCRYO case study covers design alternatives, form behavior, and recovery paths in a product workflow.</span></span><span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
          <a href="/resume/#experience"><span><strong>Review my systems experience</strong><span>My résumé lists enterprise design system roles and more than twenty years of production UI work.</span></span><span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .tools-opener .page-type { max-width: 19ch; }
  .tools-opener .page-lede { max-width: 53ch; }
  .tools-bench { padding-bottom: var(--space-section); }
  .tools-notes { display: grid; gap: 1rem; margin-top: 2rem; font-size: .85rem; line-height: 1.65; color: var(--ink-muted); }
  .tools-notes p { max-width: 58ch; }
  .tools-evidence { background: var(--portfolio-tint); }
  @media (min-width: 1024px) {
    .tools-notes { grid-template-columns: 1fr auto; gap: 4rem; align-items: center; }
  }
</style>
