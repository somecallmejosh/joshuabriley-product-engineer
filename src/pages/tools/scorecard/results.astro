---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import CTABanner from '~/components/patterns/CTABanner.astro';

const description =
  'Your personalized design system scorecard results with recommendations based on the five dimensions of a healthy design system.';
---

<BaseLayout
  title="Your Scorecard Results | Joshua Briley | Design Systems & UI Platform Engineer"
  description={description}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://joshuabriley.com/tools/scorecard/results/" />
    <meta property="og:title" content="Your Scorecard Results | Joshua Briley" />
    <meta
      property="og:description"
      content="Your personalized design system scorecard results with recommendations."
    />
    <meta property="og:image" content="/images/social/og-image-2026.png" />
    <meta property="og:site_name" content="Joshua Briley" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Your Scorecard Results | Joshua Briley" />
    <meta
      name="twitter:description"
      content="Your personalized design system scorecard results with recommendations."
    />
    <meta name="twitter:image" content="/images/social/og-image-2026.png" />
  </Fragment>

  <Section tone="paper" padding="tight" class="pt-12 md:pt-16">
    <Container width="wide">
      <div class="flex items-center justify-between gap-4 mono-label">
        <span>Tools / Self-assessment</span>
        <span class="hidden sm:inline text-ink-muted">Results</span>
      </div>

      <div class="mt-10 max-w-3xl lg:mt-12">
        <Heading level={1} visual="display-xl" class="max-w-[18ch]">
          Your <em class="ink-wink font-normal italic">report card</em> is in.
        </Heading>
        <Text size="lg" tone="muted" class="mt-7 max-w-xl">
          Here is how your design system scored across all five dimensions, plus a personalized
          recommendation for where to start.
        </Text>

        <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-muted">
          {['Saved in the URL', 'No account', 'Retake anytime'].map((p) => (
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>{p}
            </li>
          ))}
        </ul>
      </div>
    </Container>
  </Section>

  <Section tone="ink" padding="default" class="verdict-section">
    <Container width="wide">
      <div id="verdictBand"></div>
    </Container>
  </Section>

  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-2xl">
        <p class="mono-label">Performance overview</p>
        <Heading level={2} visual="display-md" class="mt-4">How you scored, by dimension.</Heading>
      </div>

      <div class="mt-12 grid items-center gap-10 lg:mt-14 lg:grid-cols-2 lg:gap-16">
        <div class="report-paper" id="radarCard">
          <div id="radarChartContainer" aria-hidden="true"></div>
        </div>
        <div id="breakdownPanel"></div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <div id="recommendationContainer"></div>
    </Container>
  </Section>

  <CTABanner
    eyebrow="The results are the URL"
    title="The whole report is in the address bar."
    lead="No database, no account, no cookie: a few characters carry the entire result. It is the same philosophy as the rest of this site: state where it belongs, structure doing the work. Want to compare notes on your score, or talk about how this was built?"
  >
    <Button variant="navy" size="lg" iconLeft="ph:envelope-duotone" href="/contact/" class="js-magnetic">
      Get in touch
    </Button>
    <Button variant="secondary" size="lg" iconLeft="ph:linkedin-logo-duotone" href="https://www.linkedin.com/in/joshuabriley/">
      Connect on LinkedIn
    </Button>
  </CTABanner>
</BaseLayout>

<style is:global>
  /* ═══ VERDICT BAND — the billboard grade reveal ════════════════════════ */
  .verdict-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .verdict-grid {
      grid-template-columns: minmax(0, auto) minmax(0, 1fr);
      gap: clamp(2.5rem, 6vw, 5.5rem);
    }
  }

  .verdict-grade {
    font-family: var(--font-fraunces), Georgia, serif;
    font-weight: 600;
    line-height: 0.74;
    letter-spacing: -0.045em;
    font-size: clamp(7rem, 27vw, 15.5rem);
    color: var(--paper);
  }
  .verdict-grade[data-status='investment'] { color: var(--accent); }
  .verdict-grade .g {
    display: inline-block;
    opacity: 0;
    transform: scale(0.72) translateY(0.1em);
    filter: blur(10px);
    transition:
      opacity 0.8s var(--ease-out),
      transform 1s var(--ease-out),
      filter 0.8s var(--ease-out);
  }
  .verdict-grid.is-in .verdict-grade .g { opacity: 1; transform: none; filter: blur(0); }

  .verdict-score {
    font-family: var(--font-fraunces), Georgia, serif;
    font-weight: 500;
    font-size: clamp(2.2rem, 5vw, 3.25rem);
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--paper);
  }
  .verdict-score .slash { color: rgba(246, 247, 249, 0.45); }

  .verdict-meter {
    height: 6px;
    border-radius: 999px;
    background: rgba(246, 247, 249, 0.14);
    overflow: hidden;
  }
  .verdict-meter i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: var(--paper);
    transition: width 1s var(--ease-out) 0.25s;
  }
  .verdict-grid.is-in .verdict-meter i { width: var(--w, 0%); }

  /* status pill — ink-surface variant (paper text) */
  .verdict-details .status-pill { color: rgba(246, 247, 249, 0.7); }
  .verdict-details .status-pill::before { background: rgba(246, 247, 249, 0.5); }
  .verdict-details .status-pill.critical { color: var(--accent); }
  .verdict-details .status-pill.critical::before { background: var(--accent); }

  /* ═══ BREAKDOWN — staggered dimension rows + bars ══════════════════════ */
  #breakdownPanel .bd-row {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.6s var(--ease-out) var(--d, 0s),
      transform 0.6s var(--ease-out) var(--d, 0s);
  }
  #breakdownPanel.is-in .bd-row { opacity: 1; transform: none; }
  #breakdownPanel .mini-bar-fill {
    width: 0;
    transition: width 0.85s var(--ease-out) var(--d, 0s);
  }
  #breakdownPanel.is-in .mini-bar-fill { width: var(--w, 0%); }

  /* ═══ RADAR draw-in (scales up from centre) ════════════════════════════ */
  #radarChartContainer .radar-data {
    opacity: 0;
    transform: scale(0.55);
    transform-origin: 230px 170px;
    transition:
      opacity 0.7s var(--ease-out) 0.1s,
      transform 0.95s var(--ease-out) 0.1s;
  }
  #radarCard.is-in #radarChartContainer .radar-data { opacity: 1; transform: none; }

  /* ── Mini score bars — flat ink fill on a line track, no knob, no stripes ── */
  .mini-bar-track {
    position: relative;
    height: 6px;
    background-color: var(--line);
    border-radius: 999px;
    overflow: hidden;
  }
  .mini-bar-fill {
    position: relative;
    height: 100%;
    border-radius: 999px;
    background: var(--ink);
    transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .mini-bar-fill.neutral {
    background: var(--ink-faint);
  }

  /* ── Status label — monospace, ink text + a small accent tick ── */
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--ink-muted);
  }
  .status-pill::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 1px;
    flex-shrink: 0;
    background: var(--ink-faint);
  }
  .status-pill.strong::before {
    background: var(--ink);
  }
  .status-pill.attention::before {
    background: var(--ink-muted);
  }
  .status-pill.critical::before {
    background: var(--accent);
  }
  .status-pill.critical {
    color: var(--accent);
  }

  /* ── Recommendation section list (inside ink reveal-card) ── */
  .rec-section-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .rec-section-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-size: 0.9rem;
  }

  /* ── "Where to focus" heading inside the ink card ── */
  .focus-heading {
    display: block;
    margin-bottom: 1rem;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 500;
    color: rgba(246, 247, 249, 0.65);
  }

  /* ── Focus list — clean hairline cards with mono index numerals ── */
  .focus-list {
    display: flex;
    flex-direction: column;
  }
  .focus-item {
    position: relative;
    padding: 1.25rem 0;
    border-top: 1px solid rgba(246, 247, 249, 0.15);
  }
  .focus-item:first-child {
    border-top: none;
    padding-top: 0;
  }
  .focus-priority {
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 500;
    color: rgba(246, 247, 249, 0.6);
    letter-spacing: 0.04em;
  }
  .focus-item-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--paper);
    letter-spacing: -0.005em;
  }
  .focus-item-score {
    margin-left: auto;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 500;
    color: rgba(246, 247, 249, 0.55);
    white-space: nowrap;
  }
  .focus-item-score strong {
    color: var(--paper);
    font-weight: 600;
  }
  .focus-item-benefit {
    margin-top: 0.65rem;
    padding-left: 1.65rem;
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(246, 247, 249, 0.75);
  }
  .focus-item-consequence {
    position: relative;
    margin: 0.85rem 0 0 1.65rem;
    padding: 0.6rem 0.9rem;
    border-left: 2px solid var(--accent);
    border-radius: 0 6px 6px 0;
    background: rgb(var(--accent-rgb) / 0.12);
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-size: 0.88rem;
    line-height: 1.55;
    color: rgba(246, 247, 249, 0.82);
  }
  .focus-item-consequence-label {
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--paper);
    margin-right: 0.35rem;
  }
  @media (max-width: 640px) {
    .focus-item-benefit,
    .focus-item-consequence {
      padding-left: 0;
      margin-left: 0;
    }
    .focus-item-consequence {
      padding-left: 0.9rem;
    }
  }

  /* ── Secondary recommendation block (inside ink card) ── */
  .secondary-rec {
    margin-top: 1.5rem;
    padding: 1.25rem;
    border-radius: 8px;
    background: rgba(246, 247, 249, 0.06);
    border: 1px solid rgba(246, 247, 249, 0.15);
  }
</style>

<script>
  import {
    SECTIONS,
    TOTAL_MAX,
    VALID_PARAM_RE,
    decodeRatings,
    sectionScore,
    sectionStatus,
    getTotalScore,
    totalPercent,
    getTotalStatus,
    letterGrade,
    type Ratings,
    type ScorecardSection,
    type SectionStatus,
    type TotalStatus,
  } from '~/lib/scorecard';

  // ─── Helpers not yet exported from ~/lib/scorecard (ported from
  //     legacy /scripts/scorecard-engine.js so this page can render results
  //     without modifying the shared lib). ─────────────────────────────────────

  const SHORT_LABELS: Record<string, string> = {
    'Component consistency': 'Consistency',
    'Accessibility': 'Accessibility',
    'Token architecture': 'Tokens',
    'Documentation': 'Docs',
    'Handoff process': 'Handoff',
  };

  const SECTION_BENEFITS: Record<string, string> = {
    'Component consistency':
      'When patterns live in one shared library, every fix propagates automatically. Your team stops rebuilding the same button a dozen different ways and designers trust that what they spec is what ships.',
    'Accessibility':
      'Accessible defaults widen your addressable market, shield you from legal exposure, and surface usability bugs that hurt every user, not just those relying on assistive tech. Baking it in early costs a fraction of retrofitting it later.',
    'Token architecture':
      'Tokens turn rebrands, theming, and dark mode into a config change instead of a codebase-wide sweep. Design decisions become cheap to revisit, which means the system can evolve without stalling the roadmap.',
    'Documentation':
      'Clear docs replace Slack threads and tribal knowledge. New hires ramp in days instead of weeks, designers stop guessing at what components already exist, and the system scales past the handful of people who built it.',
    'Handoff process':
      'A shared vocabulary between design and code means less rework, fewer one-off rebuilds, and faster shipping. Fix the ritual once and the sprint tax (the questions, the Figma-to-PR translation, the surprise at review) largely goes away.',
  };

  const SECTION_CONSEQUENCES: Record<string, string> = {
    'Component consistency':
      'Leave it alone and every team keeps shipping slight variations of the same component. A minor button tweak turns into a week of hunting down one-offs, and the same bugs keep resurfacing because the fix only landed in half the places it needed to.',
    'Accessibility':
      'Ignore it and you are one complaint or procurement review away from an expensive retrofit, while quietly locking out the roughly 1-in-4 users who rely on assistive tech, larger text, or reduced motion. The usability bugs it hides hurt every user, not just the ones you are overlooking.',
    'Token architecture':
      'Without tokens, every rebrand, theme, or dark-mode ask becomes a multi-sprint search-and-replace. Small visual changes balloon into cross-team projects, and the first time a rebrand or white-label gets proposed, the estimate quietly kills the idea.',
    'Documentation':
      'Skip this and institutional knowledge stays trapped in Slack DMs and 1:1s. Onboarding stretches from days into weeks, designers rebuild components that already exist, and the handful of people who know how the system works become bottlenecks the whole team routes through.',
    'Handoff process':
      'Left unaddressed, handoff friction becomes a hidden tax on every sprint: duplicate Figma-to-code translation, surprise PR reviews, and components rebuilt because no one knew they existed. Nothing breaks outright. Everything just ships slower than it should, and the team stops noticing the drag.',
  };

  const STATUS_LABEL: Record<SectionStatus, string> = {
    strong: 'Strong',
    'needs-attention': 'Needs attention',
    critical: 'Critical gap',
  };

  const TOTAL_STATUS_LABEL: Record<TotalStatus, string> = {
    healthy: 'Healthy',
    functional: 'Functional but inconsistent',
    investment: 'Significant investment needed',
  };

  const STATUS_COLORS: Record<TotalStatus, string> = {
    healthy: '#1B1A17',
    functional: '#1B1A17',
    investment: '#2E5C8A',
  };

  function sectionPercent(section: ScorecardSection, ratings: Ratings): number {
    return Math.round((sectionScore(section, ratings) / section.max) * 100);
  }

  function getWeakestSection(ratings: Ratings): ScorecardSection {
    return SECTIONS.reduce((weakest, section) => {
      const ratio = sectionScore(section, ratings) / section.max;
      const weakestRatio = sectionScore(weakest, ratings) / weakest.max;
      return ratio < weakestRatio ? section : weakest;
    });
  }

  function getCriticalSections(ratings: Ratings): ScorecardSection[] {
    return SECTIONS.filter((s) => sectionStatus(s, ratings) === 'critical');
  }

  type StrongSec = { title: string; score: number; max: number };
  type WeakSec = StrongSec & { status: SectionStatus };
  type Recommendation =
    | { type: 'healthy' }
    | {
        type: 'audit' | 'workflow';
        label: string;
        tagline: string;
        why: string;
        strongSections: StrongSec[];
        weakSections: WeakSec[];
        secondaryRecommendation?: { label: string; sectionNames: string[] };
      };

  function getRecommendationType(ratings: Ratings): 'audit' | 'workflow' | 'healthy' {
    const score = getTotalScore(ratings);
    const status = getTotalStatus(score);
    const criticals = getCriticalSections(ratings);
    const weakest = getWeakestSection(ratings);

    if (criticals.length > 0) return 'audit';
    if (status === 'healthy') return 'healthy';
    if (status === 'investment') return 'audit';
    return weakest.id === 's5' ? 'workflow' : 'audit';
  }

  function buildRecommendation(ratings: Ratings): Recommendation {
    const recType = getRecommendationType(ratings);
    if (recType === 'healthy') return { type: 'healthy' };

    const strong: StrongSec[] = SECTIONS
      .filter((s) => sectionStatus(s, ratings) === 'strong')
      .sort((a, b) => sectionScore(b, ratings) / b.max - sectionScore(a, ratings) / a.max)
      .map((s) => ({ title: s.title, score: sectionScore(s, ratings), max: s.max }));

    const weak: WeakSec[] = SECTIONS
      .filter((s) => {
        const st = sectionStatus(s, ratings);
        return st === 'needs-attention' || st === 'critical';
      })
      .sort((a, b) => sectionScore(a, ratings) / a.max - sectionScore(b, ratings) / b.max)
      .map((s) => ({
        title: s.title,
        score: sectionScore(s, ratings),
        max: s.max,
        status: sectionStatus(s, ratings) as SectionStatus,
      }));

    if (recType === 'workflow') {
      const s5 = SECTIONS.find((s) => s.id === 's5')!;
      const s5Score = sectionScore(s5, ratings);

      const strongNonHandoff = strong.filter((s) => s.title !== 'Handoff process');
      let why: string;
      if (strongNonHandoff.length === 0) {
        why = `Your handoff process (${s5Score}/12) is costing your team time every sprint. Design and development are not fully aligned. That leads to rework, inconsistent UI, and repeated conversations. This is a workflow issue, not a tooling issue.`;
      } else if (strongNonHandoff.length === 1) {
        why = `Your ${strongNonHandoff[0].title.toLowerCase()} is a solid foundation. But your handoff process (${s5Score}/12) is costing your team time every sprint. Design and development are not fully aligned. That leads to rework, inconsistent UI, and repeated conversations. This is a workflow issue, not a tooling issue.`;
      } else {
        const titles = strongNonHandoff.map((s) => s.title.toLowerCase());
        const last = titles.pop();
        why = `Your ${titles.join(', ')} and ${last} are solid foundations. But your handoff process (${s5Score}/12) is costing your team time every sprint. Design and development are not fully aligned. That leads to rework, inconsistent UI, and repeated conversations. This is a workflow issue, not a tooling issue.`;
      }

      const secondarySections = SECTIONS.filter((s) => {
        if (s.id === 's5') return false;
        const st = sectionStatus(s, ratings);
        return st === 'needs-attention' || st === 'critical';
      });

      return {
        type: 'workflow',
        label: 'Design-to-Code Workflow',
        tagline: 'Reduce handoff friction and rework. Fix the process once so your team stops losing time to it every sprint.',
        why,
        strongSections: strong,
        weakSections: weak,
        secondaryRecommendation: secondarySections.length > 0
          ? {
              label: 'Design System Audit',
              sectionNames: secondarySections.map((s) => s.title),
            }
          : undefined,
      };
    }

    // Audit recommendation
    const score = getTotalScore(ratings);
    const status = getTotalStatus(score);
    const criticals = getCriticalSections(ratings);
    let why: string;
    if (status === 'investment') {
      why = 'With critical gaps across multiple dimensions, the Audit gives you a prioritized roadmap before you invest in rebuilding.';
    } else if (criticals.length > 0) {
      const names = criticals.map((s) => s.title.toLowerCase());
      const last = names.pop();
      const joined = names.length > 0 ? `${names.join(', ')} and ${last}` : last;
      why = `Your ${joined} ${criticals.length === 1 ? 'has' : 'have'} a critical gap that needs expert analysis before it compounds into a larger problem.`;
    } else {
      const weakNames = weak.map((s) => s.title.toLowerCase());
      const last = weakNames.pop();
      const joined = weakNames.length > 0 ? `${weakNames.join(', ')} and ${last}` : last;
      why = `Your ${joined} ${weak.length === 1 ? 'shows' : 'show'} structural gaps that need expert analysis before you invest in fixing them.`;
    }

    return {
      type: 'audit',
      label: 'Design System Audit',
      tagline: "Before you build anything new, you need to understand what’s actually broken.",
      why,
      strongSections: strong,
      weakSections: weak,
    };
  }

  function getChartSections(ratings: Ratings) {
    return SECTIONS.map((s) => ({
      title: s.title,
      score: sectionScore(s, ratings),
      max: s.max,
    }));
  }

  // ─── URL validation ──────────────────────────────────────────────────────
  const params = new URLSearchParams(window.location.search);
  const raw = params.get('r');

  if (!raw || !VALID_PARAM_RE.test(raw)) {
    window.location.replace('/tools/scorecard/');
  } else {
    const ratings = decodeRatings(raw);
    const score = getTotalScore(ratings);
    const status = getTotalStatus(score);
    const pct = totalPercent(ratings);
    const grade = letterGrade((score / TOTAL_MAX) * 100);
    const weakest = getWeakestSection(ratings);
    const recommendation = buildRecommendation(ratings);
    const chartSections = getChartSections(ratings);

    // ─── Canonical button language (mirrors Button.astro so the JS-rendered
    //     actions match every other button on the site exactly). ──────────────
    const BTN_BASE =
      'group/btn inline-flex items-center justify-center gap-2 rounded-[5px] font-sans font-medium tracking-tight transition-[background-color,border-color,color,transform] duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-px active:scale-[0.97] active:translate-y-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
    const BTN_LG = 'px-6 py-3 text-[0.95rem]';
    const BTN_MD = 'px-5 py-2.5 text-[0.9rem]';
    // Light surfaces (score panel):
    const BTN_PRIMARY = 'bg-ink text-paper hover:bg-ink-soft';
    const BTN_GHOST = 'bg-transparent text-ink border border-line-strong hover:border-ink/40 hover:bg-ink/[0.03]';
    // Ink surfaces (recommendation reveal-card):
    const BTN_NAVY = 'bg-paper text-ink hover:bg-white';
    const BTN_SECONDARY = 'bg-transparent text-paper border border-paper/25 hover:bg-paper/10';

    // ─── Radar chart ─────────────────────────────────────────────────────────
    function renderRadarChart(
      container: HTMLElement,
      sections: { title: string; score: number; max: number }[],
      statusKey: TotalStatus,
    ) {
      const W = 460, H = 340;
      const CX = W / 2, CY = H / 2;
      const R = 130, LABEL_R = R + 28;
      const GRID = [0.25, 0.5, 0.75, 1];
      const n = sections.length;

      function angle(i: number) {
        return (Math.PI * 2 * i) / n - Math.PI / 2;
      }
      function pt(r: number, i: number) {
        return { x: CX + r * Math.cos(angle(i)), y: CY + r * Math.sin(angle(i)) };
      }
      function polygonPoints(r: number) {
        return sections.map((_, i) => {
          const p = pt(r, i);
          return `${p.x},${p.y}`;
        }).join(' ');
      }

      const statusColor = STATUS_COLORS[statusKey] || '#1B1A17';

      const dataPoints = sections.map((s, i) => pt((s.max > 0 ? s.score / s.max : 0) * R, i));
      const dataPolygon = dataPoints.map((p) => `${p.x},${p.y}`).join(' ');

      let svg = `<svg viewBox="0 0 ${W} ${H}" class="w-full h-auto" preserveAspectRatio="xMidYMid meet" aria-hidden="true">`;

      for (const level of GRID) {
        svg += `<polygon points="${polygonPoints(R * level)}" fill="none" stroke="rgba(27,26,23,0.12)" stroke-width="1"/>`;
      }

      for (let i = 0; i < n; i++) {
        const p = pt(R, i);
        svg += `<line x1="${CX}" y1="${CY}" x2="${p.x}" y2="${p.y}" stroke="rgba(27,26,23,0.12)" stroke-width="1"/>`;
      }

      svg += `<g class="radar-data">`;
      svg += `<polygon points="${dataPolygon}" fill="${statusColor}" fill-opacity="0.15" stroke="${statusColor}" stroke-width="2.5" stroke-linejoin="round"/>`;

      for (const p of dataPoints) {
        svg += `<circle cx="${p.x}" cy="${p.y}" r="5" fill="${statusColor}" stroke="#FFFFFF" stroke-width="2"/>`;
      }
      svg += `</g>`;

      for (let i = 0; i < n; i++) {
        const p = pt(LABEL_R, i);
        const cosA = Math.cos(angle(i));
        const sinA = Math.sin(angle(i));
        const anchor = cosA > 0.2 ? 'start' : cosA < -0.2 ? 'end' : 'middle';
        const baseline = sinA > 0.2 ? 'hanging' : sinA < -0.2 ? 'auto' : 'middle';
        const label = SHORT_LABELS[sections[i].title] || sections[i].title;
        svg += `<text x="${p.x}" y="${p.y}" text-anchor="${anchor}" dominant-baseline="${baseline}" fill="#1B1A17" style="font-size:13px;font-weight:600;font-family:'Hanken Grotesk',sans-serif">${label}</text>`;
      }

      svg += '</svg>';
      container.innerHTML = svg;
    }

    // ─── Verdict band (ink) — the billboard grade reveal ──────────────────────
    function renderVerdict(container: HTMLElement) {
      const statusClass = ({ healthy: 'strong', functional: 'attention', investment: 'critical' } as const)[status];

      const startHere = status !== 'healthy'
        ? `<strong class="text-paper font-semibold">Start here.</strong> Your lowest-scoring area is your highest-impact fix: in your case, <strong class="text-accent font-semibold">${weakest.title}</strong>. That&rsquo;s where you&rsquo;ll see the fastest improvement.`
        : `<strong class="text-paper font-semibold">Excellent work.</strong> Your system is performing well across every dimension. The job now is keeping it that way.`;

      container.innerHTML = `
        <div class="verdict-grid">
          <div class="verdict-glyph">
            <p class="mono-label !text-paper/60">Final grade</p>
            <div class="verdict-grade mt-3" data-status="${status}" aria-hidden="true"><span class="g">${grade}</span></div>
            <span class="sr-only">Grade ${grade}. Total score ${score} out of ${TOTAL_MAX}.</span>
          </div>

          <div class="verdict-details">
            <p class="mono-label !text-paper/60">Total score</p>
            <p class="verdict-score mt-2"><span data-countup>${score}</span><span class="slash">/${TOTAL_MAX}</span></p>
            <div class="mt-4"><span class="status-pill ${statusClass}">${TOTAL_STATUS_LABEL[status]}</span></div>

            <div class="verdict-meter mt-7 max-w-md" style="--w:${pct}%" aria-hidden="true"><i></i></div>

            <p class="mt-7 max-w-md text-[0.95rem] leading-relaxed text-paper/75">${startHere}</p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <button type="button" id="shareBtn" class="${BTN_BASE} ${BTN_LG} ${BTN_NAVY} cursor-pointer">
                <iconify-icon icon="ph:link-duotone" width="18"></iconify-icon>
                <span id="shareBtnText">Share these results</span>
              </button>
              <a href="/tools/scorecard/?r=${raw}" class="${BTN_BASE} ${BTN_LG} ${BTN_SECONDARY}">
                <iconify-icon icon="ph:arrow-counter-clockwise-duotone" width="18"></iconify-icon>
                Retake scorecard
              </a>
            </div>
          </div>
        </div>
      `;

      const shareBtn = document.getElementById('shareBtn')!;
      const shareBtnText = document.getElementById('shareBtnText')!;
      shareBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = window.location.href;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
        }
        const icon = shareBtn.querySelector('iconify-icon')!;
        icon.setAttribute('icon', 'ph:check-duotone');
        shareBtnText.textContent = 'Link copied!';
        setTimeout(() => {
          icon.setAttribute('icon', 'ph:link-duotone');
          shareBtnText.textContent = 'Share these results';
        }, 2000);
      });
    }

    // ─── Breakdown (paper) — per-dimension rows + staggered bars ───────────────
    function renderBreakdown(container: HTMLElement) {
      let html = '<div class="space-y-5">';
      for (let i = 0; i < SECTIONS.length; i++) {
        const s = SECTIONS[i];
        const sc = sectionScore(s, ratings);
        const sp = sectionPercent(s, ratings);
        const ss = sectionStatus(s, ratings);
        const barColor = ss ? 'ink' : 'neutral';
        const pillClass = ss === 'strong' ? 'strong' : ss === 'needs-attention' ? 'attention' : ss === 'critical' ? 'critical' : '';

        html += `
          <div class="bd-row" style="--d:${(i * 0.08).toFixed(2)}s">
            <div class="flex items-center justify-between mb-1.5">
              <span class="font-display text-sm font-semibold tracking-tight text-ink">${s.title}</span>
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs tabular-nums text-ink-muted">
                  <span class="sr-only">Score: </span>
                  <strong class="text-ink font-semibold">${sc}</strong>/${s.max}
                </span>
                ${ss ? `<span class="status-pill ${pillClass}">${STATUS_LABEL[ss]}</span>` : ''}
              </div>
            </div>
            <div class="mini-bar-track">
              <div class="mini-bar-fill ${barColor}" style="--w:${sp}%; --d:${(i * 0.08 + 0.1).toFixed(2)}s"></div>
            </div>
          </div>
        `;
      }
      html += '</div>';
      container.innerHTML = html;
    }

    // ─── Recommendation ───────────────────────────────────────────────────────
    function renderRecommendation(container: HTMLElement) {
      if (!recommendation) return;

      let html = '<div class="reveal-card"><div class="relative z-10">';

      if (recommendation.type === 'healthy') {
        html += `
          <p class="font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-paper/65 mb-3">The verdict</p>
          <h3 class="font-serif text-3xl md:text-4xl font-semibold tracking-[-0.018em] mb-4 leading-tight">
            A system doing its job.
          </h3>
          <p class="text-paper/75 leading-relaxed max-w-2xl mb-8">
            Your system is doing its job: accessibility is architecture, tokens are trusted, and documentation travels with the work.
            The next wins are small polishes: maybe formalizing deprecation paths or tightening the handoff ceremony.
            Mostly: don&rsquo;t let this slip.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/contact/" class="${BTN_BASE} ${BTN_LG} ${BTN_NAVY}">
              <iconify-icon icon="ph:envelope-duotone" width="18"></iconify-icon>
              Talk through your results
            </a>
          </div>
        `;
      } else {
        const rec = recommendation;
        html += `
          <div class="mb-4">
            <p class="mono-label !text-paper/65 mb-3">Where I'd focus first</p>
            <h3 class="font-serif text-2xl md:text-3xl font-semibold tracking-[-0.018em] leading-tight">
              ${rec.label}
            </h3>
          </div>
          <p class="text-paper text-lg leading-snug mb-3">${rec.tagline}</p>
          <p class="text-paper/75 leading-relaxed mb-7">${rec.why}</p>
        `;

        if (rec.strongSections && rec.strongSections.length > 0) {
          html += `
            <div class="mb-6">
              <p class="font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-paper/65 font-medium mb-3">
                What&rsquo;s working
              </p>
              <div class="rec-section-list">
          `;
          for (const s of rec.strongSections) {
            html += `
              <div class="rec-section-item text-paper/90">
                <iconify-icon icon="ph:check-duotone" width="18" class="text-paper" style="flex-shrink:0"></iconify-icon>
                <span>${s.title}</span>
                <span class="ml-auto text-paper/55 font-mono text-xs tabular-nums">${s.score}/${s.max}</span>
              </div>
            `;
          }
          html += '</div></div>';
        }

        if (rec.weakSections && rec.weakSections.length > 0) {
          html += `
            <div class="mb-7">
              <p class="focus-heading">
                <span>Where to focus</span>
              </p>
              <div class="focus-list">
          `;
          rec.weakSections.forEach((s, idx) => {
            const benefit = SECTION_BENEFITS[s.title] || '';
            const consequence = SECTION_CONSEQUENCES[s.title] || '';
            html += `
              <div class="focus-item">
                <div class="focus-item-head">
                  <span class="focus-priority" aria-hidden="true">${String(idx + 1).padStart(2, '0')}</span>
                  <span>${s.title}</span>
                  <span class="focus-item-score">
                    <span class="sr-only">Score: </span>
                    <strong>${s.score}</strong>/${s.max}
                  </span>
                </div>
                ${benefit ? `<p class="focus-item-benefit">${benefit}</p>` : ''}
                ${consequence ? `<p class="focus-item-consequence"><span class="focus-item-consequence-label">If ignored</span> ${consequence}</p>` : ''}
              </div>
            `;
          });
          html += '</div></div>';
        }

        html += `
          <div class="flex flex-col sm:flex-row gap-3 mb-2">
            <a href="/contact/" class="${BTN_BASE} ${BTN_LG} ${BTN_NAVY}">
              <iconify-icon icon="ph:envelope-duotone" width="18"></iconify-icon>
              Talk through your results
            </a>
          </div>
        `;

        if (rec.secondaryRecommendation) {
          const sec = rec.secondaryRecommendation;
          html += `
            <div class="secondary-rec">
              <p class="font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-paper/60 font-medium mb-2">You may also benefit from</p>
              <p class="font-display text-lg font-semibold tracking-tight mb-1">${sec.label}</p>
              <p class="text-paper/70 text-sm">
                Your ${sec.sectionNames.map((n) => n.toLowerCase()).join(', ')} ${sec.sectionNames.length === 1 ? 'could' : 'could all'} use attention beyond the handoff fixes.
              </p>
            </div>
          `;
        }
      }

      html += '</div></div>';
      container.innerHTML = html;
    }

    // ─── Render everything ────────────────────────────────────────────────────
    renderRadarChart(
      document.getElementById('radarChartContainer')!,
      chartSections,
      status,
    );
    renderVerdict(document.getElementById('verdictBand')!);
    renderBreakdown(document.getElementById('breakdownPanel')!);
    renderRecommendation(document.getElementById('recommendationContainer')!);

    // ─── Motion choreography ──────────────────────────────────────────────────
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function animateCount(el: Element, target: number, dur: number) {
      const start = performance.now();
      function tick(now: number) {
        const t = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = String(Math.round(target * eased));
        if (t < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    // Verdict sits near the top — reveal it on load.
    const vGrid = document.querySelector('.verdict-grid');
    const countEl = document.querySelector('[data-countup]');
    requestAnimationFrame(() =>
      requestAnimationFrame(() => {
        vGrid?.classList.add('is-in');
        if (countEl && !reduce) animateCount(countEl, score, 1000);
      }),
    );

    // Radar + breakdown reveal as they scroll into view — but can never get
    // stuck invisible (reduced-motion, already-on-screen, and timeout fallbacks).
    const revealTargets = ['radarCard', 'breakdownPanel']
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el);
    const reveal = (el: Element) => el.classList.add('is-in');

    if (reduce || !('IntersectionObserver' in window)) {
      revealTargets.forEach(reveal);
    } else {
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              reveal(e.target);
              obs.unobserve(e.target);
            }
          }
        },
        { threshold: 0.2, rootMargin: '0px 0px -8% 0px' },
      );
      revealTargets.forEach((el) => {
        if (el.getBoundingClientRect().top < window.innerHeight) reveal(el);
        else io.observe(el);
      });
      window.setTimeout(() => revealTargets.forEach(reveal), 2500);
    }
  }
</script>
