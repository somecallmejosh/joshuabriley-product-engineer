---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import Portrait from '~/components/patterns/Portrait.astro';
import WorkList from '~/components/patterns/WorkList.astro';
import Recommendation from '~/components/patterns/Recommendation.astro';
import ProjectIllustration from '~/components/patterns/ProjectIllustration.astro';
import { getNavFeatures } from '~/lib/nav-features';

const { testimonials, defaultTestimonial } = await getNavFeatures();
const needs = [
  { title: 'Workflow research and measured outcomes', body: 'I map the workflow before designing screens. After launch I measure the result. At IVFCRYO, a shared readiness check cut support calls by 75%. The case study shows the alternatives I weighed and why I chose one.', href: '/projects/ivfcryo/', link: 'Read the IVFCRYO case study', illustration: 'ivfcryo' as const },
  { title: 'Complete interface states', body: 'I build the interfaces I design. That includes the loading, error, and recovery states that mockups often omit. When Logatot can’t understand what a provider said, it asks the provider to correct it before saving.', href: '/projects/logatot/', link: 'See the voice repair flow', illustration: 'logatot-review' as const },
  { title: 'Design system automation', body: 'In my current role I automate Storybook and Figma setup so teams can spend their time on features. That work isn’t public. Rudiment UI, my personal component library, uses the same approach. It has accessible components, tokens, and documented APIs.', href: '/personal-projects/rudiment-ui/', link: 'Inspect the component library', illustration: 'rudiment-ui' as const },
];
---
<BaseLayout title="Joshua Briley | Product Design Engineer" description="Product design engineer with 20+ years of experience. I work with product teams to decide what to build, design the workflow, and ship accessible interfaces. Each case study states what I owned.">
  <section class="home-hero">
    <Container width="wide">
      <div class="home-hero-grid hero-split">
        <div class="home-hero-copy hero-split-copy">
          <h1 class="hero-type hero-in hero-in-2">Product design engineer</h1>
          <p class="hero-lede hero-in hero-in-3">I work with product managers, designers, and engineers. I design the workflow, build the interface in code, and test it for accessibility before release.</p>
          <div class="hero-actions hero-in hero-in-4">
            <a href="#selected-work" class="action-link">Explore my work</a>
            <a href="/resume/" class="editorial-link">View résumé</a>
          </div>
        </div>
        <figure class="hero-portrait hero-split-media hero-in hero-in-5">
          <Portrait eager />
          <figcaption><span>Joshua Briley</span><span>20+ years building products</span></figcaption>
        </figure>
      </div>
    </Container>
  </section>
  <section id="selected-work" class="editorial-section work-section work-section--stage bg-ink" data-surface="dark">
    <Container width="wide">
      <div class="section-heading">
        <h2 class="section-type">Selected work</h2>
        <p>These case studies cover healthcare staffing, fertility logistics, and home child care. Each one states what I owned and the measured result.</p>
      </div>
      <WorkList compact feature />
      <a href="/projects/" class="editorial-link editorial-link--light work-more">View all case studies</a>
    </Container>
  </section>
  <section class="editorial-section approach-section">
    <Container width="wide">
      <h2 class="section-type">Areas of work</h2>
      {/* One drawing per area, in the same style as the Play and Writing cards. */}
      <div class="approach-list areas-list pin-list" style="--pin-count: 3">
        {needs.map((need) => (
          <article class="pin-item">
            <a href={need.href} class="pin-media" tabindex="-1" aria-hidden="true">
              <ProjectIllustration project={need.illustration} />
            </a>
            <div class="pin-copy">
              <h3>{need.title}</h3>
              <p>{need.body}</p>
              <a href={need.href} class="editorial-link">{need.link}</a>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </section>
  {testimonials.length > 0 && (
    <section class="editorial-section surface-denim home-testimonial" data-surface="dark" aria-label="Testimonials">
      <Container width="wide">
        {testimonials.map((entry) => (
          <div data-home-quote hidden={entry.id !== defaultTestimonial.id}>
            <Recommendation testimonial={entry} featured />
          </div>
        ))}
        <p class="home-testimonial-more">
          <a href="/testimonials/" class="editorial-link editorial-link--light">Read all testimonials</a>
        </p>
      </Container>
    </section>
  )}
</BaseLayout>

<script>
  // Same behavior as the header menus: without script, the featured quote shows.
  const quotes = Array.from(document.querySelectorAll<HTMLElement>('[data-home-quote]'));
  const quote = quotes[Math.floor(Math.random() * quotes.length)];
  quotes.forEach((item) => { item.hidden = item !== quote; });
</script>

<style>
  .areas-list { margin-top: var(--space-block); }
  .home-testimonial-more { margin-top: 2.5rem; }
  @supports (animation-timeline: view()) {
    @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
      .areas-list h3 { font-size: clamp(1.75rem, 2.6vw, 2.5rem); line-height: 1.15; }
      .areas-list p { font-size: var(--type-body); max-width: 46ch; }
    }
  }
</style>
