---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import Button from '~/components/primitives/Button.astro';
import Link from '~/components/primitives/Link.astro';
import FacetGlyph from '~/components/patterns/FacetGlyph.astro';
import ProjectGlyph from '~/components/patterns/ProjectGlyph.astro';


const facets = [
  {
    glyph: 'accessible' as const,
    title: 'Accessibility from the start',
    body:
      'Keyboard navigation, focus management, and screen-reader behavior are part of the first build, not fixes after a QA pass finds them missing.',
  },
  {
    glyph: 'finish' as const,
    title: 'Empty, error, and first-run states',
    body:
      'I design and build the screens most teams leave blank: empty lists, form errors people can recover from, and the first visit before there is any data. These details decide whether a product feels finished.',
  },
  {
    glyph: 'foundation' as const,
    title: 'Design systems',
    body:
      'When a product needs a design system, I build it: one component library and one accessibility standard shared across every brand, so the UI stays consistent as the team and the product grow.',
  },
];

const work = [
  {
    href: '/projects/ivfcryo/',
    client: 'IVFCRYO',
    glyph: 'ivfcryo' as const,
    metric: { value: '75%', label: 'fewer support calls' },
    line: 'A self-service platform for shipping cryogenic fertility specimens. It confirms that all five parties are ready before a shipment is scheduled.',
  },
  {
    href: '/projects/logatot/',
    client: 'Logatot',
    glyph: 'logatot' as const,
    metric: { value: '2+ hrs', label: 'less data entry per day' },
    line: 'A voice-controlled operations platform for home-based child care providers, who can log the day hands-free while they care for children.',
  },
];

---

<BaseLayout
  title="Joshua Briley | Design systems & UI platform engineer"
  description="Design systems & UI platform engineer with 20 years in production UI, from insurance platforms to fantasy-sports games with a million-plus players. I design interfaces, build them, and ship code to production."
>
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <p class="hero-in hero-in-1 mono-label">
        Design systems &amp; UI platform engineer
      </p>

      <div class="mt-10 grid gap-10 lg:mt-14 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-8">
          <Heading level={1} visual="display-xl" class="hero-in hero-in-2 max-w-[19ch]">
            I design interfaces and <em class="ink-wink font-normal italic">build them in code.</em>
          </Heading>
          <Text size="lg" tone="muted" class="hero-in hero-in-3 mt-7 max-w-2xl">
            I've spent 20 years building production UI, from insurance platforms to fantasy sports
            games with more than a million players. I design the
            interface, build it, and ship it to production myself.
          </Text>

          <div class="hero-in hero-in-4 mt-9 flex flex-wrap items-center gap-3">
            <Button variant="primary" size="lg" href="/projects/" iconRight="ph:arrow-right" class="js-magnetic">
              View projects
            </Button>
            <Button variant="ghost" size="lg" href="/about/">
              About me
            </Button>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <Heading level={2} visual="display-md" class="text-pretty">
          What I bring to a product team
        </Heading>
        <Text size="lg" tone="muted" class="mt-5">
          Design quality and accessibility are often cut when a deadline gets close, or left to
          someone else. I build both into the work from the start, so what I ship works on real
          devices and with assistive technology, and keeps working after launch.
        </Text>
      </div>

      <div
        class="mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-line bg-line lg:grid-cols-3"
        data-reveal-stagger
      >
        {facets.map((c) => (
          <div class="bg-paper p-7 md:p-9">
            <FacetGlyph name={c.glyph} class="text-ink" />
            <Heading level={3} visual="h3" class="mt-6">{c.title}</Heading>
            <Text tone="muted" size="sm" class="mt-3">{c.body}</Text>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="ink" padding="default">
    <Container width="wide">
      <Heading level={2} visual="display-md" tone="paper">Selected projects</Heading>

      <ul class="mt-14 border-t border-paper/10" data-reveal-stagger>
        {work.map((w) => (
          <li>
            <a href={w.href} class="group grid grid-cols-12 items-center gap-4 border-b border-paper/10 py-7 transition-colors hover:bg-paper/[0.03]">
              <span class="col-span-4 md:col-span-2">
                <ProjectGlyph name={w.glyph} class="text-paper" />
              </span>
              <span class="col-span-8 md:col-span-3">
                <span class="block font-display text-4xl md:text-5xl font-semibold leading-none tracking-[-0.03em] text-paper">{w.metric.value}</span>
                <span class="mt-2 block font-sans text-sm font-medium tracking-tight text-paper/70">{w.metric.label}</span>
              </span>
              <span class="col-span-10 md:col-span-6">
                <span class="font-display text-lg font-medium tracking-tight text-paper">{w.client}</span>
                <span class="mt-0.5 block text-sm text-paper/55">{w.line}</span>
              </span>
              <span class="col-span-2 flex justify-end md:col-span-1">
                <Icon name="ph:arrow-right" size={18} class="text-paper/50 transition-transform duration-300 ease-out group-hover:translate-x-1 group-hover:text-paper" />
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-8">
        <a href="/projects/" class="inline-flex items-center gap-2 font-sans text-[0.9rem] font-medium text-paper transition-colors hover:text-accent">
          View all projects <Icon name="ph:arrow-right" size={15} />
        </a>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="grid items-start gap-10 md:items-center md:grid-cols-12 md:gap-14">
        <div class="md:col-span-4">
          <div class="overflow-hidden rounded-lg border border-line">
            <picture>
              <source
                type="image/avif"
                sizes="(min-width: 1280px) 373px, (min-width: 768px) 30vw, 100vw"
                srcset="/images/about/josh-suit-portrait-400.avif 400w, /images/about/josh-suit-portrait-640.avif 640w, /images/about/josh-suit-portrait-1000.avif 1000w"
              />
              <source
                type="image/webp"
                sizes="(min-width: 1280px) 373px, (min-width: 768px) 30vw, 100vw"
                srcset="/images/about/josh-suit-portrait-400.webp 400w, /images/about/josh-suit-portrait-640.webp 640w, /images/about/josh-suit-portrait-1000.webp 1000w"
              />
              <img
                src="/images/about/josh-suit-portrait-640.jpg"
                sizes="(min-width: 1280px) 373px, (min-width: 768px) 30vw, 100vw"
                srcset="/images/about/josh-suit-portrait-400.jpg 400w, /images/about/josh-suit-portrait-640.jpg 640w, /images/about/josh-suit-portrait-1000.jpg 1000w"
                alt="Joshua Briley, design systems and UI platform engineer"
                class="aspect-[4/5] w-full object-cover"
                loading="lazy"
                decoding="async"
                width="1000"
                height="1250"
              />
            </picture>
          </div>
        </div>
        <div class="md:col-span-8">
          <Heading level={2} visual="display-md" class="max-w-[18ch]">
            From designer to front-end engineer
          </Heading>
          <div class="mt-6 space-y-4 text-ink-muted leading-relaxed max-w-2xl">
            <p>
              I started as a designer and moved into engineering so I could build what I designed
              instead of handing it off. Twenty years later, I do my best work on the front end, where I
              make the design decisions and write the accessible code that ships them.
            </p>
            <p>
              Outside of work, I play bass and gig semi-regularly.
            </p>
          </div>
          <div class="mt-7">
            <Link href="/about/" variant="arrow">More about my background and process</Link>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

