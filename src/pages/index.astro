---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import Portrait from '~/components/patterns/Portrait.astro';
import WorkList from '~/components/patterns/WorkList.astro';
import { selectedWork } from '~/lib/selected-work';
const needs = [
  { title: 'Design decisions you can follow', body: 'I map workflows, prototype interactions, and work through loading, error, and recovery states with designers and engineers. The case studies show the decisions I owned and why.', href: '/projects/ivfcryo/', link: 'Follow a design decision' },
  { title: 'Front-end engineering that carries the design through', body: 'I build the interfaces as well as design them, including the state changes and accessible behavior that static mockups leave open. Logatot shows my work on voice input, repair flows, and shared UI.', href: '/projects/logatot/', link: 'Explore the implementation' },
  { title: 'Shared foundations for a consistent product', body: 'Reusable components and clear interaction patterns help complex interfaces hold together. My current design systems work and public component library show how I support that foundation.', href: '/personal-projects/rudiment-ui/', link: 'Inspect the component work' },
];
const workOrder = ['/projects/ivfcryo/', '/projects/logatot/', '/personal-projects/rudiment-ui/'];
const homeWork = workOrder.flatMap(href => selectedWork.filter(work => work.href === href));
---
<BaseLayout title="Joshua Briley | Product Design Engineer" description="Product design engineer with 20+ years in production UI. Explore interaction design, accessible front-end implementation, and product case studies with clear ownership.">
  <section class="home-hero">
    <Container width="wide">
      <p class="role-line hero-in hero-in-1">Product design engineer</p>
      <div class="home-hero-grid">
        <div class="home-hero-copy">
          <h1 class="hero-type hero-in hero-in-2">I design and<br />build product<br /><em>interfaces.</em></h1>
          <p class="hero-lede hero-in hero-in-3">I connect product design and front-end engineering, from workflows and prototypes to accessible interfaces in production.</p>
          <div class="hero-actions hero-in hero-in-4">
            <a href="#selected-work" class="action-link">Explore my work <span aria-hidden="true" data-link-arrow="down-right">↘</span></a>
            <a href="/resume/" class="editorial-link">View résumé <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
          </div>
        </div>
        <figure class="hero-portrait hero-in hero-in-5">
          <Portrait eager />
          <figcaption><span>Joshua Briley</span><span>Based in Connecticut</span></figcaption>
        </figure>
      </div>
      <div class="current-work">
        <p><span class="status-mark" aria-hidden="true"></span>Current focus: <strong>design systems</strong></p>
        <p>Building the design system used by roughly <strong>3,500 engineers and designers.</strong></p>
        <a href="/about/" class="editorial-link">More about me <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
      </div>
    </Container>
  </section>
  <section id="selected-work" class="editorial-section work-section">
    <Container width="wide">
      <div class="section-heading">
        <h2 class="section-type">Selected <em>work.</em></h2>
        <p>See how I designed and built interfaces for complex workflows, with clear ownership and outcomes.</p>
      </div>
      <WorkList compact items={homeWork} />
      <a href="/projects/" class="editorial-link work-more">Explore all work <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
    </Container>
  </section>
  <section class="editorial-section approach-section">
    <Container width="wide">
      <div class="approach-layout">
        <div>
          <h2 class="section-type">From design<br />to <em>production.</em></h2>
          <p class="section-intro">My work spans product workflows, interaction design, and front-end implementation. The case studies make my role and contributions explicit.</p>
          <p class="quiet-aside">The button is usually the easy part.</p>
        </div>
        <div class="approach-list" data-reveal-stagger>
          {needs.map((need) => (
            <article>
              <h3>{need.title}</h3>
              <p>{need.body}</p>
              <a href={need.href} class="editorial-link">{need.link} <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
            </article>
          ))}
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
