---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import { selectedWork } from '~/lib/selected-work';
const workOrder = ['/projects/ivfcryo/', '/projects/logatot/', '/projects/vmspark/'];
const homeWork = workOrder.flatMap(href => selectedWork.filter(work => work.href === href));
---
<BaseLayout title="Joshua Briley | Product Design Engineer" description="Product design engineer with 20+ years taking products from problem to production: working with product teams to frame what to build, design the workflow, and ship it accessible. Case studies with clear ownership.">
  <section class="home-open">
    <Container>
      <p class="home-label hero-in hero-in-1">Joshua Briley, product design engineer</p>
      <h1 class="home-statement hero-in hero-in-2"><span>Helping teams ship</span> <span>the right product.</span></h1>
      <a href="#selected-work" class="editorial-link hero-in hero-in-3">Explore my work <span aria-hidden="true" data-link-arrow="down-right">↘</span></a>
    </Container>
  </section>

  <section class="home-screen">
    <Container>
      <p class="home-twotone"><strong>I partner with product managers, designers, and engineers</strong> to figure out what users need, shape the workflow, and ship it as an accessible product.</p>
    </Container>
  </section>

  <section id="selected-work" class="home-work" aria-labelledby="selected-work-title">
    <h2 id="selected-work-title" class="sr-only">Selected work</h2>
    {homeWork.map((work) => (
      <article class="home-screen">
        <Container>
          <h3 class="home-label">{work.name}</h3>
          <p class="home-result"><strong>{work.result}</strong> {work.resultNote}.</p>
          <div class="home-case-meta">
            <p>{work.title}</p>
            <a href={work.href} class="editorial-link">{work.action} <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
          </div>
          <a href={work.href} class="home-plate" tabindex="-1" aria-hidden="true">
            <img src={work.image} alt="" width="1400" height="900" loading="lazy" decoding="async" />
          </a>
        </Container>
      </article>
    ))}
  </section>

  <section class="home-screen">
    <Container>
      <h2 class="home-label">Current role: design system engineer</h2>
      <p class="home-twotone"><strong>On a design system used by roughly 3,500 engineers and designers,</strong> I automated Storybook setup, saving more than 10 hours per component, and Figma Code Connect mapping, so nobody translates components by hand.</p>
      <a href="/about/" class="editorial-link home-after">More about me <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
    </Container>
  </section>

  <section class="home-screen home-close">
    <Container>
      <p class="home-statement home-statement--close">The button is usually the easy&nbsp;part.</p>
      <div class="home-links">
        <a href="/projects/" class="editorial-link">Explore all work <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
        <a href="/resume/" class="editorial-link">View résumé <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
        <a href="/contact/" class="editorial-link">Contact me <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
      </div>
    </Container>
  </section>
</BaseLayout>
