---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import Button from '~/components/primitives/Button.astro';
import Link from '~/components/primitives/Link.astro';
import ToolGlyph from '~/components/patterns/ToolGlyph.astro';

// ── Content (every claim is backed by the site itself or a real case study) ──
// Same four chips as the about page, worded identically. Two pages rendering
// the same strip with different items read as two different claims.
const capabilities = [
  'Design-grade front-end',
  'React · TypeScript',
  'Accessibility built in',
  'Design systems',
];

// The differentiator band. Why these products feel finished. The lead facet (UI)
// is the featured cell; the rest are the front-end disciplines behind the finish.
const facets = [
  {
    title: 'The UI is where I bring the most value',
    body:
      'Twenty years in design systems taught me where interfaces break: type, spacing, motion, the empty and error states most engineers leave blank. I build it myself instead of handing a spec to someone who will approximate it.',
    featured: true,
  },
  {
    title: 'Accessible by construction',
    body:
      'Keyboard paths, focus management, and screen-reader behavior built in from the start. Accessibility is the mechanism that makes a product work for everyone, not a checkbox.',
  },
  {
    title: 'I sweat the last 10%',
    body:
      'Empty states, recoverable forms, the screen that shows when there is nothing to show yet. Those are the parts that decide whether a product feels finished, and whether it holds up after launch.',
  },
  {
    title: 'I bring the system, not just the screen',
    body:
      'When a product needs a real design system, I build that too: one library, one accessibility floor, every brand held to the same standard. It is how the UI stays consistent as the team and the surface area grow.',
  },
];

// One number per case study linked below, in the same order as the list, so
// every figure here is a claim the reader can click through and check. Numbers
// from clients without a published case study belong on the resume, not here.
const metrics = [
  { value: '75%', label: 'fewer support calls', note: 'IVFCRYO: a readiness gate before scheduling' },
  { value: 'Zero', label: 'pipeline regressions', note: 'VMSpark: four phases, no feature flags' },
  { value: '2+ hrs', label: 'a day of data entry removed', note: 'Logatot: hands-free capture in the moment' },
];

// Products where I owned the interface: the three client platforms. Order
// matches /projects/, so the two lists cannot present the same case studies
// in different sequences.
const work = [
  {
    href: '/projects/ivfcryo/',
    client: 'IVFCRYO',
    kind: 'Logistics platform',
    line: 'A self-service platform for cryogenic fertility shipments, where the hard part was getting five parties provably ready before a specimen moved.',
  },
  {
    href: '/projects/vmspark/',
    client: 'VMSpark',
    kind: 'Admin platform',
    line: 'A multi-tenant admin platform rebuilt and shipped in four phases: the operator-facing UI and workflows, delivered with zero pipeline regressions.',
  },
  {
    href: '/projects/logatot/',
    client: 'Logatot',
    kind: 'Voice platform',
    line: 'A voice-controlled operations platform for home-based child care, built for a user whose hands are already full.',
  },
];

---

<BaseLayout
  title="Joshua Briley | Design systems & UI platform engineer"
  description="Design systems & UI platform engineer with 20 years in production UI, from insurance platforms to fantasy-sports games with a million-plus players. I design interfaces, build them, and ship code to production."
>
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <p class="hero-in hero-in-1 mono-label">
        <span class="sr-only">My role is </span>Product Design Engineer
        <span class="text-ink-faint"> · </span>
        <span class="sr-only">I focus on </span>Design &amp; front-end
      </p>

      <div class="mt-10 grid gap-10 lg:mt-14 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-8">
          <Heading level={1} visual="display-xl" class="hero-in hero-in-2 max-w-[19ch]">
            Where <em class="ink-wink font-normal italic">design meets code&hellip;</em> that's where I add value.
          </Heading>
          <Text size="lg" tone="muted" class="hero-in hero-in-3 mt-7 max-w-2xl">
            Design systems & UI platform engineer, 20 years in production UI, from insurance
            platforms to fantasy-sports games with a million-plus players. I design interfaces,
            build them, and ship code to production.
          </Text>

          <div class="hero-in hero-in-4 mt-9 flex flex-wrap items-center gap-3">
            <Button variant="primary" size="lg" href="/projects/" iconRight="ph:arrow-right" class="js-magnetic">
              See the work
            </Button>
            <Button variant="ghost" size="lg" href="/about/">
              Read how I work
            </Button>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="tight" class="!py-9 border-b border-line">
    <Container width="wide">
      <div class="">
        <ul class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-muted">
          {capabilities.map((c) => (
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>{c}
            </li>
          ))}
        </ul>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <Heading level={2} visual="display-md" >
          Why my products feel finished.
        </Heading>
        <Text size="lg" tone="muted" class="mt-5">
          Most engineers treat design and accessibility as someone else's job, or the first thing
          cut when a deadline closes in. I build them in. That's why the things I ship work for
          everyone, not just the average user on a fast laptop, and why they hold up after launch.
        </Text>
      </div>

      <div
        class="mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-line bg-line lg:grid-cols-3"
        data-reveal-stagger
      >
        {facets.map((c) => (
          <div class={`bg-paper p-7 md:p-9 ${c.featured ? 'lg:col-span-2 lg:row-span-3 lg:flex lg:flex-col lg:justify-center md:p-10' : ''}`}>
            {c.featured ? (
              <>
                <span class="mono-label text-accent">Where the value is</span>
                <Heading level={3} visual="h2" class="mt-4 max-w-[16ch] text-balance">{c.title}</Heading>
                <Text tone="muted" class="mt-4 max-w-lg">{c.body}</Text>
              </>
            ) : (
              <>
                <Heading level={3} visual="h3" >{c.title}</Heading>
                <Text tone="muted" size="sm" class="mt-3">{c.body}</Text>
              </>
            )}
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="ink" padding="default">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <p class="mono-label !text-paper/65">Selected work</p>
          <Heading level={2} visual="display-md" tone="paper" class="mt-4">Products where I owned the interface.</Heading>
        </div>
        <div class="lg:col-span-6 grid grid-cols-1 gap-8 sm:grid-cols-3 sm:gap-6">
          {metrics.map((m) => (
            <div class="flex flex-col">
              <p class="font-display text-4xl md:text-5xl font-semibold leading-none tracking-[-0.03em] text-paper">{m.value}</p>
              <p class="mt-2 font-sans text-sm font-medium tracking-tight text-paper/70">{m.label}</p>
              <p class="mt-1.5 font-mono text-[0.62rem] uppercase tracking-[0.1em] leading-relaxed text-paper/60">{m.note}</p>
            </div>
          ))}
        </div>
      </div>

      <ul class="mt-14 border-t border-paper/10" data-reveal-stagger>
        {work.map((w) => (
          <li>
            <a href={w.href} class="group grid grid-cols-12 items-center gap-4 border-b border-paper/10 py-5 transition-colors hover:bg-paper/[0.03]">
              <span class="col-span-12 flex items-center gap-3 sm:col-span-4">
                <span class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent">{w.kind}</span>
              </span>
              <span class="col-span-10 sm:col-span-7">
                <span class="font-display text-lg font-medium tracking-tight text-paper">{w.client}</span>
                <span class="mt-0.5 block text-sm text-paper/55">{w.line}</span>
              </span>
              <span class="col-span-2 flex justify-end sm:col-span-1">
                <Icon name="ph:arrow-right" size={18} class="text-paper/50 transition-transform duration-300 ease-out group-hover:translate-x-1 group-hover:text-paper" />
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-8">
        <a href="/projects/" class="inline-flex items-center gap-2 font-sans text-[0.9rem] font-medium text-paper transition-colors hover:text-accent">
          View all projects <Icon name="ph:arrow-right" size={15} />
        </a>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="grid items-start gap-10 md:grid-cols-12 md:gap-14">
        <div class="md:col-span-4">
          <div class="overflow-hidden rounded-lg border border-line">
            <picture>
              <source
                type="image/avif"
                sizes="(min-width: 1280px) 373px, (min-width: 768px) 30vw, 100vw"
                srcset="/images/about/josh-suit-portrait-400.avif 400w, /images/about/josh-suit-portrait-640.avif 640w, /images/about/josh-suit-portrait-1000.avif 1000w"
              />
              <source
                type="image/webp"
                sizes="(min-width: 1280px) 373px, (min-width: 768px) 30vw, 100vw"
                srcset="/images/about/josh-suit-portrait-400.webp 400w, /images/about/josh-suit-portrait-640.webp 640w, /images/about/josh-suit-portrait-1000.webp 1000w"
              />
              <img
                src="/images/about/josh-suit-portrait-640.jpg"
                sizes="(min-width: 1280px) 373px, (min-width: 768px) 30vw, 100vw"
                srcset="/images/about/josh-suit-portrait-400.jpg 400w, /images/about/josh-suit-portrait-640.jpg 640w, /images/about/josh-suit-portrait-1000.jpg 1000w"
                alt="Joshua Briley, product design engineer"
                class="aspect-[4/5] w-full object-cover"
                loading="lazy"
                decoding="async"
                width="1000"
                height="1250"
              />
            </picture>
          </div>
        </div>
        <div class="md:col-span-8">
          <Heading level={2} visual="display-md" class="max-w-[18ch]">
            Designer by origin. Engineer by practice.
          </Heading>
          <div class="mt-6 space-y-4 text-ink-muted leading-relaxed max-w-2xl">
            <p>
              I started in design and moved into engineering because I wanted to build the things I
              drew, not hand them off. Twenty years later, the front end is where I do my best work:
              accessible UI with the design judgment most engineering teams have to hire a separate
              designer to get.
            </p>
            <p>
              I build by feel, fast, and I sweat the finish. Away from the screen, I play bass and
              gig regularly, which is its own lesson in getting the details right in real time.
            </p>
          </div>
          <div class="mt-7">
            <Link href="/about/" variant="arrow">Read more about how I work</Link>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>


<style>
  .tool-tile {
    background: var(--ink);
  }
  .tool-tile:hover {
    background: color-mix(in srgb, var(--paper) 4%, var(--ink));
  }
</style>
