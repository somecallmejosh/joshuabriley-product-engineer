---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import ContactInvitation from '~/components/patterns/ContactInvitation.astro';

// Shared with /resume-print/ and therefore with public/resume.pdf, so the page
// and the download cannot drift. Edit the content in src/lib/resume-data.mjs,
// then re-run `npm run resume:pdf`.
import {
  SUMMARY as summary,
  EXPERIENCE as experience,
  SKILLS as skills,
  EDUCATION as education,
  CONTINUING_ED as continuingEd,
  CERT_FOCUS as certFocus,
  UPDATED as updated,
} from '~/lib/resume-data.mjs';

const description =
  'Design systems and UI platform engineer with 20+ years in production UI. Design-grade, accessible interfaces, design systems, and data-rich tools for insurance platforms and consumer products.';

const workLinks: Record<string, { href: string; label: string }[]> = {
  'Logatot, Inc.': [{ href: '/projects/logatot/', label: 'Read the Logatot case study' }],
  Independent: [
    { href: '/projects/ivfcryo/', label: 'IVFCRYO case study' },
    { href: '/projects/vmspark/', label: 'VMSpark case study' },
  ],
};

---

<BaseLayout title="Resume | Joshua Briley | Design Systems & UI Platform Engineer" description={description}>

  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16 lg:items-end">
        <div class="lg:col-span-8">
          <p class="role-line hero-in hero-in-1">Résumé · Joshua Briley</p>
          <h1 class="page-type hero-in hero-in-2">Twenty-plus years.<br />Still minding<br /><em>the details.</em></h1>
          <Text size="lg" tone="muted" class="hero-in hero-in-3 mt-7 max-w-2xl">
            {summary}
          </Text>
        </div>

        <div class="hero-in hero-in-4 lg:col-span-4 lg:flex lg:flex-col lg:items-end">
          <div class="flex flex-wrap items-center gap-x-8 gap-y-4 lg:justify-end">
            <a class="action-link" href="/resume.pdf" target="_blank" rel="noopener">
              Download PDF <span aria-hidden="true">↓</span>
            </a>
            <a class="editorial-link" href="/contact/">
              Get in touch <span aria-hidden="true">↗</span>
            </a>
          </div>
          <p class="mt-4 text-sm text-ink-muted">Updated {updated}</p>
        </div>
      </div>
      <nav class="evidence-nav" aria-label="Experience and work samples">
        <a href="#experience">Employment history <span aria-hidden="true">↓</span></a>
        <a href="/personal-projects/rudiment-ui/">Public component work <span aria-hidden="true">↗</span></a>
        <a href="/projects/">Product case studies <span aria-hidden="true">↗</span></a>
      </nav>
    </Container>
  </Section>

  <Section id="experience" tone="paper" padding="default" class="resume-experience">
    <Container width="wide">
      <div class="section-heading">
        <h2 class="section-type">Experience</h2>
        <p>Design systems and product UI across insurance, consumer products, and independent client work.</p>
      </div>

      <ul class="experience-list" role="list" data-reveal-stagger>
        {experience.map((job) => (
          <li class="experience-entry">
            <div class="experience-context">
              <p class="experience-period">{job.period.replace(' - ', ' – ')}</p>
              <h3 class="experience-company">{job.company}</h3>
              <p class="experience-role">{job.role}</p>
              <p class="experience-stack"><span class="sr-only">Tools and context: </span>{job.stack}</p>
            </div>
            <div class="experience-contribution">
              <p class="experience-lead">{job.bullets[0]}</p>
              <ul class="experience-details" role="list">
                {job.bullets.slice(1).map((bullet) => <li>{bullet}</li>)}
              </ul>
              {workLinks[job.company] && (
                <div class="experience-links">
                  {workLinks[job.company].map((link) => (
                    <a class="editorial-link" href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  <Section tone="ink" padding="default">
    <Container width="wide">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">

        <div class="lg:col-span-5">
          <Heading level={2} visual="h2" tone="paper">Education</Heading>
          <div class="mt-6 border-t border-paper/10">
            {education.map((e) => (
              <div class="border-b border-paper/10 py-5">
                <p class="font-display text-base font-medium tracking-tight text-paper">{e.title}</p>
                <p class="mt-0.5 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent">{e.org}</p>
                <p class="mt-2 text-sm text-paper/55 max-w-md">{e.note}</p>
              </div>
            ))}
          </div>

          <p class="mt-10 mono-label text-paper/55">Continuing education</p>
          <ul class="mt-5 border-t border-paper/10">
            {continuingEd.map((c) => (
              <li class="flex items-baseline justify-between gap-4 border-b border-paper/10 py-3.5">
                <span class="font-display text-sm font-medium tracking-tight text-paper">{c.title}</span>
                <span class="shrink-0 text-right text-xs text-paper/55">{c.org}</span>
              </li>
            ))}
          </ul>

          <p class="mt-10 mono-label text-paper/55">Certifications in progress</p>
          <p class="mt-3 text-sm text-paper/70">{certFocus}</p>
        </div>

        <div class="lg:col-span-7">
          <Heading level={2} visual="h2" tone="paper">Skills</Heading>
          <div class="mt-6 space-y-8" data-reveal-stagger>
            {skills.map((s) => (
              <div class="grid grid-cols-12 items-baseline gap-4 border-t border-paper/10 pt-5">
                <p class="col-span-12 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent sm:col-span-4">{s.group}</p>
                <p class="col-span-12 text-sm leading-relaxed text-paper/80 sm:col-span-8">{s.items.join(', ')}</p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </Container>
  </Section>
  <ContactInvitation />
</BaseLayout>

<style>
  .experience-list { border-top: 1px solid var(--line-strong); }
  .experience-entry {
    display: grid;
    gap: 2rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--line-strong);
  }
  .experience-context, .experience-contribution { min-width: 0; }
  .experience-period {
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: .75rem;
    line-height: 1.5;
    color: var(--accent);
  }
  .experience-company {
    margin-top: 1rem;
    max-width: 18ch;
    font-size: clamp(2.1rem, 3.5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -.05em;
    text-wrap: balance;
  }
  .experience-role {
    margin-top: 1rem;
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -.015em;
  }
  .experience-stack {
    margin-top: .65rem;
    font-size: .875rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }
  .experience-lead {
    max-width: 45ch;
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -.025em;
    text-wrap: pretty;
  }
  .experience-details {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    max-width: 59ch;
  }
  .experience-details li {
    position: relative;
    padding-left: 1rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-muted);
  }
  .experience-details li::before {
    content: '';
    position: absolute;
    left: 0;
    top: .72em;
    width: 4px;
    height: 4px;
    background: var(--accent);
  }
  .experience-links { display: flex; flex-wrap: wrap; gap: .25rem 2rem; margin-top: 1.5rem; }
  @media (min-width: 1024px) {
    .experience-entry {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: 6rem;
      padding: 3.5rem 0;
    }
    .experience-contribution { padding-top: 2rem; }
  }
</style>
