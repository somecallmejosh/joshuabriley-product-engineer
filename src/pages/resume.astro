---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';

// Shared with /resume-print/ and therefore with public/resume.pdf, so the page
// and the download cannot drift. Edit the content in src/lib/resume-data.mjs,
// then re-run `npm run resume:pdf`.
import {
  CONTACT,
  SUMMARY as summary,
  STRENGTHS as threads,
  EXPERIENCE as experience,
  SKILLS as skills,
  EDUCATION as education,
  CONTINUING_ED as continuingEd,
  UPDATED as updated,
} from '~/lib/resume-data.mjs';

const description =
  'Product design engineer with 20+ years taking products from an unclear problem to a shipped, accessible product: framing what to build, designing the flow, and building it.';

const workLinks: Record<string, { href: string; label: string }[]> = {
  'Logatot, Inc.': [{ href: '/projects/logatot/', label: 'Read the Logatot case study' }],
  Independent: [
    { href: '/projects/ivfcryo/', label: 'IVFCRYO case study' },
    { href: '/projects/vmspark/', label: 'VMSpark case study' },
  ],
};

const skillContext: Record<string, { title: string; description: string; href?: string; link?: string }> = {
  'Design & craft': {
    title: 'Product design & accessibility',
    description: 'Framing workflows, then working through interaction states, prototypes, and accessibility behavior with product, design, and engineering.',
    href: '/projects/ivfcryo/',
    link: 'Follow a design decision',
  },
  'Data & experimentation': {
    title: 'Data & experimentation',
    description: 'Analytics, experimentation, and performance checks to identify friction and evaluate changes to an interface.',
  },
  'Front end': {
    title: 'Front-end engineering',
    description: 'My deepest current systems work is in Stencil Web Components and Storybook. My broader toolkit spans markup, styling, and product UI frameworks.',
  },
  'Systems & testing': {
    title: 'Design systems & testing',
    description: 'Shared components, tokens, documentation, and the tests and tooling that support their use across product teams.',
    href: '/personal-projects/rudiment-ui/',
    link: 'Inspect a component library',
  },
  'Back end & hosting': {
    title: 'Application delivery',
    description: 'Backend and deployment tools used to support product interfaces and working prototypes.',
  },
};
const threadTitle = Object.fromEntries(threads.map((t) => [t.key, t.title]));
const skillGroups = Object.entries(skillContext).map(([group, context]) => ({
  ...context,
  items: skills.find((skill) => skill.group === group)!.items,
}));

---

<BaseLayout title="Resume | Joshua Briley | Product Design Engineer" description={description} mainClass="resume-page">

  <section class="calm-open resume-open">
    <Container>
      <div class="print-only">
        <h1>{CONTACT.name}</h1>
        <p><strong>{CONTACT.title}</strong></p>
        <p>{CONTACT.location} · <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a> · {CONTACT.phone}</p>
      </div>
      <p class="calm-label hero-in hero-in-1" data-print-screen>Résumé · Joshua Briley</p>
      <h1 class="calm-title hero-in hero-in-2" data-print-screen>I find what's worth building, design it, and ship it.</h1>
      <p class="calm-lede hero-in hero-in-3">{summary}</p>
      <div class="hero-in hero-in-4" data-print-screen>
        <div class="calm-actions">
          <a class="editorial-link" href="/resume.pdf" target="_blank" rel="noopener">Download PDF <span aria-hidden="true" data-link-arrow="down">↓</span></a>
          <a class="editorial-link" href="/contact/">Get in touch <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
        </div>
        <p class="calm-note">Updated {updated}</p>
      </div>
      <nav class="calm-jumps" aria-label="Résumé sections and work samples">
        <a href="#approach">How I work <span aria-hidden="true" data-link-arrow="down">↓</span></a>
        <a href="#experience">Employment history <span aria-hidden="true" data-link-arrow="down">↓</span></a>
        <a href="#skills">Skills <span aria-hidden="true" data-link-arrow="down">↓</span></a>
        <a href="#education">Education <span aria-hidden="true" data-link-arrow="down">↓</span></a>
        <a href="/personal-projects/rudiment-ui/">Public component work <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
        <a href="/projects/">Product case studies <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
      </nav>
    </Container>
  </section>

  <section id="approach" class="calm-section resume-approach" aria-labelledby="approach-title">
    <Container width="wide">
      <h2 id="approach-title" class="calm-heading">How I work.</h2>
      <p class="calm-intro">The same three things in every role below, whatever the industry.</p>
      <ol class="approach-list calm-points calm-points--grid calm-points--three" role="list" data-reveal-stagger>
        {threads.map((thread) => (
          <li class="approach-entry calm-point"><h3>{thread.title}.</h3> <p>{thread.body}</p></li>
        ))}
      </ol>
    </Container>
  </section>

  <section id="experience" class="calm-section resume-experience" aria-labelledby="experience-title">
    <Container width="wide">
      <h2 id="experience-title" class="calm-heading">Experience.</h2>
      <p class="calm-intro">Different industries, the same job: figure out the right problem, then design and build the answer.</p>

      <ul class="experience-list" role="list" data-reveal-stagger>
        {experience.map((job) => (
          <li class="experience-entry">
            <div class="experience-context">
              <p class="experience-period">{job.period.replace(' - ', ' – ')}</p>
              <h3 class="experience-company">{job.company}</h3>
              <p class="experience-role">{job.role}</p>
              <p class="experience-stack"><span class="sr-only">Tools and context: </span>{job.stack}</p>
              <ul class="experience-threads" role="list" aria-label="How this role shows the approach">
                {job.threads.map((key) => <li>{threadTitle[key]}</li>)}
              </ul>
            </div>
            <div class="experience-contribution">
              <p class="experience-lead">{job.bullets[0]}</p>
              <ul class="experience-details" role="list">
                {job.bullets.slice(1).map((bullet) => <li>{bullet}</li>)}
              </ul>
              {workLinks[job.company] && (
                <div class="experience-links">
                  {workLinks[job.company].map((link) => (
                    <a class="editorial-link" href={link.href}>{link.label} <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <section id="skills" class="calm-section resume-skills" aria-labelledby="skills-title">
    <Container width="wide">
      <h2 id="skills-title" class="calm-heading">Skills.</h2>
      <p class="calm-intro">The tools and disciplines behind shared components, accessible interfaces, and product workflows.</p>
      <div class="skill-list" data-reveal-stagger>
        {skillGroups.map((skill) => (
          <section class="skill-entry" aria-labelledby={`skill-${skill.title.toLowerCase().replace(/[^a-z]+/g, '-')}`}>
            <div class="skill-context">
              <h3 id={`skill-${skill.title.toLowerCase().replace(/[^a-z]+/g, '-')}`}>{skill.title}</h3>
              <p>{skill.description}</p>
              {skill.href && <a class="editorial-link" href={skill.href}>{skill.link} <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>}
            </div>
            <ul class="skill-tools" role="list" aria-label={`${skill.title} toolkit`}>
              {skill.items.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        ))}
      </div>
    </Container>
  </section>

  <section id="education" class="calm-section resume-education" aria-labelledby="education-title">
    <Container width="wide">
      <h2 id="education-title" class="calm-heading">Education.</h2>
      <p class="calm-intro">A foundation in science, with continued study in product design and accessibility.</p>
      <div class="education-layout" data-reveal>
        <div class="education-degrees">
          {education.map((degree) => (
            <article class="education-degree">
              <h3>{degree.title}</h3>
              <p class="education-institution">{degree.org}</p>
              <p class="education-note">{degree.note}</p>
            </article>
          ))}
        </div>
        <div class="education-learning">
          <h3>Continuing education</h3>
          <ul class="education-courses" role="list">
            {continuingEd.map((course) => (
              <li><h4>{course.title}</h4><p><a class="editorial-link" href={course.href} target="_blank" rel="noopener noreferrer">{course.org}<span aria-hidden="true" data-link-arrow="up-right">↗</span><span class="sr-only"> (opens in a new tab)</span></a></p></li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  /* Long-form record: hairlines (not timelines, dots, or tinted bands) separate
     entries so the page still scans; the type does the rest. */
  .resume-open .calm-lede { max-width: 52ch; }
  .approach-list { max-width: none; margin: clamp(2.5rem, 5vw, 4rem) 0 0; padding: 0; list-style: none; }
  .experience-list, .skill-list, .education-layout { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .experience-entry { display: grid; gap: 1.5rem; padding: 2.75rem 0; }
  .experience-context, .experience-contribution { min-width: 0; }
  .experience-period { font-size: .875rem; line-height: 1.5; color: var(--ink-muted); }
  .experience-company { margin-top: .6rem; max-width: 18ch; font-size: clamp(1.9rem, 3vw, 2.6rem); font-weight: 300; line-height: 1.08; letter-spacing: -.04em; text-wrap: balance; }
  .experience-role { margin-top: .6rem; font-size: 1.05rem; font-weight: 500; line-height: 1.4; }
  .experience-stack { margin-top: .5rem; font-size: .875rem; line-height: 1.5; color: var(--ink-muted); }
  .experience-threads { display: grid; gap: .2rem; margin-top: 1rem; padding: 0; list-style: none; }
  .experience-threads li { font-size: .82rem; line-height: 1.5; color: var(--ink-muted); }
  .experience-lead { max-width: 46ch; font-size: clamp(1.2rem, 1.7vw, 1.45rem); font-weight: 400; line-height: 1.45; letter-spacing: -.02em; text-wrap: pretty; }
  .experience-details { display: grid; gap: .85rem; margin-top: 1.25rem; max-width: 60ch; }
  .experience-details li { font-size: 1rem; line-height: 1.65; color: var(--ink-muted); }
  .experience-links { display: flex; flex-wrap: wrap; gap: .25rem 2rem; margin-top: 1.25rem; }
  .skill-entry { display: grid; gap: 1.5rem; padding: 2.5rem 0; }
  .skill-entry > *, .education-layout > * { min-width: 0; }
  .skill-context h3 { max-width: 20ch; font-size: clamp(1.6rem, 2.4vw, 2.1rem); font-weight: 300; line-height: 1.12; letter-spacing: -.035em; text-wrap: balance; }
  .skill-context p { max-width: 45ch; margin-top: .75rem; font-size: 1rem; line-height: 1.6; color: var(--ink-muted); }
  .skill-context a { margin-top: .75rem; }
  .skill-tools { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-content: start; gap: .6rem 1.5rem; margin: 0; padding: 0; list-style: none; }
  .skill-tools li { font-size: .98rem; line-height: 1.5; }
  .education-layout { display: grid; gap: 3rem; }
  .education-degree { padding-top: 1.75rem; }
  .education-degree + .education-degree { margin-top: 2rem; }
  .education-degree h3 { font-size: clamp(1.9rem, 3vw, 2.6rem); font-weight: 300; line-height: 1.08; letter-spacing: -.04em; text-wrap: balance; }
  .education-institution { margin-top: .6rem; font-size: 1.05rem; font-weight: 500; }
  .education-note { margin-top: .75rem; max-width: 40ch; font-size: 1rem; line-height: 1.65; color: var(--ink-muted); }
  .education-learning { padding-top: 1.75rem; }
  .education-learning > h3 { font-size: .95rem; font-weight: 500; color: var(--ink-muted); }
  .education-courses { margin: 1rem 0 0; padding: 0; list-style: none; }
  .education-courses li { padding: 1rem 0; }
  .education-courses h4 { max-width: 36ch; font-size: 1.1rem; font-weight: 400; line-height: 1.4; letter-spacing: -.015em; }
  .education-courses p { margin-top: .25rem; font-size: .95rem; line-height: 1.6; color: var(--ink-muted); }
  #approach, #experience, #skills, #education { scroll-margin-top: 5rem; }
  @media (min-width: 640px) { .skill-tools { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1024px) {
    .experience-entry, .skill-entry, .education-layout { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 5rem; }
    .experience-entry { padding: 3.25rem 0; }
    .skill-tools { padding-top: .35rem; }
  }
</style>
