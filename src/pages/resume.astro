---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Text from '~/components/primitives/Text.astro';

// Shared with /resume-print/ and therefore with public/resume.pdf, so the page
// and the download cannot drift. Edit the content in src/lib/resume-data.mjs,
// then re-run `npm run resume:pdf`.
import {
  CONTACT,
  SUMMARY as summary,
  STRENGTHS as threads,
  EXPERIENCE as experience,
  SKILLS as skills,
  EDUCATION as education,
  CONTINUING_ED as continuingEd,
  UPDATED as updated,
} from '~/lib/resume-data.mjs';

const description =
  'Product design engineer with 20+ years taking products from an unclear problem to a shipped, accessible product: framing what to build, designing the flow, and building it.';

const workLinks: Record<string, { href: string; label: string }[]> = {
  'Logatot, Inc.': [{ href: '/projects/logatot/', label: 'Read the Logatot case study' }],
  Independent: [
    { href: '/projects/ivfcryo/', label: 'IVFCRYO case study' },
    { href: '/projects/vmspark/', label: 'VMSpark case study' },
  ],
};

const skillContext: Record<string, { title: string; description: string; href?: string; link?: string }> = {
  'Design & craft': {
    title: 'Product design & accessibility',
    description: 'Framing workflows, then working through interaction states, prototypes, and accessibility behavior with product, design, and engineering.',
    href: '/projects/ivfcryo/',
    link: 'Follow a design decision',
  },
  'Data & experimentation': {
    title: 'Data & experimentation',
    description: 'Analytics, experimentation, and performance checks to identify friction and evaluate changes to an interface.',
  },
  'Front end': {
    title: 'Front-end engineering',
    description: 'My deepest current systems work is in Stencil Web Components and Storybook. My broader toolkit spans markup, styling, and product UI frameworks.',
  },
  'Systems & testing': {
    title: 'Design systems & testing',
    description: 'Shared components, tokens, documentation, and the tests and tooling that support their use across product teams.',
    href: '/personal-projects/rudiment-ui/',
    link: 'Inspect a component library',
  },
  'Back end & hosting': {
    title: 'Application delivery',
    description: 'Backend and deployment tools used to support product interfaces and working prototypes.',
  },
};
const threadTitle = Object.fromEntries(threads.map((t) => [t.key, t.title]));
const skillGroups = Object.entries(skillContext).map(([group, context]) => ({
  ...context,
  items: skills.find((skill) => skill.group === group)!.items,
}));

---

<BaseLayout title="Resume | Joshua Briley | Product Design Engineer" description={description} mainClass="resume-page">

  <Section tone="paper" padding="default" class="pt-12 md:pt-16">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16 lg:items-end">
        <div class="lg:col-span-8">
          <div class="print-only">
            <h1>{CONTACT.name}</h1>
            <p><strong>{CONTACT.title}</strong></p>
            <p>{CONTACT.location} · <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a> · {CONTACT.phone}</p>
          </div>
          <p class="role-line hero-in hero-in-1" data-print-screen>Résumé · Joshua Briley</p>
          <h1 class="page-type hero-in hero-in-2" data-print-screen>I find what's worth building, <em>design it, and ship it.</em></h1>
          <Text size="lg" tone="muted" class="hero-in hero-in-3 mt-7 max-w-2xl">
            {summary}
          </Text>
        </div>

        <div class="hero-in hero-in-4 lg:col-span-4 lg:flex lg:flex-col lg:items-end" data-print-screen>
          <div class="flex flex-wrap items-center gap-x-8 gap-y-4 lg:justify-end">
            <a class="action-link" href="/resume.pdf" target="_blank" rel="noopener">
              Download PDF <span aria-hidden="true" data-link-arrow="down">↓</span>
            </a>
            <a class="editorial-link" href="/contact/">
              Get in touch <span aria-hidden="true" data-link-arrow="up-right">↗</span>
            </a>
          </div>
          <p class="mt-4 text-sm text-ink-muted">Updated {updated}</p>
        </div>
      </div>
      <nav class="evidence-nav" aria-label="Résumé sections and work samples">
        <a href="#approach">How I work <span aria-hidden="true" data-link-arrow="down">↓</span></a>
        <a href="#experience">Employment history <span aria-hidden="true" data-link-arrow="down">↓</span></a>
        <a href="#skills">Skills <span aria-hidden="true" data-link-arrow="down">↓</span></a>
        <a href="#education">Education <span aria-hidden="true" data-link-arrow="down">↓</span></a>
        <a href="/personal-projects/rudiment-ui/">Public component work <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
        <a href="/projects/">Product case studies <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
      </nav>
    </Container>
  </Section>

  <section id="approach" class="editorial-section resume-approach" aria-labelledby="approach-title">
    <Container width="wide">
      <div class="section-heading">
        <h2 id="approach-title" class="section-type">How I work</h2>
        <p>The same three things in every role below, whatever the industry.</p>
      </div>
      <ol class="approach-list" role="list" data-reveal-stagger>
        {threads.map((thread, i) => (
          <li class="approach-entry">
            <p class="approach-index">{String(i + 1).padStart(2, '0')}</p>
            <h3>{thread.title}</h3>
            <p>{thread.body}</p>
          </li>
        ))}
      </ol>
    </Container>
  </section>

  <Section id="experience" tone="paper" padding="default" class="resume-experience">
    <Container width="wide">
      <div class="section-heading">
        <h2 class="section-type">Experience</h2>
        <p>Different industries, the same job: figure out the right problem, then design and build the answer.</p>
      </div>

      <ul class="experience-list" role="list" data-reveal-stagger>
        {experience.map((job) => (
          <li class="experience-entry">
            <div class="experience-context">
              <p class="experience-period">{job.period.replace(' - ', ' – ')}</p>
              <h3 class="experience-company">{job.company}</h3>
              <p class="experience-role">{job.role}</p>
              <p class="experience-stack"><span class="sr-only">Tools and context: </span>{job.stack}</p>
              <ul class="experience-threads" role="list" aria-label="How this role shows the approach">
                {job.threads.map((key) => <li>{threadTitle[key]}</li>)}
              </ul>
            </div>
            <div class="experience-contribution">
              <p class="experience-lead">{job.bullets[0]}</p>
              <ul class="experience-details" role="list">
                {job.bullets.slice(1).map((bullet) => <li>{bullet}</li>)}
              </ul>
              {workLinks[job.company] && (
                <div class="experience-links">
                  {workLinks[job.company].map((link) => (
                    <a class="editorial-link" href={link.href}>{link.label} <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  <section id="skills" class="editorial-section resume-skills" aria-labelledby="skills-title">
    <Container width="wide">
      <div class="section-heading">
        <h2 id="skills-title" class="section-type">Skills</h2>
        <p>The tools and disciplines behind shared components, accessible interfaces, and product workflows.</p>
      </div>
      <div class="skill-list" data-reveal-stagger>
        {skillGroups.map((skill) => (
          <section class="skill-entry" aria-labelledby={`skill-${skill.title.toLowerCase().replace(/[^a-z]+/g, '-')}`}>
            <div class="skill-context">
              <h3 id={`skill-${skill.title.toLowerCase().replace(/[^a-z]+/g, '-')}`}>{skill.title}</h3>
              <p>{skill.description}</p>
              {skill.href && <a class="editorial-link" href={skill.href}>{skill.link} <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>}
            </div>
            <ul class="skill-tools" role="list" aria-label={`${skill.title} toolkit`}>
              {skill.items.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        ))}
      </div>
    </Container>
  </section>

  <section id="education" class="editorial-section resume-education" aria-labelledby="education-title">
    <Container width="wide">
      <div class="section-heading">
        <h2 id="education-title" class="section-type">Education</h2>
        <p>A foundation in science, with continued study in product design and accessibility.</p>
      </div>
      <div class="education-layout" data-reveal>
        <div class="education-degrees">
          {education.map((degree) => (
            <article class="education-degree">
              <h3>{degree.title}</h3>
              <p class="education-institution">{degree.org}</p>
              <p class="education-note">{degree.note}</p>
            </article>
          ))}
        </div>
        <div class="education-learning">
          <h3>Continuing education</h3>
          <ul class="education-courses" role="list">
            {continuingEd.map((course) => (
              <li><h4>{course.title}</h4><p><a class="editorial-link" href={course.href} target="_blank" rel="noopener noreferrer">{course.org}<span aria-hidden="true" data-link-arrow="up-right">↗</span><span class="sr-only"> (opens in a new tab)</span></a></p></li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .experience-entry {
    position: relative;
    display: grid;
    gap: 2rem;
    padding: 2.5rem 0 2.5rem 1.75rem;
  }
  .experience-entry::before { content: ''; position: absolute; left: 3px; top: 0; bottom: 0; width: 1px; background: #b7c6d2; }
  .experience-entry::after { content: ''; position: absolute; top: 2.85rem; left: 0; width: 7px; height: 7px; border: 1px solid var(--portfolio-blue); background: var(--paper); border-radius: 50%; }
  .experience-entry:first-child { padding-top: 0; }
  .experience-entry:first-child::before, .experience-entry:first-child::after { top: .35rem; }
  .experience-entry:first-child::after { background: var(--portfolio-blue); }
  .experience-entry:last-child::before { bottom: auto; height: 2.85rem; }
  .experience-context, .experience-contribution { min-width: 0; }
  .experience-period {
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: .75rem;
    line-height: 1.5;
    color: var(--accent);
  }
  .experience-company {
    margin-top: 1rem;
    max-width: 18ch;
    font-size: clamp(2.1rem, 3.5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -.05em;
    text-wrap: balance;
  }
  .experience-role {
    margin-top: 1rem;
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -.015em;
  }
  .experience-stack {
    margin-top: .65rem;
    font-size: .875rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }
  .experience-lead {
    max-width: 45ch;
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -.025em;
    text-wrap: pretty;
  }
  .experience-details {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    max-width: 59ch;
  }
  .experience-details li {
    position: relative;
    padding-left: 1rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-muted);
  }
  .experience-details li::before {
    content: '';
    position: absolute;
    left: 0;
    top: .72em;
    width: 4px;
    height: 4px;
    background: var(--accent);
  }
  .experience-links { display: flex; flex-wrap: wrap; gap: .25rem 2rem; margin-top: 1.5rem; }
  .experience-threads { display: grid; gap: .3rem; margin-top: 1rem; list-style: none; padding: 0; }
  .experience-threads li { font-family: var(--font-geist-mono), ui-monospace, monospace; font-size: .75rem; line-height: 1.5; color: var(--accent); }
  .approach-list { display: grid; gap: 0; list-style: none; padding: 0; margin: 0; }
  .approach-entry { padding: 2rem 0; min-width: 0; }
  .approach-index { font-family: var(--font-geist-mono), ui-monospace, monospace; font-size: .75rem; color: var(--accent); }
  .approach-entry h3 { margin-top: .75rem; font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 800; line-height: 1.1; letter-spacing: -.04em; text-wrap: balance; }
  .approach-entry p:last-child { margin-top: .85rem; max-width: 38ch; color: var(--ink-muted); font-size: 1rem; line-height: 1.65; }
  .resume-skills { background: var(--portfolio-tint); }
  .skill-list { }
  .skill-entry { display: grid; gap: 1.75rem; padding: 2.5rem 0; }
  .skill-entry > *, .education-layout > * { min-width: 0; }
  .skill-context h3 { max-width: 19ch; font-size: clamp(1.9rem, 3vw, 2.7rem); font-weight: 800; line-height: 1.08; letter-spacing: -.045em; text-wrap: balance; }
  .skill-context p { max-width: 45ch; margin-top: 1rem; color: var(--ink-muted); font-size: 1rem; line-height: 1.65; }
  .skill-context a { margin-top: 1rem; }
  .skill-tools { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-content: start; gap: .7rem 1.5rem; list-style: none; padding: 0; margin: 0; }
  .skill-tools li { font-size: .98rem; line-height: 1.5; color: var(--ink); }
  .education-layout { display: grid; gap: 3rem; }
  .education-degree { padding-top: 1.75rem; }
  .education-degree + .education-degree { margin-top: 2rem; }
  .education-degree h3 { font-size: clamp(2.2rem, 4vw, 3.5rem); font-weight: 800; line-height: 1.05; letter-spacing: -.05em; text-wrap: balance; }
  .education-institution { margin-top: 1rem; font-size: 1.2rem; font-weight: 600; color: var(--portfolio-blue); letter-spacing: -.02em; }
  .education-note { margin-top: 1rem; max-width: 39ch; color: var(--ink-muted); font-size: 1rem; line-height: 1.7; }
  .education-learning > h3 { font-size: 1.4rem; font-weight: 700; line-height: 1.25; letter-spacing: -.03em; }
  .education-learning { padding-top: 1.75rem; }
  .education-courses { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  .education-courses li { padding: 1.25rem 0; }
  .education-courses h4 { max-width: 35ch; font-size: 1.15rem; font-weight: 600; letter-spacing: -.015em; line-height: 1.4; }
  .education-courses p { margin-top: .5rem; font-size: .95rem; line-height: 1.6; color: var(--ink-muted); }
  #approach, #skills, #education { scroll-margin-top: 6rem; }
  @media (min-width: 1024px) {
    .approach-list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem; }
    .approach-entry { }
  }
  @media (min-width: 640px) { .skill-tools { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1024px) {
    .skill-entry, .education-layout { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 6rem; }
    .skill-entry { padding: 3rem 0; }
    .skill-tools { padding-top: .4rem; }
  }

  @media (min-width: 1024px) {
    .experience-entry {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: 6rem;
      padding: 3.5rem 0 3.5rem 1.75rem;
    }
    .experience-entry::after { top: 3.85rem; }
    .experience-entry:last-child::before { height: 3.85rem; }
    .experience-contribution { padding-top: 2rem; }
  }
</style>
