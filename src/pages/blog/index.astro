---
import { getCollection } from 'astro:content';
import { writing } from '~/lib/writing';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import BookList from '~/components/patterns/BookList.astro';
import ArticleIllustration from '~/components/patterns/ArticleIllustration.astro';
import { hasIllustration } from '~/lib/article-illustrations';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || a.id.localeCompare(b.id),
);
const [lead, ...rest] = posts;
// Index sections follow each post's frontmatter `category`, so a post's label and its section always agree.
const topics = [
  { id: 'design-systems', category: 'Design Systems', title: 'Design', emphasis: 'systems.', description: 'Architecture, adoption, and the effort behind a dependable component system.' },
  { id: 'ai-and-engineering', category: 'AI & Engineering', title: 'AI &', emphasis: 'engineering.', description: 'Research and perspectives on changing tools, responsibilities, and ownership.' },
  { id: 'ui-engineering', category: 'UI Engineering', title: 'UI', emphasis: 'engineering.', description: 'Interface craft beyond the component library, and the skills behind it.' },
];
const known = new Set(topics.map((topic) => topic.category));
// Posts with an unlisted category remain visible without requiring an index edit.
const groups = [
  ...topics.map((topic) => ({ ...topic, label: topic.category, posts: rest.filter((post) => post.data.category === topic.category) })),
  { id: 'more-writing', title: 'More', emphasis: 'writing.', label: 'More writing', description: 'Further notes on interfaces and the teams building them.', posts: rest.filter((post) => !known.has(post.data.category)) },
].filter((group) => group.posts.length > 0);
const guideSections = lead?.id === 'staff-level-ui-engineering-for-dummies' ? [
  { title: 'From components to a UI platform', anchor: 'from-component-library-to-ui-platform' },
  { title: 'Accessibility, testing, and browser support', anchor: 'accessibility-testing-and-browser-support' },
  { title: 'Tokens, governance, and adoption', anchor: 'tokens-governance-and-adoption' },
] : [];
const formatDate =(date: Date) => date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

<BaseLayout title="Writing on design systems & UI engineering | Joshua Briley" description="Guides, comparisons, and practical notes on component architecture, design system adoption, AI-assisted development, and front-end engineering.">
  <section class="calm-open">
    <Container>
      <p class="calm-label hero-in hero-in-1">Writing <span aria-hidden="true">·</span> Design systems &amp; UI engineering</p>
      <h1 class="calm-title hero-in hero-in-2">Notes on building better UI.</h1>
      <p class="calm-lede hero-in hero-in-3">Components, architecture, adoption, and the decisions behind shared interfaces. Guides and perspectives drawn from twenty-plus years in production UI.</p>
      <nav class="calm-jumps hero-in hero-in-4" aria-label="Browse writing by topic">
        {groups.map((group) => <a href={`#${group.id}`}>{group.label} <span aria-hidden="true" data-link-arrow="down">↓</span></a>)}
        <a href="#books">Books <span aria-hidden="true" data-link-arrow="down">↓</span></a>
      </nav>
    </Container>
  </section>

  {lead && (
    <section class="latest-writing" aria-labelledby="latest-title">
      <Container width="wide">
        <div class="latest-layout" data-reveal>
          <div class="latest-copy">
            <p class="calm-label">Latest {writing[lead.id]?.format?.toLowerCase() ?? 'article'}</p>
            <h2 id="latest-title"><a href={`/blog/${lead.id}/`}>{lead.data.title}</a></h2>
            <p class="latest-description">{lead.data.description}</p>
            <p class="post-meta latest-meta"><time datetime={isoDate(lead.data.date)}>{formatDate(lead.data.date)}</time><span>{lead.data.readMinutes} min read</span></p>
            <a class="editorial-link latest-action" href={`/blog/${lead.id}/`}>Read the {writing[lead.id]?.format?.toLowerCase() === 'guide' ? 'guide' : 'article'} <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
          </div>
          {guideSections.length === 0 && hasIllustration(lead.id) && (
            <div class="latest-illustration"><ArticleIllustration post={lead.id} /></div>
          )}
          {guideSections.length > 0 && (
            <div class="guide-contents">
              <h3>Inside the guide</h3>
              <ul>{guideSections.map((section) => <li><a href={`/blog/${lead.id}/#${section.anchor}`}>{section.title}<span aria-hidden="true" data-link-arrow="up-right">↗</span></a></li>)}</ul>
              <p>A detailed look at technical decisions and the responsibility that comes with shared UI.</p>
            </div>
          )}
        </div>
      </Container>
    </section>
  )}

  {groups.map((group) => (
    <section id={group.id} class="calm-section writing-section" aria-labelledby={`${group.id}-title`}>
      <Container>
        <div class="writing-topic">
          <h2 id={`${group.id}-title`} class="calm-heading">{group.title} {group.emphasis}</h2>
          <p class="calm-intro">{group.description}</p>
        </div>
        <ul class="writing-list" data-reveal-stagger>
          {group.posts.map((post) => (
            <li>
              <a class:list={['post-link article-preview-link', hasIllustration(post.id) && 'post-link--illustrated']} href={`/blog/${post.id}/`} aria-labelledby={`title-${post.id}`}>
                {hasIllustration(post.id) && <ArticleIllustration post={post.id} class="post-illustration" />}
                <div class="post-copy">
                  <p class="post-meta"><span>{post.data.category}</span><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time><span>{post.data.readMinutes} min read</span></p>
                  <h3 id={`title-${post.id}`}>{post.data.title}</h3>
                  <p class="post-description">{post.data.description}</p>
                  <span class="editorial-link post-action" aria-hidden="true">Read article <span data-link-arrow="up-right">↗</span></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </Container>
    </section>
  ))}

  <section id="books" class="calm-section books-section" aria-labelledby="books-title">
    <Container>
      <h2 id="books-title" class="calm-heading">Longer reads.</h2>
      <p class="calm-intro">Two free online books, each taking a single subject from start to finish.</p>
      <div class="calm-column"><BookList stacked /></div>
    </Container>
  </section>
</BaseLayout>

<style>
  /* The latest piece leads the page on paper, not a coloured slab: light display
     type beside its illustration. */
  .latest-writing { padding: clamp(2rem, 5vw, 4rem) 0 clamp(4rem, 8vw, 6rem); }
  .latest-layout { display: grid; gap: 3rem; }
  .latest-copy h2 { max-width: 18ch; margin-top: 1rem; font-size: clamp(2.3rem, 4.4vw, 4rem); font-weight: 300; letter-spacing: -.045em; line-height: 1.05; text-wrap: balance; }
  .latest-copy h2 a { transition: color .2s; }
  .latest-copy h2 a:hover { color: var(--accent); }
  .latest-description { margin-top: 1.5rem; max-width: 46ch; font-size: 1.15rem; line-height: 1.6; color: var(--ink-muted); }
  .post-meta { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; color: var(--ink-muted); font-size: .85rem; line-height: 1.5; }
  .latest-meta { margin-top: 1.25rem; }
  .latest-action { margin-top: 1.5rem; }
  .guide-contents h3 { font-size: .95rem; font-weight: 500; color: var(--ink-muted); }
  .guide-contents ul { margin-top: .75rem; }
  .guide-contents li a { display: flex; gap: 1.5rem; justify-content: space-between; align-items: start; padding: .9rem 0; font-size: 1.15rem; line-height: 1.4; letter-spacing: -.015em; transition: color .2s; }
  .guide-contents li a:hover { color: var(--accent); }
  .guide-contents li span { color: var(--ink-muted); }
  .guide-contents > p { max-width: 40ch; margin-top: 1.25rem; font-size: .9rem; line-height: 1.6; color: var(--ink-muted); }
  .latest-illustration { display: block; min-width: 0; }
  .writing-list { max-width: 50rem; margin: clamp(2.5rem, 5vw, 4rem) auto 0; }
  .writing-list li + li { margin-top: clamp(2.5rem, 5vw, 3.5rem); }
  .post-link { display: block; }
  .post-copy { min-width: 0; }
  .post-link h3 { max-width: 28ch; margin-top: .6rem; font-size: clamp(1.6rem, 2.6vw, 2.2rem); font-weight: 400; line-height: 1.15; letter-spacing: -.035em; text-wrap: balance; transition: color .2s; }
  .post-link:hover h3 { color: var(--accent); }
  .post-description { margin-top: .75rem; max-width: 56ch; font-size: 1.02rem; line-height: 1.6; color: var(--ink-muted); }
  .post-action { margin-top: .5rem; }
  .post-link--illustrated { display: grid; gap: 1.5rem; }
  .post-link :global(.post-illustration) { --mat: 1rem; min-width: 0; }
  @media (min-width: 768px) {
    .post-link--illustrated { grid-template-columns: minmax(0, 1fr) minmax(0, 13rem); gap: 2.5rem; align-items: start; }
    .post-link--illustrated :global(.post-illustration) { order: 2; }
  }
  @media (min-width: 1024px) {
    .latest-layout { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 5rem; align-items: center; }
  }
</style>
