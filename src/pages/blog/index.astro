---
import { getCollection } from 'astro:content';
import { writing } from '~/lib/writing';
import { writingTopics } from '~/lib/writing-topics';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import ArticleIllustration from '~/components/patterns/ArticleIllustration.astro';
import { hasIllustration } from '~/lib/article-illustrations';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || a.id.localeCompare(b.id),
);
const [lead, ...rest] = posts;
// Index sections follow each post's frontmatter `category`, so a post's label and its section always agree.
const topics = writingTopics;
const known = new Set(topics.map((topic) => topic.category));
// Posts with an unlisted category remain visible without requiring an index edit.
const groups = [
  ...topics.map((topic) => ({ ...topic, label: topic.category, posts: rest.filter((post) => post.data.category === topic.category) })),
  { id: 'more-writing', title: 'More', emphasis: 'writing.', label: 'More writing', description: 'Further notes on interfaces and the teams building them.', posts: rest.filter((post) => !known.has(post.data.category)) },
].filter((group) => group.posts.length > 0);
// The hero lineup: one entry per series, shown with a recent illustration
// (not the lead post's, which appears again right below).
const countNoun: Record<string, string> = { 'wild-interfaces': 'episodes', 'ui-court': 'cases', 'fictional-ux-engineers': 'profiles' };
const lineup = topics
  .map((topic) => ({ ...topic, posts: posts.filter((post) => post.data.category === topic.category) }))
  .filter((series) => series.posts.length > 0)
  .map((series) => ({ ...series, cover: series.posts.find((post) => post.id !== lead?.id && hasIllustration(post.id)), unit: countNoun[series.id] ?? 'articles' }));
const formatDate =(date: Date) => date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

<BaseLayout title="Writing: interface lessons, played for laughs | Joshua Briley" description="Bad interface patterns stand trial, everyday components get the nature-documentary treatment, and famous characters join product teams. Each story hides a real lesson about building better UI.">
  <section class="page-opener writing-opener">
    <Container width="wide">
      <p class="role-line hero-in hero-in-1">Writing</p>
      <h1 class="page-type hero-in hero-in-2">Interface lessons, <em>played for laughs.</em></h1>
      <p class="page-lede hero-in hero-in-3">Bad patterns stand trial, everyday components get the nature-documentary treatment, and famous characters join product teams. Each story hides a real lesson about building better UI.</p>
      <nav class="series-lineup hero-in hero-in-4" aria-label="Browse the series">
        <ul role="list">
          {lineup.map((series) => (
            <li>
              <a href={`#${series.id}`}>
                {series.cover && hasIllustration(series.cover.id) && <span class="series-cover" aria-hidden="true"><ArticleIllustration post={series.cover.id} /></span>}
                <span class="series-name">{series.category} <span aria-hidden="true" data-link-arrow="down">↓</span></span>
                <span class="series-description">{series.description}</span>
                <span class="series-count">{series.posts.length} {series.unit}</span>
              </a>
            </li>
          ))}
        </ul>
    </Container>
  </section>

  {lead && (
    <section class="latest-writing" aria-labelledby="latest-title">
      <Container width="wide">
        <div class="latest-layout" data-reveal>
          <div class="latest-copy">
            <p class="latest-context">Latest {writing[lead.id]?.format?.toLowerCase() ?? 'article'}</p>
            <h2 id="latest-title"><a href={`/blog/${lead.id}/`}>{lead.data.title}</a></h2>
            <p class="latest-description">{lead.data.description}</p>
            <p class="post-meta latest-meta"><time datetime={isoDate(lead.data.date)}>{formatDate(lead.data.date)}</time><span>{lead.data.readMinutes} min read</span></p>
            <a class="action-link latest-action" href={`/blog/${lead.id}/`}>Read the article <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
          </div>
          {hasIllustration(lead.id) && (
            <div class="latest-illustration"><ArticleIllustration post={lead.id} /></div>
          )}
        </div>
      </Container>
    </section>
  )}

  {groups.map((group) => (
    <section id={group.id} class="editorial-section writing-section" aria-labelledby={`${group.id}-title`}>
      <Container width="wide">
        <div class="writing-group">
          <div class="writing-topic">
            <h2 id={`${group.id}-title`} class="section-type">{group.title} <em>{group.emphasis}</em></h2>
            <p>{group.description}</p>
          </div>
          <ul class="writing-list" data-reveal-stagger>
            {group.posts.map((post) => (
              <li>
                <a class:list={['post-link article-preview-link', hasIllustration(post.id) && 'post-link--illustrated']} href={`/blog/${post.id}/`} aria-labelledby={`title-${post.id}`}>
                  {hasIllustration(post.id) && <ArticleIllustration post={post.id} class="post-illustration" />}
                  <div class="post-copy">
                    <p class="post-meta"><span>{post.data.category}</span><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time><span>{post.data.readMinutes} min read</span></p>
                    <h3 id={`title-${post.id}`}>{post.data.title}</h3>
                    <p class="post-description">{post.data.description}</p>
                    <span class="post-action" aria-hidden="true">Read article <span data-link-arrow="up-right">↗</span></span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </Container>
    </section>
  ))}
</BaseLayout>

<style>
  .writing-opener .page-type { max-width: 19ch; }
  /* The series lineup: each series' latest illustration, name, and a one-line pitch. */
  .series-lineup { margin-top: 3.5rem; }
  .series-lineup ul { display: grid; gap: 2.5rem; margin: 0; padding: 0; list-style: none; }
  .series-lineup a { display: grid; gap: .5rem; align-content: start; }
  .series-cover { display: none; margin-bottom: .75rem; }
  .series-cover :global(.illustration) { --mat: .75rem; }
  .series-name { display: inline-flex; align-items: center; gap: .6rem; font-size: 1.125rem; font-weight: 600; letter-spacing: -.015em; color: var(--ink); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 5px; transition: color .2s, text-decoration-color .2s; }
  .series-description { max-width: 34ch; font-size: .9375rem; line-height: 1.55; color: var(--ink-muted); }
  .series-count { font-size: .8125rem; color: var(--ink-muted); }
  .series-lineup a:is(:hover, :focus-visible) .series-name { color: var(--accent); text-decoration-color: currentColor; }
  .series-lineup a:focus-visible { outline: 3px solid var(--accent); outline-offset: 6px; }
  @media (min-width: 768px) {
    .series-lineup ul { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem; }
    .series-cover { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .series-name { transition: none; }
  }
  .latest-writing { background: var(--portfolio-blue); color: white; padding: 4.5rem 0; }
  .latest-layout { display: grid; gap: 3rem; }
  .latest-writing a:focus-visible { outline: 3px solid white; outline-offset: 5px; }
  .latest-context { color: #c6d8e8; font-size: .87rem; margin-bottom: 1.4rem; }
  .latest-copy h2 { max-width: 17ch; font-size: clamp(2.65rem, 5.3vw, 4.8rem); font-weight: 800; letter-spacing: -.055em; line-height: 1.03; }
  .latest-copy h2 a:hover, .latest-copy h2 a:focus-visible { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .latest-description { margin-top: 1.6rem; max-width: 49ch; font-size: 1.1rem; line-height: 1.65; color: #e0e8ef; }
  .post-meta { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; color: var(--ink-muted); font-size: .82rem; line-height: 1.5; }
  .latest-meta { color: #c6d8e8; margin-top: 1.4rem; }
  .latest-action { background: white; color: var(--portfolio-blue); margin-top: 1.7rem; }
  .latest-action:hover { background: #e0e8ef; }
  .writing-group { display: grid; gap: 2.5rem; }
  .writing-topic .section-type { font-size: clamp(2.6rem, 4.3vw, 4rem); }
  .writing-topic > p { max-width: 29ch; margin-top: 1.5rem; color: var(--ink-muted); font-size: 1rem; line-height: 1.65; }
  .writing-list li + li { margin-top: 1.5rem; }
  .post-link { display: block; border: 1px solid transparent; border-top-color: var(--line-strong); padding: 1.5rem 1rem 1.75rem; }
  .post-link h3 { max-width: 26ch; font-size: clamp(1.95rem, 3vw, 2.8rem); font-weight: 750; line-height: 1.12; letter-spacing: -.04em; margin-top: 1rem; }
  .post-copy { min-width: 0; }
  .post-link--illustrated { display: grid; gap: 1.5rem; }
  .post-link :global(.post-illustration) { --mat: 1rem; min-width: 0; }
  .latest-illustration { display: block; min-width: 0; }
  .post-description { margin-top: 1rem; max-width: 57ch; font-size: 1rem; line-height: 1.65; color: var(--ink-muted); }
  .post-action { display: inline-flex; align-items: center; gap: 1.2rem; min-height: 44px; margin-top: .85rem; font-size: .9rem; font-weight: 600; color: var(--portfolio-blue); text-decoration: underline; text-underline-offset: 5px; }
  @media (min-width: 1024px) {
    .latest-layout { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 6rem; align-items: center; }
    .writing-group { grid-template-columns: minmax(0, .8fr) minmax(0, 1.7fr); gap: 5rem; }
  }
  @media (min-width: 768px) {
    .post-link--illustrated { grid-template-columns: minmax(0, 1fr) minmax(0, 15rem); gap: 2.5rem; align-items: start; }
    .post-link--illustrated :global(.post-illustration) { order: 2; }
  }
  @media (max-width: 639px) {
    .latest-writing { padding: 3.5rem 0; }
    .post-link { padding-inline: .5rem; }
    .writing-list li + li { margin-top: 1rem; }
  }
</style>
