---
import { getCollection } from 'astro:content';
import { writing } from '~/lib/writing';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import BookList from '~/components/patterns/BookList.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || a.id.localeCompare(b.id),
);
const [lead, ...rest] = posts;
// Index sections follow each post's frontmatter `category`, so a post's label and its section always agree.
const topics = [
  { id: 'design-systems', category: 'Design Systems', title: 'Design', emphasis: 'systems.', description: 'Architecture, adoption, and the effort behind a dependable component system.' },
  { id: 'ai-and-engineering', category: 'AI & Engineering', title: 'AI &', emphasis: 'engineering.', description: 'Research and perspectives on changing tools, responsibilities, and ownership.' },
  { id: 'ui-engineering', category: 'UI Engineering', title: 'UI', emphasis: 'engineering.', description: 'Interface craft beyond the component library, and the skills behind it.' },
];
const known = new Set(topics.map((topic) => topic.category));
// Posts with an unlisted category remain visible without requiring an index edit.
const groups = [
  ...topics.map((topic) => ({ ...topic, label: topic.category, posts: rest.filter((post) => post.data.category === topic.category) })),
  { id: 'more-writing', title: 'More', emphasis: 'writing.', label: 'More writing', description: 'Further notes on interfaces and the teams building them.', posts: rest.filter((post) => !known.has(post.data.category)) },
].filter((group) => group.posts.length > 0);
const guideSections = lead?.id === 'staff-level-ui-engineering-for-dummies' ? [
  { title: 'From components to a UI platform', anchor: 'from-component-library-to-ui-platform' },
  { title: 'Accessibility, testing, and browser support', anchor: 'accessibility-testing-and-browser-support' },
  { title: 'Tokens, governance, and adoption', anchor: 'tokens-governance-and-adoption' },
] : [];
const formatDate =(date: Date) => date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

<BaseLayout title="Writing on design systems & UI engineering | Joshua Briley" description="Guides, comparisons, and practical notes on component architecture, design system adoption, AI-assisted development, and front-end engineering.">
  <section class="page-opener writing-opener">
    <Container width="wide">
      <p class="role-line hero-in hero-in-1">Writing <span aria-hidden="true">/</span> Design systems &amp; UI engineering</p>
      <h1 class="page-type hero-in hero-in-2">Notes on building<br /><em>better UI.</em></h1>
      <p class="page-lede hero-in hero-in-3">Components, architecture, adoption, and the decisions behind shared interfaces. Guides and perspectives drawn from twenty-plus years in production UI.</p>
      <nav class="evidence-nav hero-in hero-in-4" aria-label="Browse writing by topic">
        <a href="#books">Books <span aria-hidden="true" data-link-arrow="down">↓</span></a>
        {groups.map((group) => <a href={`#${group.id}`}>{group.label} <span aria-hidden="true" data-link-arrow="down">↓</span></a>)}
      </nav>
    </Container>
  </section>

  <section id="books" class="editorial-section books-section" aria-labelledby="books-title">
    <Container width="wide">
      <div class="books-intro">
        <h2 id="books-title" class="section-type">Longer<br /><em>reads.</em></h2>
        <p>Two free online books, each taking a single subject from start to finish.</p>
      </div>
      <BookList />
    </Container>
  </section>

  {lead && (
    <section class="latest-writing" aria-labelledby="latest-title">
      <Container width="wide">
        <div class="latest-layout" data-reveal>
          <div class="latest-copy">
            <p class="latest-context">Latest {writing[lead.id]?.format?.toLowerCase() ?? 'article'}</p>
            <h2 id="latest-title"><a href={`/blog/${lead.id}/`}>{lead.data.title}</a></h2>
            <p class="latest-description">{lead.data.description}</p>
            <p class="post-meta latest-meta"><time datetime={isoDate(lead.data.date)}>{formatDate(lead.data.date)}</time><span>{lead.data.readMinutes} min read</span></p>
            <a class="action-link latest-action" href={`/blog/${lead.id}/`}>Read the {writing[lead.id]?.format?.toLowerCase() === 'guide' ? 'guide' : 'article'} <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
          </div>
          {guideSections.length > 0 && (
            <div class="guide-contents">
              <h3>Inside the guide</h3>
              <ul>{guideSections.map((section) => <li><a href={`/blog/${lead.id}/#${section.anchor}`}>{section.title}<span aria-hidden="true" data-link-arrow="up-right">↗</span></a></li>)}</ul>
              <p>A detailed look at technical decisions and the responsibility that comes with shared UI.</p>
            </div>
          )}
        </div>
      </Container>
    </section>
  )}

  {groups.map((group) => (
    <section id={group.id} class="editorial-section writing-section" aria-labelledby={`${group.id}-title`}>
      <Container width="wide">
        <div class="writing-group">
          <div class="writing-topic">
            <h2 id={`${group.id}-title`} class="section-type">{group.title}<br /><em>{group.emphasis}</em></h2>
            <p>{group.description}</p>
          </div>
          <ul class="writing-list" data-reveal-stagger>
            {group.posts.map((post) => (
              <li>
                <a class="post-link article-preview-link" href={`/blog/${post.id}/`} aria-labelledby={`title-${post.id}`}>
                  <p class="post-meta"><span>{post.data.category}</span><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time><span>{post.data.readMinutes} min read</span></p>
                  <h3 id={`title-${post.id}`}>{post.data.title}</h3>
                  <p class="post-description">{post.data.description}</p>
                  <span class="post-action" aria-hidden="true">Read article <span data-link-arrow="up-right">↗</span></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </Container>
    </section>
  ))}

  <section class="editorial-section writing-tools" aria-labelledby="writing-tools-title">
    <Container width="wide">
      <div class="approach-layout">
        <h2 id="writing-tools-title" class="section-type">Try the<br /><em>tools.</em></h2>
        <div>
          <p>Assess your design system, estimate UI rework, explore shared tokens, or inspect sample audit findings. Four free tools you can use in your browser.</p>
          <a href="/tools/" class="action-link">Explore the tools <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .writing-opener .page-type { max-width: 19ch; }
  .latest-writing { background: var(--portfolio-blue); color: white; padding: 4.5rem 0; }
  .latest-layout { display: grid; gap: 3rem; }
  .latest-writing a:focus-visible { outline: 3px solid white; outline-offset: 5px; }
  .latest-context { color: #c6d8e8; font-size: .87rem; margin-bottom: 1.4rem; }
  .latest-copy h2 { max-width: 17ch; font-size: clamp(2.65rem, 5.3vw, 4.8rem); font-weight: 800; letter-spacing: -.055em; line-height: 1.03; text-wrap: balance; }
  .latest-copy h2 a:hover, .latest-copy h2 a:focus-visible { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .latest-description { margin-top: 1.6rem; max-width: 49ch; font-size: 1.1rem; line-height: 1.65; color: #e0e8ef; }
  .post-meta { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; color: var(--ink-muted); font-size: .82rem; line-height: 1.5; }
  .latest-meta { color: #c6d8e8; margin-top: 1.4rem; }
  .latest-action { background: white; color: var(--portfolio-blue); margin-top: 1.7rem; }
  .latest-action:hover { background: #e0e8ef; }
  .guide-contents { border-top: 1px solid #6c89a3; padding-top: 1.5rem; }
  .guide-contents h3 { font-size: 1.15rem; font-weight: 600; margin-bottom: 1rem; }
  .guide-contents li { border-top: 1px solid #6c89a3; }
  .guide-contents li a { display: flex; gap: 1.5rem; justify-content: space-between; align-items: start; padding: 1.15rem 0; font-size: 1.1rem; line-height: 1.4; }
  .guide-contents li a:hover, .guide-contents li a:focus-visible { text-decoration: underline; text-underline-offset: 5px; }
  .guide-contents li span { color: #c6d8e8; }
  .guide-contents > p { max-width: 38ch; color: #c6d8e8; font-size: .85rem; line-height: 1.65; margin-top: 1.5rem; }
  .writing-group { display: grid; gap: 2.5rem; }
  .writing-topic .section-type { font-size: clamp(2.6rem, 4.3vw, 4rem); }
  .writing-topic > p { max-width: 29ch; margin-top: 1.5rem; color: var(--ink-muted); font-size: 1rem; line-height: 1.65; }
  .writing-list li + li { margin-top: 1.5rem; }
  .post-link { display: block; border: 1px solid transparent; border-top-color: var(--line-strong); padding: 1.5rem 1rem 1.75rem; }
  .post-link h3 { max-width: 26ch; font-size: clamp(1.95rem, 3vw, 2.8rem); font-weight: 750; line-height: 1.12; letter-spacing: -.04em; margin-top: 1rem; text-wrap: balance; }
  .books-section { background: var(--portfolio-tint); }
  .books-intro { display: grid; gap: 1.5rem; margin-bottom: 3.5rem; }
  .books-intro > p { max-width: 34ch; color: var(--ink-muted); font-size: 1.1rem; line-height: 1.65; }
  @media (min-width: 1024px) {
    .books-intro { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 6rem; align-items: end; }
  }
  .post-description { margin-top: 1rem; max-width: 57ch; font-size: 1rem; line-height: 1.65; color: var(--ink-muted); }
  .post-action { display: inline-flex; align-items: center; gap: 1.2rem; min-height: 44px; margin-top: .85rem; font-size: .9rem; font-weight: 600; color: var(--portfolio-blue); text-decoration: underline; text-underline-offset: 5px; }
  .writing-tools { background: var(--portfolio-tint); }
  .writing-tools .approach-layout { align-items: center; }
  .writing-tools p { max-width: 46ch; font-size: 1.1rem; line-height: 1.65; color: var(--ink-muted); margin-bottom: 1.6rem; }
  @media (min-width: 1024px) {
    .latest-layout { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 6rem; align-items: center; }
    .guide-contents { border-top: 0; border-left: 1px solid #6c89a3; padding: 0 0 0 2.5rem; }
    .writing-group { grid-template-columns: minmax(0, .8fr) minmax(0, 1.7fr); gap: 5rem; }
  }
  @media (max-width: 639px) {
    .latest-writing { padding: 3.5rem 0; }
    .post-link { padding-inline: .5rem; }
    .writing-list li + li { margin-top: 1rem; }
  }
</style>
