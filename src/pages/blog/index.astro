---
import { getCollection } from 'astro:content';
import { writing } from '~/lib/writing';
import { writingTopics } from '~/lib/writing-topics';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import ArticleIllustration from '~/components/patterns/ArticleIllustration.astro';
import { hasIllustration } from '~/lib/article-illustrations';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || a.id.localeCompare(b.id),
);
const [lead, ...rest] = posts;
// Index sections follow each post's frontmatter `category`, so a post's label and its section always agree.
const topics = writingTopics;
const known = new Set(topics.map((topic) => topic.category));
// Posts with an unlisted category remain visible without requiring an index edit.
const groups = [
  ...topics.map((topic) => ({ ...topic, label: topic.category, posts: rest.filter((post) => post.data.category === topic.category) })),
  { id: 'more-writing', title: 'More', emphasis: 'writing', label: 'More writing', description: 'Notes on interfaces and the teams that build them.', posts: rest.filter((post) => !known.has(post.data.category)) },
].filter((group) => group.posts.length > 0);
// The series lineup: a compact index of the series, linking to their sections below.
const countNoun: Record<string, string> = { 'wild-interfaces': 'episodes', 'ui-court': 'cases', 'fictional-ux-engineers': 'profiles' };
const lineup = topics
  .map((topic) => ({ ...topic, posts: posts.filter((post) => post.data.category === topic.category) }))
  .filter((series) => series.posts.length > 0)
  .map((series) => ({ ...series, unit: countNoun[series.id] ?? 'articles' }));
---

<BaseLayout title="Writing about interfaces | Joshua Briley" description="Three comedy series about interface design. In UI Court, bad patterns stand trial. Wild Interfaces narrates common components like a nature documentary. In Fictional UX Engineers, famous characters join product teams. Each story covers a real interface lesson.">
  <section class="page-opener writing-opener">
    <Container width="wide">
      <h1 class="page-type hero-in hero-in-2">Writing about <em>interfaces</em></h1>
      <p class="page-lede hero-in hero-in-3">Three comedy series about interface design. In UI Court, bad patterns stand trial. Wild Interfaces narrates common components like a nature documentary. In Fictional UX Engineers, famous characters join product teams. Each story covers a real interface lesson.</p>
    </Container>
  </section>

  {lead && (
    <section class="latest-writing" aria-labelledby="latest-title">
      <Container width="wide">
        <div class="latest-layout" data-reveal>
          <div class="latest-copy">
            <p class="latest-context">Latest {writing[lead.id]?.format?.toLowerCase() ?? 'article'}</p>
            <h2 id="latest-title"><a href={`/blog/${lead.id}/`}>{lead.data.title}</a></h2>
            <p class="latest-description">{lead.data.description}</p>
            <a class="action-link action-link--inverse latest-action" href={`/blog/${lead.id}/`}>Read the article</a>
          </div>
          {hasIllustration(lead.id) && (
            <div class="latest-illustration"><ArticleIllustration post={lead.id} /></div>
          )}
        </div>
      </Container>
    </section>
  )}

  <nav class="editorial-section series-lineup" aria-labelledby="series-lineup-title">
    <Container width="wide">
      <h2 id="series-lineup-title" class="mono-label series-lineup-title">Series</h2>
      <ul role="list">
        {lineup.map((series) => (
          <li>
            <a href={`#${series.id}`}>
              <span class="series-name">{series.category}<span class="link-dot" aria-hidden="true"></span></span>
              <span class="series-description">{series.description}</span>
              <span class="series-count">{series.posts.length} {series.unit}</span>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </nav>

  {groups.map((group) => (
    <section id={group.id} class="editorial-section writing-section" aria-labelledby={`${group.id}-title`}>
      <Container width="wide">
        <div class="writing-group">
          <div class="writing-topic">
            <h2 id={`${group.id}-title`} class="section-type">{group.title} {group.emphasis}</h2>
            <p>{group.description}</p>
          </div>
          <ul class="writing-list" role="list" data-reveal-stagger>
            {group.posts.map((post) => (
              <li>
                <a class="post-link article-preview-link" href={`/blog/${post.id}/`} aria-labelledby={`title-${post.id}`} aria-describedby={`desc-${post.id}`}>
                  {hasIllustration(post.id) && <ArticleIllustration post={post.id} class="post-illustration" />}
                  <h3 id={`title-${post.id}`}>{post.data.title}</h3>
                  <p id={`desc-${post.id}`} class="post-description">{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </Container>
    </section>
  ))}
</BaseLayout>

<style>
  .writing-opener .page-type { max-width: 19ch; }
  /* The series lineup: a hairline index of the series, kept plain so it doesn't read as another set of post cards. */
  /* The first series section supplies the space below the lineup. */
  .series-lineup { padding-bottom: 0; }
  .series-lineup-title { margin-bottom: 1.25rem; }
  .series-lineup ul { display: grid; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .series-lineup li { border-bottom: 1px solid var(--line); }
  .series-lineup a { display: grid; gap: .5rem; align-content: start; height: 100%; padding: 1.5rem 0; }
  .series-name { font-size: 1.375rem; font-weight: 700; letter-spacing: -.02em; line-height: 1.2; color: var(--ink); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 5px; transition: color .2s, text-decoration-color .2s; }
  .series-description { max-width: 36ch; font-size: .9375rem; line-height: 1.55; color: var(--ink-muted); }
  .series-count { display: inline-flex; align-items: center; gap: .5rem; margin-top: .5rem; font-size: .8125rem; color: var(--ink-muted); }
  .series-lineup a:is(:hover, :focus-visible) .series-name { color: var(--accent); text-decoration-color: currentColor; }
  .series-lineup a:focus-visible { outline: 3px solid var(--accent); outline-offset: 6px; }
  @media (min-width: 768px) {
    .series-lineup ul { grid-template-columns: repeat(3, minmax(0, 1fr)); border-bottom: 1px solid var(--line); }
    .series-lineup li { border-bottom: 0; }
    .series-lineup li + li { border-left: 1px solid var(--line); }
    .series-lineup a { padding: 1.75rem 2rem 2rem; }
    .series-lineup li:first-child a { padding-left: 0; }
    .writing-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .series-name, .post-link h3 { transition: none; }
  }
  .latest-writing { background: var(--portfolio-blue); color: white; padding: 4.5rem 0; }
  .latest-layout { display: grid; gap: 3rem; }
  .latest-writing a:focus-visible { outline: 3px solid white; outline-offset: 5px; }
  .latest-context { color: #c6d8e8; font-size: .87rem; margin-bottom: 1.4rem; }
  .latest-copy h2 { max-width: 17ch; font-size: clamp(2.65rem, 5.3vw, 4.8rem); font-weight: 800; letter-spacing: -.055em; line-height: 1.03; }
  .latest-copy h2 a:hover, .latest-copy h2 a:focus-visible { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .latest-description { margin-top: 1.6rem; max-width: 49ch; font-size: 1.1rem; line-height: 1.65; color: #e0e8ef; }
  .latest-action { margin-top: 1.7rem; }
  .writing-group { display: grid; gap: 2.5rem; }
  .writing-topic { display: grid; gap: 1.25rem; }
  .writing-topic .section-type { font-size: clamp(2.6rem, 4.3vw, 4rem); }
  .writing-topic > p { max-width: 42ch; color: var(--ink-muted); font-size: 1rem; line-height: 1.65; }
  /* Each series is a grid of cards; the illustration does the selling, so cards carry only title and meta. */
  .writing-list { display: grid; gap: 4rem 3.5rem; margin: 0; padding: 0; list-style: none; }
  .post-link { display: grid; gap: .75rem; align-content: start; }
  .post-link :global(.post-illustration) { --mat: .75rem; min-width: 0; margin-bottom: .5rem; }
  .post-link h3 { font-size: 1.3rem; font-weight: 700; line-height: 1.25; letter-spacing: -.02em; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 5px; transition: color .2s, text-decoration-color .2s; }
  .post-description { max-width: 57ch; font-size: 1rem; line-height: 1.65; color: var(--ink-muted); }
  .post-link:is(:hover, :focus-visible) h3 { color: var(--accent); text-decoration-color: currentColor; }
  .post-link:focus-visible { outline: 3px solid var(--accent); outline-offset: 6px; }
  .latest-illustration { display: block; min-width: 0; }
  @media (min-width: 1024px) {
    .latest-layout { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 6rem; align-items: center; }
    .writing-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  /* Stacked layout: eyebrow, then the drawing, then the copy, like the post cards and other page teasers. */
  @media (max-width: 1023px) {
    .latest-layout { gap: 0; }
    .latest-copy { display: contents; }
    .latest-context { order: -2; }
    .latest-illustration { order: -1; margin-bottom: 2.5rem; }
    .latest-action { justify-self: start; }
  }
  @media (max-width: 639px) {
    .latest-writing { padding: 3.5rem 0; }
  }
</style>
