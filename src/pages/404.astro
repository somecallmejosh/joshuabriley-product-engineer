---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import ContrastGame from '~/components/islands/ContrastGame.astro';

const description =
  "The page you're looking for wandered off. Let's get you back on track.";

const detours = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Selected work' },
  { href: '/contact/', label: 'Contact' },
];
---

<BaseLayout title="Page not found | Joshua Briley" description={description} noindex>
  <Section tone="paper" padding="tight">
    <Container width="wide">
      <div class="notfound-layout">
        <div class="notfound-copy">
          <figure class="notfound-mark" aria-hidden="true">
            <svg viewBox="0 0 330 124" role="presentation">
              <text x="-3" y="114">404</text>
            </svg>
            <figcaption>This 404 fails contrast on purpose.</figcaption>
          </figure>

          <h1 class="hero-type notfound-title">This page took an <em>unplanned detour.</em></h1>

          <p class="hero-lede">
            Maybe it was renamed, maybe it's a typo, or maybe it drifted out of the system and nobody
            wrote it down. Either way, here are a few good places to land.
          </p>

          <ul class="notfound-links">
            {detours.map((d) => (
              <li>
                <a href={d.href} class="editorial-link">{d.label} <span aria-hidden="true" data-link-arrow="right">→</span></a>
              </li>
            ))}
          </ul>

          <p class="notfound-report">
            Broken link? <a href="/contact/" class="editorial-link">Let me know <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
          </p>
        </div>

        <ContrastGame />
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .notfound-layout {
    display: grid;
    gap: var(--space-block);
  }
  @media (min-width: 1024px) {
    .notfound-layout {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: center;
      gap: 5rem;
    }
  }

  /* The numeral is decoration in the hero's own face, drawn in a pale token. It
     really does fail contrast, and the caption owns up to it as a nod to the game. */
  .notfound-mark {
    max-width: 17rem;
    margin: 0 0 1.5rem;
  }
  .notfound-mark svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .notfound-mark text {
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-size: 150px;
    font-weight: 800;
    letter-spacing: -0.065em;
    fill: var(--line-strong);
  }
  .notfound-mark figcaption {
    margin-top: 0.6rem;
    font-size: 0.83rem;
    font-weight: 500;
    color: var(--ink-muted);
  }

  .notfound-title {
    max-width: 13ch;
    font-size: clamp(2.8rem, 2rem + 3.2vw, 4.9rem);
    line-height: 1.02;
  }

  .notfound-links {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }
  .notfound-links .editorial-link {
    font-size: 1.15rem;
  }

  .notfound-report {
    margin-top: 2.5rem;
    font-size: 0.93rem;
    color: var(--ink-muted);
  }
</style>
