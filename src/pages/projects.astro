---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import WorkList from '~/components/patterns/WorkList.astro';
const further = [
  { href: '/resume/', title: 'Enterprise systems experience', body: 'Shared UI for enterprise insurance platforms and consumer products.' },
  { href: '/personal-projects/', title: 'Personal projects', body: 'Experiments in design tokens, component systems, and learning by building.' },
  { href: '/blog/', title: 'Writing about the work', body: 'Component architecture, adoption, and the decisions that keep UI maintainable.' },
];
---
<BaseLayout title="Work | Joshua Briley" description="Explore Joshua Briley’s product design and engineering work: IVFCRYO, Logatot, VMSpark, and Rudiment UI, with contribution, decisions, and outcomes explained.">
  <section class="calm-open">
    <Container>
      <p class="calm-label hero-in hero-in-1">Selected work</p>
      <h1 class="calm-title hero-in hero-in-2">Projects I’ve designed and built.</h1>
      <p class="calm-lede hero-in hero-in-3">Explore the architecture, the interaction decisions, and the work I owned. Each project gives you a different part of the picture.</p>
    </Container>
  </section>
  <section class="index-work" aria-label="Project details">
    <Container width="wide"><WorkList /></Container>
  </section>
  <section class="home-screen home-close">
    <Container>
      <h2 class="home-statement home-statement--close">Still curious?</h2>
      <ul class="index-further">
        {further.map((item) => (
          <li><a href={item.href}><strong>{item.title} <span aria-hidden="true" data-link-arrow="up-right">↗</span></strong><span>{item.body}</span></a></li>
        ))}
      </ul>
    </Container>
  </section>
</BaseLayout>
