---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import WorkList from '~/components/patterns/WorkList.astro';
---
<BaseLayout title="Work | Joshua Briley" description="Explore Joshua Briley’s component architecture and product design work: Rudiment UI, IVFCRYO, and Logatot, with contribution, decisions, and outcomes explained.">
  <section class="page-opener">
    <Container width="wide">
      <p class="role-line hero-in hero-in-1">Selected work</p>
      <h1 class="page-type hero-in hero-in-2">From shared components<br />to shipped <em>products.</em></h1>
      <p class="page-lede hero-in hero-in-3">Explore the architecture, the interaction decisions, and the work I owned. Each project gives you a different part of the picture.</p>
      <nav class="evidence-nav" aria-label="Find relevant work">
        <a href="/personal-projects/rudiment-ui/">Component architecture <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
        <a href="/projects/ivfcryo/">Workflow design <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
        <a href="/projects/logatot/">Application behavior <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
      </nav>
    </Container>
  </section>
  <section class="editorial-section work-section" aria-label="Project details">
    <Container width="wide"><WorkList /></Container>
  </section>
  <section class="editorial-section">
    <Container width="wide">
      <div class="approach-layout">
        <h2 class="section-type">Still <em>curious?</em></h2>
        <div class="resource-list">
          <a href="/resume/"><span><strong>Enterprise systems experience</strong><span>Shared UI for enterprise insurance platforms and consumer products.</span></span><span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
          <a href="/personal-projects/"><span><strong>Personal projects</strong><span>Experiments in design tokens, component systems, and learning by building.</span></span><span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
          <a href="/blog/"><span><strong>Writing about the work</strong><span>Component architecture, adoption, and the decisions that keep UI maintainable.</span></span><span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
