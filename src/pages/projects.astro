---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';

const description =
  'Case studies by Joshua Briley: a shipping platform for frozen embryos and a voice-controlled app for home child care providers. Each one explains the design decisions behind the interface and the results after launch.';

// Each teaser reads the same way: what it is, what I owned, and the number the
// case study actually substantiates. Kinds name the product type, not the craft.
const projects = [
  {
    index: '01',
    href: '/projects/ivfcryo/',
    client: 'IVFCRYO',
    kind: 'Logistics platform',
    title: 'Coordinating five people before a shipment moves',
    summary:
      'IVFCRYO ships frozen embryos between clinics. I designed the app patients and staff use, and worked with engineers on the tracking system behind it.',
    note: '75% fewer support calls',
  },
  // {
  //   index: '02',
  //   href: '/projects/vmspark/',
  //   client: 'VMSpark',
  //   kind: 'Admin platform',
  //   title: 'Rebuilding an app without changing what it does',
  //   summary:
  //     "VMSpark's admin app hadn't kept up with the system it ran on. I audited the interface, chose a new direction, and rebuilt it in stages.",
  //   note: 'Zero pipeline regressions',
  // },
  {
    index: '03',
    href: '/projects/logatot/',
    client: 'Logatot',
    kind: 'Voice platform',
    title: 'Hands-free logging for home child care',
    summary:
      'Logatot lets home child care providers log naps, meals, and diaper changes by voice while they work, instead of catching up on paperwork at the end of the day.',
    note: '2+ hours less data entry per day',
  },

];

// Personal work — surfaced as its own band so it reads as a distinct body of
// work, not a footnote to the client case studies. Names and order mirror the
// index page.
const personalProjects = [
  {
    href: '/personal-projects/rudiment-ui/',
    name: 'Rudiment UI',
    line: 'An open-source React component library built on React Aria, with a three-tier token system and Storybook docs.',
  },
  {
    href: '/personal-projects/token-galaga/',
    name: 'Token Adventure',
    line: 'A browser game that teaches the W3C Design Tokens Format by having you write tokens that are checked against the spec.',
  },
];

---

<BaseLayout title="Projects | Joshua Briley" description={description}>
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <p class="hero-in hero-in-1 mono-label">Case studies</p>

      <div class="mt-10 max-w-4xl lg:mt-14">
        <Heading level={1} visual="display-xl" class="hero-in hero-in-2 max-w-[20ch] text-balance">
          Products where I owned the <em class="ink-wink font-normal italic">interface</em>.
        </Heading>
        <Text size="lg" tone="muted" class="hero-in hero-in-3 mt-7 max-w-2xl">
          Two products in production, a shipping platform for frozen embryos and a voice app for
          home child care providers. Each case study explains the design decisions, how they were
          built, and what changed after launch.
        </Text>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default">
    <Container width="wide">
      <ul
        class="grid grid-cols-1 gap-x-10 gap-y-0 md:grid-cols-2 md:gap-x-14"
        data-reveal-stagger
      >
        {projects.map((p, i) => (
          <li>
            <a
              href={p.href}
              class="group flex h-full flex-col pb-9 pt-6 transition-colors hover:bg-ink/[0.02]"
            >
              <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-ink-muted">{p.kind}</span>
              </span>

              <Heading level={2} visual="h2" class="mt-4 transition-colors group-hover:text-accent">
                {p.client}
              </Heading>

              <span class="mt-2.5 block max-w-xl font-display text-base font-medium leading-snug tracking-tight text-ink text-pretty">
                {p.title}
              </span>

              <Text tone="muted" size="sm" class="mt-3 max-w-2xl">{p.summary}</Text>

              <span class="mt-auto flex items-center gap-2 pt-6 font-mono text-[0.62rem] uppercase tracking-[0.1em] text-ink-muted">
                <span class="h-1 w-1 shrink-0 rounded-[1px] bg-accent" aria-hidden="true"></span>
                {p.note}
                <Icon
                  name="ph:arrow-right"
                  size={13}
                  class="shrink-0 transition-all duration-300 ease-out group-hover:translate-x-1 group-hover:text-accent"
                />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <Heading level={2} visual="display-md" class="max-w-[14ch]">
            Personal projects
          </Heading>
          <Text size="lg" tone="muted" class="mt-5 max-w-xl">
            Projects I build on my own time to try out ideas in design systems and design tokens.
          </Text>
        </div>
        <Button
          variant="ghost"
          href="/personal-projects/"
          iconRight="ph:arrow-right"
          class="shrink-0 self-start sm:self-auto"
        >View personal projects</Button>
      </div>

      <ul class="mt-10 grid grid-cols-1 border-t border-line md:grid-cols-2 md:gap-x-14 md:border-t-0" data-reveal-stagger>
        {personalProjects.map((p) => (
          <li class="border-b border-line md:border-t">
            <a href={p.href} class="group flex items-start justify-between gap-6 py-5">
              <span>
                <span class="block font-display text-lg font-medium tracking-tight text-ink transition-colors group-hover:text-accent">{p.name}</span>
                <span class="mt-1 block max-w-md text-sm text-ink-muted">{p.line}</span>
              </span>
              <Icon
                name="ph:arrow-right"
                size={16}
                class="mt-1.5 shrink-0 text-ink-faint transition-all duration-300 ease-out group-hover:translate-x-1 group-hover:text-accent"
              />
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </Section>
</BaseLayout>
