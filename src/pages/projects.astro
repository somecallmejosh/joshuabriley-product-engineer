---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import WorkList from '~/components/patterns/WorkList.astro';
---
<BaseLayout title="Case studies | Joshua Briley" description="Client case studies by Joshua Briley for VMSpark, IVFCRYO, and Logatot. Each one covers the problem, the design decisions, his role, and the outcome.">
  <section class="page-opener">
    <Container width="wide">
      <h1 class="page-type hero-in hero-in-2">Client <em>case studies</em></h1>
      <p class="page-lede hero-in hero-in-3">Each case study covers the problem, the decisions I made, the work I owned, and the outcome.</p>
      <nav class="evidence-nav" aria-label="Case study topics">
        <a href="/projects/vmspark/">Design system rollout<span class="link-dot" aria-hidden="true"></span></a>
        <a href="/projects/ivfcryo/">Workflow design<span class="link-dot" aria-hidden="true"></span></a>
        <a href="/projects/logatot/">Application behavior<span class="link-dot" aria-hidden="true"></span></a>
      </nav>
    </Container>
  </section>
  <section class="editorial-section work-section" aria-label="Project details">
    <Container width="wide"><WorkList /></Container>
  </section>
  <section class="editorial-section">
    <Container width="wide">
      <div class="approach-layout">
        <h2 class="section-type">Related pages</h2>
        <div class="resource-list">
          <a href="/resume/"><span><strong>Résumé<span class="link-dot" aria-hidden="true"></span></strong><span>Shared UI work for enterprise insurance platforms and consumer products.</span></span></a>
          <a href="/personal-projects/"><span><strong>Personal projects<span class="link-dot" aria-hidden="true"></span></strong><span>Apps and experiments I make outside client work.</span></span></a>
          <a href="/blog/"><span><strong>Blog<span class="link-dot" aria-hidden="true"></span></strong><span>Comic stories about interface design. Each one carries a UI lesson.</span></span></a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
