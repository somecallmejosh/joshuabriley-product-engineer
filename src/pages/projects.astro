---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import WorkList from '~/components/patterns/WorkList.astro';
---
<BaseLayout title="Case studies | Joshua Briley" description="Case studies by Joshua Briley: client work for VMSpark, IVFCRYO, and Logatot, and the Rudiment UI component library. Each one covers the problem, the design decisions, his role, and the outcome.">
  <section class="page-opener">
    <Container width="wide">
      <h1 class="page-type hero-in hero-in-2">Case studies</h1>
      <p class="page-lede hero-in hero-in-3">Each case study covers the problem, the decisions I made, the work I owned, and the outcome.</p>
      <nav class="evidence-nav" aria-label="Case study topics">
        <a href="/projects/vmspark/">Design system rollout</a>
        <a href="/projects/ivfcryo/">Workflow design</a>
        <a href="/projects/logatot/">Application behavior</a>
        <a href="/projects/rudiment-ui/">Component library</a>
      </nav>
    </Container>
  </section>
  <section class="editorial-section work-section" aria-label="Project details">
    <Container width="wide"><WorkList /></Container>
  </section>
  <section class="editorial-section">
    <Container width="wide">
      <div class="approach-layout">
        <h2 class="section-type">More of my work</h2>
        <div class="resource-list">
          <a href="/resume/"><span><strong>Résumé</strong><span>Shared UI work for enterprise insurance platforms and consumer products.</span></span></a>
          <a href="/blog/"><span><strong>Blog</strong><span>Comic stories about interface design. Each one carries a UI lesson.</span></span></a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
