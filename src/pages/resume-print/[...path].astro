---
/**
 * Internal print document for public/resume.pdf. Not the /resume/ page: that
 * one is a web page with a hero, CTAs, and site chrome. This is a letter-format
 * resume laid out for paper and for the six seconds a recruiter gives it.
 *
 * noindex + bare + excluded from the sitemap and robots.txt; not linked
 * anywhere. `npm run resume:pdf` prints it to public/resume.pdf against a
 * running `astro dev`.
 *
 * Content comes from src/lib/resume-data.mjs, shared with /resume/, so the page
 * and the PDF cannot drift apart.
 *
 * A rest param (resolving to the bare /resume-print/ route) purely so
 * getStaticPaths can return nothing for production builds, same guard as
 * og-render: the internal renderer should never ship. The artifact it exists to
 * produce is public/resume.pdf, which does.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import {
  CONTACT,
  SUMMARY,
  STRENGTHS,
  EXPERIENCE,
  SKILLS,
  EDUCATION,
  CONTINUING_ED,
  CERT_FOCUS,
} from '~/lib/resume-data.mjs';

export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return [{ params: { path: undefined } }];
}

const contactLines = [
  CONTACT.location,
  CONTACT.phone,
  CONTACT.email,
  CONTACT.site,
  CONTACT.linkedin,
  CONTACT.github,
];
---

<BaseLayout title="Joshua K. Briley — Resume" bare noindex>
  <article class="doc">

    <header class="masthead">
      <div class="masthead__id">
        <h1>{CONTACT.name}<span class="dot">.</span></h1>
        <p class="masthead__title">{CONTACT.title}</p>
      </div>
      <ul class="masthead__contact">
        {contactLines.map((line) => <li>{line}</li>)}
      </ul>
    </header>

    <p class="summary">{SUMMARY}</p>

    <h2 class="section-label">Core strengths</h2>
    <div class="strengths">
      {STRENGTHS.map((s) => (
        <div class="strength">
          <p class="strength__title">{s.title}</p>
          <p class="strength__body">{s.body}</p>
        </div>
      ))}
    </div>

    <h2 class="section-label">Experience</h2>
    {EXPERIENCE.map((job) => (
      <section class="job">
        <div class="job__head">
          <h3 class="job__role">
            {job.role}<span class="sep"> · </span><span class="job__co">{job.company}</span>
          </h3>
          <p class="job__period">{job.period}</p>
        </div>
        <p class="job__stack">{job.stack}</p>
        <ul class="job__bullets">
          {job.bullets.map((b) => <li>{b}</li>)}
        </ul>
      </section>
    ))}

    <h2 class="section-label">Selected toolkit</h2>
    <dl class="toolkit">
      {SKILLS.map((s) => (
        <div class="toolkit__row">
          <dt>{s.group}</dt>
          <dd>{s.items.join(', ')}.</dd>
        </div>
      ))}
    </dl>

    <h2 class="section-label">Education</h2>
    <ul class="education">
      {EDUCATION.map((e) => (
        <li><span class="ed__title">{e.title}</span><span class="sep"> · </span>{e.org}</li>
      ))}
      <li>
        <span class="ed__title">Continuing education</span><span class="sep"> · </span>
        {CONTINUING_ED.map((c) => `${c.title} (${c.org})`).join(', ')}
      </li>
      <li><span class="ed__title">Certifications in progress</span><span class="sep"> · </span>{CERT_FOCUS}</li>
    </ul>

  </article>
</BaseLayout>

<style>
  /* Letter-format print document. No rules, no fills, no boxes: hierarchy comes
     from the type system alone. Physical units throughout, because this is
     measured in inches on paper rather than rems on a screen. Chromium's
     page.pdf() supplies the sheet; @page owns the margin. */
  @page {
    size: letter;
    margin: 0.62in 0.68in;
  }

  /* This route is a document, not a page. The layout still emits its screen
     affordances (skip link, inspector toast, view-source chip, lightbox
     scaffold) as siblings of <main>, and they print as a stray filled block at
     the end of the last sheet. Nothing outside the article belongs on paper. */
  :global(body > *:not(main)) { display: none !important; }

  /* The only "background" left, and it is paper, not decoration. It has to be
     stated: the site's surface tokens invert under prefers-color-scheme: dark,
     and a resume that prints white-on-black is a lost application. */
  :global(html),
  :global(body) { background: #fff; }

  .doc {
    /* The site's three faces, same roles they play everywhere else:
       Hanken Grotesk for body, Newsreader (--font-fraunces) for display,
       Geist Mono for the small uppercase labels. */
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-size: 9.2pt;
    line-height: 1.45;
    color: #33302b;
    max-width: 7.14in;
    margin: 0 auto;
  }

  .doc :is(h1, h2, h3, p, ul, dl, dd) { margin: 0; }
  .doc :is(.masthead__contact, .education) { list-style: none; padding: 0; }

  /* ── Masthead ─────────────────────────────────────────────────────────── */
  .masthead {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.4in;
  }

  .masthead__id h1 {
    font-family: var(--font-fraunces), Georgia, serif;
    font-size: 21pt;
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.05;
    color: #1b1a17;
  }
  /* The trailing period is the site's wordmark, carried onto paper. */
  .masthead__id h1 .dot { color: #a8412a; }

  .masthead__title {
    margin-top: 0.05in !important;
    max-width: 4.75in;
    font-size: 8.6pt;
    color: #5b574f;
  }

  .masthead__contact {
    text-align: right;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 7pt;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    color: #5b574f;
    line-height: 1.65;
  }

  /* ── Summary ──────────────────────────────────────────────────────────── */
  /* Set a step larger than the body and in full ink. With no rule above it,
     size and color are what separate it from the masthead. */
  .summary {
    margin-top: 0.2in !important;
    font-size: 9.8pt;
    line-height: 1.52;
    color: #1b1a17;
    max-width: 6.4in;
  }

  /* ── Section headings ─────────────────────────────────────────────────── */
  /* The site's .mono-label, in accent. These were hairline-ruled; with the rule
     gone, the label carries the break on its own, so it gets wider tracking and
     a lot more air above than below. That asymmetry is what groups it with the
     content beneath instead of floating between two blocks.
     NOT named .rule: site.css already owns that class as a 1px hairline with a
     `background: var(--line)`, which the scoped styles here do not override and
     which printed as a stray grey line above every section. */
  .section-label {
    margin-top: 0.34in !important;
    margin-bottom: 0.15in !important;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 7.2pt;
    font-weight: 500;
    letter-spacing: 0.185em;
    text-transform: uppercase;
    color: #a8412a;
    /* A heading stranded at the foot of a sheet is the classic print bug. */
    break-after: avoid;
    page-break-after: avoid;
  }

  /* ── Core strengths ───────────────────────────────────────────────────── */
  .strengths {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.1in 0.36in;
  }
  .strength { break-inside: avoid; page-break-inside: avoid; }
  .strength__title {
    font-size: 8.7pt;
    font-weight: 600;
    color: #1b1a17;
  }
  .strength__body {
    margin-top: 0.015in !important;
    font-size: 8.3pt;
    line-height: 1.4;
    color: #5b574f;
  }

  /* ── Experience ───────────────────────────────────────────────────────── */
  .job {
    /* Never split a role across sheets: the bullets are the argument and they
       have to sit under the job that earned them. */
    break-inside: avoid;
    page-break-inside: avoid;
  }
  .job + .job { margin-top: 0.17in; }

  .job__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25in;
  }
  .job__role {
    font-size: 10.1pt;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #1b1a17;
  }
  .job__co { font-weight: 400; color: #5b574f; }
  .sep { color: #a09a90; }

  .job__period,
  .job__stack {
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .job__period {
    flex-shrink: 0;
    font-size: 7pt;
    color: #5b574f;
    white-space: nowrap;
  }
  .job__stack {
    margin-top: 0.022in !important;
    font-size: 6.9pt;
    color: #8a847a;
  }

  /* Real list markers rather than the colored squares that were here before:
     a disc is drawn by the font, which is the whole point of this pass. */
  .job__bullets {
    margin-top: 0.07in !important;
    padding-left: 0.155in;
    list-style: disc;
    display: grid;
    gap: 0.045in;
  }
  .job__bullets li {
    font-size: 8.8pt;
    line-height: 1.46;
    color: #33302b;
    padding-left: 0.015in;
  }
  .job__bullets li::marker { color: #b3ada2; font-size: 0.8em; }

  /* ── Toolkit ──────────────────────────────────────────────────────────── */
  .toolkit { display: grid; gap: 0.07in; }
  .toolkit__row {
    display: grid;
    grid-template-columns: 1.28in 1fr;
    gap: 0.18in;
    break-inside: avoid;
    page-break-inside: avoid;
  }
  .toolkit dt {
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 7pt;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #5b574f;
    padding-top: 0.015in;
  }
  .toolkit dd {
    font-size: 8.6pt;
    line-height: 1.44;
    color: #33302b;
  }

  /* ── Education ────────────────────────────────────────────────────────── */
  .education {
    display: grid;
    gap: 0.04in;
    font-size: 8.7pt;
    color: #33302b;
  }
  .ed__title { font-weight: 600; color: #1b1a17; }
</style>
