---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';
import PrincipleGlyph from '~/components/patterns/PrincipleGlyph.astro';

const description =
  'Product design engineer working at the intersection of front-end engineering and UX. 20 years in production UI, most recently building accessible component libraries in Vue, React, and Web Components.';

// Same four chips as the home page, worded identically. Two pages rendering the
// same strip with different items read as two different claims.
const capabilities = [
  'Design-grade front-end',
  'React · TypeScript',
  'Accessibility built in',
  'Design systems',
];

// Each principle carries its own drawing instead of an index number. The glyph
// does the work the `01 / 02 / 03` was doing (marking where a cell starts) and
// says something besides "this is the first one".
const principles = [
  {
    glyph: 'system' as const,
    title: 'A design system is a product, and its users write code',
    body:
      "If the API fights the team consuming it, they will copy the markup, tweak it, and move on, and the system quietly stops being one. So the props, the defaults, and the docs get the same care as the type and the spacing.",
  },
  {
    glyph: 'accessibility' as const,
    title: 'Accessibility belongs inside the component',
    body:
      "When the keyboard paths, focus states, and semantics ship inside the component itself, instead of getting bolted on later through an audit or a ticket, every team that adopts it inherits them, and nobody has to be an expert to get it right.",
  },
  {
    glyph: 'directness' as const,
    title: 'Directness over diplomacy',
    body:
      "If a product is in trouble, I'll tell you exactly where and why. Kindly, but without hedging. Then we'll map the shortest honest path forward. You're hiring me for the truth, not the comfort.",
  },
];

const learning = [
  { title: 'WAI-ARIA & APG', note: 'Authoring practices for patterns that truly work for assistive tech.' },
  { title: 'Design Tokens CG', note: 'The emerging standard for portable, multi-platform design decisions.' },
  { title: 'CSS Working Group', note: 'Container queries, anchor positioning, cascade layers (the good stuff).' },
  { title: 'Rudiment UI', note: 'My open-source React component library, built with the reasoning left in.' },
];

// Real facts, not a bio-page mood board. Ordered as a rough life arc: where I'm
// from, what the Army had us do with that, what I still do with a bass or a
// drum kit, and what our family spends its time and money on now.
const personal = [
  {
    icon: 'ph:cooking-pot',
    title: 'Louisiana runs deep',
    body: "I grew up in Louisiana on Cajun food and Cajun music. Nothing beats my grandmother's chicken and sausage gumbo, her crawfish étouffée, or my step dad's boiled crawfish. Nothing!",
  },
  {
    icon: 'ph:shield-star',
    title: 'My wife and I both served',
    body: "We're Army veterans who met at our first duty station, overseas. We were stationed in Hohenfels, Germany, lived in the nearby village of Seubersdorf, and had our first child there. Ein bier, bitte!",
  },
  {
    icon: 'ph:music-notes-simple',
    title: 'Bass, drums, thirty-plus years',
    body: 'In my younger days I toured the southeast college circuit, playing in fraternity houses and college clubs. I also spent a lot of time playing gigs on Bourbon Street and Frenchman Street in New Orleans. These days I keep it local.',
  },
  {
    icon: 'ph:map-trifold',
    title: 'We travel as a family, a lot',
    body: 'Every chance we get, with our kids: Canada, the Bahamas, Italy, Iceland, Ireland, France, Austria, and Germany so far. Iceland is still our favorite. We also enjoy stateside travel and like staying off the beaten path.',
  },
];
---

<BaseLayout title="About | Joshua Briley | Product Design Engineer" description={description}>

  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="hero-in hero-in-1 flex items-center justify-between gap-4 mono-label">
        <span>About · Product Design Engineer</span>
      </div>

      <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-16 lg:items-center">
        <div class="lg:col-span-7">
          <Heading level={1} visual="display-xl" class="hero-in hero-in-2 max-w-[18ch]">
            <em class="ink-wink font-normal italic">Twenty years</em> between front end engineering & UX.
          </Heading>
          <Text size="lg" tone="muted" class="hero-in hero-in-3 mt-7 max-w-xl">
            I've spent most of my career at the intersection of front-end engineering and UX, with
            design systems becoming an increasingly large part of that work. I've built and
            supported component libraries in Vue, React, and Web Components, for teams that had to
            ship on all three.
          </Text>
          <Text tone="muted" class="hero-in hero-in-3 mt-5 max-w-xl">
            The constant across all of them is accessibility, and <em class="text-ink not-italic font-medium">component
            APIs that work as well for the engineers consuming the system as they do for the people
            using the product</em>. Right now that means Stencil-based Web Components, Storybook,
            automated testing, and Figma integration.
          </Text>

          <div class="hero-in hero-in-4 mt-9 flex flex-wrap items-center gap-3">
            <Button variant="primary" size="lg" href="/contact/" iconRight="ph:arrow-right" class="js-magnetic">
              Get in touch
            </Button>
            <Button variant="ghost" size="lg" href="/projects/">
              See the work
            </Button>
          </div>

          <ul class="hero-in hero-in-4 mt-10 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-muted">
            {capabilities.map((p) => (
              <li class="flex items-center gap-2">
                <span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>{p}
              </li>
            ))}
          </ul>
        </div>

        <div class="hero-in hero-in-5 lg:col-span-5">
          <figure class="overflow-hidden rounded-lg border border-line">
            <picture>
              <source
                type="image/avif"
                sizes="(min-width: 1280px) 476px, (min-width: 1024px) 40vw, 100vw"
                srcset="/images/about/josh-suit-portrait-400.avif 400w, /images/about/josh-suit-portrait-640.avif 640w, /images/about/josh-suit-portrait-1000.avif 1000w"
              />
              <source
                type="image/webp"
                sizes="(min-width: 1280px) 476px, (min-width: 1024px) 40vw, 100vw"
                srcset="/images/about/josh-suit-portrait-400.webp 400w, /images/about/josh-suit-portrait-640.webp 640w, /images/about/josh-suit-portrait-1000.webp 1000w"
              />
              <img
                src="/images/about/josh-suit-portrait-640.jpg"
                sizes="(min-width: 1280px) 476px, (min-width: 1024px) 40vw, 100vw"
                srcset="/images/about/josh-suit-portrait-400.jpg 400w, /images/about/josh-suit-portrait-640.jpg 640w, /images/about/josh-suit-portrait-1000.jpg 1000w"
                alt="Joshua Briley, product design engineer"
                class="aspect-[4/5] w-full object-cover"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="1000"
                height="1250"
              />
            </picture>
          </figure>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label">How I work</p>
        <Heading level={2} visual="display-md" class="mt-4">
          Three things I hold on to.
        </Heading>
      </div>

      <div
        class="mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-line bg-line lg:grid-cols-3"
        data-reveal-stagger
      >
        {principles.map((p, i) => (
          <div class={`bg-paper p-7 md:p-9 ${i === 0 ? 'lg:col-span-2 lg:row-span-2 lg:flex lg:flex-col lg:justify-center md:p-10' : ''}`}>
            <PrincipleGlyph name={p.glyph} size={i === 0 ? 'lg' : 'md'} class="text-ink" />
            <Heading level={3} visual={i === 0 ? 'h2' : 'h3'} class={i === 0 ? 'mt-7 max-w-[22ch]' : 'mt-6'}>{p.title}</Heading>
            <Text tone="muted" class={i === 0 ? 'mt-4 max-w-lg' : 'mt-3'} size={i === 0 ? undefined : 'sm'}>{p.body}</Text>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="mono-label">Always learning</p>
          <Heading level={2} visual="display-md" class="mt-4 max-w-[16ch]">
            Still reading the spec drafts.
          </Heading>
          <div class="mt-7 space-y-4 text-ink-muted leading-relaxed max-w-md">
            <p>
              I stay close to the sources: WAI-ARIA working drafts, the Design Tokens Community
              Group, CSS Working Group proposals. The platform moves. The best systems move
              with it.
            </p>
            <p>
              I also maintain <span class="text-ink font-medium">Rudiment UI</span>, an
              open-source React component library where I sharpen ideas in public before they land
              in production systems.
            </p>
          </div>
        </div>

        <div class="lg:col-span-7">
          <p class="mono-label">What I follow</p>
          <ul class="mt-5 divide-y divide-line border-y border-line" data-reveal-stagger>
            {learning.map((item, i) => (
              <li class="flex items-baseline gap-4 py-4">
                <span class="font-mono text-[0.75rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <p class="font-display text-base font-medium tracking-tight text-ink">{item.title}</p>
                  <p class="mt-0.5 text-sm text-ink-muted">{item.note}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <div class="max-w-3xl">
        <Heading level={2} visual="display-md">
          A few things that aren't on the résumé.
        </Heading>
        <Text tone="muted" class="mt-4 max-w-xl">
          The professional stuff is the rest of this page. Here's the short version of
          everything else.
        </Text>
      </div>

      <div
        class="mt-14 grid grid-cols-1 gap-x-10 gap-y-10 sm:grid-cols-2 md:gap-y-12"
        data-reveal-stagger
      >
        {personal.map((p) => (
          <div>
            <Icon name={p.icon} size={28} class="text-accent" />
            <Heading level={3} visual="h3" class="mt-5">{p.title}</Heading>
            <Text tone="muted" size="sm" class="mt-3 max-w-sm">{p.body}</Text>
          </div>
        ))}
      </div>
    </Container>
  </Section>
</BaseLayout>
