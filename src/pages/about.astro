---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';
import PrincipleGlyph from '~/components/patterns/PrincipleGlyph.astro';

const description =
  'Design systems and UI platform engineer working where front-end engineering and UX meet. 20 years in production UI, most recently building accessible component libraries in Vue, React, and Web Components.';

// Same chips as the home page, worded identically. Two pages rendering the
// same strip with different items read as two different claims.
const capabilities = [
  'Interface design',
  'Front-end development',
  'Accessibility',
  'Design systems',
];

// Each principle carries its own drawing instead of an index number. The glyph
// does the work the `01 / 02 / 03` was doing (marking where a cell starts) and
// says something besides "this is the first one".
const principles = [
  {
    glyph: 'system' as const,
    title: 'Design systems are products for engineers',
    body:
      "If a component's API is hard to use, teams copy the markup, change it, and move on, and the system stops being shared. I give props, defaults, and documentation the same care as type and spacing.",
  },
  {
    glyph: 'accessibility' as const,
    title: 'Accessibility built into components',
    body:
      "Keyboard support, focus states, and semantic markup ship inside each component instead of being added after an audit or a ticket. Every team that adopts the component gets them without needing to be accessibility experts.",
  },
  {
    glyph: 'directness' as const,
    title: 'Clear, honest feedback',
    body:
      "If a product has problems, I'll tell you where they are and why, kindly and without hedging. Then we'll work out the most direct way to fix them.",
  },
];

const learning = [
  { title: 'WAI-ARIA Authoring Practices', note: 'Patterns for building menus, tabs, dialogs, and other widgets that work with assistive technology.' },
  { title: 'Design Tokens Community Group', note: 'A shared format for design tokens, so colors, spacing, and type can move between tools and platforms.' },
  { title: 'CSS Working Group', note: 'Proposals for new CSS features, such as container queries, anchor positioning, and cascade layers.' },
  { title: 'Rudiment UI', note: 'My open-source React component library, where I test ideas in public before using them in production.' },
];

// Real facts, not a bio-page mood board. Ordered as a rough life arc: where I'm
// from, what the Army had us do with that, what I still do with a bass or a
// drum kit, and what our family spends its time and money on now.
const personal = [
  {
    icon: 'ph:cooking-pot',
    title: 'Louisiana roots',
    body: "I grew up in Louisiana on Cajun food and Cajun music. My favorites are still my grandmother's chicken and sausage gumbo and crawfish étouffée, and my stepdad's boiled crawfish.",
  },
  {
    icon: 'ph:shield-star',
    title: 'Army veterans',
    body: "My wife and I met at our first duty station in Hohenfels, Germany. We lived in the nearby village of Seubersdorf and had our first child there.",
  },
  {
    icon: 'ph:music-notes-simple',
    title: 'Bass and drums',
    body: "I've played for more than thirty years. When I was younger, I toured college clubs and fraternity houses across the Southeast and played gigs on Bourbon Street and Frenchmen Street in New Orleans. These days I play locally.",
  },
  {
    icon: 'ph:map-trifold',
    title: 'Family travel',
    body: "We travel with our kids whenever we can. So far we've visited Canada, the Bahamas, Italy, Iceland, Ireland, France, Austria, and Germany, and Iceland is still our favorite. In the U.S., we look for places off the beaten path.",
  },
];
---

<BaseLayout title="About | Joshua Briley | Design Systems & UI Platform Engineer" description={description}>

  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="hero-in hero-in-1 flex items-center justify-between gap-4 mono-label">
        <span>About · Design systems &amp; UI platform engineer</span>
      </div>

      <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-16 lg:items-center">
        <div class="lg:col-span-7">
          <Heading level={1} visual="display-xl" class="hero-in hero-in-2 max-w-[18ch]">
            I've worked in front-end engineering and UX for <em class="ink-wink font-normal italic">twenty years.</em>
          </Heading>
          <Text size="lg" tone="muted" class="hero-in hero-in-3 mt-7 max-w-xl">
            Design systems have become a larger part of that work over time. I've built and
            supported component libraries in Vue, React, and Web Components for teams that needed
            to ship on all three.
          </Text>
          <Text tone="muted" class="hero-in hero-in-3 mt-5 max-w-xl">
            In every library, I focus on accessibility and on <em class="text-ink not-italic font-medium">component
            APIs that work as well for the engineers using the system as they do for the people
            using the product</em>. My current work uses Stencil-based Web Components, Storybook,
            automated testing, and Figma integration.
          </Text>

          <div class="hero-in hero-in-4 mt-9 flex flex-wrap items-center gap-3">
            <Button variant="primary" size="lg" href="/contact/" iconRight="ph:arrow-right" class="js-magnetic">
              Contact me
            </Button>
            <Button variant="ghost" size="lg" href="/projects/">
              View projects
            </Button>
          </div>

          <ul class="hero-in hero-in-4 mt-10 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-muted">
            {capabilities.map((p) => (
              <li class="flex items-center gap-2">
                <span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>{p}
              </li>
            ))}
          </ul>
        </div>

        <div class="hero-in hero-in-5 lg:col-span-5">
          <figure class="overflow-hidden rounded-lg border border-line">
            <picture>
              <source
                type="image/avif"
                sizes="(min-width: 1280px) 476px, (min-width: 1024px) 40vw, 100vw"
                srcset="/images/about/josh-suit-portrait-400.avif 400w, /images/about/josh-suit-portrait-640.avif 640w, /images/about/josh-suit-portrait-1000.avif 1000w"
              />
              <source
                type="image/webp"
                sizes="(min-width: 1280px) 476px, (min-width: 1024px) 40vw, 100vw"
                srcset="/images/about/josh-suit-portrait-400.webp 400w, /images/about/josh-suit-portrait-640.webp 640w, /images/about/josh-suit-portrait-1000.webp 1000w"
              />
              <img
                src="/images/about/josh-suit-portrait-640.jpg"
                sizes="(min-width: 1280px) 476px, (min-width: 1024px) 40vw, 100vw"
                srcset="/images/about/josh-suit-portrait-400.jpg 400w, /images/about/josh-suit-portrait-640.jpg 640w, /images/about/josh-suit-portrait-1000.jpg 1000w"
                alt="Joshua Briley, design systems and UI platform engineer"
                class="aspect-[4/5] w-full object-cover"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="1000"
                height="1250"
              />
            </picture>
          </figure>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <Heading level={2} visual="display-md">
          How I work
        </Heading>
      </div>

      <div
        class="mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-line bg-line lg:grid-cols-3"
        data-reveal-stagger
      >
        {principles.map((p, i) => (
          <div class={`bg-paper p-7 md:p-9 ${i === 0 ? 'lg:col-span-2 lg:row-span-2 lg:flex lg:flex-col lg:justify-center md:p-10' : ''}`}>
            <PrincipleGlyph name={p.glyph} size={i === 0 ? 'lg' : 'md'} class="text-ink" />
            <Heading level={3} visual={i === 0 ? 'h2' : 'h3'} class={i === 0 ? 'mt-7' : 'mt-6'}>{p.title}</Heading>
            <Text tone="muted" class={i === 0 ? 'mt-4 max-w-lg' : 'mt-3'} size={i === 0 ? undefined : 'sm'}>{p.body}</Text>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <Heading level={2} visual="display-md">
            Standards and open source
          </Heading>
          <Text tone="muted" class="mt-6 max-w-md">
            I follow the groups that set accessibility, design token, and CSS standards, so the
            systems I build keep up with what browsers support. I also maintain an open-source
            component library.
          </Text>
        </div>

        <div class="lg:col-span-7">
          <ul class="divide-y divide-line border-y border-line" data-reveal-stagger>
            {learning.map((item) => (
              <li class="flex items-baseline gap-4 py-4">
                <div>
                  <p class="font-display text-base font-medium tracking-tight text-ink">{item.title}</p>
                  <p class="mt-0.5 text-sm text-ink-muted">{item.note}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <div class="max-w-3xl">
        <Heading level={2} visual="display-md">
          Outside of work
        </Heading>
      </div>

      <div
        class="mt-14 grid grid-cols-1 gap-x-10 gap-y-10 sm:grid-cols-2 md:gap-y-12"
        data-reveal-stagger
      >
        {personal.map((p) => (
          <div>
            <Icon name={p.icon} size={28} class="text-accent" />
            <Heading level={3} visual="h3" class="mt-5">{p.title}</Heading>
            <Text tone="muted" size="sm" class="mt-3 max-w-sm">{p.body}</Text>
          </div>
        ))}
      </div>
    </Container>
  </Section>
</BaseLayout>
