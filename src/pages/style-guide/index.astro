---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import Specimen from '~/components/style-guide/Specimen.astro';
import Logo from '~/components/primitives/Logo.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import Link from '~/components/primitives/Link.astro';
import Portrait from '~/components/patterns/Portrait.astro';
import Recommendation from '~/components/patterns/Recommendation.astro';
import Metric from '~/components/patterns/Metric.astro';
import Tldr from '~/components/patterns/Tldr.astro';
import { ivfcryoSummary } from '~/lib/project-summaries';
import Plate from '~/components/patterns/Plate.astro';
import ToolIllustration from '~/components/patterns/ToolIllustration.astro';
import Field from '~/components/form/Field.astro';
import Input from '~/components/form/Input.astro';
import Textarea from '~/components/form/Textarea.astro';
import FormAlert from '~/components/form/FormAlert.astro';
import SubmitButton from '~/components/form/SubmitButton.astro';
import ArticleTable from '~/components/writing/ArticleTable.astro';
import ResourceList from '~/components/writing/ResourceList.astro';
import { componentCatalogue } from '~/lib/component-catalogue';
import { projectPages } from '~/lib/project-pages';
import baseStyles from '~/styles/site.css?raw';
import portfolioStyles from '~/styles/redesign.css?raw';
import shipmentSheet from '~/assets/projects/ivfcryo/wires-and-flows/05-shipment-detail.png';
import '~/styles/articles.css';
import '~/styles/projects.css';
import '~/styles/style-guide.css';

const sections = [
  ['foundations', 'Colors & surfaces'], ['typography', 'Typography'], ['actions', 'Actions'], ['forms', 'Forms'],
  ['patterns', 'Content & media'], ['tools', 'Tools'], ['interaction', 'Layout & interaction'], ['components', 'Component index'],
];
const colors = [
  { name: 'Paper', token: '--paper', note: 'Default page surface.' },
  { name: 'Raised', token: '--raised', note: 'Inputs and selected content panels.' },
  { name: 'Ink', token: '--ink', note: 'Primary text, the footer, and dark feature surfaces.' },
  { name: 'Muted ink', token: '--ink-muted', note: 'Descriptions, captions, and supporting text.' },
  { name: 'Denim', token: '--portfolio-blue', note: 'Primary actions, editorial italics, and feature bands.' },
  { name: 'Denim tint', token: '--portfolio-tint', note: 'Tool workspaces, related content, and quiet emphasis.' },
  { name: 'Accent', token: '--accent', note: 'Surface-aware icons, links, and focus indicators.' },
  { name: 'Line', token: '--line', note: 'Quiet dividers; not a sufficient input boundary on its own.' },
  { name: 'Strong line', token: '--line-strong', note: 'Stronger rules and panel outlines.' },
  { name: 'Faint ink', token: '--ink-faint', note: 'Decoration only. Use muted ink for readable text.' },
];
const css = baseStyles + '\n' + portfolioStyles;
const tokenValue = (token: string) => {
  const raw = css.match(new RegExp(`${token}:\\s*([^;]+);`))?.[1]?.trim() ?? '';
  if (token === '--accent') {
    const channels = css.match(/--accent-rgb:\s*([\d\s]+);/)?.[1].trim().split(/\s+/).map(Number);
    return channels ? '#' + channels.map((channel) => channel.toString(16).padStart(2, '0')).join('').toUpperCase() : raw;
  }
  return raw.toUpperCase();
};
const [recommendation] = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
const tools = (await getCollection('tools', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { id: 'chrome', label: 'Site navigation' }, { id: 'layout', label: 'Layout' }, { id: 'primitives', label: 'Type, links & icons' },
  { id: 'form', label: 'Form controls' }, { id: 'patterns', label: 'Content & media patterns' },
  { id: 'islands', label: 'Interactive features' }, { id: 'writing', label: 'Article components' },
];
const primaryMarkup = `<a class="action-link" href="/projects/">\n  Explore my work <span aria-hidden="true" data-link-arrow="down-right">↘</span>\n</a>\n<a class="editorial-link" href="/resume/">\n  View résumé <span aria-hidden="true" data-link-arrow="up-right">↗</span>\n</a>`;
const typeMarkup = `<h1 class="page-type">The site,<br /><em>documented.</em></h1>\n<p class="page-lede">A short introduction with a clear purpose.</p>\n<h2 class="section-type">Shared <em>practice.</em></h2>`;
const formMarkup = `<Field label="Email" name="email" required hint="Only used to reply.">\n  <Input name="email" type="email" required\n    describedBy="field-email-hint" />\n</Field>\n<SubmitButton label="Send message" loadingLabel="Sending…" />`;
const widths = [
  ['narrow', '48rem', 'Supporting copy and narrow page content'], ['content', '64rem', 'Case-study reading layouts'],
  ['default', '72rem', 'General page content'], ['wide', '80rem', 'Main page grids and full design sheets'],
];
---

<BaseLayout title="Style guide | Joshua Briley" description="The typography, colors, components, and interactions currently used across this portfolio, with live examples and usage notes." mainClass="style-guide">
  <header class="page-opener">
    <Container width="wide">
      <p class="role-line hero-in hero-in-1">Style guide <span aria-hidden="true">/</span> The portfolio’s working design system</p>
      <h1 class="page-type hero-in hero-in-2">The site,<br /><em>documented.</em></h1>
      <p class="page-lede hero-in hero-in-3">The colors, type, components, and interactions used across this portfolio. Live examples, usage notes, and links to the pages where they do the work.</p>
      <nav class="evidence-nav hero-in hero-in-4" aria-label="Style guide sections">{sections.map(([id, label]) => <a href={`#${id}`}>{label} <span aria-hidden="true" data-link-arrow="down">↓</span></a>)}</nav>
    </Container>
  </header>

  <section id="foundations" class="editorial-section" aria-labelledby="foundations-title">
    <Container width="wide">
      <div class="section-heading"><h2 id="foundations-title" class="section-type">Colors &<br /><em>surfaces.</em></h2><p>Cool paper, charcoal, and denim. The palette stays in tune with the photograph on the home and about pages.</p></div>
      <div class="sg-palette-intro" data-reveal><div class="sg-portrait"><Portrait /></div><div><h3>A photograph sets the tone.</h3><p>The navy suit and throw, dark shelves, and daylight give the site its color direction. Strong typography provides the emphasis; blue connects the actions, feature sections, and editorial details.</p><p>Use paper for reading, denim tint to group related content, and ink or denim for a deliberate change of pace.</p><a class="editorial-link" href="/about/">See the portrait in context <span aria-hidden="true" data-link-arrow="up-right">↗</span></a></div></div>
      <ul class="sg-swatches">{colors.map((color) => <li><div class="sg-swatch" style={`background: var(${color.token})`} aria-hidden="true"></div><h3>{color.name}</h3><p class="sg-color-value">{tokenValue(color.token)}</p><code>{color.token}</code><p>{color.note}</p></li>)}</ul>
      <div class="sg-surface-grid"><div class="sg-surface bg-paper"><h3>Paper & ink</h3><p>Primary text stays dark. Descriptions use muted ink; readable text never uses faint ink.</p><a class="editorial-link" href="/blog/">Browse writing <span aria-hidden="true" data-link-arrow="up-right">↗</span></a></div><div class="sg-surface sg-surface--denim"><h3>Denim & paper</h3><p>Feature bands use white text and lighter blue supporting text. Keep links underlined or otherwise explicit.</p><a class="editorial-link editorial-link--light" href="/testimonials/">Read recommendations <span aria-hidden="true" data-link-arrow="up-right">↗</span></a></div><div class="sg-surface bg-ink"><h3>Ink & paper</h3><p>The footer, project navigation, and code artifacts use light text on ink. Links, icons, and focus styles need enough contrast against the dark surface.</p><a class="editorial-link editorial-link--light" href="/contact/">Get in touch <span aria-hidden="true" data-link-arrow="up-right">↗</span></a></div></div>
      <p class="sg-note">Swatch values are read from the site’s CSS at build time. Decorative borders and colors are separate from the contrast required for text, focus indicators, and controls.</p>
    </Container>
  </section>

  <section id="typography" class="editorial-section sg-tint" aria-labelledby="typography-title">
    <Container width="wide">
      <div class="section-heading"><h2 class="section-type" id="typography-title">Big type.<br /><em>Clear hierarchy.</em></h2><p>Four typefaces, with distinct jobs. Bold headings carry the message; italics add a little character.</p></div>
      <div class="sg-fonts"><article><p class="sg-font-label">Hanken Grotesk</p><p class="sg-hanken">Built to be used.</p><p>Headlines, paragraphs, navigation, form labels, and most metadata. Display type is heavy and tightly tracked; reading text has a more relaxed rhythm.</p></article><article><p class="sg-font-label">Newsreader</p><p class="sg-newsreader">A little character.</p><p>Editorial italics within large headings and occasional pull quotes. It adds contrast without taking over the reading experience.</p></article><article><p class="sg-font-label">Geist Mono</p><p class="sg-mono">const shared = true;</p><p>Code and selected technical metadata. It identifies technical detail rather than serving as a label on every section.</p></article><article><p class="sg-font-label">Style Script</p><div class="sg-logo"><Logo /></div><p>The wordmark in the header and footer. Keep it out of body copy, buttons, and interface labels.</p></article></div>
      <Specimen title="Page and section headings" note="Use the shared page-type and section-type classes for the main editorial hierarchy. Semantic heading levels still follow the document outline." href="/" code={typeMarkup} filename="Shared heading styles">
        <p class="page-type sg-type-page">Shared UI.<br /><em>Clear intent.</em></p><p class="page-lede">Accessible components and product interfaces, built for the teams using them.</p><p class="section-type sg-type-section">Shared <em>practice.</em></p>
      </Specimen>
      <Specimen title="Supporting headings and body copy" note="Heading and Text remain in use for case studies and supporting pages. Visual size is independent of the heading’s semantic level." href="/projects/ivfcryo/">
        <Heading level={4} visual="h2">Decisions need context.</Heading><Text size="lg" tone="muted" class="mt-4">Explain the situation, the alternatives, and the reason for a decision. Keep the reading column comfortable rather than stretching every paragraph across the page.</Text><Text size="sm" tone="muted" class="mt-4">Captions describe what the reader is seeing and why it matters.</Text>
      </Specimen>
    </Container>
  </section>

  <section id="actions" class="editorial-section" aria-labelledby="actions-title">
    <Container width="wide">
      <div class="section-heading"><h2 class="section-type" id="actions-title">Actions with<br /><em>intent.</em></h2><p>Use a filled denim action for the next important step, and an underlined editorial link for the supporting route.</p></div>
      <Specimen title="Primary action and editorial link" note="The same styles appear on the home page, résumé, articles, and tools. Arrow glyphs are decorative; the visible words name the destination." href="/resume/" code={primaryMarkup} filename="Shared actions">
        <div class="sg-actions"><a class="action-link" href="/projects/">Explore my work <span aria-hidden="true" data-link-arrow="down-right">↘</span></a><a class="editorial-link" href="/resume/">View résumé <span aria-hidden="true" data-link-arrow="up-right">↗</span></a></div>
      </Specimen>
      <Specimen title="Links on ink" note="Use the light editorial-link variant on dark surfaces. The underline remains visible before hover." href="/contact/" dark><a class="editorial-link editorial-link--light" href="/contact/">Talk shop <span aria-hidden="true" data-link-arrow="up-right">↗</span></a></Specimen>
      <Specimen title="Navigation links and icons" note="The Link component still supplies site navigation and inline legal-page links. Decorative icons stay out of the accessible name; standalone controls need a label." href="/privacy/">
        <div class="sg-actions"><Link href="/privacy/" variant="inline">Privacy policy</Link><Link href="/projects/" variant="arrow" iconRight="ph:arrow-right">View projects</Link><span class="sg-icon-caption"><Icon name="ph:keyboard" size={24} /> Keyboard access</span></div>
      </Specimen>
      <p class="sg-note">Try hovering and tabbing through the examples. Hover changes the fill, underline, or border. Keyboard focus adds a visible outline. The primary action is at least 52px tall; editorial links provide a 44px minimum target.</p>
    </Container>
  </section>

  <section id="forms" class="editorial-section sg-tint" aria-labelledby="forms-title">
    <Container width="wide">
      <div class="section-heading"><h2 class="section-type" id="forms-title">Forms that<br /><em>explain.</em></h2><p>Visible labels, useful hints, specific errors, and feedback while sending. The contact page uses these same components.</p></div>
      <Specimen title="Fields, validation, and submission" note="Try the validation and sending state. This demonstration stays in your browser and does not send a message." href="/contact/" code={formMarkup} filename="Contact field pattern">
        <form id="sg-form" class="sg-demo-form" novalidate>
          <Field label="Email" name="sg-email" required hint="Use an address like you@example.com."><Input name="sg-email" type="email" required autocomplete="email" describedBy="field-sg-email-hint sg-email-error" /></Field>
          <p id="sg-email-error" class="sg-field-error" hidden></p>
          <Field label="Message" name="sg-message" required hint="A few sentences is plenty."><Textarea name="sg-message" rows={3} required describedBy="field-sg-message-hint sg-message-error" /></Field>
          <p id="sg-message-error" class="sg-field-error" hidden></p>
          <SubmitButton label="Try sending state" loadingLabel="Sending…" disabled />
          <FormAlert variant="success" id="sg-success"><p>Example complete. Nothing was sent.</p></FormAlert>
          <FormAlert variant="error" id="sg-error"><p>Please check the highlighted fields.</p></FormAlert>
        </form>
      </Specimen>
      <div class="sg-two-up"><Specimen title="Busy and disabled" note="The busy state changes the label, shows a spinner, and prevents repeat submission. A disabled action keeps its label and uses reduced opacity."><div class="sg-actions"><SubmitButton label="Send message" busy /><SubmitButton label="Send message" disabled /></div></Specimen><Specimen title="Inline error" note="Match label and input IDs. Connect the hint and error with describedBy, and apply aria-invalid when a field needs attention."><Field label="Email" name="sg-invalid" error="Enter a complete email address."><Input name="sg-invalid" type="email" value="you@" invalid describedBy="field-sg-invalid-error" /></Field></Specimen></div>
    </Container>
  </section>

  <section id="patterns" class="editorial-section" aria-labelledby="patterns-title">
    <Container width="wide">
      <div class="section-heading"><h2 class="section-type" id="patterns-title">Content earns<br /><em>its space.</em></h2><p>Case studies make ownership and evidence clear. Articles support long reading. Recommendations keep the words and their author together.</p></div>
      <Specimen title="Project summaries and evidence" note="ProjectHero establishes context and ownership. Tldr expands the decision record. WorkList and ProjectNext connect related work; CaseReview provides page shortcuts." href="/projects/ivfcryo/">
        <div class="project-page"><div class="sg-metrics">{projectPages.ivfcryo.figures.map((metric) => <Metric value={metric.value} label={metric.label} />)}</div>
        <p class="sg-note">Reported outcomes from the IVFCRYO case study. Keep a metric’s source, scope, and explanation close to the number.</p>
        <Tldr {...ivfcryoSummary} /></div>
      </Specimen>
      <div class="sg-two-up"><Specimen title="Design sheets and the artifact viewer" note="Plate shows the full design sheet at its natural aspect ratio. Open the viewer to inspect details; Escape closes it and returns focus." href="/projects/ivfcryo/"><Plate src={shipmentSheet} title="Shipment detail" alt="IVFCRYO shipment detail design sheet, showing readiness, shipment status, and tracking" caption="A real interface artifact from the IVFCRYO case study." size="half" /></Specimen><Specimen title="Recommendations" note="Use Recommendation for a named, attributed quote. The testimonials page also has a larger featured treatment on denim with a small Newsreader quotation mark." href="/testimonials/">{recommendation && <Recommendation testimonial={recommendation} />}</Specimen></div>
      <Specimen title="Article prose and comparison tables" note="Articles use a focused reading measure, strong chapter headings, underlined links, and a section index. Tables keep their column headings and scroll horizontally when needed." href="/blog/native-lit-or-stencil/">
        <div class="article-page"><article class="article-prose prose-whimsy"><h4>Make the contract visible</h4><p>Component APIs, examples, and tests describe how shared UI behaves. A reader should be able to find the decision behind the interface.</p><p class="pullquote">Shared interfaces need shared contracts.</p><ArticleTable><thead><tr><th>Pattern</th><th>Purpose</th><th>Where it appears</th></tr></thead><tbody><tr><td>Contents navigation</td><td>Jump between sections and track reading position</td><td>Blog articles</td></tr><tr><td>Expandable summary</td><td>Read the decision record without extending the opening summary</td><td>Project pages</td></tr></tbody></ArticleTable></article></div>
      </Specimen>
      <Specimen title="Article author credit" note="A small portrait, modest name, and short biography close each article. Keep the credit on the page surface and use muted text for supporting details." href="/blog/where-to-learn-modern-front-end/#author-title">
        <div class="article-author" role="group" aria-labelledby="sg-author-title">
          <div class="article-author-identity"><img src="/images/about/josh-suit-avatar-96.webp" alt="" width="48" height="48" loading="lazy" /><div><p class="article-author-label">Written by</p><h2 id="sg-author-title">Joshua Briley</h2></div></div>
          <p class="article-author-bio">Product design engineer with twenty-plus years building accessible interfaces and shared UI foundations.</p>
          <a class="editorial-link article-author-link" href="/about/">More about my work <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
        </div>
      </Specimen>
      <Specimen title="Article pager" note="Older and newer links close each article below the author credit. Keep it to a hairline, a small direction label, and the title; arrows point the way the reader travels: left for older, right for newer. Hover brings the title into the accent color." href="/blog/where-to-learn-modern-front-end/">
        <nav class="article-pager" aria-label="Article pager example">
          <a class="article-pager-link" href="/blog/the-hidden-cost-of-component-inconsistency/"><span class="article-pager-label"><span aria-hidden="true" data-link-arrow="left">←</span> Older article</span><span class="article-pager-title">What component inconsistency costs</span></a>
          <a class="article-pager-link article-pager-link--newer" href="/blog/measuring-style-guide-adoption/"><span class="article-pager-label">Newer article <span aria-hidden="true" data-link-arrow="right">→</span></span><span class="article-pager-title">Measuring style guide adoption</span></a>
        </nav>
      </Specimen>
      <Specimen title="Article resource lists" note="Give each resource its own linked name and a short description when it helps readers choose. Simple link collections can use two columns on wider screens; phones keep a single reading column." href="/blog/where-to-learn-modern-front-end/">
        <ResourceList items={[
          { name: 'CSS for JS Developers', href: 'https://css-for-js.dev/', description: 'Josh Comeau · CSS fundamentals and layout for JavaScript developers.' },
          { name: 'Total TypeScript', href: 'https://www.totaltypescript.com/', description: 'Matt Pocock · TypeScript and the types behind application APIs.' },
        ]} />
      </Specimen>
      <p class="sg-note">Visual details need a content purpose. The résumé timeline connects employment dates; a small quotation mark identifies the featured recommendation. Keep project previews on plain stages, and reserve numbering for content where sequence matters.</p>
      <p class="sg-note">SiteShot, ScrollShot, and LiveEmbed support personal-project and case-study media. FidelityBand compares design stages. CodeBlock uses the same GitHub Dark syntax highlighting as articles, with readable comment colors, line numbers, wrapped lines, and a copy action; open any “View markup” example here to try it.</p>
    </Container>
  </section>

  <section id="tools" class="editorial-section sg-tint" aria-labelledby="tools-title">
    <Container width="wide">
      <div class="section-heading"><h2 class="section-type" id="tools-title">Tools with<br /><em>a purpose.</em></h2><p>Four explanatory illustrations, each tied to a working tool. Their controls and results share the portfolio’s type, surfaces, and action styles.</p></div>
      <ul class="sg-tools">{tools.map((tool) => <li><a class="sg-tool-link" href={`/tools/${tool.id}/`} aria-labelledby={`sg-tool-${tool.id}`}><ToolIllustration tool={tool.data.tool} /><h3 id={`sg-tool-${tool.id}`}>{tool.data.title}</h3><p>{tool.data.takeaway}</p><span class="sg-tool-action" aria-hidden="true">{tool.data.action} <span data-link-arrow="up-right">↗</span></span></a></li>)}</ul>
      <div class="sg-guidance-grid"><article><h3>Inputs and choices</h3><p>The calculator and token playground use labelled sliders and numeric inputs. The Scorecard uses grouped choices with a visible selected state. Preserve the label, value, and keyboard behavior.</p></article><article><h3>Results and state</h3><p>The calculator recalculates estimates from its inputs. The Scorecard preserves progress locally and opens a report. The audit tool pairs findings with fixes; it is a sample interface, not a scan of the reader’s website.</p></article></div>
    </Container>
  </section>

  <section id="interaction" class="editorial-section" aria-labelledby="interaction-title">
    <Container width="wide">
      <div class="section-heading"><h2 class="section-type" id="interaction-title">Room to read.<br /><em>Ways to move.</em></h2><p>Shared widths and spacing keep pages coherent. Motion helps explain a state change or makes an available action easier to notice.</p></div>
      <div class="sg-guidance-grid"><article><h3>Containers and spacing</h3><p>Container provides a 24px gutter on each side. Its width caps include those gutters. Editorial sections use 5.5rem vertical padding on larger screens and 3.75rem on phones.</p><dl class="sg-widths">{widths.map(([name, width, note]) => <div><dt><code>{name}</code> <span>{width}</span></dt><dd>{note}</dd></div>)}</dl></article><article><h3>Reading and responsive layout</h3><p>Article text is capped at 48rem, with a separate contents rail on desktop and an expandable index on smaller screens. Project pages combine narrower reading columns with wider interface artifacts.</p><p>Headings use fluid sizes. Section shortcut navigation becomes a full-width list below 768px, with labels on the left and arrows on the right. Multi-column content stacks when its reading space gets too tight; data tables keep a horizontal scroller rather than dropping their headers.</p></article></div>
      <div class="sg-guidance-grid"><article><h3>Entry and scroll reveal</h3><p>Hero content rises 12px over 0.7 seconds with a small stagger. Sections reveal once as they enter the viewport. Content stays visible when reduced motion is requested.</p><button type="button" class="editorial-link" data-guide-replay>Replay entry motion <span aria-hidden="true" data-link-arrow="up-right">↗</span></button><div class="sg-motion-sample" data-guide-motion><strong>Clear, then a little character.</strong><span>Heading entrance and restrained movement.</span></div><p role="status" class="sg-motion-status" data-guide-motion-status></p></article><article><h3>Hover, focus, and reading progress</h3><p>Link arrows move 3px in their pointing direction over 200ms with the shared ease-out curve, on hover and keyboard focus. Reduced motion keeps arrows still. Article previews fade in a title underline and accent color on hover, with no enclosing hover border. Keyboard focus adds the enclosing border and outline. Other related-content links may also change their background or underline. A visible focus outline supports keyboard navigation. The thin page-top progress bar tracks scrolling where the browser supports scroll timelines.</p><a class="editorial-link" href="/tools/scorecard/#related-title">Try the related-tool links <span aria-hidden="true" data-link-arrow="up-right">↗</span></a></article></div>
      <div class="sg-guidance-grid"><article><h3>Designed for paper</h3><p>Print uses one centered 70ch measure for body content and headings, with no narrower text limits inside it. Hanken headings with Newsreader emphasis, generous page margins and spacing, white surfaces, and a small identity and source line keep the document coherent. Whitespace separates sections; horizontal section rules are omitted. Screen navigation, share controls, and decorative effects are omitted. Headings stay with their content; tables repeat their column headings and code wraps to the page width.</p></article><article><h3>Complete, readable snapshots</h3><p>Disclosures expand for print and return to their previous state afterward. Case-study artwork fits within a sheet, live demos use their poster images, and external links receive numbered references. Tools retain current answers, values, and results. The downloadable résumé keeps its separate document layout.</p></article></div>
      <div class="sg-guidance-grid"><article><h3>Navigation, dialogs, and clipboard</h3><p>The skip link is the first keyboard stop. Mobile navigation uses a native modal dialog with bold primary links, supporting destinations, and a Contact me link. It contains keyboard focus, locks background scrolling, closes on an outside click or Escape, and returns focus to the menu button. Artifact dialogs also support Escape dismissal. The artifact viewer restores focus to its trigger. Code and article-share actions announce clipboard success or failure.</p></article><article><h3>Optional inspection features</h3><p>Alt/Option plus hover reveals source information on elements with <code>data-source</code>. The layout inspector is activated with <kbd>↑ ↑ ↓ ↓ ← → ← → B A</kbd>; Escape dismisses it. These are optional inspection aids, separate from normal site navigation.</p></article></div>
    </Container>
  </section>

  <section id="components" class="editorial-section sg-tint" aria-labelledby="components-title">
    <Container width="wide">
      <div class="section-heading"><h2 class="section-type" id="components-title">The component<br /><em>index.</em></h2><p>{componentCatalogue.length} components reached by the site’s pages. Each entry links to a page that uses it; examples created only for this guide are excluded.</p></div>
      <p class="sg-note">Shared CSS patterns such as <code>action-link</code>, <code>page-type</code>, and <code>editorial-section</code> are documented above. Run <code>npm run audit:components</code> to check production usage and this index.</p>
      <div class="sg-catalogue">{groups.map((group) => <details class="sg-catalogue-group"><summary>{group.label}<span>{componentCatalogue.filter((component) => component.group === group.id).length} <span aria-hidden="true">+</span></span></summary><ul>{componentCatalogue.filter((component) => component.group === group.id).map((component) => <li><div><h3>{component.name}</h3><p>{component.note}</p><code>{component.path}</code></div><a class="editorial-link" href={component.href} aria-label={`See ${component.name} in use`}>See in use <span aria-hidden="true" data-link-arrow="up-right">↗</span></a></li>)}</ul></details>)}</div>
    </Container>
  </section>
</BaseLayout>

<script>
  const demo = document.querySelector<HTMLFormElement>('#sg-form');
  if (demo) {
    const button = demo.querySelector<HTMLButtonElement>('[data-submit]')!;
    const fields = [...demo.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')];
    const success = demo.querySelector<HTMLElement>('#sg-success')!;
    const error = demo.querySelector<HTMLElement>('#sg-error')!;
    button.disabled = false;
    demo.addEventListener('submit', (event) => {
      event.preventDefault();
      if (button.disabled) return;
      success.hidden = true;
      error.hidden = true;
      let invalid: HTMLInputElement | HTMLTextAreaElement | undefined;
      for (const field of fields) {
        const message = document.getElementById(`${field.name}-error`)!;
        const valid = field.checkValidity() && field.value.trim().length > 0;
        field.setAttribute('aria-invalid', String(!valid));
        message.hidden = valid;
        message.textContent = valid ? '' : field.type === 'email' ? 'Enter a complete email address.' : 'Add a short message.';
        if (!valid && !invalid) invalid = field;
      }
      if (invalid) { error.hidden = false; invalid.focus(); return; }
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      window.setTimeout(() => {
        button.disabled = false;
        button.removeAttribute('aria-busy');
        success.hidden = false;
        success.focus();
      }, 1000);
    });
  }
  const replay = document.querySelector<HTMLButtonElement>('[data-guide-replay]');
  const motion = document.querySelector<HTMLElement>('[data-guide-motion]');
  const motionStatus = document.querySelector<HTMLElement>('[data-guide-motion-status]');
  replay?.addEventListener('click', () => {
    if (!motion || !motionStatus) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    motionStatus.textContent = reduced ? 'Reduced motion is enabled. The sample stays still.' : 'Replaying the entry animation.';
    if (reduced) return;
    motion.classList.remove('sg-motion-replay');
    requestAnimationFrame(() => requestAnimationFrame(() => motion.classList.add('sg-motion-replay')));
  });
</script>
