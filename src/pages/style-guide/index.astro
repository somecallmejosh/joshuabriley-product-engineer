---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Grid from '~/components/layout/Grid.astro';
import SectionHeader from '~/components/patterns/SectionHeader.astro';
import Metric from '~/components/patterns/Metric.astro';
import CodeBlock from '~/components/patterns/CodeBlock.astro';
import FAQ from '~/components/patterns/FAQ.astro';
import FAQItem from '~/components/patterns/FAQItem.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import Logo from '~/components/primitives/Logo.astro';
import Button from '~/components/primitives/Button.astro';
import Link from '~/components/primitives/Link.astro';
import Badge from '~/components/primitives/Badge.astro';
import Field from '~/components/form/Field.astro';
import Input from '~/components/form/Input.astro';
import Textarea from '~/components/form/Textarea.astro';
import Select from '~/components/form/Select.astro';
import ChoiceGroup from '~/components/form/ChoiceGroup.astro';
import Choice from '~/components/form/Choice.astro';
import FormAlert from '~/components/form/FormAlert.astro';
import SubmitButton from '~/components/form/SubmitButton.astro';

// ── Foundations: the constrained token set that drives the whole system.
// Hex values mirror :root in src/styles/site.css. Swatches are rendered as
// small hairline-bordered chips, not bright scrapbook tiles.
const tokens = [
  { name: 'paper',       token: '--paper',       hex: '#FAFBFC', note: 'Page background', fill: 'bg-paper', border: 'border-line-strong' },
  { name: 'raised',      token: '--raised',      hex: '#FFFFFF', note: 'Cards and input boxes', fill: 'bg-raised', border: 'border-line-strong' },
  { name: 'surface-warm', token: '--surface-warm', hex: '#F7F5F0', note: 'Warm background for personal sections', fill: 'bg-surface-warm', border: 'border-line-strong' },
  { name: 'ink',         token: '--ink',         hex: '#1A1B1E', note: 'Headings, text, and dark sections', fill: 'bg-ink', border: 'border-ink' },
  { name: 'ink-muted',   token: '--ink-muted',   hex: '#565760', note: 'Most body text', fill: 'bg-[#565760]', border: 'border-[#565760]' },
  { name: 'ink-faint',   token: '--ink-faint',   hex: '#9A9AA1', note: 'Decoration only, never for text you read', fill: 'bg-[#9A9AA1]', border: 'border-[#9A9AA1]' },
  { name: 'line',        token: '--line',        hex: '#E5E7EB', note: 'Thin borders and dividers', fill: 'bg-line', border: 'border-line-strong' },
  { name: 'line-strong', token: '--line-strong', hex: '#D4D7DD', note: 'A slightly darker border', fill: 'bg-line-strong', border: 'border-line-strong' },
  { name: 'accent',      token: '--accent',      hex: '#2E5C8A', note: 'The one accent color, used sparingly', fill: 'bg-accent', border: 'border-accent' },
];

// ── Palette origin: the token set is sampled from one portrait, not a
// generator. Each row maps a token back to where it lives in the photograph.
const originMap = [
  { token: '--paper',        fill: 'bg-paper',        border: 'border-line-strong', from: 'Daylight through the window' },
  { token: '--surface-warm', fill: 'bg-surface-warm', border: 'border-line-strong', from: 'The blanket and wood shelf' },
  { token: '--ink',          fill: 'bg-ink',           border: 'border-ink',         from: 'The picture frame and dark shadows' },
  { token: '--accent',       fill: 'bg-accent',        border: 'border-accent',      from: 'The blue in the blanket' },
];

// Live in-section nav for the editorial rail.
const sections = [
  { id: 'foundations', label: 'Colors' },
  { id: 'typography',  label: 'Fonts' },
  { id: 'primitives',  label: 'Basic parts' },
  { id: 'patterns',    label: 'Groups' },
  { id: 'forms',       label: 'Forms' },
  { id: 'motion',      label: 'Movement & spacing' },
];

const apiSnippet = `// Field.astro: accessibility wired in by construction.
// label[for], input id, aria-describedby (hint + error),
// aria-invalid and aria-required are all derived, never hand-set.
const hintId = hint ? \`\${id}-hint\` : undefined;
const errorId = error ? \`\${id}-error\` : undefined;
const describedBy =
  [hintId, errorId].filter(Boolean).join(' ') || undefined;
// You cannot create a mislabeled input through this API.`;

// Illustrative metric figures — replace with real numbers in production.
const metrics = [
  { value: '9', label: 'colors used across the site' },
  { value: '2', label: 'fonts used across the site' },
  { value: '100%', label: 'parts work with a keyboard' },
  { before: '6', value: '1', label: 'way to build a button' },
];
---

<BaseLayout
  title="Style guide | Joshua Briley"
  description="A look at the colors, fonts, and parts I use to build this site."
>
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="flex items-center justify-between gap-4 mono-label">
        <span>Style guide</span>
        <span class="hidden sm:inline text-ink-muted">Updated 2026</span>
      </div>

      <div class="mt-10 max-w-3xl lg:mt-14">
        <Heading level={1} visual="display-xl">
          The parts that make up this site.
        </Heading>
        <Text size="lg" tone="muted" class="mt-7">
          This page shows the colors, fonts, and pieces, like buttons and
          forms, that every page on this site is built from.
        </Text>
      </div>

      <nav aria-label="Page sections" class="mt-10 flex flex-wrap items-center gap-2">
        {sections.map((s) => (
          <Button variant="ghost" size="sm" href={`#${s.id}`}>{s.label}</Button>
        ))}
      </nav>
    </Container>
  </Section>

  <Section id="foundations" tone="paper" padding="default" class="border-b border-line">
    <Container width="wide">
      <p class="mono-label">Colors / 01</p>
      <div class="mt-4 max-w-2xl">
        <Heading level={2} visual="display-md">Colors.</Heading>
        <Text tone="muted" class="mt-4">
          I use nine colors across the whole site. There are no bright
          colors and no gradients. Most pages are dark text on a light
          background, with one blue accent color used sparingly.
        </Text>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-5 md:items-center">
        <figure class="overflow-hidden rounded-lg border border-line md:col-span-2">
          <picture>
            <source
              type="image/avif"
              sizes="(min-width: 1280px) 474px, (min-width: 768px) 40vw, 100vw"
              srcset="/images/about/josh-suit-portrait-400.avif 400w, /images/about/josh-suit-portrait-640.avif 640w, /images/about/josh-suit-portrait-1000.avif 1000w"
            />
            <source
              type="image/webp"
              sizes="(min-width: 1280px) 474px, (min-width: 768px) 40vw, 100vw"
              srcset="/images/about/josh-suit-portrait-400.webp 400w, /images/about/josh-suit-portrait-640.webp 640w, /images/about/josh-suit-portrait-1000.webp 1000w"
            />
            <img
              src="/images/about/josh-suit-portrait-640.jpg"
              sizes="(min-width: 1280px) 474px, (min-width: 768px) 40vw, 100vw"
              srcset="/images/about/josh-suit-portrait-400.jpg 400w, /images/about/josh-suit-portrait-640.jpg 640w, /images/about/josh-suit-portrait-1000.jpg 1000w"
              alt="Joshua Briley sitting in a sunlit room. These colors come from this photo."
              class="aspect-[4/5] w-full object-cover"
              loading="lazy"
              decoding="async"
              width="1000"
              height="1250"
            />
          </picture>
        </figure>

        <div class="md:col-span-3">
          <p class="mono-label">Where the colors come from</p>
          <Heading level={3} visual="h3" class="mt-4">The colors come from a real photo.</Heading>
          <Text tone="muted" class="mt-4">
            I picked these colors from a single photo of me at home. The
            light from the window became the white background. The wood
            shelf and blanket became the warm tan color. The blue in the
            blanket became the one accent color used across the site.
          </Text>

          <dl class="mt-6 grid gap-px overflow-hidden rounded-lg border border-line bg-line">
            {originMap.map((m) => (
              <div class="bg-raised px-4 py-3">
                <dt class="flex items-center gap-4">
                  <span class={`h-9 w-9 shrink-0 rounded-[5px] border ${m.fill} ${m.border}`} aria-hidden="true"></span>
                  <span class="font-mono text-[0.7rem] uppercase tracking-[0.06em] text-accent">{m.token}</span>
                </dt>
                <dd class="mt-1 pl-[3.25rem] text-sm leading-snug text-ink-muted">{m.from}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <Grid cols={4} gap="md" class="mt-12">
        {tokens.map((t) => (
          <div class="rounded-lg border border-line bg-raised p-4">
            <div class={`h-16 w-full rounded-[5px] border ${t.fill} ${t.border}`}></div>
            <div class="mt-4 flex items-baseline justify-between gap-2">
              <span class="font-sans text-sm font-semibold tracking-tight text-ink">{t.name}</span>
              <span class="font-mono text-[0.7rem] uppercase tracking-[0.06em] text-ink-muted">{t.hex}</span>
            </div>
            <p class="mt-1 font-mono text-[0.65rem] text-accent">{t.token}</p>
            <p class="mt-2 text-xs leading-relaxed text-ink-muted">{t.note}</p>
          </div>
        ))}
      </Grid>

      <div class="mt-10 rounded-lg border border-line bg-raised p-6 md:p-7">
        <p class="mono-label">Easy to read</p>
        <Text size="sm" tone="muted" class="mt-3 max-w-3xl">
          Text stays dark enough to read clearly on every background, light
          or dark. I follow standard accessibility guidelines so people
          with low vision can read the site too.
        </Text>
      </div>
    </Container>
  </Section>

  <Section id="typography" tone="paper" padding="default" class="border-b border-line">
    <Container width="wide">
      <p class="mono-label">Fonts / 02</p>
      <div class="mt-4 max-w-2xl">
        <Heading level={2} visual="display-md">The fonts I use.</Heading>
        <Text tone="muted" class="mt-4">
          I use two fonts. Hanken Grotesk is for headings and paragraphs.
          Geist Mono, a monospace font, is for small labels.
        </Text>
      </div>

      <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-line bg-line">
        {[
          { spec: 'Biggest',    visual: 'display-xl' as const, sample: 'The biggest heading' },
          { spec: 'Large',      visual: 'display-lg' as const, sample: 'A large heading' },
          { spec: 'Medium',     visual: 'display-md' as const, sample: 'A medium heading' },
          { spec: 'Section',    visual: 'h2' as const,         sample: 'A section heading' },
          { spec: 'Subsection', visual: 'h3' as const,         sample: 'A subsection heading' },
          { spec: 'Small',      visual: 'h4' as const,         sample: 'A small heading' },
        ].map((row) => (
          <div class="bg-paper px-6 py-7 md:px-8">
            <p class="mono-label mb-3">{row.spec}</p>
            <Heading level={3} visual={row.visual}>{row.sample}</Heading>
          </div>
        ))}
      </div>

      <div class="mt-10 grid gap-8 md:grid-cols-2">
        <div class="rounded-lg border border-line bg-raised p-6 md:p-8">
          <p class="mono-label">Paragraph sizes</p>
          <div class="mt-5 space-y-4">
            <Text size="xl">Extra large: for intro paragraphs.</Text>
            <Text size="lg" tone="muted">Large: for secondary text.</Text>
            <Text size="base" tone="muted">Normal: everyday paragraph text.</Text>
            <Text size="sm" tone="muted">Small: captions and notes.</Text>
            <Text size="xs" tone="muted">Extra small: fine print.</Text>
          </div>
        </div>

        <div class="rounded-lg border border-line bg-raised p-6 md:p-8">
          <p class="mono-label">Small labels</p>
          <div class="mt-5 space-y-6">
            <div>
              <p class="mono-label">Colors / 01</p>
              <Text size="sm" tone="muted" class="mt-2">
                A small label at the top of each section. The number helps
                you keep track of where you are.
              </Text>
            </div>
            <div>
              <p class="font-mono text-sm text-ink">const tokens = await build();</p>
              <Text size="sm" tone="muted" class="mt-2">
                This font is also used to show code, like the line above.
              </Text>
            </div>
            <div class="flex items-center gap-3">
              <Logo />
              <span class="mono-label">Logo: Style Script font</span>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="primitives" tone="paper" padding="default" class="border-b border-line">
    <Container width="wide">
      <p class="mono-label">Basic parts / 03</p>
      <div class="mt-4 max-w-2xl">
        <Heading level={2} visual="display-md">The basic parts.</Heading>
        <Text tone="muted" class="mt-4">
          These are the small pieces, like buttons and icons, that make up
          every page. They look and work the same everywhere on the site.
        </Text>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-2">
        <div class="rounded-lg border border-line bg-raised p-6 md:p-8">
          <p class="mono-label">Buttons</p>
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <Button variant="primary" iconRight="ph:arrow-right">Primary</Button>
            <Button variant="ghost">Ghost</Button>
            <Button variant="text">Text</Button>
          </div>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <Button variant="primary" size="sm">Small</Button>
            <Button variant="primary" size="md">Medium</Button>
            <Button variant="primary" size="lg" iconLeft="ph:paper-plane-tilt">Large + icon</Button>
          </div>
          <Text size="xs" tone="muted" class="mt-4">
            Solid buttons are for light backgrounds. On dark backgrounds, I
            switch to an outlined button instead.
          </Text>
        </div>

        <div class="rounded-lg border border-ink bg-ink p-6 md:p-8">
          <p class="mono-label !text-paper/65">Buttons on dark backgrounds</p>
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <Button variant="navy" iconRight="ph:arrow-right">Navy (inverse fill)</Button>
            <Button variant="secondary">Secondary (outlined)</Button>
          </div>
          <Text size="xs" tone="whiteMuted" class="mt-4">
            These versions are only used on dark backgrounds.
          </Text>
        </div>

        <div class="rounded-lg border border-line bg-raised p-6 md:p-8">
          <p class="mono-label">Links</p>
          <div class="mt-5 space-y-3 text-sm">
            <p class="text-ink-muted">
              Read <Link href="/about/" variant="inline">the approach</Link> to
              see a link inside a sentence.
            </p>
            <p><Link href="/projects/" variant="arrow">Selected work</Link></p>
            <p class="flex gap-5">
              <Link href="/style-guide/" variant="nav" current>Active nav</Link>
              <Link href="/blog/" variant="nav">Inactive nav</Link>
            </p>
          </div>
        </div>

        <div class="rounded-lg border border-line bg-raised p-6 md:p-8">
          <p class="mono-label">Tags</p>
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <Badge>Default</Badge>
            <Badge icon="ph:package">With icon</Badge>
            <Badge tone="coral">Accent tick</Badge>
            <Badge solid>Solid ink</Badge>
            <Badge size="sm">Small</Badge>
          </div>
          <Text size="xs" tone="muted" class="mt-4">
            Small tags I use to highlight or label something.
          </Text>
        </div>

        <div class="rounded-lg border border-line bg-raised p-6 md:p-8">
          <p class="mono-label">Logo</p>
          <div class="mt-6 flex flex-wrap items-baseline gap-x-10 gap-y-6">
            <Logo size="sm" />
            <Logo size="md" />
            <Logo size="lg" />
          </div>
          <Text size="xs" tone="muted" class="mt-5">
            My name in a handwritten script. It's real text, so screen
            readers can read it aloud. The browser tab icon uses the same
            style.
          </Text>
        </div>

        <div class="rounded-lg border border-line bg-raised p-6 md:p-8">
          <p class="mono-label">Icons</p>
          <div class="mt-6 flex flex-wrap items-center gap-6 text-ink">
            <Icon name="ph:arrow-right" size={26} />
            <Icon name="ph:check-circle" size={26} />
            <Icon name="ph:warning-circle" size={26} class="text-accent" />
            <Icon name="ph:terminal-window" size={26} />
            <Icon name="ph:package" size={26} />
          </div>
          <Text size="xs" tone="muted" class="mt-5">
            Most icons are just decoration. When an icon means something on
            its own, I add a label so screen readers can announce it.
          </Text>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="patterns" tone="paper" padding="default" class="border-b border-line">
    <Container width="wide">
      <p class="mono-label">Groups / 04</p>
      <div class="mt-4 max-w-2xl">
        <Heading level={2} visual="display-md">Bigger pieces, built from small parts.</Heading>
        <Text tone="muted" class="mt-4">
          These are bigger pieces built from the parts above: a section
          header, a row of numbers, a code sample, and a list of questions
          and answers.
        </Text>
      </div>

      <div class="mt-8 rounded-lg border border-line bg-raised p-7 md:p-10">
        <p class="mono-label mb-6">Numbers and results</p>
        <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
          {metrics.map((m) => (
            <Metric value={m.value} before={m.before} label={m.label} />
          ))}
        </div>
        <Text size="xs" tone="muted" class="mt-6">
          These numbers are just examples.
        </Text>
      </div>

      <div class="mt-8">
        <p class="mono-label mb-4">Code samples</p>
        <CodeBlock
          filename="Field.astro"
          lang="ts"
          code={apiSnippet}
          caption="A real piece of code from this site."
        />
      </div>

      <div class="mt-10 rounded-lg border border-line bg-raised p-7 md:p-10">
        <p class="mono-label mb-2">Common questions</p>
        <FAQ class="mt-4">
          <FAQItem question="Why only one accent color?" open>
            One color stands out more than many. It keeps your eyes on the
            words instead of the design.
          </FAQItem>
          <FAQItem question="How do you make sure everyone can use the site?">
            Every button, link, and form field is built to work well with
            screen readers and keyboards, not just a mouse.
          </FAQItem>
          <FAQItem question="What moves on the page?">
            Sections fade in gently as you scroll. If your device is set to
            reduce motion, this turns off.
          </FAQItem>
        </FAQ>
      </div>
    </Container>
  </Section>

  <Section id="forms" tone="paper" padding="default" class="border-b border-line">
    <Container width="wide">
      <p class="mono-label">Forms / 05</p>
      <div class="mt-4 max-w-2xl">
        <Heading level={2} visual="display-md">Forms everyone can use.</Heading>
        <Text tone="muted" class="mt-4">
          Every field has a clear label. Hints and error messages are
          connected to the field, so screen readers announce them too.
        </Text>
      </div>

      <Grid cols={2} gap="lg" class="mt-12">
        <form class="rounded-lg border border-line bg-raised p-6 md:p-8 flex flex-col gap-5">
          <Heading level={3} visual="h4">Field examples</Heading>

          <Field label="Full name" name="demo-name" required>
            <Input name="demo-name" autocomplete="name" required />
          </Field>

          <Field label="Email" name="demo-email" required hint="Only used to reply.">
            <Input name="demo-email" type="email" autocomplete="email" required />
          </Field>

          <Field label="What can I help with?" name="demo-service">
            <Select name="demo-service" placeholder="Pick one" options={[
              { value: 'audit', label: 'Design system audit' },
              { value: 'library', label: 'Component library' },
              { value: 'a11y', label: 'Accessibility review' },
            ]} />
          </Field>

          <Field label="Project notes" name="demo-message" hint="A few sentences is plenty.">
            <Textarea name="demo-message" rows={4} />
          </Field>

          <Field label="Phone" name="demo-phone" error="The phone number looks invalid.">
            <Input name="demo-phone" type="tel" invalid value="abc" />
          </Field>

          <SubmitButton label="Send message" />
        </form>

        <div class="flex flex-col gap-6">
          <div class="rounded-lg border border-line bg-raised p-6 md:p-8">
            <p class="mono-label mb-4">Multiple choice</p>
            <ChoiceGroup legend="How would you rate this page?" name="demo-rating" required>
              <Choice name="demo-rating" value="strong" label="Strong" />
              <Choice name="demo-rating" value="ok" label="Good" checked />
              <Choice name="demo-rating" value="weak" label="Needs work" />
            </ChoiceGroup>
          </div>

          <div class="rounded-lg border border-line bg-raised p-6 md:p-8">
            <p class="mono-label mb-4">Status messages</p>
            <div class="space-y-4">
              <FormAlert variant="success" hidden={false}>
                <p class="font-sans font-semibold text-ink">Thanks. Your message is on its way.</p>
                <p class="mt-1 text-ink-muted">I&rsquo;ll reply within one business day, usually sooner.</p>
              </FormAlert>
              <FormAlert variant="error" hidden={false}>
                <p class="font-sans font-semibold text-ink">We couldn&rsquo;t send your message.</p>
                <p class="mt-1 text-ink-muted">Please check the highlighted fields.</p>
              </FormAlert>
            </div>
          </div>
        </div>
      </Grid>
    </Container>
  </Section>

  <Section id="motion" tone="ink" padding="default">
    <Container width="wide">
      <p class="mono-label !text-paper/65">Movement & spacing / 06</p>
      <div class="mt-4 max-w-2xl">
        <Heading level={2} visual="display-md" tone="paper">Movement on the page.</Heading>
        <Text size="lg" tone="whiteMuted" class="mt-4">
          Animations are small and simple. Nothing spins or loops forever,
          and the site turns them off if your device is set to reduce
          motion.
        </Text>
      </div>

      <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-paper/15 bg-paper/15 md:grid-cols-3">
        <div class="bg-ink p-7">
          <p class="mono-label !text-paper/65">Scroll reveal</p>
          <Text size="sm" tone="whiteMuted" class="mt-3">
            Sections fade in gently as you scroll down the page.
          </Text>
        </div>
        <div class="bg-ink p-7">
          <p class="mono-label !text-paper/65">Smooth start</p>
          <Text size="sm" tone="whiteMuted" class="mt-3">
            Used when something appears, like on hover or a button nudge.
          </Text>
        </div>
        <div class="bg-ink p-7">
          <p class="mono-label !text-paper/65">Smooth start and stop</p>
          <Text size="sm" tone="whiteMuted" class="mt-3">
            Used for motion that moves back and forth.
          </Text>
        </div>
      </div>

      <div class="mt-8 rounded-lg border border-paper/15 p-7 md:p-8">
        <p class="mono-label !text-paper/65">Spacing between sections</p>
        <Text size="sm" tone="whiteMuted" class="mt-3 max-w-3xl">
          Pages use consistent spacing between sections. Extra whitespace,
          not boxes or lines, keeps everything easy to scan.
        </Text>
      </div>
    </Container>
  </Section>
</BaseLayout>
