---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import Specimen from '~/components/style-guide/Specimen.astro';
import Logo from '~/components/primitives/Logo.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import Link from '~/components/primitives/Link.astro';
import Portrait from '~/components/patterns/Portrait.astro';
import Recommendation from '~/components/patterns/Recommendation.astro';
import Metric from '~/components/patterns/Metric.astro';
import Tldr from '~/components/patterns/Tldr.astro';
import { ivfcryoSummary } from '~/lib/project-summaries';
import Plate from '~/components/patterns/Plate.astro';
import ToolIllustration from '~/components/patterns/ToolIllustration.astro';
import Field from '~/components/form/Field.astro';
import Input from '~/components/form/Input.astro';
import Textarea from '~/components/form/Textarea.astro';
import FormAlert from '~/components/form/FormAlert.astro';
import SubmitButton from '~/components/form/SubmitButton.astro';
import ArticleTable from '~/components/writing/ArticleTable.astro';
import ResourceList from '~/components/writing/ResourceList.astro';
import { componentCatalogue } from '~/lib/component-catalogue';
import { projectPages } from '~/lib/project-pages';
import baseStyles from '~/styles/site.css?raw';
import portfolioStyles from '~/styles/redesign.css?raw';
import shipmentSheet from '~/assets/projects/ivfcryo/wires-and-flows/05-shipment-detail.png';
import '~/styles/articles.css';
import '~/styles/projects.css';
import '~/styles/style-guide.css';

const sections = [
  ['foundations', 'Colors & surfaces'], ['typography', 'Typography'], ['actions', 'Actions'], ['forms', 'Forms'],
  ['patterns', 'Content & media'], ['tools', 'Tools'], ['interaction', 'Layout & interaction'], ['components', 'Component index'],
];
const colors = [
  { name: 'Paper', token: '--paper', note: 'Default page surface.' },
  { name: 'Raised', token: '--raised', note: 'Inputs, illustration frames, and the printed page.' },
  { name: 'Ink', token: '--ink', note: 'Primary text, the lead in two-tone sentences, and code artifacts.' },
  { name: 'Muted ink', token: '--ink-muted', note: 'Descriptions, captions, and the continuation in two-tone sentences.' },
  { name: 'Denim', token: '--portfolio-blue', note: 'The filled primary action, keyboard focus outlines, and the answer panels inside tools.' },
  { name: 'Denim tint', token: '--portfolio-tint', note: 'The plain stage behind interfaces, illustrations, and the working tools.' },
  { name: 'Accent', token: '--accent', note: 'Hover color for links and titles, the wordmark’s dot, required markers, and field errors. Lighter on dark surfaces.' },
  { name: 'Line', token: '--line', note: 'Hairlines that do a job: table rows, sticky-bar edges, the divider between compared columns, and the code gutter. Never decoration, and never carrying bullets or numbers.' },
  { name: 'Strong line', token: '--line-strong', note: 'Link underlines at rest and input outlines.' },
  { name: 'Faint ink', token: '--ink-faint', note: 'Decoration only. Use muted ink for readable text.' },
];
const css = baseStyles + '\n' + portfolioStyles;
const tokenValue = (token: string) => {
  const raw = css.match(new RegExp(`${token}:\\s*([^;]+);`))?.[1]?.trim() ?? '';
  if (token === '--accent') {
    const channels = css.match(/--accent-rgb:\s*([\d\s]+);/)?.[1].trim().split(/\s+/).map(Number);
    return channels ? '#' + channels.map((channel) => channel.toString(16).padStart(2, '0')).join('').toUpperCase() : raw;
  }
  return raw.toUpperCase();
};
const [recommendation] = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
const tools = (await getCollection('tools', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { id: 'chrome', label: 'Site navigation' }, { id: 'layout', label: 'Layout' }, { id: 'primitives', label: 'Type, links & icons' },
  { id: 'form', label: 'Form controls' }, { id: 'patterns', label: 'Content & media patterns' },
  { id: 'islands', label: 'Interactive features' }, { id: 'writing', label: 'Article components' },
];
const primaryMarkup = `<a class="action-link" href="/projects/">\n  Explore my work <span aria-hidden="true" data-link-arrow="down-right">↘</span>\n</a>\n<a class="editorial-link" href="/resume/">\n  View résumé <span aria-hidden="true" data-link-arrow="up-right">↗</span>\n</a>`;
const typeMarkup = `<h1 class="calm-title">How this site <em>is designed.</em></h1>\n<p class="calm-lede">A short introduction with a clear purpose.</p>\n<h2 class="calm-heading">Section heading.</h2>`;
const pointMarkup = `<article class="calm-point">\n  <h3>Treat internal tools as products.</h3>\n  <p>Engineers are users, too.</p>\n</article>`;
const formMarkup = `<Field label="Email" name="email" required hint="Only used to reply.">\n  <Input name="email" type="email" required\n    describedBy="field-email-hint" />\n</Field>\n<SubmitButton label="Send message" loadingLabel="Sending…" />`;
const widths = [
  ['narrow', '48rem', 'Supporting copy and narrow page content'], ['content', '64rem', 'Case-study reading layouts'],
  ['default', '72rem', 'General page content'], ['wide', '80rem', 'Main page grids and full design sheets'],
];
---

<BaseLayout title="Style guide | Joshua Briley" description="The typography, colors, components, and interactions currently used across this portfolio, with live examples and usage notes." mainClass="style-guide">
  <header class="calm-open">
    <Container>
      <p class="calm-label hero-in hero-in-1">Style guide <span aria-hidden="true">·</span> The portfolio’s working design system</p>
      <h1 class="calm-title hero-in hero-in-2">How this site <em>is designed.</em></h1>
      <p class="calm-lede hero-in hero-in-3">The colors, type, components, and interactions used across this portfolio. Live examples, usage notes, and links to the pages where they do the work.</p>
      <nav class="calm-jumps hero-in hero-in-4" aria-label="Style guide sections">{sections.map(([id, label]) => <a href={`#${id}`}>{label} <span aria-hidden="true" data-link-arrow="down">↓</span></a>)}</nav>
    </Container>
  </header>

  <section id="foundations" class="calm-section" aria-labelledby="foundations-title">
    <Container width="wide">
      <h2 id="foundations-title" class="calm-heading">Colors & surfaces.</h2><p class="calm-intro">Cool paper, charcoal, and denim. The palette stays in tune with the photograph on the home and about pages.</p>
      <div class="sg-palette-intro" data-reveal><div class="sg-portrait"><Portrait /></div><div><h3>A photograph sets the tone.</h3><p>The navy suit and throw, dark shelves, and daylight give the site its color direction. Large, light type provides the emphasis; denim marks the primary action, keyboard focus, and the answers inside the tools.</p><p>Use paper for reading and denim tint as the stage behind interfaces. The working tools are the only full-width tinted band; every other section is separated by space.</p><a class="editorial-link" href="/about/">See the portrait in context <span aria-hidden="true" data-link-arrow="up-right">↗</span></a></div></div>
      <ul class="sg-swatches">{colors.map((color) => <li><div class="sg-swatch" style={`background: var(${color.token})`} aria-hidden="true"></div><h3>{color.name}</h3><p class="sg-color-value">{tokenValue(color.token)}</p><code>{color.token}</code><p>{color.note}</p></li>)}</ul>
      <div class="sg-surface-grid"><div class="sg-surface bg-paper"><h3>Paper & ink</h3><p>Primary text stays dark. Descriptions use muted ink; readable text never uses faint ink.</p><a class="editorial-link" href="/blog/">Browse writing <span aria-hidden="true" data-link-arrow="up-right">↗</span></a></div><div class="sg-surface sg-surface--denim"><h3>Denim & paper</h3><p>Tool answer panels use white text and lighter blue supporting text. Keep links underlined or otherwise explicit.</p><a class="editorial-link editorial-link--light" href="/testimonials/">Read recommendations <span aria-hidden="true" data-link-arrow="up-right">↗</span></a></div><div class="sg-surface bg-ink"><h3>Ink & paper</h3><p>Code artifacts use light text on ink. Links, icons, and focus styles need enough contrast against the dark surface.</p><a class="editorial-link editorial-link--light" href="/contact/">Get in touch <span aria-hidden="true" data-link-arrow="up-right">↗</span></a></div></div>
      <p class="sg-note">Swatch values are read from the site’s CSS at build time. Decorative borders and colors are separate from the contrast required for text, focus indicators, and controls.</p>
    </Container>
  </section>

  <section id="typography" class="calm-section" aria-labelledby="typography-title">
    <Container width="wide">
      <h2 id="typography-title" class="calm-heading">Type and hierarchy.</h2><p class="calm-intro">Four typefaces, with distinct jobs. Large, light headings carry the message; ink against muted grey sets the hierarchy inside a sentence.</p>
      <div class="sg-fonts"><article><p class="sg-font-label">Hanken Grotesk</p><p class="sg-hanken">Built to be used.</p><p>Headlines, paragraphs, navigation, form labels, and metadata. Display type is light (300) and tightly tracked; reading text has a more relaxed rhythm.</p></article><article><p class="sg-font-label">Geist Mono</p><p class="sg-mono">const shared = true;</p><p>Code, footnote markers, and the small technical labels inside illustrations, interface artifacts, and the tools. It identifies technical detail rather than serving as a label on every section.</p></article><article><p class="sg-font-label">Style Script</p><div class="sg-logo"><Logo /></div><p>The wordmark in the header and footer. Keep it out of body copy, buttons, and interface labels.</p></article></div>
      <Specimen title="Page and section headings" note="Use calm-title and calm-heading for the page hierarchy. An em inside a title sets its continuation in muted grey rather than italics. Semantic heading levels still follow the document outline." href="/" code={typeMarkup} filename="Shared heading styles">
        <div class="sg-calm-sample"><p class="calm-title">Shared UI. <em>Clear intent.</em></p><p class="calm-lede">Accessible components and product interfaces, built for the teams using them.</p><p class="calm-heading sg-type-section">Section heading.</p></div>
      </Specimen>
      <Specimen title="Two-tone points" note="A heading and its paragraph set as one sentence: the heading is the ink lead, the body continues in muted grey. Used for principles, working approaches, and personal notes." href="/about/" code={pointMarkup} filename="calm-point">
        <div class="calm-points"><article class="calm-point"><h3>Treat internal tools as products.</h3> <p>Engineers are users, too. I give component APIs, defaults, documentation, and automation the same care as type and spacing.</p></article></div>
      </Specimen>
      <Specimen title="Supporting headings and body copy" note="Heading and Text remain in use for case studies and supporting pages. Visual size is independent of the heading’s semantic level." href="/projects/ivfcryo/">
        <Heading level={4} visual="h2">Decisions need context.</Heading><Text size="lg" tone="muted" class="mt-4">Explain the situation, the alternatives, and the reason for a decision. Keep the reading column comfortable rather than stretching every paragraph across the page.</Text><Text size="sm" tone="muted" class="mt-4">Captions describe what the reader is seeing and why it matters.</Text>
      </Specimen>
    </Container>
  </section>

  <section id="actions" class="calm-section" aria-labelledby="actions-title">
    <Container width="wide">
      <h2 id="actions-title" class="calm-heading">Buttons and links.</h2><p class="calm-intro">Use a filled denim action for the next important step, and an underlined editorial link for the supporting route.</p>
      <Specimen title="Primary action and editorial link" note="The filled action is reserved for a single most important step: sending the contact form, opening the scorecard report, and exploring Rudiment UI’s Storybook. Every other route uses an editorial link. Arrow glyphs are decorative; the visible words name the destination." href="/contact/" code={primaryMarkup} filename="Shared actions">
        <div class="sg-actions"><a class="action-link" href="/projects/">Explore my work <span aria-hidden="true" data-link-arrow="down-right">↘</span></a><a class="editorial-link" href="/resume/">View résumé <span aria-hidden="true" data-link-arrow="up-right">↗</span></a></div>
      </Specimen>
      <Specimen title="Links on ink" note="No page currently places a text link on a dark surface. If one does, use the light editorial-link variant so the underline stays visible before hover." dark><a class="editorial-link editorial-link--light" href="/contact/">Talk shop <span aria-hidden="true" data-link-arrow="up-right">↗</span></a></Specimen>
      <Specimen title="Navigation links and icons" note="Every underlined text link shares one treatment: ink with a light 1px underline, turning accent with a 2px underline on hover and focus. Use .text-link inside a sentence and .editorial-link for a standalone route; article prose applies it automatically. The Link component supplies site navigation and inline legal-page links. Decorative icons stay out of the accessible name; standalone controls need a label." href="/privacy/">
        <div class="sg-actions"><Link href="/privacy/" variant="inline">Privacy policy</Link><Link href="/projects/" variant="arrow" iconRight="ph:arrow-right">View projects</Link><span class="sg-icon-caption"><Icon name="ph:keyboard" size={24} /> Keyboard access</span></div>
      </Specimen>
      <p class="sg-note">Try hovering and tabbing through the examples. Hover never relies on color alone: the primary action changes its fill, underlined links thicken their underline, and quiet links (navigation, footer, shortcuts, card titles) reveal one. Keyboard focus shows the same change plus a visible outline. The primary action is at least 52px tall; text links provide a 44px minimum target.</p>
    </Container>
  </section>

  <section id="forms" class="calm-section" aria-labelledby="forms-title">
    <Container width="wide">
      <h2 id="forms-title" class="calm-heading">Forms and feedback.</h2><p class="calm-intro">Visible labels, useful hints, specific errors, and feedback while sending. The contact page uses these same components.</p>
      <Specimen title="Fields, validation, and submission" note="Try the validation and sending state. This demonstration stays in your browser and does not send a message." href="/contact/" code={formMarkup} filename="Contact field pattern">
        <form id="sg-form" class="sg-demo-form" novalidate>
          <Field label="Email" name="sg-email" required hint="Use an address like you@example.com."><Input name="sg-email" type="email" required autocomplete="email" describedBy="field-sg-email-hint sg-email-error" /></Field>
          <p id="sg-email-error" class="sg-field-error" hidden></p>
          <Field label="Message" name="sg-message" required hint="A few sentences is plenty."><Textarea name="sg-message" rows={3} required describedBy="field-sg-message-hint sg-message-error" /></Field>
          <p id="sg-message-error" class="sg-field-error" hidden></p>
          <SubmitButton label="Try sending state" loadingLabel="Sending…" disabled />
          <FormAlert variant="success" id="sg-success"><p>Example complete. Nothing was sent.</p></FormAlert>
          <FormAlert variant="error" id="sg-error"><p>Please check the highlighted fields.</p></FormAlert>
        </form>
      </Specimen>
      <div class="sg-two-up"><Specimen title="Busy and disabled" note="The busy state changes the label, shows a spinner, and prevents repeat submission. A disabled action keeps its label and uses reduced opacity."><div class="sg-actions"><SubmitButton label="Send message" busy /><SubmitButton label="Send message" disabled /></div></Specimen><Specimen title="Inline error" note="Match label and input IDs. Connect the hint and error with describedBy, and apply aria-invalid when a field needs attention."><Field label="Email" name="sg-invalid" error="Enter a complete email address."><Input name="sg-invalid" type="email" value="you@" invalid describedBy="field-sg-invalid-error" /></Field></Specimen></div>
    </Container>
  </section>

  <section id="patterns" class="calm-section" aria-labelledby="patterns-title">
    <Container width="wide">
      <h2 id="patterns-title" class="calm-heading">Content patterns.</h2><p class="calm-intro">Case studies make ownership and evidence clear. Articles support long reading. Recommendations keep the words and their author together.</p>
      <Specimen title="Project summaries and evidence" note="ProjectHero establishes context and ownership. Tldr expands the decision record. WorkList is the project index; ProjectNext links each case study to the next; CaseReview provides the pinned page shortcuts." href="/projects/ivfcryo/">
        <div class="project-page"><div class="sg-metrics">{projectPages.ivfcryo.figures.map((metric) => <Metric value={metric.value} label={metric.label} />)}</div>
        <p class="sg-note">Reported outcomes from the IVFCRYO case study. Keep a metric’s source, scope, and explanation close to the number.</p>
        <Tldr {...ivfcryoSummary} /></div>
      </Specimen>
      <div class="sg-two-up"><Specimen title="Design sheets and the artifact viewer" note="Plate shows the full design sheet at its natural aspect ratio. Open the viewer to inspect details; Escape closes it and returns focus." href="/projects/ivfcryo/"><Plate src={shipmentSheet} title="Shipment detail" alt="IVFCRYO shipment detail design sheet, showing readiness, shipment status, and tracking" caption="A real interface artifact from the IVFCRYO case study." size="half" /></Specimen><Specimen title="Recommendations" note="Use Recommendation for a named, attributed quote. The testimonials page also has a larger, centered featured treatment in light display type." href="/testimonials/">{recommendation && <Recommendation testimonial={recommendation} />}</Specimen></div>
      <Specimen title="Article prose and comparison tables" note="Articles use a focused reading measure, light chapter headings without rules, underlined links, and a section index. Tables keep their column headings and scroll horizontally when needed." href="/blog/native-lit-or-stencil/">
        <div class="article-page"><article class="article-prose prose-whimsy"><h4>Make the contract visible</h4><p>Component APIs, examples, and tests describe how shared UI behaves. A reader should be able to find the decision behind the interface.</p><p class="pullquote">Shared interfaces need shared contracts.</p><ArticleTable><thead><tr><th>Pattern</th><th>Purpose</th><th>Where it appears</th></tr></thead><tbody><tr><td>Contents navigation</td><td>Jump between sections and track reading position</td><td>Blog articles</td></tr><tr><td>Expandable summary</td><td>Read the decision record without extending the opening summary</td><td>Project pages</td></tr></tbody></ArticleTable></article></div>
      </Specimen>
      <Specimen title="Article pager" note="Older and newer links close each article, below the share links. Keep it to a small direction label and the title; arrows point the way the reader travels: left for older, right for newer. Hover and keyboard focus bring the title into the accent color and underline it." href="/blog/where-to-learn-modern-front-end/">
        <nav class="article-pager" aria-label="Article pager example">
          <a class="article-pager-link" href="/blog/the-hidden-cost-of-component-inconsistency/"><span class="article-pager-label"><span aria-hidden="true" data-link-arrow="left">←</span> Older article</span><span class="article-pager-title">What component inconsistency costs</span></a>
          <a class="article-pager-link article-pager-link--newer" href="/blog/measuring-style-guide-adoption/"><span class="article-pager-label">Newer article <span aria-hidden="true" data-link-arrow="right">→</span></span><span class="article-pager-title">Measuring style guide adoption</span></a>
        </nav>
      </Specimen>
      <Specimen title="Article resource lists" note="Give each resource its own linked name and a short description when it helps readers choose. Simple link collections can use two columns on wider screens; phones keep a single reading column." href="/blog/where-to-learn-modern-front-end/">
        <ResourceList items={[
          { name: 'CSS for JS Developers', href: 'https://css-for-js.dev/', description: 'Josh Comeau · CSS fundamentals and layout for JavaScript developers.' },
          { name: 'Total TypeScript', href: 'https://www.totaltypescript.com/', description: 'Matt Pocock · TypeScript and the types behind application APIs.' },
        ]} />
      </Specimen>
      <p class="sg-note">Visual details need a content purpose. Keep project previews on plain stages without shadows, separate sections with space rather than horizontal rules (tables and sticky bars are the exceptions), and reserve numbering for content where sequence matters.</p>
      <p class="sg-note">SiteShot, ScrollShot, and LiveEmbed support personal-project and case-study media. FidelityBand compares design stages. CodeBlock renders every code sample on the site, including article code fences (through ArticleCode), with GitHub Dark syntax highlighting, with readable comment colors, line numbers, wrapped lines, and a copy action; open any “View markup” example here to try it.</p>
    </Container>
  </section>

  <section id="tools" class="calm-section" aria-labelledby="tools-title">
    <Container width="wide">
      <h2 id="tools-title" class="calm-heading">Interactive tools.</h2><p class="calm-intro">Four explanatory illustrations, each tied to a working tool. Their controls and results share the portfolio’s type, surfaces, and action styles.</p>
      <ul class="sg-tools">{tools.map((tool) => <li><a class="sg-tool-link" href={`/tools/${tool.id}/`} aria-labelledby={`sg-tool-${tool.id}`}><ToolIllustration tool={tool.data.tool} /><h3 id={`sg-tool-${tool.id}`}>{tool.data.title}</h3><p>{tool.data.takeaway}</p><span class="editorial-link sg-tool-action" aria-hidden="true">{tool.data.action} <span data-link-arrow="up-right">↗</span></span></a></li>)}</ul>
      <div class="sg-guidance-grid"><article><h3>Inputs and choices</h3><p>The calculator and token playground use labelled sliders, each with its current value shown beside it, plus grouped choices. The Scorecard uses grouped choices with a visible selected state. Preserve the label, value, and keyboard behavior.</p></article><article><h3>Results and state</h3><p>The calculator recalculates estimates from its inputs. The Scorecard keeps answers on the page and carries them to its report in the link, so a result can be shared. The audit tool pairs findings with fixes; it is a sample interface, not a scan of the reader’s website.</p></article></div>
    </Container>
  </section>

  <section id="interaction" class="calm-section" aria-labelledby="interaction-title">
    <Container width="wide">
      <h2 id="interaction-title" class="calm-heading">Spacing, layout, and motion.</h2><p class="calm-intro">Shared widths and spacing keep pages coherent. Motion helps explain a state change or makes an available action easier to notice.</p>
      <div class="sg-guidance-grid"><article><h3>Containers and spacing</h3><p>Container provides a 24px gutter on each side. Its width caps include those gutters. Sections (calm-section) use roughly 5–8.5rem of vertical space; that space, not a rule, is what separates them.</p><dl class="sg-widths">{widths.map(([name, width, note]) => <div><dt><code>{name}</code> <span>{width}</span></dt><dd>{note}</dd></div>)}</dl></article><article><h3>Reading and responsive layout</h3><p>Article text is capped at 48rem, with a separate contents rail on desktop and an expandable index on smaller screens. Project pages combine narrower reading columns with wider interface artifacts.</p><p>Headings use fluid sizes. Page shortcuts wrap as a centered row of quiet links; the case-study shortcut bar stays pinned under the header and scrolls sideways on narrow screens. Multi-column content stacks when its reading space gets too tight; data tables keep a horizontal scroller rather than dropping their headers.</p></article></div>
      <div class="sg-guidance-grid"><article><h3>Entry and scroll reveal</h3><p>Hero content rises 12px over 0.7 seconds with a small stagger. Sections reveal once as they enter the viewport. Content stays visible when reduced motion is requested.</p><button type="button" class="editorial-link" data-guide-replay>Replay entry motion <span aria-hidden="true" data-link-arrow="up-right">↗</span></button><div class="sg-motion-sample" data-guide-motion><strong>Clear, then a little character.</strong><span>Heading entrance and restrained movement.</span></div><p role="status" class="sg-motion-status" data-guide-motion-status></p></article><article><h3>Hover, focus, and reading progress</h3><p>Link arrows move 3px in their pointing direction over 200ms with the shared ease-out curve, on hover and keyboard focus. Reduced motion keeps arrows still. Card-style links (article previews, related tools, resource lists) underline their title on hover and keyboard focus. A visible focus outline supports keyboard navigation. The thin page-top progress bar tracks scrolling where the browser supports scroll timelines.</p><a class="editorial-link" href="/tools/scorecard/#related-title">Try the related-tool links <span aria-hidden="true" data-link-arrow="up-right">↗</span></a></article></div>
      <div class="sg-guidance-grid"><article><h3>Designed for paper</h3><p>Print uses one centered 70ch measure for body content and headings, with no narrower text limits inside it. Hanken headings, generous page margins and spacing, white surfaces, and a small identity and source line keep the document coherent. Whitespace separates sections; horizontal section rules are omitted. Screen navigation, share controls, and decorative effects are omitted. Headings stay with their content; tables repeat their column headings and code wraps to the page width.</p></article><article><h3>Complete, readable snapshots</h3><p>Disclosures expand for print and return to their previous state afterward. Case-study artwork fits within a sheet, live demos use their poster images, and external links receive numbered references. Tools retain current answers, values, and results. The downloadable résumé keeps its separate document layout.</p></article></div>
      <div class="sg-guidance-grid"><article><h3>Navigation, dialogs, and clipboard</h3><p>The skip link is the first keyboard stop. Mobile navigation uses a native modal dialog with large, light primary links, supporting destinations, and a Contact me link. It contains keyboard focus, locks background scrolling, closes on an outside click or Escape, and returns focus to the menu button. Artifact dialogs also support Escape dismissal. The artifact viewer restores focus to its trigger. Code and article-share actions announce clipboard success or failure.</p></article><article><h3>Optional inspection features</h3><p>Alt/Option plus hover reveals source information on elements with <code>data-source</code>. The layout inspector is activated with <kbd>↑ ↑ ↓ ↓ ← → ← → B A</kbd>; Escape dismisses it. These are optional inspection aids, separate from normal site navigation.</p></article></div>
    </Container>
  </section>

  <section id="components" class="calm-section" aria-labelledby="components-title">
    <Container width="wide">
      <h2 id="components-title" class="calm-heading">The component index.</h2><p class="calm-intro">{componentCatalogue.length} components reached by the site’s pages. Each entry links to a page that uses it; examples created only for this guide are excluded.</p>
      <p class="sg-note">Shared CSS patterns such as <code>action-link</code>, <code>editorial-link</code>, <code>calm-title</code>, <code>calm-heading</code>, and <code>calm-section</code> are documented above. Run <code>npm run audit:components</code> to check production usage and this index.</p>
      <div class="sg-catalogue">{groups.map((group) => <details class="sg-catalogue-group"><summary>{group.label}<span>{componentCatalogue.filter((component) => component.group === group.id).length} <span aria-hidden="true">+</span></span></summary><ul>{componentCatalogue.filter((component) => component.group === group.id).map((component) => <li><div><h3>{component.name}</h3><p>{component.note}</p><code>{component.path}</code></div><a class="editorial-link" href={component.href} aria-label={`See ${component.name} in use`}>See in use <span aria-hidden="true" data-link-arrow="up-right">↗</span></a></li>)}</ul></details>)}</div>
    </Container>
  </section>
</BaseLayout>

<script>
  const demo = document.querySelector<HTMLFormElement>('#sg-form');
  if (demo) {
    const button = demo.querySelector<HTMLButtonElement>('[data-submit]')!;
    const fields = [...demo.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')];
    const success = demo.querySelector<HTMLElement>('#sg-success')!;
    const error = demo.querySelector<HTMLElement>('#sg-error')!;
    button.disabled = false;
    demo.addEventListener('submit', (event) => {
      event.preventDefault();
      if (button.disabled) return;
      success.hidden = true;
      error.hidden = true;
      let invalid: HTMLInputElement | HTMLTextAreaElement | undefined;
      for (const field of fields) {
        const message = document.getElementById(`${field.name}-error`)!;
        const valid = field.checkValidity() && field.value.trim().length > 0;
        field.setAttribute('aria-invalid', String(!valid));
        message.hidden = valid;
        message.textContent = valid ? '' : field.type === 'email' ? 'Enter a complete email address.' : 'Add a short message.';
        if (!valid && !invalid) invalid = field;
      }
      if (invalid) { error.hidden = false; invalid.focus(); return; }
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      window.setTimeout(() => {
        button.disabled = false;
        button.removeAttribute('aria-busy');
        success.hidden = false;
        success.focus();
      }, 1000);
    });
  }
  const replay = document.querySelector<HTMLButtonElement>('[data-guide-replay]');
  const motion = document.querySelector<HTMLElement>('[data-guide-motion]');
  const motionStatus = document.querySelector<HTMLElement>('[data-guide-motion-status]');
  replay?.addEventListener('click', () => {
    if (!motion || !motionStatus) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    motionStatus.textContent = reduced ? 'Reduced motion is enabled. The sample stays still.' : 'Replaying the entry animation.';
    if (reduced) return;
    motion.classList.remove('sg-motion-replay');
    requestAnimationFrame(() => requestAnimationFrame(() => motion.classList.add('sg-motion-replay')));
  });
</script>
