---
import ProjectLayout from '~/layouts/ProjectLayout.astro';
import ProjectHero from '~/components/patterns/ProjectHero.astro';
import ProjectNext from '~/components/patterns/ProjectNext.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import LiveEmbed from '~/components/patterns/LiveEmbed.astro';
import SiteShot from '~/components/patterns/SiteShot.astro';
import CaseReview from '~/components/patterns/CaseReview.astro';

const description =
  'Case study: building Rudiment UI, an open-source React component library and 13-chapter guide that explains the reasoning behind each architectural decision.';


/**
 * The live Storybook stories, in order. `id` drives both URLs: the embed loads the
 * bare story (iframe.html), while "open" goes to the full Storybook so the sidebar
 * and docs come with it.
 */
const liveStories = [
  {
    id: 'examples-project-management-board--board',
    title: 'Project board',
    blurb:
      'A Kanban board of draggable issue cards across four sprint columns, with WIP-limit warnings. Cards can be dragged with a keyboard as well as a mouse.',
    poster: '/images/projects/rudiment-ui/rudiment-board.webp',
    posterAlt:
      'Rudiment UI project board story: a Kanban board with To Do, In Progress, In Review, and Done columns of issue cards showing priority and story points',
  },
  {
    id: 'examples-project-management-dashboard--dashboard',
    title: 'Sprint dashboard',
    blurb:
      'An analytics page with stat tiles, a burndown line chart, a work-by-status donut, and team workload meters.',
    poster: '/images/projects/rudiment-ui/rudiment-dashboard.webp',
    posterAlt:
      'Rudiment UI sprint dashboard story: committed, completed, remaining, and velocity stat tiles above a sprint burndown chart, a work-by-status donut, and team workload meters',
  },
  {
    id: 'examples-ecommerce-landing-page--landing-page',
    title: 'Ecommerce landing page',
    blurb:
      'A marketing storefront: sticky navigation, a full-bleed hero, and a shop-by-room product grid.',
    poster: '/images/projects/rudiment-ui/rudiment-ecommerce-landing.webp',
    posterAlt:
      'Rudiment UI ecommerce landing page story: a furniture storefront with a navigation bar, full-bleed hero, and a shop-by-room product grid',
  },
];

const tokenTiers = [
  {
    icon: 'ph:paint-bucket',
    title: 'Global tokens · raw palette',
    desc: 'Raw values with no meaning attached.',
    code: 'color.blue.500 = #3B82F6',
  },
  {
    icon: 'ph:tag',
    title: 'Semantic tokens · assigned meaning',
    desc: 'Names that describe intent, such as brand or danger. A rebrand only changes this layer.',
    code: 'color.brand.primary → color.blue.500',
  },
  {
    icon: 'ph:puzzle-piece',
    title: 'Component tokens · scoped values',
    desc: 'Values for a single component, so it can be adjusted without affecting others.',
    code: 'button.background.default → color.brand.primary',
  },
];

const a11yList = [
  { icon: 'ph:keyboard', text: 'Full keyboard operability via React Aria' },
  { icon: 'ph:target', text: 'Focus traps & restoration in overlays' },
  { icon: 'ph:megaphone', text: 'ARIA semantics on every component' },
  { icon: 'ph:magnifying-glass', text: 'vitest-axe checks in every test run' },
  { icon: 'ph:squares-four', text: 'Eight intrinsic layout primitives' },
  { icon: 'ph:eye', text: 'Contrast verified against token values' },
];

const chapters = [
  { num: '01', title: 'Architectural decisions (no code)' },
  { num: '02', title: 'Token system design' },
  { num: '03', title: 'Styling strategy' },
  { num: '04', title: 'Accessibility primitives' },
  { num: '05', title: 'Layout primitives' },
  { num: '06', title: 'Component patterns' },
  { num: '07', title: 'Design tokens in DTCG format' },
  { num: '08', title: 'Style Dictionary configuration' },
  { num: '09', title: 'React Aria integration' },
  { num: '11', title: 'Testing accessibility contracts' },
  { num: '12', title: 'Build & packaging workflow' },
];

const guideChecks = [
  'Architecture, tokens, primitives, components, tests, publishing',
  'Companion GitHub repo with a complete working implementation',
];

const storybookChecks = [
  'Live components built on React Aria & Tailwind CSS 4',
  'Token-driven theming visible across every story',
  'a11y & interaction addons wired in out of the box',
];

const proof = [
  { label: 'Skills', items: ['CRUD development', 'Accessible component APIs', 'Front-end architecture', 'UI/UX design', 'Style guide documentation', 'Theming'] },
  { label: 'Stack', items: ['React', 'React Aria', 'Storybook', 'Design tokens', 'Tailwind CSS 4'] },
  { label: 'Quality', items: ['Keyboard operability', 'Focus management', 'ARIA semantics', 'Token contrast checks'] },
  { label: 'Outcomes', items: ['13 shipped chapters', '3 example pages built from the library', 'Two live deployed sites: guide + Storybook'] },
];
---

<ProjectLayout title="Rudiment UI | Joshua Briley" description={description}>

  <ProjectHero project="rudiment" />

  <CaseReview links={[
    { href: '#examples', label: 'Working examples' },
    { href: '#tokens', label: 'Token architecture' },
    { href: '#accessibility', label: 'Behavior and tests' },
    { href: '#explore', label: 'Guide and Storybook' },
  ]} />

  <Section id="examples" tone="paper" padding="default" aria-label="Live Storybook examples">
    <Container width="wide">
      <Heading level={2} visual="h2" class="max-w-[24ch]">
        Example pages built with the library
      </Heading>
      <Text tone="muted" class="mt-4 max-w-2xl">
        A sprint board, an analytics dashboard, and a storefront, built entirely from
        Rudiment components. These are live Storybook stories, so you can load one and
        use it.
      </Text>

      <div class="mt-12 space-y-16">
        {liveStories.map((story) => (
          <div>
            <div class="mb-6 flex items-baseline gap-3 border-t border-line pt-4">
              <div>
                <p class="font-medium text-ink">{story.title}</p>
                <Text tone="muted" size="sm" class="mt-1 max-w-xl">{story.blurb}</Text>
              </div>
            </div>
            <LiveEmbed
              posterSrc={story.poster}
              posterAlt={story.posterAlt}
              href={`https://rudiment-ui.netlify.app/?path=/story/${story.id}`}
              title={story.title}
              embedSrc={`https://rudiment-ui.netlify.app/iframe.html?id=${story.id}&viewMode=story`}
            />
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" aria-label="Field guide">
    <Container width="wide">
      <Heading level={2} visual="h2" class="max-w-[24ch]">
        The guide
      </Heading>
      <Text tone="muted" class="mt-4 max-w-2xl">
        Thirteen chapters that go from an empty directory to a published, accessible
        library built on design tokens. Each chapter explains its decisions and the
        alternatives that were ruled out.
      </Text>
      <div class="mt-9">
        <SiteShot
          src="/images/projects/rudiment-ui/rudiment-guide.webp"
          alt="The Rudiment field guide: a 13-chapter walkthrough to building a component library"
          href="https://rudiment-guide.netlify.app/"
          label="rudiment-guide.netlify.app"
          index="01"
        />
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="tight" aria-label="Scope and results" class="project-scope">
    <Container width="content">
      <p class="mono-label mb-8">Scope and results</p>
      <dl class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {proof.map((group) => (
          <div class="border-t border-line pt-4">
            <dt class="mono-label mb-3">{group.label}</dt>
            <dd>
              <ul class="space-y-1.5">
                {group.items.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-ink-muted leading-relaxed">
                    <Icon name="ph:check" size={14} class="mt-0.5 shrink-0 text-accent" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </Container>
  </Section>

  <Section tone="paper" padding="tight" class="project-context">
    <Container width="content">


      <Text size="lg" tone="muted" class="mt-10 measure">
        Rudiment UI is a personal reference project, showing component architecture and documentation rather than enterprise adoption or production application scale. Most of the component
        libraries I've been brought in to fix had the same root cause:
        architectural decisions that nobody wrote down, made in the wrong order,
        and now taking a quarter's work to untangle. Rudiment UI is the library I
        wish those teams had started with, built chapter by chapter with the
        reasoning documented.
      </Text>
    </Container>
  </Section>

  <Section id="problem" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">
            Why component libraries break down
          </Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-6 measure space-y-5 text-ink-muted leading-relaxed text-lg">
            <p>
              Component libraries usually degrade through many small compromises
              until they stop working as a system. A missing semantic
              token layer turns a rebrand into hundreds of manual renames. An
              undecided styling strategy turns a refactor into a full rewrite.
              Accessibility bolted on after launch always costs more than
              accessibility designed in from day one.
            </p>
            <p>
              These mistakes are usually expensive because they were
              <strong class="text-ink font-semibold">made implicitly</strong>: in a stand-up,
              a PR comment, or a rushed sprint. Rudiment UI makes the structural
              decisions first, before writing code, and documents each choice with
              its consequences.
            </p>
            <p>
              Chapter 1 of the guide contains no code. It covers the decisions a team
              should make <em>before</em> choosing a CSS strategy.
            </p>
          </div>

        </div>
      </div>
    </Container>
  </Section>

  <Section id="tokens" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">
            A three-tier token system
          </Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-6 measure space-y-5 text-ink-muted leading-relaxed text-lg">
            <p>
              Most token systems collapse because they try to do two jobs in one
              layer: hold raw values <em>and</em> express design intent.
              Rudiment separates those jobs across three tiers, each referencing
              the one beneath it, so a rebrand changes one file and a change to one
              component doesn't affect the rest of the library.
            </p>
          </div>

          <div class="mt-10 border-t border-line">
            {tokenTiers.map((tier) => (
              <div class="border-b border-line py-5">
                <div class="flex items-start gap-4">
                  <Icon name={tier.icon} size={26} class="mt-1 flex-shrink-0 text-ink-muted" />
                  <div>
                    <Heading level={3} visual="h4" tone="ink">{tier.title}</Heading>
                    <p class="mb-3 mt-1 text-ink-muted leading-relaxed">{tier.desc}</p>
                    <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">{tier.code}</code>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <p class="mt-10 measure text-ink-muted leading-relaxed text-lg">
            Token files use the Design Tokens Community Group format, flow
            through Style Dictionary v4, and land in Tailwind CSS 4 via
            <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">@theme inline</code>, so changing one value updates every component that uses it.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="accessibility" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">
            Accessibility with React Aria
          </Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-6 measure space-y-5 text-ink-muted leading-relaxed text-lg">
            <p>
              Interactive components need a lot of accessibility behavior. A modal
              alone needs focus trapping, scroll locking,
              escape-key handling, focus restoration, and
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">aria-modal</code>
              management. Instead of rebuilding that for each component, Rudiment
              uses React Aria, maintained by Adobe's design system team, for the
              behavior layer.
            </p>
            <p>
              React Aria owns keyboard navigation, focus management, ARIA
              semantics, pointer normalization, and i18n. Tailwind CSS 4 handles
              the visuals. The two layers stay cleanly separated, which is what
              lets the library re-skin without touching any behavior.
            </p>
            <p>
              Tests then lock in that separation. Layout primitives are verified
              against the tokens and classes they emit. UI components are
              verified against their
              <em>accessibility contract</em>: keyboard activation, disabled and
              error states, focus behavior, loading-state ARIA, and zero
              axe-core violations. Tests query by role and text, never by class
              name, so refactors don't silently break coverage.
            </p>
          </div>

          <div class="mt-10 rounded-lg border border-line p-6 md:p-8">
            <p class="mono-label mb-5">Accessibility features</p>
            <ul class="grid gap-x-8 gap-y-3 text-ink-muted sm:grid-cols-2">
              {a11yList.map((item) => (
                <li class="flex items-center gap-3">
                  <Icon name={item.icon} size={20} class="flex-shrink-0 text-ink-muted" />
                  {item.text}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="chapters" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">
            Guide chapters
          </Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-6 measure space-y-5 text-ink-muted leading-relaxed text-lg">
            <p>
              The chapters follow the order the decisions need to be made. The token
              layer has to be settled before component decisions, the component API
              has to be stable before tests are useful, and the build workflow has to
              keep every tier in sync before the library is published.
            </p>
          </div>

          <ul class="mt-10 rounded-lg border border-line">
            {chapters.slice(0, 9).map((c) => (
              <li class="flex items-center gap-4 border-b border-line px-5 py-3.5">
                <span class="font-mono text-[0.75rem] text-accent">{c.num}</span>
                <span class="text-sm text-ink">{c.title}</span>
              </li>
            ))}
            <li class="border-b border-line">
              <a
                href="https://rudiment-ui.netlify.app/"
                target="_blank"
                rel="noopener"
                class="group flex items-center gap-4 px-5 py-3.5 text-ink transition-colors hover:text-accent"
              >
                <span class="font-mono text-[0.75rem] text-accent">10</span>
                <span class="flex-1 text-sm">Storybook documentation</span>
                <Icon name="ph:arrow-up-right" size={14} class="text-accent opacity-0 transition-opacity group-hover:opacity-100" />
              </a>
            </li>
            {chapters.slice(9).map((c) => (
              <li class="flex items-center gap-4 border-b border-line px-5 py-3.5">
                <span class="font-mono text-[0.75rem] text-accent">{c.num}</span>
                <span class="text-sm text-ink">{c.title}</span>
              </li>
            ))}
            <li class="flex items-center gap-4 px-5 py-3.5">
              <span class="font-mono text-[0.75rem] text-accent">13</span>
              <span class="text-sm text-ink">Publishing to npm</span>
            </li>
          </ul>

          <Heading level={3} visual="h3" tone="ink" class="mt-16 mb-6">
            What the guide provides
          </Heading>
          <div class="grid gap-6 md:grid-cols-3">
            <div class="border-t border-line pt-5">
              <Icon name="ph:compass" size={28} class="mb-3 text-ink-muted" />
              <Heading level={4} visual="h4" tone="ink">Explained decisions</Heading>
              <p class="mt-1 text-sm text-ink-muted leading-relaxed">
                Every decision is explained alongside the alternatives it closes
                off, so you can extend the system instead of copying it.
              </p>
            </div>
            <div class="border-t border-line pt-5">
              <Icon name="ph:stack" size={28} class="mb-3 text-ink-muted" />
              <Heading level={4} visual="h4" tone="ink">A working reference</Heading>
              <p class="mt-1 text-sm text-ink-muted leading-relaxed">
                An end-to-end library you can run, read, and pull pieces from:
                tokens, primitives, tests, publishing pipeline.
              </p>
            </div>
            <div class="border-t border-line pt-5">
              <Icon name="ph:shield-check" size={28} class="mb-3 text-ink-muted" />
              <Heading level={4} visual="h4" tone="ink">Common mistakes, explained early</Heading>
              <p class="mt-1 text-sm text-ink-muted leading-relaxed">
                Common expensive mistakes, such as shallow tokens, accessibility
                added late, and outdated docs, are explained before they become
                costly to fix.
              </p>
            </div>
          </div>

        </div>
      </div>
    </Container>
  </Section>

  <Section id="explore" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">
            Guide and Storybook
          </Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-6 measure space-y-5 text-ink-muted leading-relaxed text-lg">
            <p>
              Rudiment is deployed as two sites. The guide explains the
              architectural decisions and trade-offs chapter by chapter, and the
              Storybook shows the library those decisions produced, with every
              primitive, component, and variant.
            </p>
          </div>

          <div class="mt-10 grid gap-7 md:grid-cols-2">
            <a
              href="https://rudiment-guide.netlify.app/"
              target="_blank"
              rel="noopener"
              class="group block rounded-lg border border-line p-7 transition-colors hover:border-line-strong"
            >
              <Icon name="ph:compass" size={26} class="text-ink-muted" />
              <Heading level={3} visual="h3" tone="ink" class="mt-5">The Rudiment Guide</Heading>
              <p class="mt-1 font-mono text-xs text-ink-muted">rudiment-guide.netlify.app</p>

              <p class="mt-5 text-ink-muted leading-relaxed">
                A sequenced, decision-by-decision walkthrough: from an empty
                directory to a published, token-driven, accessible React library.
                Every choice is shown alongside the alternatives it closed off.
              </p>

              <ul class="mt-5 space-y-2 text-sm text-ink-muted">
                {guideChecks.map((c) => (
                  <li class="flex items-start gap-2">
                    <Icon name="ph:check" size={16} class="mt-0.5 flex-shrink-0 text-accent" />
                    {c}
                  </li>
                ))}
                <li class="flex items-start gap-2">
                  <Icon name="ph:check" size={16} class="mt-0.5 flex-shrink-0 text-accent" />
                  The reasoning behind each decision
                </li>
              </ul>

              <div class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-ink transition-colors group-hover:text-accent">
                Open the guide
                <Icon name="ph:arrow-up-right" size={14} class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </div>
            </a>

            <a
              href="https://rudiment-ui.netlify.app/"
              target="_blank"
              rel="noopener"
              class="group block rounded-lg border border-line p-7 transition-colors hover:border-line-strong"
            >
              <Icon name="ph:cube" size={26} class="text-ink-muted" />
              <Heading level={3} visual="h3" tone="ink" class="mt-5">The Storybook</Heading>
              <p class="mt-1 font-mono text-xs text-ink-muted">rudiment-ui.netlify.app</p>

              <p class="mt-5 text-ink-muted leading-relaxed">
                The deployed component library as an interactive reference:
                layout primitives, form controls, overlays, and every variant
                the guide produces, with controls and docs on each story.
              </p>

              <ul class="mt-5 space-y-2 text-sm text-ink-muted">
                {storybookChecks.map((c) => (
                  <li class="flex items-start gap-2">
                    <Icon name="ph:check" size={16} class="mt-0.5 flex-shrink-0 text-accent" />
                    {c}
                  </li>
                ))}
              </ul>

              <div class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-ink transition-colors group-hover:text-accent">
                Browse the Storybook
                <Icon name="ph:arrow-up-right" size={14} class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </div>
            </a>
          </div>

          <p class="mt-10 text-center text-sm text-ink-muted">
            Read a chapter, then open the matching story. The guide and the
            library are meant to be used side by side.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <ProjectNext project="rudiment" />

</ProjectLayout>
