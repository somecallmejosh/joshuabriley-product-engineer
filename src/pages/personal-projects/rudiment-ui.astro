---
import ProjectLayout from '~/layouts/ProjectLayout.astro';
import ProjectHero from '~/components/patterns/ProjectHero.astro';
import ProjectNext from '~/components/patterns/ProjectNext.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import CodeBlock from '~/components/patterns/CodeBlock.astro';
import Plate from '~/components/patterns/Plate.astro';
import Tldr from '~/components/patterns/Tldr.astro';
import CaseReview from '~/components/patterns/CaseReview.astro';
import LiveEmbed from '~/components/patterns/LiveEmbed.astro';
import { rudimentSummary as tldr } from '~/lib/project-summaries';
import type { ImageMetadata } from 'astro';

const title = 'Rudiment UI | Joshua Briley';
const description =
  'Case study: an accessible React component library on React Aria and three-tier design tokens, tested by building 26 pages across four example apps.';

// Copy throughout comes from notes/rudiment-ui.md (Josh's write-up).
const auditLooksFor = [
  { icon: 'ph:puzzle-piece', label: 'Missing components', text: 'raw HTML standing in for a table or breadcrumb' },
  { icon: 'ph:wrench', label: 'API gaps', text: 'components that had to be styled around' },
  { icon: 'ph:drop', label: 'Leaky APIs', text: 'components that need an import from React Aria or React Stately' },
  { icon: 'ph:palette', label: 'Hardcoded values', text: 'colors and sizes not read from tokens' },
  { icon: 'ph:toolbox', label: 'Local helpers', text: 'app-built components like <code>StoreHeader</code> or <code>StatusDot</code>' },
];

const findings = [
  { title: 'Inline style was the only escape hatch.', body: 'About 476 inline <code>style</code> attributes and no <code>className</code> overrides. The components needed more props.' },
  { title: 'Typography caused the most workarounds.', body: '<code>RudiText</code> had no weight, tone or alignment, and <code>RudiHeading</code> couldn’t drop its margin, so nearly every heading carried <code>style={{ margin: 0 }}</code>.' },
  { title: 'Every app rebuilt its page shell.', body: 'Each app made its own header, footer, sidebar and page header. Both dashboards skipped <code>RudiSidebar</code>, a two-column layout, not a navigation rail.' },
  { title: 'Some components needed third-party imports.', body: '<code>RudiSelect</code> needed <code>Item</code> from <code>react-stately</code>, and menus needed internal class names like <code>rudi-menu__item-icon</code>, which had become public API by accident.' },
];

// The rows of the priority matrix in src/stories/examples/DEPARTURES.md that all four
// apps hit. Status follows notes/rudiment-ui.md, which is newer than parts of the matrix.
const gaps = [
  { gap: '<code>RudiText</code> missing weight, tone and alignment', type: 'API gap', status: 'Fixed in 0.3.0', done: true },
  { gap: '<code>RudiHeading</code> missing a margin reset', type: 'API gap', status: 'Fixed in 0.3.0', done: true },
  { gap: '<code>RudiSelect</code> needs <code>Item</code> from <code>react-stately</code>', type: 'Leaky API', status: 'Fixed in 0.3.0', done: true },
  { gap: 'App chrome: header, footer, app shell, top bar', type: 'Missing component', status: 'Built, not yet exported', done: true },
  { gap: 'Page header and section header', type: 'Missing component', status: 'Built, not yet exported', done: true },
  { gap: 'Data table', type: 'Missing component', status: 'Open', done: false },
  { gap: '<code>RudiBox</code> missing radius, surface and full-bleed props', type: 'API gap', status: 'Open', done: false },
  { gap: 'Brand and logo lockup', type: 'Missing component', status: 'Open', done: false },
  { gap: 'No class name or variant escape hatch', type: 'Systemic API gap', status: 'Open', done: false },
];

const fixes = [
  { label: 'Typography', text: '<code>weight</code>, <code>tone</code>, <code>align</code> and <code>noMargin</code> props, backed by semantic tokens.' },
  { label: 'App chrome', text: '<code>RudiAppShell</code>, <code>RudiTopBar</code>, <code>RudiFooter</code>, <code>RudiPageHeader</code> and <code>RudiSectionHeader</code> replaced each app’s own versions. They stay unexported until used outside the examples.' },
  { label: 'Leaky APIs', text: '<code>RudiOption</code> and <code>RudiMenuSeparator</code> are exported, and <code>RudiMenuItem</code> takes <code>icon</code>, <code>label</code>, <code>description</code> and <code>shortcut</code> props.' },
  { label: 'Nine new components', text: 'Breadcrumb, Divider, Dot, Image, Link, Pagination, Rating, Stepper and Textarea, each replacing a hand-built helper.' },
  { label: 'Smaller fixes', text: '<code>RudiProgressBar</code> takes <code>thresholds</code>, and charts accept <code>null</code> so a burndown line can stop mid-sprint.' },
];

const tokenTiers = [
  { name: 'Primitive', role: 'Raw values', body: 'Colors, spacing, radii, fonts and motion.', example: 'color.neutral.900' },
  { name: 'Semantic', role: 'Intent', body: 'What a value is for. Most themes only change this tier.', example: 'color.brand.primary → {color.neutral.900}' },
  { name: 'Component', role: 'One component’s values', body: 'Adjust one component without touching the rest.', example: 'component.button.primary-bg → {color.brand.primary}' },
];

const results = [
  '460 tests across 42 files, plus a browser render of every story with the accessibility addon',
  'Four of the six fix steps shipped in 0.3.0',
  'No example needs React Aria, React Stately, or an internal class name',
  'Eight themes ship as token values only',
  'The stylesheet can’t restyle anything outside Rudiment’s own classes',
];

/**
 * The live Storybook stories, in order. `id` drives both URLs: the embed loads the
 * bare story (iframe.html), while "open" goes to the full Storybook so the sidebar
 * and docs come with it.
 */
const liveStories = [
  {
    id: 'examples-project-management-board--board',
    title: 'Project board',
    blurb: 'Issue cards across four sprint columns, with WIP-limit warnings and keyboard moves.',
    poster: '/images/projects/rudiment-ui/rudiment-board.webp',
    posterAlt: 'Rudiment UI project board story: a Kanban board with To Do, In Progress, In Review, and Done columns of issue cards showing priority and story points',
  },
  {
    id: 'examples-project-management-dashboard--dashboard',
    title: 'Sprint dashboard',
    blurb: 'Stat tiles, a burndown chart, a status donut and workload meters.',
    poster: '/images/projects/rudiment-ui/rudiment-dashboard.webp',
    posterAlt: 'Rudiment UI sprint dashboard story: committed, completed, remaining, and velocity stat tiles above a sprint burndown chart, a work-by-status donut, and team workload meters',
  },
  {
    id: 'examples-ecommerce-landing-page--landing-page',
    title: 'Ecommerce landing page',
    blurb: 'A furniture storefront with a full-bleed hero and a shop-by-room grid.',
    poster: '/images/projects/rudiment-ui/rudiment-ecommerce-landing.webp',
    posterAlt: 'Rudiment UI ecommerce landing page story: a furniture storefront with a navigation bar, full-bleed hero, and a shop-by-room product grid',
  },
];

const edges = [
  {
    icon: 'ph:users-three',
    title: 'The gap list only finds my gaps',
    body: 'I wrote the library and the examples, so the audit only catches what I reach for. The biggest known gap is a data table.',
  },
  {
    icon: 'ph:paint-brush',
    title: 'Theming has a sharp edge',
    body: 'A brand color set on <code>:root</code> loses inside a themed section, so overrides must be repeated per theme. I also haven’t tested the examples with a screen reader.',
  },
];

const progressSnippet = `// src/stories/examples/project-management/Dashboard.stories.tsx
// Before: a hand-built two-div meter, because ProgressBar had one fixed color.
// After: warning fill once a team member reaches 16 points.
<RudiProgressBar
  label={w.member.name.split(' ')[0]}
  value={w.points}
  maxValue={maxWorkload}
  showValueLabel
  size="sm"
  thresholds={[
    { at: (16 / maxWorkload) * 100, variant: 'warning' },
  ]}
/>`;

const themeSnippet = `// tokens/style-dictionary.config.compressed.mjs
files: [
  {
    destination: 'tokens-compressed.css',
    format: 'css/variables',
    options: { selector: '[data-theme="compressed"]', outputReferences: true },
    filter: (token) => {
      const category = token.path[0]
      if (category === 'color' || category === 'font' || category === 'motion') return false
      return true
    },
  },
],`;

// Screenshots of the local Storybook (0.3.0). Story canvases at 1600px wide; the docs
// page and the workload card at 2x.
const shots = import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/rudiment-ui/*.png', { eager: true });
const shot = (slug: string) => shots[`../../assets/projects/rudiment-ui/${slug}.png`].default;

const themeShots = [
  { slug: 'theme-default', title: 'Default', alt: 'The CRM dashboard in the default theme.' },
  { slug: 'theme-roomy', title: 'Roomy', alt: 'The same CRM dashboard in the Roomy theme, with more space and rounder corners.' },
  { slug: 'theme-compressed', title: 'Compressed', alt: 'The same CRM dashboard in the Compressed theme, with tight spacing.' },
];
---

<ProjectLayout title={title} description={description}>

  <ProjectHero project="rudiment" />

  <CaseReview links={[{ href: '#tldr', label: 'Summary' }, { href: '#method', label: 'Example apps' }, { href: '#fixes', label: 'Fixes' }, { href: '#tokens', label: 'Themes' }, { href: '#outcomes', label: 'Results' }, { href: '#engineering', label: 'Engineering' }, { href: '#edges', label: 'Limitations' }]} />

  <Tldr
    problem={tldr.problem}
    decision={tldr.decision}
    evidence={tldr.evidence}
  />

  <Section tone="paper" padding="default" id="method" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Example apps</Heading>
        </div>
        <div class="case-layout__body">
          <Text size="lg" tone="muted" class="mt-8 measure">
            I built four apps that need different things from the library: a biotech marketing site, a
            CRM, a project tracker and a storefront. Then I recorded every place their code left the
            library.
          </Text>

          <div class="mt-10 rounded-lg border border-line p-6 md:p-8">
            <p class="mono-label mb-5">The audit looked for</p>
            <ul class="space-y-3">
              {auditLooksFor.map((item) => (
                <li class="flex items-start gap-3 text-ink-muted">
                  <Icon name={item.icon} size={20} class="mt-0.5 shrink-0 text-ink-muted" />
                  <span><strong class="font-medium text-ink">{item.label}:</strong> <Fragment set:html={item.text} /></span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-12">
            <p class="mono-label mb-6">What it found</p>
            <ul class="space-y-6">
              {findings.map((f) => (
                <li>
                  <Heading level={3} visual="h3" tone="ink" class="mb-1.5">{f.title}</Heading>
                  <Text size="sm" tone="muted"><Fragment set:html={f.body} /></Text>
                </li>
              ))}
            </ul>
          </div>

          <Heading level={3} visual="h3" tone="ink" class="mt-12 mb-3">Ranked by how many apps hit it</Heading>
          <Text size="lg" tone="muted" class="measure">
            Typography props came first: the cheapest fix that removed the most workarounds.
          </Text>

          <figure class="mt-8">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-line">
                  <th scope="col" class="mono-label py-3 pr-4 font-normal">Gap</th>
                  <th scope="col" class="mono-label hidden py-3 pr-4 font-normal sm:table-cell">Type</th>
                  <th scope="col" class="mono-label py-3 font-normal">Status</th>
                </tr>
              </thead>
              <tbody>
                {gaps.map((g) => (
                  <tr class="border-b border-line align-top">
                    <td class="py-3 pr-4 text-ink"><Fragment set:html={g.gap} /></td>
                    <td class="hidden py-3 pr-4 text-ink-muted sm:table-cell">{g.type}</td>
                    <td class:list={['py-3', g.done ? 'text-ink' : 'text-ink-muted']}>{g.status}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <figcaption class="mt-4 text-sm text-ink-muted">
              Gaps all four apps hit. Fourteen more were hit by one to three.
            </figcaption>
          </figure>
        </div>
      </div>
    </Container>

    <Container width="wide" class="mt-16">
      <Plate title="Sketch: project board" caption="Redrawn from the shipped story." src={shot('sketch-board')} alt="A hand-drawn sketch of the project board example: a sidebar with project navigation, a top bar with the sprint and search, a WIP-limit warning, and four columns of issue cards labeled To Do, In Progress, In Review and Done." />
    </Container>

    <Container width="wide" class="mt-16">
      <Plate title="Example source" caption="Each example page shows its full source in the docs." src={shot('example-source')} alt="A Storybook docs page for the CRM dashboard example, with the rendered page above its full source code." />
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="fixes" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Fixing the library</Heading>
        </div>
        <div class="case-layout__body">
          <Text size="lg" tone="muted" class="mt-8 measure">
            Each fix went into the library first. A workaround counted as fixed only once the example
            code that needed it was gone.
          </Text>

          <ul class="mt-8 space-y-4">
            {fixes.map((f) => (
              <li class="flex items-start gap-3 leading-relaxed text-ink-muted">
                <Icon name="ph:check" size={16} class="mt-1 shrink-0 text-accent" />
                <span><strong class="font-medium text-ink">{f.label}:</strong> <Fragment set:html={f.text} /></span>
              </li>
            ))}
          </ul>

          <div class="mt-10">
            <CodeBlock
              filename="Dashboard.stories.tsx"
              lang="tsx"
              code={progressSnippet}
              caption="The workload meter now uses the library’s progress bar, so it keeps an accessible name and value."
            />
          </div>
        </div>
      </div>
    </Container>

    <Container width="wide" class="mt-16">
      <ul class="grid gap-x-8 gap-y-14 md:grid-cols-2">
        <li>
          <Plate size="half" title="Workload thresholds" caption="Fill color follows the percentage." src={shot('workload-thresholds')} alt="Team workload meters on the sprint dashboard: Avery at 100% and Mei at 90% show the warning color, and the members below 16 points use the default fill." />
        </li>
      </ul>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="tokens" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Token themes</Heading>
        </div>
        <div class="case-layout__body">
          <Text size="lg" tone="muted" class="mt-8 measure">
            Every visual value is a <code>--rudi-</code> CSS custom property in one of three tiers.
            Components read only the semantic and component tiers.
          </Text>

          <ol class="mt-12 space-y-8">
            {tokenTiers.map((tier, i) => (
              <li class="flex items-start gap-5">
                <span class="mono-label mt-1 shrink-0 text-accent">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <Heading level={3} visual="h3" tone="ink" class="mb-1.5">{tier.name} · {tier.role}</Heading>
                  <Text size="sm" tone="muted">{tier.body}</Text>
                  <p class="mt-2 text-sm"><code>{tier.example}</code></p>
                </div>
              </li>
            ))}
          </ol>

          <div class="mt-12 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Rudiment ships eight themes: default, dark, and Roomy, Soft and Compressed, each with a
              dark version. In 0.3.0 I deleted every theme override from eleven component
              stylesheets, so a theme is only token values.
            </p>
            <p>
              Each theme is a Style Dictionary build that re-emits only the tokens it changes.
              Compressed changes spacing and radius:
            </p>
          </div>

          <div class="mt-10">
            <CodeBlock
              filename="style-dictionary.config.compressed.mjs"
              lang="js"
              code={themeSnippet}
              caption="Colors and fonts fall through to the default theme."
            />
          </div>

          <Text size="lg" tone="muted" class="mt-10 measure">
            A <code>data-theme</code> attribute works on any element, so a dark sidebar can sit in a
            light page. Charts read tokens too and update when the theme changes.
          </Text>
        </div>
      </div>
    </Container>

    <Container width="wide" class="mt-16">
      <Heading level={3} visual="h3" tone="ink" class="mb-8">One dashboard, three themes</Heading>
      <ul class="grid gap-x-8 gap-y-14 md:grid-cols-3">
        {themeShots.map((s) => (
          <li>
            <Plate size="half" title={s.title} src={shot(s.slug)} alt={s.alt} />
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="outcomes" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Results</Heading>
        </div>
        <div class="case-layout__body">
          <Text size="lg" tone="muted" class="mt-8 measure">
            No one else has built with Rudiment yet, so these come from my own examples and tests.
          </Text>

          <ul class="mt-8 space-y-3">
            {results.map((item) => (
              <li class="flex items-start gap-3 text-ink">
                <Icon name="ph:check" size={16} class="mt-1 shrink-0 text-accent" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" aria-label="Live examples">
    <Container width="wide">
      <Heading level={2} visual="h2" tone="ink" class="mb-3">Live examples</Heading>
      <Text tone="muted" class="max-w-2xl">Load a Storybook story to use it.</Text>

      <div class="mt-12 space-y-16">
        {liveStories.map((story) => (
          <div>
            <div class="mb-6 pt-4">
              <p class="font-medium text-ink">{story.title}</p>
              <Text tone="muted" size="sm" class="mt-1 max-w-xl">{story.blurb}</Text>
            </div>
            <LiveEmbed
              posterSrc={story.poster}
              posterAlt={story.posterAlt}
              href={`https://rudiment-ui.netlify.app/?path=/story/${story.id}`}
              title={story.title}
              embedSrc={`https://rudiment-ui.netlify.app/iframe.html?id=${story.id}&viewMode=story`}
            />
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="engineering" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Engineering</Heading>
        </div>
        <div class="case-layout__body">
          <Heading level={3} visual="h3" tone="ink" class="mt-8 mb-3">Accessibility and testing</Heading>
          <div class="measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              React Aria handles keyboard, focus, ARIA roles and pointer input; Rudiment owns the look
              and the API. That’s why buttons take <code>onPress</code> and <code>onChange</code>
              returns a value, not an event.
            </p>
            <p>
              Every component’s tests cover rendering, input, and disabled, loading and error states,
              then run axe. Tests query by role and text, never class name, so restyling can’t break
              them.
            </p>
          </div>

          <Heading level={3} visual="h3" tone="ink" class="mt-12 mb-3">Packaging</Heading>
          <Text size="lg" tone="muted" class="measure">
            The package uses BEM classes like <code>rudi-button--primary</code>, with no Tailwind,
            reset or bare element selectors, so it can’t restyle the host app. React Aria stays
            external, and a <code>'use client'</code> banner lets Next.js Server Components import it
            directly.
          </Text>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="edges" class="scroll-mt-24">
    <Container width="content">
      <Heading level={2} visual="h2" tone="ink" class="mb-10">Limitations</Heading>
      <ul class="grid gap-x-10 gap-y-10 md:grid-cols-2">
        {edges.map((e) => (
          <li class="pt-5">
            <Icon name={e.icon} size={24} class="mb-3 text-ink-muted" />
            <Heading level={3} visual="h3" tone="ink" class="mb-1.5">{e.title}</Heading>
            <Text size="sm" tone="muted"><Fragment set:html={e.body} /></Text>
          </li>
        ))}
      </ul>
      <p class="mt-14 measure text-sm text-ink-muted leading-relaxed">
        I also wrote the <a href="https://rudiment-guide.netlify.app/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-accent">13-chapter Rudiment Guide</a>
        on component library architecture.
      </p>
    </Container>
  </Section>

  <ProjectNext project="rudiment" />

</ProjectLayout>
