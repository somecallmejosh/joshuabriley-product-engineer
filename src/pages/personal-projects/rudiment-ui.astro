---
import ProjectLayout from '~/layouts/ProjectLayout.astro';
import ProjectHero from '~/components/patterns/ProjectHero.astro';
import ProjectNext from '~/components/patterns/ProjectNext.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import LiveEmbed from '~/components/patterns/LiveEmbed.astro';
import CaseReview from '~/components/patterns/CaseReview.astro';

const description =
  'Building Rudiment UI: a token-driven React component library with accessible interaction patterns, live Storybook documentation, and composed interface examples.';


/**
 * The live Storybook stories, in order. `id` drives both URLs: the embed loads the
 * bare story (iframe.html), while "open" goes to the full Storybook so the sidebar
 * and docs come with it.
 */
const liveStories = [
  {
    id: 'examples-project-management-board--board',
    title: 'Project board',
    blurb:
      'A Kanban board of draggable issue cards across four sprint columns, with WIP-limit warnings. Cards can be dragged with a keyboard as well as a mouse.',
    poster: '/images/projects/rudiment-ui/rudiment-board.webp',
    posterAlt:
      'Rudiment UI project board story: a Kanban board with To Do, In Progress, In Review, and Done columns of issue cards showing priority and story points',
  },
  {
    id: 'examples-project-management-dashboard--dashboard',
    title: 'Sprint dashboard',
    blurb:
      'An analytics page with stat tiles, a burndown line chart, a work-by-status donut, and team workload meters.',
    poster: '/images/projects/rudiment-ui/rudiment-dashboard.webp',
    posterAlt:
      'Rudiment UI sprint dashboard story: committed, completed, remaining, and velocity stat tiles above a sprint burndown chart, a work-by-status donut, and team workload meters',
  },
  {
    id: 'examples-ecommerce-landing-page--landing-page',
    title: 'Ecommerce landing page',
    blurb:
      'A marketing storefront: sticky navigation, a full-bleed hero, and a shop-by-room product grid.',
    poster: '/images/projects/rudiment-ui/rudiment-ecommerce-landing.webp',
    posterAlt:
      'Rudiment UI ecommerce landing page story: a furniture storefront with a navigation bar, full-bleed hero, and a shop-by-room product grid',
  },
];

const tokenTiers = [
  {
    icon: 'ph:paint-bucket',
    title: 'Global tokens · raw palette',
    desc: 'Raw values with no meaning attached.',
    code: 'color.blue.500 = #3B82F6',
  },
  {
    icon: 'ph:tag',
    title: 'Semantic tokens · assigned meaning',
    desc: 'Names that describe intent, such as brand or danger. A rebrand only changes this layer.',
    code: 'color.brand.primary → color.blue.500',
  },
  {
    icon: 'ph:puzzle-piece',
    title: 'Component tokens · scoped values',
    desc: 'Values for a single component, so it can be adjusted without affecting others.',
    code: 'button.background.default → color.brand.primary',
  },
];

const a11yList = [
  { icon: 'ph:keyboard', text: 'Full keyboard operability via React Aria' },
  { icon: 'ph:target', text: 'Focus traps & restoration in overlays' },
  { icon: 'ph:megaphone', text: 'ARIA semantics on every component' },
  { icon: 'ph:magnifying-glass', text: 'vitest-axe checks in every test run' },
  { icon: 'ph:squares-four', text: 'Eight intrinsic layout primitives' },
  { icon: 'ph:eye', text: 'Contrast verified against token values' },
];

const storybookChecks = [
  'Live components built on React Aria & Tailwind CSS 4',
  'Token-driven theming visible across every story',
  'a11y & interaction addons wired in out of the box',
];

const proof = [
  { label: 'Skills', items: ['Accessible component APIs', 'Front-end architecture', 'UI/UX design', 'Storybook documentation', 'Theming'] },
  { label: 'Stack', items: ['React', 'React Aria', 'Storybook', 'Design tokens', 'Tailwind CSS 4'] },
  { label: 'Quality', items: ['Keyboard operability', 'Focus management', 'ARIA semantics', 'Token contrast checks'] },
  { label: 'Implementation', items: ['Three-tier token architecture', '3 featured pages composed from the library', 'Live component documentation in Storybook'] },
];
---

<ProjectLayout title="Rudiment UI | Joshua Briley" description={description}>

  <ProjectHero project="rudiment" />

  <CaseReview links={[
    { href: '#examples', label: 'Working examples' },
    { href: '#tokens', label: 'Token architecture' },
    { href: '#accessibility', label: 'Behavior and tests' },
    { href: '#explore', label: 'Explore Storybook' },
  ]} />

  <Section id="examples" tone="paper" padding="default" aria-label="Live Storybook examples">
    <Container width="wide">
      <Heading level={2} visual="h2" class="max-w-[24ch]">
        Example pages built with the library
      </Heading>
      <Text tone="muted" class="mt-4 max-w-2xl">
        A sprint board, an analytics dashboard, and a storefront, built entirely from
        Rudiment components. These are live Storybook stories, so you can load one and
        use it.
      </Text>

      <div class="mt-12 space-y-16">
        {liveStories.map((story) => (
          <div>
            <div class="mb-6 flex items-baseline gap-3 pt-4">
              <div>
                <p class="font-medium text-ink">{story.title}</p>
                <Text tone="muted" size="sm" class="mt-1 max-w-xl">{story.blurb}</Text>
              </div>
            </div>
            <LiveEmbed
              posterSrc={story.poster}
              posterAlt={story.posterAlt}
              href={`https://rudiment-ui.netlify.app/?path=/story/${story.id}`}
              title={story.title}
              embedSrc={`https://rudiment-ui.netlify.app/iframe.html?id=${story.id}&viewMode=story`}
            />
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="tight" aria-label="Scope and results" class="project-scope">
    <Container width="content">
      <p class="calm-label mb-8">Scope and results</p>
      <dl class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {proof.map((group) => (
          <div class="pt-4">
            <dt class="calm-label mb-3">{group.label}</dt>
            <dd>
              <ul class="space-y-1.5">
                {group.items.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-ink-muted leading-relaxed">
                    <Icon name="ph:check" size={14} class="mt-0.5 shrink-0 text-accent" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </Container>
  </Section>

  <Section tone="paper" padding="tight" class="project-context">
    <Container width="content">


      <Text size="lg" tone="muted" class="mt-10 measure">
        I designed and built Rudiment UI as a personal reference library for React
        interfaces. Storybook brings the implementation together: component APIs,
        visual variants, interaction states, and examples that show how the pieces
        work in a complete interface.
      </Text>
    </Container>
  </Section>

  <Section id="problem" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">
            Making components work together
          </Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-6 measure space-y-5 text-ink-muted leading-relaxed text-lg">
            <p>
              A component needs to hold up on its own and alongside the rest of the
              library. A button can look right in isolation while its spacing,
              focus behavior, or styling becomes awkward inside a form or toolbar.
            </p>
            <p>
              Rudiment UI combines component stories with composed interface
              examples. The board, dashboard, and storefront show how the same
              tokens, layout primitives, and controls work together across
              different kinds of pages. Storybook gives readers a place to inspect
              those details and try the interactions directly.
            </p>
          </div>

        </div>
      </div>
    </Container>
  </Section>

  <Section id="tokens" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">
            A three-tier token system
          </Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-6 measure space-y-5 text-ink-muted leading-relaxed text-lg">
            <p>
              Most token systems collapse because they try to do two jobs in one
              layer: hold raw values <em>and</em> express design intent.
              Rudiment separates those jobs across three tiers, each referencing
              the one beneath it, so a rebrand changes one file and a change to one
              component doesn't affect the rest of the library.
            </p>
          </div>

          <div class="mt-10">
            {tokenTiers.map((tier) => (
              <div class="py-5">
                <div class="flex items-start gap-4">
                  <Icon name={tier.icon} size={26} class="mt-1 flex-shrink-0 text-ink-muted" />
                  <div>
                    <Heading level={3} visual="h4" tone="ink">{tier.title}</Heading>
                    <p class="mb-3 mt-1 text-ink-muted leading-relaxed">{tier.desc}</p>
                    <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">{tier.code}</code>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <p class="mt-10 measure text-ink-muted leading-relaxed text-lg">
            Token files use the Design Tokens Community Group format, flow
            through Style Dictionary v4, and land in Tailwind CSS 4 via
            <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">@theme inline</code>, so changing one value updates every component that uses it.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="accessibility" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">
            Accessibility with React Aria
          </Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-6 measure space-y-5 text-ink-muted leading-relaxed text-lg">
            <p>
              Interactive components need a lot of accessibility behavior. A modal
              alone needs focus trapping, scroll locking,
              escape-key handling, focus restoration, and
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">aria-modal</code>
              management. Instead of rebuilding that for each component, Rudiment
              uses React Aria, maintained by Adobe's design system team, for the
              behavior layer.
            </p>
            <p>
              React Aria owns keyboard navigation, focus management, ARIA
              semantics, pointer normalization, and i18n. Tailwind CSS 4 handles
              the visuals. The two layers stay cleanly separated, which is what
              lets the library re-skin without touching any behavior.
            </p>
            <p>
              Tests then lock in that separation. Layout primitives are verified
              against the tokens and classes they emit. UI components are
              verified against their
              <em>accessibility contract</em>: keyboard activation, disabled and
              error states, focus behavior, loading-state ARIA, and zero
              axe-core violations. Tests query by role and text, never by class
              name, so refactors don't silently break coverage.
            </p>
          </div>

          <div class="mt-10 rounded-lg border border-line p-6 md:p-8">
            <p class="calm-label mb-5">Accessibility features</p>
            <ul class="grid gap-x-8 gap-y-3 text-ink-muted sm:grid-cols-2">
              {a11yList.map((item) => (
                <li class="flex items-center gap-3">
                  <Icon name={item.icon} size={20} class="flex-shrink-0 text-ink-muted" />
                  {item.text}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="explore" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">
            Explore the implementation
          </Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-6 measure space-y-5 text-ink-muted leading-relaxed text-lg">
            <p>
              Storybook is the live reference for the library. Browse layout
              primitives, form controls, overlays, and visual variants, then open
              the example pages to see them composed into interfaces.
            </p>
          </div>
          <ul class="mt-8 space-y-3 text-ink-muted">
            {storybookChecks.map((item) => (
              <li class="flex items-start gap-3">
                <Icon name="ph:check" size={16} class="mt-1 shrink-0 text-accent" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a
            href="https://rudiment-ui.netlify.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="action-link mt-8"
          >
            Explore Storybook <span aria-hidden="true" data-link-arrow="up-right">↗</span>
          </a>
          <p class="mt-10 measure text-sm text-ink-muted leading-relaxed">
            I also wrote the separate <a href="https://rudiment-guide.netlify.app/" target="_blank" rel="noopener noreferrer" class="text-link">13-chapter Rudiment Guide</a>,
            a walkthrough of component-library architecture.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <ProjectNext project="rudiment" />

</ProjectLayout>
