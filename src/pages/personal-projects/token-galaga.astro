---
import ProjectLayout from '~/layouts/ProjectLayout.astro';
import ProjectHero from '~/components/patterns/ProjectHero.astro';
import ProjectNext from '~/components/patterns/ProjectNext.astro';
import CaseReview from '~/components/patterns/CaseReview.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import LiveEmbed from '~/components/patterns/LiveEmbed.astro';

const title = 'Token Adventure | Joshua Briley';
const description =
  'Case study: Token Adventure, a browser game that teaches the W3C Design Tokens Format (2025.10). You write tokens in a CodeMirror editor, the game runs them in a sandboxed iframe, and an assertion engine checks your code against the spec across 20 levels. A companion to Rudiment UI.';

const proof = [
  {
    label: 'Skills',
    items: [
      'Interactive learning & curriculum design',
      'In-browser code execution & sandboxing',
      'Test-harness engineering',
      'W3C Design Tokens Format',
      'Accessibility engineering',
      'Motion design',
    ],
  },
  {
    label: 'Stack',
    items: ['Astro 5', 'React island', 'CodeMirror', 'Sandboxed iframe', 'axe-core', 'Netlify'],
  },
  {
    label: 'Quality',
    items: [
      'Faithful to the stable 2025.10 spec',
      'Grading based on spec rules, such as resolved aliases',
      'Reduced-motion honored on every effect',
      'astro check and a clean build before each release',
    ],
  },
  {
    label: 'Outcomes',
    items: ['20 sectors across three arcs', 'A serializable assertion engine', 'Companion to Rudiment UI'],
  },
];

const docket = [
  { href: '#why', icon: 'ph:game-controller', label: 'Why a game' },
  { href: '#what', icon: 'ph:browsers', label: 'How it works' },
  { href: '#engine', icon: 'ph:test-tube', label: 'The assertion engine' },
  { href: '#curriculum', icon: 'ph:path', label: 'Curriculum' },
  { href: '#a11y', icon: 'ph:heart', label: 'Accessibility' },
  { href: '#craft', icon: 'ph:sparkle', label: 'Visual design and motion' },
];

// The arc colors describe the product's own difficulty coding (cyan / yellow /
// magenta in the game). Darkened here so they clear WCAG AA on the paper surface.
const arcs = [
  {
    label: 'Arc I',
    rank: 'Beginner',
    blurb: 'The foundations: why tokens exist, the file, naming, color, groups, consuming.',
    color: '#0E7490',
    sectors: [
      { num: '01', title: 'The Hardcoded Hellscape', teaches: 'Why tokens exist: a named decision gets one home' },
      { num: '02', title: 'The Registry Awakens', teaches: 'tokens.json, $value and $type' },
      { num: '03', title: "The Cartographer's Codex", teaches: 'Naming and path rules' },
      { num: '04', title: 'Color the 2025 Way', teaches: 'Object-form color: colorSpace, components, alpha, hex' },
      { num: '05', title: 'Forge a Group', teaches: 'Groups and $type inheritance' },
      { num: '06', title: 'Self-Documenting Tokens', teaches: '$description' },
      { num: '07', title: 'Reading the Registry', teaches: 'Consuming semantic tokens' },
    ],
  },
  {
    label: 'Arc II',
    rank: 'Intermediate',
    blurb: 'Relationships and composites: aliases, layering, types, and the composite shapes.',
    color: '#B45309',
    sectors: [
      { num: '08', title: 'Echoes and Aliases', teaches: 'Alias references' },
      { num: '09', title: 'Three-Tier Architecture', teaches: 'Global, semantic, and component layers' },
      { num: '10', title: 'Types of the Realm', teaches: 'Token types and their canonical value shapes' },
      { num: '11', title: 'Composite Constructs', teaches: 'The typography composite' },
      { num: '12', title: 'Border Composite', teaches: 'The border composite' },
      { num: '13', title: 'Shadow Composite', teaches: 'Shadow, including multi-shadow arrays' },
      { num: '14', title: 'Gradient and Transition', teaches: 'The gradient and transition composites' },
    ],
  },
  {
    label: 'Arc III',
    rank: 'Expert',
    blurb: 'Production, theming, and audit: the pipeline, integrity, color spaces, migration, the boss.',
    color: '#A21CAF',
    sectors: [
      { num: '15', title: 'The Translation Pipeline', teaches: 'tokens.json to CSS custom properties' },
      { num: '16', title: 'Alias Integrity', teaches: 'Detecting dangling and circular references' },
      { num: '17', title: 'Color Spaces', teaches: 'Color spaces and wide-gamut output' },
      { num: '18', title: 'Theming and Modes', teaches: 'Modes as a tooling convention, flagged as not in the spec' },
      { num: '19', title: 'The Great Reformation', teaches: 'Migrating a legacy file to 2025.10' },
      { num: '20', title: 'Audit the Library', teaches: 'The final audit boss' },
    ],
  },
];

const loop = [
  { icon: 'ph:chat-circle-text', title: 'An NPC frames the problem', text: 'A story panel states the real failure the concept prevents: a brand color hardcoded in five places, a dangling alias that locks a team out of a build.' },
  { icon: 'ph:code', title: 'You write real code', text: 'A CodeMirror editor with the right language modes (JSON for tokens.json, plus CSS, HTML, and JS where the sector calls for it). Only the tabs a sector needs are shown.' },
  { icon: 'ph:browsers', title: 'It runs in a sandbox', text: 'The host builds an srcdoc document from your editor and loads it with sandbox="allow-scripts" and no same-origin access, so player code cannot reach the host page.' },
  { icon: 'ph:test-tube', title: 'A test runner grades it', text: 'Assertions are posted into the iframe over postMessage, evaluated against the live DOM and your parsed token tree, then posted back. Pass them all and the wave clears.' },
  { icon: 'ph:medal', title: 'You earn rewards', text: 'XP, a badge, and a pilot-log entry that distills the lesson into a reusable snippet. Clear a full arc and a celebration interstitial fires.' },
];

const architecture = [
  { icon: 'ph:lightning', text: 'Astro 5 renders the static surfaces (star chart, story panels, one route per sector). No client JS ships for these.' },
  { icon: 'ph:cube', text: 'One React island carries the sector runner: editor, sandbox, and test list. It loads only on quest pages.' },
  { icon: 'ph:shield-check', text: 'The sandbox is an iframe srcdoc with sandbox="allow-scripts". Player code cannot reach the host page.' },
  { icon: 'ph:arrows-left-right', text: 'The test runtime speaks to the host over postMessage, with a request-id handshake and a timeout so a broken script cannot hang the grader.' },
  { icon: 'ph:eye', text: 'axe-core is pulled into the sandbox to run real accessibility audits against the player’s rendered output.' },
  { icon: 'ph:database', text: 'Progress is saved in localStorage. There is no backend and no account.' },
];

const domChecks = [
  { name: 'selectorExists · tagName · notTagName', text: 'Structure and semantics' },
  { name: 'computedStyle', text: 'Resolved CSS values: exact, regex, or one-of a set' },
  { name: 'contrast', text: 'WCAG contrast ratios (AA normal, AA large, AAA)' },
  { name: 'axe', text: 'Runs axe-core, optionally scoped to specific rule ids' },
  { name: 'keyboardReachable', text: 'Tab-order reachability' },
  { name: 'hasAttribute · textMatches', text: 'ARIA and content' },
];

const tokenChecks = [
  { name: 'tokenJsonValid', text: 'Confirms it parses at all' },
  { name: 'tokenHasPath · tokenFieldEquals', text: 'Structure and field values' },
  { name: 'tokenTypeMatches', text: 'Honors $type inheritance from ancestor groups' },
  { name: 'tokenAliasResolves', text: 'Follows {alias} reference chains to a final value' },
  { name: 'cssVarFromToken', text: 'Reads a CSS custom property to confirm a token wired through' },
];

const a11yBuilt = [
  { icon: 'ph:person-simple-run', text: 'Every motion effect gated behind prefers-reduced-motion' },
  { icon: 'ph:app-window', text: 'Celebration modal: role="dialog", aria-modal, focus management' },
  { icon: 'ph:keyboard', text: 'Escape and backdrop dismissal, background scroll lock' },
  { icon: 'ph:cursor', text: 'Parallax disables itself on coarse and touch pointers' },
  { icon: 'ph:eye', text: 'Sectors grade output with the same contrast math the app holds itself to' },
  { icon: 'ph:check-square', text: 'Sectors run axe and keyboardReachable against the player’s UI' },
];

const feel = [
  { icon: 'ph:television-simple', title: 'A CRT boot sequence', text: 'A one-shot scanline sweep across the cabinet plus a marquee-title power-on flicker, built in CSS and the Web Animations API.' },
  { icon: 'ph:sun', title: 'Dual-layer neon glow', text: 'A tight tube core plus a soft bloom, over a corner-vignetted field, so lit elements look like neon tubes instead of flat drop shadows.' },
  { icon: 'ph:rocket-launch', title: 'Animated star chart', text: 'A scout ship follows the mission route via CSS offset-path while a nebula drifts opposite the cursor through a transform-only, rAF-throttled handler.' },
];
---

<ProjectLayout title={title} description={description}>

  <ProjectHero project="tokens" />
  <CaseReview links={docket} />

  <Section id="game" tone="paper" padding="default" aria-label="The game, live">
    <Container width="wide">
      <Heading level={2} visual="h2" class="max-w-[24ch]">
        Live game
      </Heading>
      <Text tone="muted" class="mt-4 max-w-2xl">
        Pick a sector from the star chart, write your tokens, run them in the sandbox, and clear the
        sector when every check passes. You can load the game below and play it on this page.
      </Text>
      <div class="mt-9">
        <LiveEmbed
          posterSrc="/images/projects/token-galaga/token-galaga.webp"
          posterAlt="Token Adventure: a retro arcade cabinet UI with a pilot dossier, a high score, and a 'Press Start' to begin the design-tokens curriculum"
          embedSrc="https://token-galaga.netlify.app/"
          href="https://token-galaga.netlify.app/"
          title="Token Adventure"
          ratio="1600 / 1005"
          ctaNote="the live, playable game"
        />
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="tight" aria-label="Scope and results" class="project-scope">
    <Container width="content">
      <p class="calm-label mb-8">Scope and results</p>
      <dl class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {proof.map((group) => (
          <div class="pt-4">
            <dt class="calm-label mb-3">{group.label}</dt>
            <dd>
              <ul class="space-y-1.5">
                {group.items.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-ink-muted leading-relaxed">
                    <Icon name="ph:check" size={14} class="mt-0.5 shrink-0 text-accent" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </Container>
  </Section>

  <Section tone="paper" padding="tight" class="project-context">
    <Container width="content">


      <Text size="lg" tone="muted" class="mt-10 measure">
        I came up with the idea while playing Galaga Wars on my phone. Watching the ship rank up wave
        after wave, I realized I should be leveling up on the W3C Design Tokens Format instead. It had
        just become stable at version 2025.10, and I wanted to understand it properly instead of
        skimming it. The spec is useful but a dry read, so I built a game around it.
      </Text>
      <Text size="lg" tone="muted" class="mt-6 measure">
        Each sector you clear covers one more part of the spec, and your code has to pass a real grader
        to clear it, so finishing the game shows you can apply the format.
      </Text>
    </Container>
  </Section>

  <Section id="why" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Why a game</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Design tokens are table stakes for any serious design system, but the W3C format is hard
              to internalize from the source material. The spec is precise by necessity:
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">$value</code>,
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">$type</code>,
              group inheritance, aliases, composite types. That precision makes it a good reference but
              hard to learn from: after reading it, you know the terms but not how to apply them.
            </p>
            <p>
              In the game, you learn aliases by
              <strong class="text-ink font-semibold">using one to clear a sector</strong>. Each rule is a
              sector you can't pass until your code applies it, the fixed sequence gives you a path, and
              pass-or-fail results tell you what to fix. By the end, you have written spec-correct tokens
              yourself.
            </p>
          </div>

        </div>
      </div>
    </Container>
  </Section>

  <Section id="what" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">How it works</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Token Adventure looks like a deep-space arcade cabinet. You select sectors from a star
              chart, clear waves, log intel to a pilot log, and rank up from Recruit to Ace. Under that
              presentation, every sector is a small coding exercise. The preview shows your code
              running, and a pass means your tokens meet the spec.
            </p>
          </div>

          <ol class="mt-10 space-y-4">
            {loop.map((s, i) => (
              <li class="flex gap-4 pt-4">
                <span class="font-mono text-[0.75rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
                <div class="flex items-start gap-3">
                  <Icon name={s.icon} size={22} class="mt-0.5 shrink-0 text-ink-muted" />
                  <div>
                    <p class="font-medium text-ink">{s.title}</p>
                    <p class="mt-1 text-sm text-ink-muted leading-relaxed">{s.text}</p>
                  </div>
                </div>
              </li>
            ))}
          </ol>

          <div class="mt-12 rounded-lg border border-line p-6 md:p-8">
            <p class="calm-label mb-5">Architecture</p>
            <ul class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
              {architecture.map((a) => (
                <li class="flex items-start gap-3 text-sm text-ink-muted leading-relaxed">
                  <Icon name={a.icon} size={18} class="mt-0.5 shrink-0 text-ink-muted" />
                  <span>{a.text}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="engine" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">The assertion engine</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Grading the exercises means inspecting code that runs in an isolated sandbox the host page
              can't reach directly. The solution is a fully <strong class="text-ink font-semibold">serializable assertion DSL</strong>: every
              check is a plain data object, so it crosses the
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">postMessage</code>
              boundary into the sandbox, runs there against the live DOM and parsed token tree, and
              returns a plain result.
            </p>
          </div>

          <div class="mt-10 grid gap-7 md:grid-cols-2">
            <div class="rounded-lg border border-line p-6">
              <Heading level={3} visual="h4" tone="ink" class="mb-4">DOM &amp; accessibility checks</Heading>
              <ul class="space-y-3">
                {domChecks.map((c) => (
                  <li class="pt-3 first:-0 first:pt-0">
                    <code class="font-mono text-[0.78rem] text-ink">{c.name}</code>
                    <p class="mt-0.5 text-sm text-ink-muted">{c.text}</p>
                  </li>
                ))}
              </ul>
            </div>
            <div class="rounded-lg border border-line p-6">
              <Heading level={3} visual="h4" tone="ink" class="mb-4">Design-token checks</Heading>
              <ul class="space-y-3">
                {tokenChecks.map((c) => (
                  <li class="pt-3 first:-0 first:pt-0">
                    <code class="font-mono text-[0.78rem] text-ink">{c.name}</code>
                    <p class="mt-0.5 text-sm text-ink-muted">{c.text}</p>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="mt-10 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              The design-token checks follow the spec's rules instead of matching text.
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">tokenAliasResolves</code>
              doesn&rsquo;t look for the string
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">{'{color.brand.primary}'}</code>
              in your file. It follows the reference chain the way a translation tool would and checks
              the resolved value, so players can't pass by pattern-matching.
            </p>
            <p>
              The final sector is a broken tokens.json file with four realistic 2025.10 violations, and
              the player has to find and fix all four. It is the closest the game gets to real design
              system work.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="curriculum" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Curriculum</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Twenty sectors are grouped into three arcs, in the order the spec has to be learned:
              foundations first, then aliases and composite types, then build, theming, migration, and
              audit work. You
              can&rsquo;t reason about aliases until you can name a single token, and you can&rsquo;t audit
              a broken library until you understand the types it&rsquo;s supposed to honor.
            </p>
          </div>

          <div class="mt-10 space-y-10">
            {arcs.map((arc) => (
              <div>
                <div class="mb-4 flex items-center gap-3">
                  <span class="h-2.5 w-2.5 rounded-[2px]" style={`background:${arc.color}`} aria-hidden="true"></span>
                  <span class="text-sm font-medium" style={`color:${arc.color}`}>{arc.label}</span>
                  <span class="text-sm text-ink-muted">{arc.rank}</span>
                </div>
                <p class="mb-4 max-w-2xl text-sm text-ink-muted leading-relaxed">{arc.blurb}</p>
                <ul class="rounded-lg border border-line">
                  {arc.sectors.map((s) => (
                    <li class="flex items-center gap-4 px-5 py-3">
                      <span class="font-mono text-[0.75rem] text-accent">{s.num}</span>
                      <span class="flex-1">
                        <span class="block text-sm font-medium text-ink">{s.title}</span>
                        <span class="block text-sm text-ink-muted">{s.teaches}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

        </div>
      </div>
    </Container>
  </Section>

  <Section id="a11y" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Accessibility</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Token Adventure builds accessibility into the game and also teaches it.
              <strong class="text-ink font-semibold">In the game itself</strong>, every motion effect
              becomes static under
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">prefers-reduced-motion</code>,
              and the celebration interstitial is a real dialog with focus management, Escape and backdrop
              dismissal, and a scroll lock.
            </p>
            <p>
              <strong class="text-ink font-semibold">In the lessons</strong>, several sectors grade the player&rsquo;s rendered output with
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">axe</code>,
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">contrast</code>, and
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">keyboardReachable</code>
              assertions, holding the player to the same WCAG AA ratios and axe-core rules the app holds
              itself to. You learn to ship tokens that produce accessible interfaces.
            </p>
          </div>

          <div class="mt-10 rounded-lg border border-line p-6 md:p-8">
            <p class="calm-label mb-5">Accessibility features</p>
            <ul class="grid gap-x-8 gap-y-3 text-ink-muted sm:grid-cols-2">
              {a11yBuilt.map((item) => (
                <li class="flex items-start gap-3 text-sm leading-relaxed">
                  <Icon name={item.icon} size={18} class="mt-0.5 shrink-0 text-ink-muted" />
                  <span>{item.text}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="craft" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <Heading level={2} visual="display-md" tone="ink">Visual design and motion</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              The arcade is built entirely from CSS and the Web Animations API, with no game loop and no
              canvas. The constraint was deliberate: keep the bundle small and the Core Web Vitals clean
              while still feeling like an arcade game. Difficulty is color-coded throughout, cyan for
              beginner, yellow for intermediate, and magenta for expert, so color always signals which
              arc you are in.
            </p>
          </div>

          <div class="mt-10 grid gap-6 sm:grid-cols-2">
            {feel.map((f) => (
              <div class="pt-5">
                <Icon name={f.icon} size={28} class="mb-3 text-ink-muted" />
                <Heading level={3} visual="h4" tone="ink" class="mb-1">{f.title}</Heading>
                <Text size="sm" tone="muted">{f.text}</Text>
              </div>
            ))}
          </div>

          <div class="mt-12 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              The game is built on the same kind of token system it teaches: three tiers, with light,
              dark, and high-contrast modes, matching the architecture in sector 9.
            </p>
            <p>
              Because the refresh was motion-heavy, I built a precision feedback loop instead of eyeballing
              changes: a headless-Chrome screenshot harness captures every key screen at desktop and mobile
              for before-and-after diffing, and a
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">?nomotion</code>
              escape hatch freezes the reveal animations so full-page captures show the settled layout. I
              also held the source to zero em-dashes and en-dashes anywhere, verified by grep, and shipped
              only after <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">astro check</code>
              and a clean build pass.
            </p>
          </div>

          <div class="mt-12 measure leading-relaxed text-ink-muted text-lg">
            <p>
              Token Adventure is a companion to
              <a href="/personal-projects/rudiment-ui/" class="text-link">Rudiment UI</a>. This game
              teaches the token format, and Rudiment UI shows how to build a component library on top of
              those tokens.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <ProjectNext project="tokens" />

</ProjectLayout>
