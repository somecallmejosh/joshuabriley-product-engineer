---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import ContactInvitation from '~/components/patterns/ContactInvitation.astro';
import { projectPages } from '~/lib/project-pages';
const projects = [
  { ...projectPages.rudiment, href: '/personal-projects/rudiment-ui/' },
  { ...projectPages.tokens, href: '/personal-projects/token-galaga/' },
];
---
<BaseLayout title="Personal projects | Joshua Briley" description="Working reference projects in component architecture and design tokens: Rudiment UI and Token Adventure.">
  <section class="page-opener">
    <Container width="wide">
      <p class="role-line hero-in hero-in-1">Personal projects</p>
      <h1 class="page-type hero-in hero-in-2">Ideas you can<br /><em>put to work.</em></h1>
      <p class="page-lede hero-in hero-in-3">Reference implementations and experiments in components and design tokens. Read the decisions, try the interfaces, and see how they work.</p>
    </Container>
  </section>
  <section class="editorial-section work-section" aria-label="Personal project details">
    <Container width="wide">
      <div class="work-list">
        {projects.map(project => <article class="work-entry" data-reveal>
          <a href={project.href} class="work-image work-image--rudiment" aria-label={`Explore ${project.name}`}><img src={project.image} alt={project.alt} width="1600" height="1000" loading="lazy" decoding="async" /><span class="work-image-arrow" aria-hidden="true">↗</span></a>
          <div class="work-copy"><p class="work-kind">{project.kind}</p><h2 class="project-index-name"><a href={project.href}>{project.name}</a></h2><p class="work-title">{project.headline} {project.emphasis}</p><p class="work-summary">{project.intro}</p><a class="editorial-link mt-5" href={project.href}>Explore the project <span aria-hidden="true">↗</span></a></div>
        </article>)}
      </div>
    </Container>
  </section>
  <ContactInvitation />
</BaseLayout>
<style>.project-index-name { margin-top: .75rem; font-size: clamp(2.2rem, 3.5vw, 3.3rem); font-weight: 800; letter-spacing: -.045em; line-height: 1.05; } .project-index-name a:hover { color: var(--accent); }</style>
