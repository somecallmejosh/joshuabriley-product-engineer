---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import { projectPages } from '~/lib/project-pages';
const projects = [
  { ...projectPages.rudiment, href: '/personal-projects/rudiment-ui/' },
  { ...projectPages.tokens, href: '/personal-projects/token-galaga/' },
];
---
<BaseLayout title="Personal projects | Joshua Briley" description="Working reference projects in component architecture and design tokens: Rudiment UI and Token Adventure.">
  <section class="calm-open">
    <Container>
      <p class="calm-label hero-in hero-in-1">Personal projects</p>
      <h1 class="calm-title hero-in hero-in-2">Things I build on my own time.</h1>
      <p class="calm-lede hero-in hero-in-3">Reference implementations and experiments in components and design tokens. Read the decisions, try the interfaces, and see how they work.</p>
    </Container>
  </section>
  <section class="index-work" aria-label="Personal project details">
    <Container width="wide">
      <div class="work-grid">
        {projects.map(project => <article class="work-card">
          <a href={project.href} class="home-plate work-card-plate" tabindex="-1" aria-hidden="true"><img src={project.image} alt="" width="1600" height="1000" loading="lazy" decoding="async" /></a>
          <p class="work-card-kind">{project.kind}</p>
          <h2 class="work-card-title"><a href={project.href}><strong>{project.name}.</strong> {project.headline} {project.emphasis}</a></h2>
          <p class="work-card-result">{project.intro}</p>
          <a class="editorial-link work-card-link" href={project.href}>Explore the project <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
        </article>)}
      </div>
    </Container>
  </section>
</BaseLayout>
<style>.work-card-link { margin-top: 1.25rem; }</style>
