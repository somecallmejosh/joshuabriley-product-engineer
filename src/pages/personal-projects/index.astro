---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import ScrapMosaic from '~/components/patterns/scrapbook/ScrapMosaic.astro';
import { personalProjects, personalProjectOrder, type PersonalProject } from '~/lib/personal-projects';
import '~/styles/scrapbook.css';

const projects: PersonalProject[] = personalProjectOrder.map((key) => personalProjects[key]);
---
<BaseLayout title="Personal projects | Joshua Briley" description="Things Joshua Briley makes for the fun of it: a journal with a drawing for every thinking trap, a household budget, a React component library, and an arcade game about design tokens." mainClass="scrap-page">
  <section class="page-opener">
    <Container width="wide">
      <p class="role-line hero-in hero-in-1">Personal projects <span aria-hidden="true">/</span> {projects.length} so far</p>
      <h1 class="page-type hero-in hero-in-2">Things I make <em>for the fun of it.</em></h1>
      <p class="page-lede hero-in hero-in-3">These are for my own enjoyment, and for keeping up with things I can’t do in a typical job.</p>
    </Container>
  </section>
  <section aria-label="Personal projects" class="scrap-wall-section">
    <Container width="wide">
      <ul class="scrap-wall" role="list" data-reveal-stagger>
        {projects.map(({ wall, name, note, href }, i) => (
          <li class="scrap-piece">
            <a class="scrap-link" href={href}>
              <ScrapMosaic tiles={wall} eager={i < 2} />
              <h2 class="scrap-name"><span>{name}</span> <span aria-hidden="true" data-link-arrow="right">→</span></h2>
              <p class="scrap-summary">{note}</p>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </section>
</BaseLayout>
