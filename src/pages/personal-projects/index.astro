---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import ScrapMosaic from '~/components/patterns/scrapbook/ScrapMosaic.astro';
import PersonalProjectsIllustration from '~/components/patterns/PersonalProjectsIllustration.astro';
import { personalProjects, personalProjectOrder, type PersonalProject } from '~/lib/personal-projects';
import '~/styles/scrapbook.css';

const projects: PersonalProject[] = personalProjectOrder.map((key) => personalProjects[key]);
---
<BaseLayout title="Personal projects | Joshua Briley" description="Things Joshua Briley makes for the fun of it: a journal with a drawing for every thinking trap, a household budget, a React component library, and an arcade game about design tokens." mainClass="scrap-page">
  <section class="page-opener">
    <Container width="wide">
      <div class="scrap-opener hero-split">
        <div class="hero-split-copy">
          <h1 class="page-type hero-in hero-in-1">Things I make <em>for the fun of it.</em></h1>
          <p class="page-lede hero-in hero-in-2">These are for my own enjoyment, and for keeping up with things I can’t do in a typical job.</p>
        </div>
        <div class="scrap-opener-art hero-split-media hero-in hero-in-3"><PersonalProjectsIllustration /></div>
      </div>
    </Container>
  </section>
  <section aria-label="Personal projects" class="scrap-section">
    <Container width="wide">
      <div class="scrap-wall">
        {projects.map(({ wall, name, note, href }, i) => (
          <article class="scrap-piece" data-reveal>
            <a class="scrap-link" href={href}>
              <ScrapMosaic tiles={wall} eager={i < 2} />
              <h2 class="scrap-name">{name}</h2>
              <p class="scrap-note">{note}</p>
            </a>
          </article>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>
