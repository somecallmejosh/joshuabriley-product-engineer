---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import ArticleIllustration from '~/components/patterns/ArticleIllustration.astro';
import { hasIllustration } from '~/lib/article-illustrations';
import '~/styles/articles.css';

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  date: Date;
  readMinutes: number;
  pathname: string;
  headings?: { depth: number; slug: string; text: string }[];
  prevPost?: { id: string; title: string } | null;
  nextPost?: { id: string; title: string } | null;
}
const { slug, title, description, category, date, readMinutes, pathname, headings = [], prevPost, nextPost } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 && h.slug !== 'footnote-label');
const hasToc = toc.length >= 2;
const words = title.split(' ');
const emphasis = words.pop();
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const shareUrl = new URL(pathname, Astro.site ?? 'https://joshuabriley.com').toString();
const liShare = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`;
const neighbours = [
  prevPost && { ...prevPost, direction: 'Older' as const },
  nextPost && { ...nextPost, direction: 'Newer' as const },
].filter((post) => !!post);
---

<BaseLayout title={`${title} · Joshua Briley`} description={description} pathname={pathname} mainClass="article-page" article={{ publishedTime: date, section: category, author: 'Joshua Briley' }}>
  <header class="calm-open article-opener">
    <Container>
      <a class="project-back hero-in hero-in-1" href="/blog/"><span aria-hidden="true" data-link-arrow="left">←</span> All writing</a>
      <p class="calm-label article-meta hero-in hero-in-2"><span>{category}</span> <span aria-hidden="true">·</span> <time datetime={date.toISOString().slice(0, 10)}>{formattedDate}</time> <span aria-hidden="true">·</span> <span class="article-read-time">{readMinutes} min read</span></p>
      <h1 class="calm-title article-title hero-in hero-in-3">{words.join(' ')} <em>{emphasis}</em></h1>
      <p class="calm-lede hero-in hero-in-4">{description}</p>
      <div class="calm-actions hero-in hero-in-4">
        <a class="editorial-link" href="#article-body">Read article <span aria-hidden="true" data-link-arrow="down">↓</span></a>
        {hasToc && <a class="editorial-link" href="#article-contents">Browse sections <span aria-hidden="true" data-link-arrow="down">↓</span></a>}
      </div>
      {hasIllustration(slug) && <div class="article-hero-illustration hero-in hero-in-5"><ArticleIllustration post={slug} /></div>}
    </Container>
  </header>


  <div class="article-reading">
    <Container width="wide">
      <div class:list={['article-grid', !hasToc && 'article-grid--wide']}>
        {hasToc && (
          <aside class="article-rail" id="article-contents" aria-label="Article contents" tabindex="-1">
            <div class="article-rail-sticky">
              <nav class="article-desktop-toc" aria-label="On this page">
                <h2>On this page</h2>
                <ol>{toc.map((h) => <li><a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a></li>)}</ol>
              </nav>
              <details class="article-mobile-toc">
                <summary>On this page <span aria-hidden="true">+</span></summary>
                <nav aria-label="Article sections"><ol>{toc.map((h) => <li><a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a></li>)}</ol></nav>
              </details>
              <a class="article-back-top editorial-link" href="#main">Back to top <span aria-hidden="true" data-link-arrow="up">↑</span></a>
            </div>
          </aside>
        )}
        <div class="article-column">
          <article id="article-body" aria-label={title} tabindex="-1" class="prose-whimsy article-prose"><slot /></article>
          <div class="article-share" aria-label="Share this article" role="group">
            <p>Useful to your team?</p>
            <div><button type="button" class="editorial-link" data-article-copy>Copy article link <span aria-hidden="true" data-link-arrow="up-right">↗</span></button><a class="editorial-link" href={liShare} target="_blank" rel="noopener noreferrer">Share on LinkedIn <span aria-hidden="true" data-link-arrow="up-right">↗</span></a></div>
            <p class="article-copy-status" role="status" data-article-copy-status></p>
          </div>
          {neighbours.length > 0 && (
            <nav class="article-pager" aria-label="More writing">
              {neighbours.map((post) => (
                <a class:list={['article-pager-link', post.direction === 'Newer' && 'article-pager-link--newer']} href={`/blog/${post.id}/`} rel={post.direction === 'Older' ? 'prev' : 'next'}>
                  <span class="article-pager-label">
                    {post.direction === 'Older' && <span aria-hidden="true" data-link-arrow="left">←</span>}
                    {post.direction} article
                    {post.direction === 'Newer' && <span aria-hidden="true" data-link-arrow="right">→</span>}
                  </span>
                  <span class="article-pager-title">{post.title}</span>
                </a>
              ))}
            </nav>
          )}
        </div>
      </div>
    </Container>
  </div>

</BaseLayout>

<script>
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const setActive = (id: string) => {
    tocLinks.forEach((link) => {
      if (link.dataset.tocLink === id) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };
  const sections = [...document.querySelectorAll<HTMLElement>('.article-prose h2[id]:not(#footnote-label)')];
  const updateActive = () => {
    let active = '';
    const readingLine = window.innerHeight * .3;
    sections.forEach((heading) => {
      if (heading.getBoundingClientRect().top <= readingLine) active = heading.id;
    });
    setActive(active);
  };
  if (tocLinks.length) {
    let scheduled = false;
    const scheduleUpdate = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => { updateActive(); scheduled = false; });
    };
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate, { passive: true });
    updateActive();
  }
  const copy = document.querySelector<HTMLButtonElement>('[data-article-copy]');
  const status = document.querySelector<HTMLElement>('[data-article-copy-status]');
  copy?.addEventListener('click', async () => {
    if (!status) return;
    try {
      await navigator.clipboard.writeText(window.location.href);
      status.textContent = 'Article link copied.';
    } catch {
      status.textContent = 'Couldn’t copy the link. You can copy it from your browser’s address bar.';
    }
  });
</script>
