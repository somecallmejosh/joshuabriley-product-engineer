---
import '~/styles/tools.css';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/layout/Container.astro';
import Icon from '~/components/primitives/Icon.astro';
import ToolIllustration from '~/components/patterns/ToolIllustration.astro';

import ScorecardEngine from '~/components/islands/ScorecardEngine.astro';
import RoiCalculator from '~/components/islands/RoiCalculator.astro';
import TokenPlayground from '~/components/islands/TokenPlayground.astro';
import Diagnostic from '~/components/islands/Diagnostic.astro';

interface RelatedTool {
  href: string;
  kind: string;
  title: string;
  takeaway: string;
  tool: 'ScorecardEngine' | 'RoiCalculator' | 'TokenPlayground' | 'Diagnostic';
}

interface Props {
  title: string;
  description: string;
  kind: string;
  tool: 'ScorecardEngine' | 'RoiCalculator' | 'TokenPlayground' | 'Diagnostic';
  props?: string[];
  instructions: string;
  pathname: string;
  date: Date;
  related?: RelatedTool[];
}

const {
  title,
  description,
  kind,
  tool,
  props: toolProps = [],
  instructions,
  pathname,
  date,
  related = [],
} = Astro.props;

// Astro resolves component imports at build time, so the island is selected
// from a static map rather than a dynamic import.
const ISLANDS = { ScorecardEngine, RoiCalculator, TokenPlayground, Diagnostic };
const Island = ISLANDS[tool];

const titleWords = title.split(' ');
const titleEnd = titleWords.pop();
const startLabels = { ScorecardEngine: 'Start the assessment', RoiCalculator: 'Use the calculator', TokenPlayground: 'Try the playground', Diagnostic: 'Inspect the examples' };

const workspaceHeadings = {
  ScorecardEngine: ['Assess your', 'shared UI.'],
  RoiCalculator: ['Put a number', 'on rework.'],
  TokenPlayground: ['See how tokens', 'shape the interface.'],
  Diagnostic: ['Inspect the UI', 'and plan a fix.'],
};
const [workspaceLead, workspaceEmphasis] = workspaceHeadings[tool];

const shareUrl = new URL(pathname, Astro.site ?? 'https://joshuabriley.com').toString();
const xShare = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(shareUrl)}`;
const liShare = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`;
---

<BaseLayout
  title={`${title} · Joshua Briley`}
  description={description}
  pathname={pathname}
  mainClass="tool-page"
  article={{ publishedTime: date, section: 'Tools', author: 'Joshua Briley' }}
>
  <section class="calm-open tool-opener">
    <Container>
      <p class="calm-label hero-in hero-in-1"><a href="/tools/">Tools</a> <span aria-hidden="true">·</span> {kind}</p>
      <h1 class="calm-title hero-in hero-in-2">{titleWords.join(' ')} <em>{titleEnd}.</em></h1>
      <p class="calm-lede hero-in hero-in-3">{description}</p>
      <div class="calm-actions hero-in hero-in-4">
        <a class="editorial-link" href="#tool">{startLabels[tool]} <span aria-hidden="true" data-link-arrow="down">↓</span></a>
        <a class="editorial-link" href="/tools/">All tools <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
      </div>
      <div class="tool-hero-illustration hero-in hero-in-5"><ToolIllustration tool={tool} /></div>
      {toolProps.length > 0 && <ul class="tool-facts">{toolProps.map((fact) => <li>{fact}</li>)}</ul>}
    </Container>
  </section>

  <section id="tool" class="tool-workspace" aria-labelledby="tool-workspace-title">
    <Container width="wide">
      <div class="tool-workspace-heading" data-reveal>
        <h2 id="tool-workspace-title" class="calm-heading">{workspaceLead} <em>{workspaceEmphasis}</em></h2>
        <p class="calm-intro tool-instructions">{instructions}</p>
      </div>
      <div class="tool-stage">
        <Island />
      </div>
    </Container>
  </section>

  <section class="calm-section">
    <Container>
      <h2 class="calm-heading">Using this tool.</h2>
      <div class="calm-column tool-reading">
        <article class="prose-whimsy"><slot /></article>
        <div class="tool-share">
          <span>Share this tool</span>
          <a href={xShare} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Share on X"><Icon name="ph:x-logo" size={17} /></a>
          <a href={liShare} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Share on LinkedIn"><Icon name="ph:linkedin-logo" size={17} /></a>
          <button type="button" class="share-btn" data-copy-link aria-label="Copy link"><Icon name="ph:link" size={17} /></button>
        </div>
      </div>
    </Container>
  </section>

  {related.length > 0 && (
    <section class="calm-section related-tools" aria-labelledby="related-title">
      <Container width="wide">
        <h2 id="related-title" class="calm-heading">Another question to explore?</h2>
        <ul class="related-list" data-reveal-stagger>
          {related.map((item) => (
            <li>
              <a class="related-tool-link" href={item.href} aria-labelledby={`related-${item.tool}`}>
                <ToolIllustration tool={item.tool} />
                <h3 id={`related-${item.tool}`}>{item.title}</h3>
                <p>{item.takeaway}</p>
                <span class="editorial-link related-tool-action" aria-hidden="true">Explore tool <span data-link-arrow="up-right">↗</span></span>
              </a>
            </li>
          ))}
        </ul>
      </Container>
    </section>
  )}
</BaseLayout>

<style>
  .tool-opener .calm-label a:hover { color: var(--ink); }
  .tool-hero-illustration { max-width: 40rem; margin: clamp(3rem, 6vw, 4.5rem) auto 0; text-align: left; }
  .tool-facts { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem 2rem; margin-top: 2rem; padding: 0; list-style: none; color: var(--ink-muted); font-size: .875rem; }
  /* The working tool keeps its tinted stage: it is the product on the page. */
  .tool-workspace { padding: clamp(4rem, 8vw, 6rem) 0; background: var(--portfolio-tint); }
  .tool-workspace-heading { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .tool-workspace-heading em { font-style: normal; color: var(--ink-muted); }
  .tool-stage { width: 100%; }
  .tool-reading :global(.prose-whimsy > h2:first-child) { margin-top: 0; }
  .tool-reading :global(.prose-whimsy h2) { font-family: var(--font-hanken), sans-serif; font-size: 1.6rem; font-weight: 400; letter-spacing: -.03em; }
  .tool-share { display: flex; align-items: center; flex-wrap: wrap; gap: .75rem; margin-top: 2.5rem; }
  .tool-share > span { margin-right: .5rem; color: var(--ink-muted); font-size: .85rem; }
  .related-list { display: grid; gap: 3.5rem 3rem; margin-top: clamp(2.5rem, 5vw, 4rem); }
  .related-list li { min-width: 0; }
  .related-tool-link { display: flex; flex-direction: column; height: 100%; }
  .related-tool-link:focus-visible { outline: 3px solid var(--portfolio-blue); outline-offset: 5px; }
  .related-tool-link:hover h3 { color: var(--accent); }
  .related-tool-action { align-self: flex-start; margin-top: auto; padding-top: 1rem; }
  .related-list h3 { margin-top: 1.5rem; max-width: 22ch; font-size: clamp(1.35rem, 1.9vw, 1.6rem); font-weight: 400; letter-spacing: -.03em; line-height: 1.2; transition: color .2s; }
  .related-list p { margin-top: .75rem; color: var(--ink-muted); font-size: 1rem; line-height: 1.6; max-width: 40ch; }
  @media (min-width: 768px) { .related-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1280px) { .related-list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
