---
interface Resource {
  name: string;
  href?: string;
  description?: string;
}
interface Props { items: Resource[]; columns?: 1 | 2; }
const { items, columns = 1 } = Astro.props;
---

<ul class:list={['reading-resources not-prose', { 'reading-resources--columns': columns === 2 }]} role="list">
  {items.map(item => <li>
    {item.href
      ? <a class="reading-resource-name" href={item.href}><span>{item.name}</span><span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
      : <strong class="reading-resource-label">{item.name}</strong>}
    {item.description && <p>{item.description}</p>}
  </li>)}
</ul>

<style>
  .reading-resources { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0 2rem; list-style: none; margin: 1.25rem 0 2.5rem; padding: 0; }
  .reading-resources > li { min-width: 0; margin: 0; padding: .75rem 0; }
  .reading-resource-name { display: flex; align-items: baseline; justify-content: space-between; gap: 1.25rem; min-height: 44px; padding-block: .4rem; color: var(--ink); font-size: 1.1rem; font-weight: 650; line-height: 1.4; text-decoration: underline; text-decoration-color: var(--line-strong); text-decoration-thickness: 1px; text-underline-offset: 5px; transition: color 200ms, text-decoration-color 200ms; }
  .reading-resource-name > span:first-child { min-width: 0; overflow-wrap: anywhere; }
  .reading-resource-name > [data-link-arrow] { color: var(--accent); }
  .reading-resource-name:hover { color: var(--accent); text-decoration-color: currentColor; }
  .reading-resource-name:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  .reading-resource-label { display: block; padding-block: .4rem; font-size: 1.1rem; line-height: 1.4; font-weight: 650; color: var(--ink); }
  .reading-resources p { margin: .15rem 0 0; font-size: 1rem; line-height: 1.6; color: var(--ink-muted); }
  @media (min-width: 640px) { .reading-resources--columns { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
