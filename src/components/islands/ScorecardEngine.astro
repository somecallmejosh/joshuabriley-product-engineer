---
import Icon from '~/components/primitives/Icon.astro';
import { SECTIONS, TOTAL_ITEMS, TOTAL_MAX } from '~/lib/scorecard';

/**
 * Five subject cards with question rows, plus floating score badge and
 * results card. Sections + question text are rendered server-side from the
 * shared scorecard module; the inline script handles live scoring, reset,
 * and URL `?r=` prefill.
 */

const headlines: Record<string, { description: string }> = {
  s1: { description: 'Check whether shared patterns have consistent APIs, behavior, and migration paths.' },
  s2: { description: 'Review keyboard access, labels, focus, contrast, and feedback in the interfaces people use.' },
  s3: { description: 'Check how shared design decisions are named, maintained, and applied to components.' },
  s4: { description: 'Review the examples and guidance an engineer needs to use the system independently.' },
  s5: { description: 'Look at how design and engineering keep shared patterns aligned through changes and releases.' },
};

const labels = [
  { v: 0, label: 'No' },
  { v: 1, label: 'Partial' },
  { v: 2, label: 'Yes' },
];
---

<div
  class="rounded-lg border border-line p-6 md:p-7 mb-12 bg-white"
  data-scorecard-totals
>
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="mono-label mb-2">Total score so far</p>
      <p class="font-serif text-5xl md:text-6xl font-semibold tracking-[-0.03em] text-ink leading-[0.85]">
        <span data-total-score>0</span><span class="text-ink-muted">/{TOTAL_MAX}</span>
      </p>
    </div>
    <div class="sm:text-right">
      <p class="mono-label mb-2">Questions answered</p>
      <p class="font-mono text-xl font-medium tabular-nums text-ink">
        <span data-answered>0</span><span class="text-ink-muted">/{TOTAL_ITEMS}</span>
      </p>
    </div>
  </div>
  <div class="meter-track mt-6">
    <div class="meter-fill" data-meter></div>
  </div>
</div>

<form id="scorecardForm" class="space-y-10" onsubmit="return false">
  {SECTIONS.map((section, idx) => (
    <article
      class="subject-card overflow-hidden"
      data-subject={section.id}
      data-total={section.max}
      data-count={section.items.length}
    >
      <div class="p-6 md:p-8 bg-white">
        <header class="mb-7 flex items-start justify-between gap-5">
          <div class="max-w-md">
            <p class="mono-label mb-2">Subject {String(idx + 1).padStart(2, '0')}</p>
            <h3 class="font-serif text-2xl md:text-[1.75rem] font-semibold tracking-[-0.018em] text-ink leading-tight mb-2">
              {section.title}
            </h3>
            <p class="text-sm text-ink-muted leading-relaxed">
              {headlines[section.id].description}
            </p>
          </div>
          <div class="grade-stamp" data-grade-stamp aria-hidden="true">-</div>
        </header>
        <div class="q-list">
          {section.items.map((item, i) => (
            <div class="q-row">
              <span class="q-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <p class="q-text" id={`question-${item.id}`}>
                <span class="sr-only">{i + 1}. </span>{item.label}
              </p>
              <div class="choice-group" role="radiogroup" aria-labelledby={`question-${item.id}`}>
                {labels.map(({ v, label }) => (
                  <label class="choice" data-v={v}>
                    <input
                      type="radio"
                      name={item.id}
                      value={v}
                      data-subject={section.id}
                    />
                    <span class="choice-bar" aria-hidden="true"></span>
                    <span class="choice-label">{label}</span>
                  </label>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </article>
  ))}
</form>

<div class="mt-10 flex flex-col sm:flex-row items-center justify-between gap-4">
  <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
    <button type="button" id="resetBtn" class="tool-control-button"><Icon name="ph:arrow-counter-clockwise" size={17} />Reset assessment</button>
    <p class="sc-reset-status" role="status">
      <span data-reset-notice hidden>Answers cleared. <button type="button" class="editorial-link" data-reset-undo>Undo</button></span>
    </p>
  </div>
  <p class="mono-label">Your final report is below</p>
</div>

<div class="mt-14">
  <div class="reveal-card">
    <div class="relative z-10">
      <p class="mono-label text-paper/80 mb-2">Your assessment</p>
      <h3 class="font-serif text-3xl md:text-4xl font-semibold tracking-[-0.018em] mb-4 leading-tight">
        <span data-result-headline>Answer every question to see your report.</span>
      </h3>
      <div class="flex flex-wrap items-end gap-x-10 gap-y-5 mb-7">
        <div>
          <p class="mono-label text-paper/80 mb-1">Overall grade</p>
          <p class="sc-final-grade font-serif font-semibold leading-[0.74] tracking-[-0.04em] text-paper" data-final-grade>-</p>
        </div>
        <div class="pb-1">
          <p class="mono-label text-paper/80 mb-1">Final score</p>
          <p class="font-serif text-4xl md:text-5xl font-medium leading-none text-paper">
            <span data-final-score>0</span><span class="text-paper/60">/{TOTAL_MAX}</span>
          </p>
        </div>
      </div>
      <p data-result-body class="text-paper/80 leading-relaxed max-w-2xl font-sans">
        Complete every question to see your subject scores and suggested priorities.
      </p>
      <div data-result-actions class="mt-8 flex flex-col sm:flex-row gap-3" hidden>
        <a id="results-link" class="action-link action-link--inverse" href="/tools/scorecard/results/">See detailed results</a>
        <a class="tool-control-button tool-control-button--light" href="/contact/">Talk through your results</a>
      </div>
    </div>
  </div>
</div>


<script>
  import { letterGrade, TOTAL_ITEMS, TOTAL_MAX, VALID_PARAM_RE, SECTIONS } from '~/lib/scorecard';

  const form = document.getElementById('scorecardForm') as HTMLFormElement | null;
  if (form) {
    const totalScoreEl = document.querySelector<HTMLElement>('[data-total-score]')!;
    const answeredEl = document.querySelector<HTMLElement>('[data-answered]')!;
    const meterEl = document.querySelector<HTMLElement>('[data-meter]')!;
    const finalScoreEl = document.querySelector<HTMLElement>('[data-final-score]')!;
    const finalGradeEl = document.querySelector<HTMLElement>('[data-final-grade]')!;
    const resultHeadline = document.querySelector<HTMLElement>('[data-result-headline]')!;
    const resultBody = document.querySelector<HTMLElement>('[data-result-body]')!;
    const resultActions = document.querySelector<HTMLElement>('[data-result-actions]')!;
    const resultsLink = document.getElementById('results-link') as HTMLAnchorElement;

    const subjectCards = Array.from(document.querySelectorAll<HTMLElement>('.subject-card'));
    const revealCard = document.querySelector<HTMLElement>('.reveal-card');

    const reduceMotion =
      typeof matchMedia === 'function' &&
      matchMedia('(prefers-reduced-motion: reduce)').matches;
    // `primed` keeps the first paint / URL-prefill calm; flourishes start after.
    let primed = false;
    let wasComplete = false;
    const numRaf = new WeakMap<HTMLElement, number>();

    /** Roll a number toward its new value (easeOutCubic). */
    function countTo(el: HTMLElement, to: number) {
      el.dataset.printValue = String(to);
      const from = parseInt(el.dataset.n ?? el.textContent ?? '0', 10) || 0;
      el.dataset.n = String(to);
      const prev = numRaf.get(el);
      if (prev) cancelAnimationFrame(prev);
      if (reduceMotion || !primed || from === to) {
        el.textContent = String(to);
        return;
      }
      const dur = 420;
      const start = performance.now();
      const step = (now: number) => {
        if (document.body.dataset.printing || window.matchMedia('print').matches) {
          el.textContent = String(to);
          return;
        }
        const t = Math.min(1, (now - start) / dur);
        el.textContent = String(Math.round(from + (to - from) * (1 - Math.pow(1 - t, 3))));
        if (t < 1) numRaf.set(el, requestAnimationFrame(step));
      };
      numRaf.set(el, requestAnimationFrame(step));
    }

    /** Replay a one-shot animation class. */
    function bump(el: HTMLElement | null, cls: string, ms: number) {
      if (reduceMotion || !primed || !el) return;
      el.classList.remove(cls);
      void el.offsetWidth;
      el.classList.add(cls);
      setTimeout(() => el.classList.remove(cls), ms);
    }

    function encodeSelections(): string {
      let encoded = '';
      for (const section of SECTIONS) {
        for (const item of section.items) {
          const checked = form!.querySelector<HTMLInputElement>(`input[name="${item.id}"]:checked`);
          encoded += checked ? checked.value : '0';
        }
      }
      return encoded;
    }

    /** Like encodeSelections, but keeps unanswered rows distinct ('-') so a
     *  half-finished draft restores exactly. */
    function encodeDraft(): string {
      let encoded = '';
      for (const section of SECTIONS) {
        for (const item of section.items) {
          const checked = form!.querySelector<HTMLInputElement>(`input[name="${item.id}"]:checked`);
          encoded += checked ? checked.value : '-';
        }
      }
      return encoded;
    }

    /** Check the radios named by an encoded string; '-' leaves a row blank. */
    function applySelections(encoded: string) {
      let idx = 0;
      for (const section of SECTIONS) {
        for (const item of section.items) {
          const value = encoded[idx++];
          const radio = form!.querySelector<HTMLInputElement>(`input[name="${item.id}"][value="${value}"]`);
          if (radio) {
            radio.checked = true;
            radio.closest('.choice')?.classList.add('is-on');
          }
        }
      }
    }

    // A refresh or stray click shouldn't cost ten minutes of answers, so the
    // draft lives in sessionStorage until the tab closes.
    const DRAFT_KEY = 'scorecard-draft';
    const DRAFT_RE = new RegExp(`^[012-]{${TOTAL_ITEMS}}$`);
    function saveDraft() {
      try {
        const draft = encodeDraft();
        if (/[012]/.test(draft)) sessionStorage.setItem(DRAFT_KEY, draft);
        else sessionStorage.removeItem(DRAFT_KEY);
      } catch { /* storage unavailable: the assessment still works */ }
    }
    function loadDraft(): string | null {
      try {
        const draft = sessionStorage.getItem(DRAFT_KEY);
        return draft && DRAFT_RE.test(draft) ? draft : null;
      } catch {
        return null;
      }
    }

    function updateScore() {
      let total = 0;
      let answered = 0;
      const subjectTotals: Record<string, number> = {};

      form!.querySelectorAll<HTMLInputElement>('input[type=radio]:checked').forEach((r) => {
        const v = parseInt(r.value, 10);
        total += v;
        answered += 1;
        const subject = r.dataset.subject!;
        subjectTotals[subject] = (subjectTotals[subject] ?? 0) + v;
      });

      countTo(totalScoreEl, total);
      answeredEl.textContent = String(answered);
      const nextWidth = `${(answered / TOTAL_ITEMS) * 100}%`;
      if (meterEl.style.width !== nextWidth) {
        meterEl.style.width = nextWidth;
        bump(meterEl, 'meter-bump', 600);
      }

      subjectCards.forEach((card) => {
        const subject = card.dataset.subject!;
        const max = parseInt(card.dataset.total!, 10);
        const totalQs = parseInt(card.dataset.count!, 10);
        const score = subjectTotals[subject] ?? 0;
        const stamp = card.querySelector<HTMLElement>('[data-grade-stamp]')!;
        const answeredInSubject = form!.querySelectorAll(
          `input[data-subject="${subject}"]:checked`,
        ).length;

        if (answeredInSubject === 0) {
          stamp.textContent = '-';
          stamp.removeAttribute('data-grade');
          stamp.removeAttribute('data-state');
          return;
        }

        if (answeredInSubject < totalQs) {
          const progressText = `${answeredInSubject}/${totalQs}`;
          if (stamp.textContent !== progressText) stamp.textContent = progressText;
          stamp.removeAttribute('data-grade');
          stamp.setAttribute('data-state', 'progress');
          return;
        }

        stamp.removeAttribute('data-state');
        const pct = (score / max) * 100;
        const g = letterGrade(pct);
        if (stamp.textContent !== g) {
          stamp.textContent = g;
          stamp.setAttribute('data-grade', g);
          stamp.style.animation = 'none';
          void stamp.offsetWidth;
          stamp.style.animation = '';
          // Celebrate a freshly-completed subject.
          bump(card, 'subject-complete', 700);
        }
      });

      countTo(finalScoreEl, total);

      if (answered === TOTAL_ITEMS) {
        const pct = (total / TOTAL_MAX) * 100;
        finalGradeEl.textContent = letterGrade(pct);

        const encoded = encodeSelections();
        resultsLink.href = `/tools/scorecard/results/?r=${encoded}`;
        resultActions.hidden = false;

        let headline: string;
        let body: string;
        if (pct >= 85) {
          headline = 'Your answers suggest a strong foundation.';
          body = 'Review the subject breakdown and check those strengths against working interfaces and recent changes.';
        } else if (pct >= 70) {
          headline = 'A few subjects need a closer look.';
          body = 'The detailed results show your scores and suggest practical checks for the lower-scoring subjects.';
        } else if (pct >= 55) {
          headline = 'There are gaps worth investigating.';
          body = 'Use the subject breakdown to choose a component, workflow, or document to review with your team.';
        } else if (pct >= 40) {
          headline = 'Several subjects need attention.';
          body = 'Review the lower-scoring subjects and verify the issues in a real workflow before planning a fix.';
        } else {
          headline = 'Start with a focused review.';
          body = 'Your answers suggest gaps across the system. The detailed results can help you choose a manageable starting point.';
        }

        resultHeadline.textContent = headline;
        resultBody.textContent = body;

        // Choreograph the unlock the first time the card fills.
        if (!wasComplete && primed) {
          bump(revealCard, 'just-unlocked', 1200);
          bump(finalGradeEl, 'grade-pop', 650);
          bump(resultActions, 'actions-in', 800);
        }
        wasComplete = true;
      } else {
        finalGradeEl.textContent = '-';
        resultActions.hidden = true;
        resultHeadline.textContent = 'Answer every question to see your report.';
        resultBody.textContent = `You're ${answered} of ${TOTAL_ITEMS} questions in. A personalized writeup appears here once you've scored every row.`;
        wasComplete = false;
      }
    }

    form.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.type !== 'radio') return;
      form.querySelectorAll<HTMLInputElement>(`input[name="${target.name}"]`).forEach((input) => {
        const label = input.closest('.choice');
        label?.classList.toggle('is-on', input.checked);
        if (input.checked && label instanceof HTMLElement && !reduceMotion) {
          label.classList.remove('choice-pop');
          void label.offsetWidth;
          label.classList.add('choice-pop');
        }
      });
      hideUndo();
      updateScore();
      saveDraft();
    });

    // Reset clears every answer at once, so it offers an undo instead of a
    // confirmation step. Any new answer retires the undo.
    const resetNotice = document.querySelector<HTMLElement>('[data-reset-notice]')!;
    let undoSnapshot: string | null = null;
    function hideUndo() {
      undoSnapshot = null;
      resetNotice.hidden = true;
    }
    function clearAnswers() {
      form.reset();
      form.querySelectorAll('.choice.is-on').forEach((el) => el.classList.remove('is-on'));
    }

    document.getElementById('resetBtn')?.addEventListener('click', () => {
      const snapshot = encodeDraft();
      if (!/[012]/.test(snapshot)) return;
      clearAnswers();
      updateScore();
      saveDraft();
      undoSnapshot = snapshot;
      resetNotice.hidden = false;
    });

    resetNotice.querySelector('[data-reset-undo]')?.addEventListener('click', () => {
      if (!undoSnapshot) return;
      applySelections(undoSnapshot);
      hideUndo();
      updateScore();
      saveDraft();
      document.getElementById('resetBtn')?.focus();
    });

    // Pre-fill from a shared ?r= link, or else from this tab's saved draft.
    const params = new URLSearchParams(window.location.search);
    const r = params.get('r');
    const draft = loadDraft();
    if (r && VALID_PARAM_RE.test(r)) applySelections(r);
    else if (draft) applySelections(draft);

    updateScore();
    primed = true;
  }
</script>

<style>
  /* De-carded subject panel: paper surface + hairline, no white fill, no
     floating colored tab. Radius pulled to the site's 8px scale. */
  .sc-reset-status { min-height: 44px; display: flex; align-items: center; font-size: .9rem; color: var(--ink-muted); }
  .sc-reset-status [data-reset-undo] { min-height: 44px; margin-left: .25rem; color: var(--ink); }

  .subject-card {
    position: relative;
    background: transparent;
    border-radius: 8px;
    border: 1px solid var(--line);
    transition: border-color 0.35s var(--ease-out);
  }
  .subject-card:hover {
    border-color: var(--line-strong);
  }

  /* Card gives a little hop when its section earns a grade. */
  .subject-card.subject-complete { animation: sc-card-celebrate 0.7s ease-out; }
  @keyframes sc-card-celebrate {
    0% { transform: translateY(0) scale(1); }
    30% { transform: translateY(-5px) scale(1.014); }
    100% { transform: translateY(0) scale(1); }
  }

  /* Each question is a row: a large number in the margin column, the question,
     and a rising scale of answers. Bars up to the chosen answer fill in, so the
     row shows its score. The number turns accent with the site's corner dot
     once the question is answered. */
  .q-row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 1.5rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--line);
  }
  .q-row:first-of-type { border-top: none; }
  .q-num {
    position: relative;
    justify-self: start;
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
    transition: color 0.3s var(--ease-out);
  }
  .q-num::after {
    content: '';
    position: absolute;
    top: 0.1em;
    right: -0.45rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    transform: scale(0);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .q-row:has(input:checked) .q-num { color: var(--accent); }
  .q-row:has(input:checked) .q-num::after { transform: scale(1); }
  .q-text {
    max-width: 62ch;
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-size: 1.0625rem;
    color: var(--ink);
    line-height: 1.55;
  }

  .choice-group {
    display: flex;
    align-items: flex-end;
    gap: 0.375rem;
  }
  .choice {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-end;
    gap: 0.5rem;
    width: 4.75rem;
    min-height: 44px;
    padding: 0.25rem 0;
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    text-align: center;
    color: var(--ink-muted);
    cursor: pointer;
    user-select: none;
    transition: color 0.2s var(--ease-out);
  }
  .choice input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .choice-bar {
    display: block;
    height: 0.5rem;
    background: color-mix(in srgb, var(--line-strong) 55%, transparent);
    transform-origin: bottom;
    transition: background-color 0.25s var(--ease-out), transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .choice[data-v='1'] .choice-bar { height: 1.125rem; }
  .choice[data-v='2'] .choice-bar { height: 1.75rem; }
  .choice:hover { color: var(--ink); }
  .choice:hover .choice-bar { background: color-mix(in srgb, var(--accent) 35%, transparent); }
  .choice-group:has(input[value='0']:checked) .choice[data-v='0'] .choice-bar,
  .choice-group:has(input[value='1']:checked) .choice:is([data-v='0'], [data-v='1']) .choice-bar,
  .choice-group:has(input[value='2']:checked) .choice-bar { background: var(--accent); }
  .choice.is-on { color: var(--accent); }
  .choice.is-on .choice-label { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .choice:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  /* Springy settle when an answer is chosen. Lands on the is-on resting transform. */
  .choice.choice-pop .choice-bar { animation: sc-choice-pop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes sc-choice-pop {
    0% { transform: scaleY(0.6); }
    60% { transform: scaleY(1.12); }
    100% { transform: scaleY(1); }
  }

  /* Quick brightness lift on the progress meter each time it advances. */
  [data-meter].meter-bump { animation: sc-meter-bump 0.6s ease-out; }
  @keyframes sc-meter-bump {
    0% { filter: brightness(1); }
    30% { filter: brightness(1.32) saturate(1.1); }
    100% { filter: brightness(1); }
  }

  /* ===== final report reveal choreography ===== */
  .reveal-card { position: relative; }
  .reveal-card.just-unlocked::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 30%,
      rgba(246, 247, 249, 0.18) 50%,
      transparent 70%
    );
    transform: translateX(-110%);
    animation: sc-sheen 1s ease-out;
  }
  @keyframes sc-sheen { to { transform: translateX(110%); } }

  .sc-final-grade {
    font-size: clamp(4.5rem, 13vw, 7rem);
  }
  [data-final-grade].grade-pop {
    display: inline-block;
    animation: sc-grade-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes sc-grade-pop {
    0% { transform: scale(0.4); opacity: 0; }
    60% { transform: scale(1.14); opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
  }

  [data-result-actions].actions-in > * {
    animation: sc-action-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }
  [data-result-actions].actions-in > *:nth-child(1) { animation-delay: 0.16s; }
  [data-result-actions].actions-in > *:nth-child(2) { animation-delay: 0.3s; }
  @keyframes sc-action-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .choice,
    .choice-bar,
    .q-num,
    .q-num::after,
    .subject-card { transition: none; }
    .choice.choice-pop .choice-bar,
    [data-meter].meter-bump,
    .subject-card.subject-complete,
    .reveal-card.just-unlocked::after,
    [data-final-grade].grade-pop,
    [data-result-actions].actions-in > * { animation: none; }
  }

  @media (max-width: 640px) {
    .q-row { grid-template-columns: 2.75rem minmax(0, 1fr); column-gap: 1rem; row-gap: 1rem; align-items: start; }
    .q-num { font-size: 1.6rem; }
    .choice-group { grid-column: 2; }
    .choice { flex: 1; width: auto; }
  }
</style>
