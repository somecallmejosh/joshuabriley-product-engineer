---

/**
 * Live diagnostic. Visitors pick a demo screen whose mock is intentionally
 * "broken" — the inconsistencies a design-system audit surfaces (mismatched
 * radius, off-grid spacing, contrast failures, drifted color) are always
 * rendered. The "Show issues" toggle only reveals or hides the dashed
 * call-out marks anchored to each defect; it does not fix the mock.
 *
 * Mocks are hand-painted in HTML/CSS per demo. Honest about being a
 * prototype — no real screenshot scraping.
 */

const demos = [
  { id: 'pricing',  label: 'Pricing page' },
  { id: 'hero',     label: 'Marketing hero' },
] as const;
---

<section class="dx" data-dx-root data-active="pricing" aria-labelledby="dx-title">
  <h3 id="dx-title" class="sr-only">Interface examples and findings</h3>

  <div class="dx-controls">
    <div class="dx-tabs" role="tablist" aria-label="Demo screens">
      {demos.map((d, i) => (
        <button
          type="button"
          class="dx-tab"
          role="tab"
          id={`dx-tab-${d.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`dx-panel-${d.id}`}
          data-dx-tab={d.id}
        >
          {d.label}
        </button>
      ))}
    </div>

    <label class="dx-toggle">
      <input type="checkbox" data-dx-show-issues checked />
      <span class="dx-toggle-track"><span class="dx-toggle-thumb" aria-hidden="true"></span></span>
      <span class="dx-toggle-label">Show issues</span>
    </label>
  </div>

  <div
    class="dx-panel"
    id="dx-panel-pricing"
    role="tabpanel"
    aria-labelledby="dx-tab-pricing"
    data-dx-panel="pricing"
    data-dx-state="issues"
  >
    <div class="dx-stage">
      <div class="dx-frame">
        <div class="dx-chrome">
          <span class="dx-chrome-dots"><i></i><i></i><i></i></span>
          <span class="dx-chrome-url">your-app.com/pricing</span>
        </div>

        <div class="dx-pricing">
          <article class="dx-price-card" data-dx-fix="radius-1">
            <p class="dx-price-tier">Starter</p>
            <p class="dx-price-num">$19<span>/mo</span></p>
            <ul>
              <li>Up to 3 projects</li>
              <li>Email support</li>
              <li>Basic analytics</li>
            </ul>
            <button type="button" class="dx-price-cta" tabindex="-1" aria-hidden="true">Get started</button>
          </article>

          <article class="dx-price-card dx-price-card--featured" data-dx-fix="badge-color">
            <span class="dx-price-badge" data-dx-mark="02">Popular</span>
            <p class="dx-price-tier">Team</p>
            <p class="dx-price-num">$49<span>/mo</span></p>
            <ul>
              <li>Up to 25 projects</li>
              <li>Priority support</li>
              <li class="dx-price-spacing-bug" data-dx-fix="spacing" data-dx-mark="03">Advanced analytics</li>
            </ul>
            <button type="button" class="dx-price-cta" tabindex="-1" aria-hidden="true">Get started</button>
          </article>

          <article class="dx-price-card dx-price-card--bad-radius" data-dx-fix="radius-2" data-dx-mark="01">
            <p class="dx-price-tier">Business</p>
            <p class="dx-price-num">$99<span>/mo</span></p>
            <ul>
              <li>Unlimited projects</li>
              <li>Dedicated CSM</li>
              <li>SSO &amp; audit logs</li>
            </ul>
            <button type="button" class="dx-price-cta" tabindex="-1" aria-hidden="true">Contact sales</button>
          </article>
        </div>
      </div>

      <aside class="dx-issues" aria-label="Issues found">
        <p class="dx-issues-count">
          <span data-dx-count>3</span> issues found
        </p>
        <ol>
          <li>
            <span class="dx-issues-num">01</span>
            <div>
              <p class="dx-severity">Low priority</p>
              <p class="dx-issues-title">Mismatched radius</p>
              <p class="dx-issues-body">Card 3 uses <code>4px</code>; the others use <code>16px</code>. One token, three values.</p>
              <p class="dx-fix"><strong>Fix:</strong> Use the same card-radius token for all three plans.</p>
            </div>
          </li>
          <li>
            <span class="dx-issues-num">02</span>
            <div>
              <p class="dx-severity">Medium priority</p>
              <p class="dx-issues-title">Drifted brand color</p>
              <p class="dx-issues-body">Badge orange is <code>#F08A5D</code>, a one-off, not the system&rsquo;s <code>#E8573D</code>.</p>
              <p class="dx-fix"><strong>Fix:</strong> Replace the one-off badge color with the shared brand token.</p>
            </div>
          </li>
          <li>
            <span class="dx-issues-num">03</span>
            <div>
              <p class="dx-severity">Low priority</p>
              <p class="dx-issues-title">Off-grid spacing</p>
              <p class="dx-issues-body">Bullet uses <code>18px</code> margin. The system uses an 8px grid (<code>16</code> or <code>24</code>).</p>
              <p class="dx-fix"><strong>Fix:</strong> Use a spacing token from the shared scale, such as 16px or 24px.</p>
            </div>
          </li>
        </ol>
      </aside>
    </div>
  </div>

  <div
    class="dx-panel"
    id="dx-panel-hero"
    role="tabpanel"
    aria-labelledby="dx-tab-hero"
    data-dx-panel="hero"
    data-dx-state="issues"
    hidden
  >
    <div class="dx-stage">
      <div class="dx-frame">
        <div class="dx-chrome">
          <span class="dx-chrome-dots"><i></i><i></i><i></i></span>
          <span class="dx-chrome-url">your-app.com/</span>
        </div>

        <div class="dx-hero">
          <h4 class="dx-hero-title" data-dx-fix="type-scale" data-dx-mark="01">
            Build faster with our flexible platform.
          </h4>
          <p class="dx-hero-body">
            Everything your team needs to ship, minus the overhead.
          </p>
          <p class="dx-hero-help" data-dx-fix="contrast" data-dx-mark="03">
            Cancel anytime. Try it free for 14 days. No credit card.
          </p>
          <div class="dx-hero-actions">
            <button class="dx-hero-cta" type="button" tabindex="-1" aria-hidden="true" data-dx-fix="btn-radius" data-dx-mark="02">
              Get started
            </button>
            <button class="dx-hero-cta dx-hero-cta--ghost" type="button" tabindex="-1" aria-hidden="true">
              See pricing
            </button>
          </div>
        </div>
      </div>

      <aside class="dx-issues" aria-label="Issues found">
        <p class="dx-issues-count">
          <span>3</span> issues found
        </p>
        <ol>
          <li>
            <span class="dx-issues-num">01</span>
            <div>
              <p class="dx-severity">Low priority</p>
              <p class="dx-issues-title">Off-scale type size</p>
              <p class="dx-issues-body">Headline is <code>38px</code>. The scale jumps <code>32 / 36 / 48</code>.</p>
              <p class="dx-fix"><strong>Fix:</strong> Choose a heading size from the type scale and reference its token.</p>
            </div>
          </li>
          <li>
            <span class="dx-issues-num">02</span>
            <div>
              <p class="dx-severity">Low priority</p>
              <p class="dx-issues-title">Mismatched button radius</p>
              <p class="dx-issues-body">CTA uses <code>6px</code>. The button token is <code>14px</code>.</p>
              <p class="dx-fix"><strong>Fix:</strong> Use the button-radius token instead of a local 6px value.</p>
            </div>
          </li>
          <li>
            <span class="dx-issues-num">03</span>
            <div>
              <p class="dx-severity">High priority</p>
              <p class="dx-issues-title">Contrast fails AA</p>
              <p class="dx-issues-body">Help text contrast is <code>3.2:1</code>. AA needs <code>4.5:1</code>.</p>
              <p class="dx-fix"><strong>Fix:</strong> Use a darker text token and verify at least 4.5:1 contrast for this small text.</p>
            </div>
          </li>
        </ol>
      </aside>
    </div>
  </div>

  <p class="dx-foot-note">
    Annotations point to the example issues. Each finding includes a priority and a suggested fix.
    <a href="/contact/" class="dx-foot-link">Get in touch &rarr;</a>
  </p>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-dx-root]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dx-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-dx-panel]'));
    const toggle = root.querySelector<HTMLInputElement>('[data-dx-show-issues]')!;
    const reduceMotion =
      typeof matchMedia === 'function' &&
      matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Stagger each call-out badge by its number, so 01/02/03 pop in sequence.
    root.querySelectorAll<HTMLElement>('[data-dx-mark]').forEach((m) => {
      const n = parseInt(m.dataset.dxMark ?? '1', 10);
      m.style.setProperty('--dx-delay', `${(n - 1) * 90}ms`);
    });

    // Bidirectional spotlight: hovering a finding lights its mark, and vice versa.
    panels.forEach((panel) => {
      panel.querySelectorAll<HTMLElement>('.dx-issues li').forEach((li) => {
        const num = li.querySelector('.dx-issues-num')?.textContent?.trim();
        const mark = num ? panel.querySelector<HTMLElement>(`[data-dx-mark="${num}"]`) : null;
        if (!mark) return;
        const on = () => {
          li.classList.add('dx-issue-hot');
          mark.classList.add('dx-mark-hot');
        };
        const off = () => {
          li.classList.remove('dx-issue-hot');
          mark.classList.remove('dx-mark-hot');
        };
        li.addEventListener('mouseenter', on);
        li.addEventListener('mouseleave', off);
        mark.addEventListener('mouseenter', on);
        mark.addEventListener('mouseleave', off);
      });
    });

    function countUp(el: HTMLElement, to: number) {
      if (reduceMotion) {
        el.textContent = String(to);
        return;
      }
      const dur = 520;
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / dur);
        el.textContent = String(Math.round(to * (1 - Math.pow(1 - t, 3))));
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    /** Replay the scan sweep, count-up and staggered findings for a panel. */
    function reveal(panel: HTMLElement | undefined) {
      if (!panel || panel.dataset.dxState !== 'issues') return;
      const countEl = panel.querySelector<HTMLElement>('.dx-issues-count span');
      const total = panel.querySelectorAll('.dx-issues li').length;
      if (countEl) countUp(countEl, total);
      if (reduceMotion) return;
      panel.classList.remove('dx-animate');
      void panel.offsetWidth; // restart the CSS animations
      panel.classList.add('dx-animate');
      setTimeout(() => panel.classList.remove('dx-animate'), 1200);
    }

    function activate(id: string) {
      root!.dataset.active = id;
      tabs.forEach((t) => {
        const on = t.dataset.dxTab === id;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panels.forEach((p) => {
        p.hidden = p.dataset.dxPanel !== id;
      });
      reveal(panels.find((p) => p.dataset.dxPanel === id));
    }

    tabs.forEach((t) => {
      t.addEventListener('click', () => activate(t.dataset.dxTab!));
    });

    toggle.addEventListener('change', () => {
      const state = toggle.checked ? 'issues' : 'fixed';
      panels.forEach((p) => (p.dataset.dxState = state));
      reveal(panels.find((p) => !p.hidden));
    });
  }
</script>

<style>
  .dx {
    background: var(--raised);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .dx-head { margin-bottom: 1.25rem; }

  .dx-controls {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }
  .dx-tabs {
    display: inline-flex;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px;
  }
  .dx-tab {
    border: 0; background: transparent;
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.78rem;
    color: var(--ink-muted);
    cursor: pointer;
    transition: all 0.18s var(--ease-out);
  }
  .dx-tab[aria-selected='true'] {
    background: var(--ink);
    color: var(--paper);
  }
  .dx-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .dx-toggle {
    display: inline-flex; align-items: center; gap: 0.6rem;
    cursor: pointer;
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--ink);
  }
  .dx-toggle input { position: absolute; opacity: 0; pointer-events: none; }
  .dx-toggle-track {
    width: 38px; height: 22px;
    background: var(--line);
    border-radius: 999px;
    position: relative;
    transition: background 0.2s var(--ease-out);
  }
  .dx-toggle-thumb {
    position: absolute;
    top: 2px; left: 2px;
    width: 18px; height: 18px;
    background: var(--raised);
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--line);
    transition: transform 0.2s var(--ease-out);
  }
  .dx-toggle input:checked + .dx-toggle-track { background: var(--accent); }
  .dx-toggle input:checked + .dx-toggle-track .dx-toggle-thumb { transform: translateX(16px); }
  .dx-toggle input:focus-visible + .dx-toggle-track { outline: 2px solid var(--accent); outline-offset: 3px; }

  /* ============ stage ============ */
  .dx-stage {
    display: grid; gap: 1.5rem;
  }
  @media (min-width: 880px) {
    .dx-stage { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); }
  }
  .dx-frame {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
  }
  .dx-chrome {
    display: flex; align-items: center; gap: 0.6rem;
    background: var(--ink);
    color: rgba(246, 247, 249, 0.7);
    padding: 0.5rem 0.8rem;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.7rem;
  }
  .dx-chrome-dots { display: inline-flex; gap: 4px; }
  .dx-chrome-dots i {
    width: 9px; height: 9px; border-radius: 50%;
    background: var(--line-strong);
  }
  .dx-chrome-dots i:nth-child(1) { background: var(--line-strong); }
  .dx-chrome-dots i:nth-child(2) { background: var(--line-strong); }
  .dx-chrome-dots i:nth-child(3) { background: var(--line-strong); }
  .dx-chrome-url { letter-spacing: 0.04em; }

  /* ============ pricing demo ============ */
  .dx-pricing {
    display: grid; gap: 0.75rem;
    padding: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) { .dx-pricing { grid-template-columns: repeat(3, 1fr); } }
  .dx-price-card {
    background: var(--raised);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.9rem;
    position: relative;
  }
  /* "broken" — radius drift */
  .dx-price-card--bad-radius { border-radius: 4px; }
  /* "broken" — drifted color (off-token brown-orange one-off, AA-safe) */
  .dx-price-card--featured .dx-price-badge {
    background: #9A4A1E;
  }
  .dx-price-tier {
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 0.2rem;
  }
  .dx-price-num {
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-weight: 800;
    color: var(--ink);
    font-size: 1.6rem;
    margin: 0 0 0.6rem;
  }
  .dx-price-num span { font-size: 0.78rem; color: var(--ink-muted); font-weight: 400; }
  .dx-price-card ul {
    list-style: none; padding: 0; margin: 0 0 0.9rem;
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-size: 0.78rem;
    color: var(--ink-muted);
    display: grid; gap: 0.35rem;
  }
  /* "broken" — off-grid */
  .dx-price-spacing-bug { margin-top: 18px !important; }
  .dx-price-cta {
    width: 100%;
    background: var(--ink);
    color: var(--paper);
    border: 0;
    border-radius: 10px;
    padding: 0.45rem 0.7rem;
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.78rem;
  }
  .dx-price-badge {
    position: absolute;
    top: -10px; left: 50%;
    transform: translateX(-50%);
    background: var(--accent);
    color: var(--paper);
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 9px;
    border-radius: 999px;
  }

  /* ============ hero demo ============ */
  .dx-hero { padding: 2rem 1.25rem 1.5rem; }
  .dx-hero-title {
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-weight: 700;
    font-size: 38px; /* off-scale */
    color: var(--ink);
    line-height: 1.1;
    margin: 0 0 0.5rem;
    max-width: 28ch;
  }
  .dx-hero-body {
    font-family: var(--font-hanken), system-ui, sans-serif;
    color: var(--ink-muted);
    font-size: 0.95rem;
    margin: 0 0 0.8rem;
    max-width: 36ch;
  }
  .dx-hero-help {
    color: var(--ink-muted); /* contrast fix — passes AA */
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-size: 0.78rem;
    margin: 0 0 1rem;
  }
  .dx-hero-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .dx-hero-cta {
    background: var(--accent);
    color: var(--paper);
    border: 0;
    border-radius: 6px; /* off — system is 14px */
    padding: 0.55rem 1rem;
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
  }
  .dx-hero-cta--ghost {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line);
  }

  /* ============ issue marks (anchored to the real element) ============ */
  /* Each call-out box wraps the actual element it flags via [data-dx-mark],
     so it tracks the target regardless of rendered size — no magic numbers.
     The badge absolutely positions itself, so it skips position:relative. */
  [data-dx-mark]:not(.dx-price-badge) { position: relative; }

  /* The dashed call-out + its number bubble are always present; the toggle
     fades/scales them in and out so the reveal feels deliberate, not snapped.
     A transparent outline holds its space with zero reflow when hidden. */
  [data-dx-mark] {
    outline: 2px solid transparent;
    outline-offset: 3px;
    transition: outline-color 0.3s var(--ease-out);
  }
  [data-dx-mark]::after {
    content: attr(data-dx-mark);
    position: absolute;
    top: -10px; left: -10px;
    width: 22px; height: 22px;
    background: var(--accent);
    color: var(--paper);
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1;
    border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    pointer-events: none;
    opacity: 0;
    transform: scale(0);
    transition:
      transform 0.38s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.24s ease;
  }
  [data-dx-state='issues'] [data-dx-mark] { outline-color: var(--accent); }
  [data-dx-state='issues'] [data-dx-mark]::after {
    opacity: 1;
    transform: scale(1);
    transition-delay: var(--dx-delay, 0ms);
  }
  [data-dx-state='fixed'] [data-dx-mark]::after {
    opacity: 0;
    transform: scale(0);
  }
  /* Spotlight when a linked finding is hovered (or the mark itself). */
  [data-dx-mark].dx-mark-hot { outline-color: var(--accent); }
  [data-dx-state='issues'] [data-dx-mark].dx-mark-hot::after {
    transform: scale(1.22);
  }

  /* Diagnostic scan sweep, replayed each time issues are revealed. */
  .dx-frame::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 -45%;
    width: 40%;
    z-index: 4;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(var(--accent-rgb) / 0.16),
      rgb(var(--accent-rgb) / 0.42),
      rgb(var(--accent-rgb) / 0.16),
      transparent
    );
  }
  .dx-panel.dx-animate .dx-frame::before { animation: dx-scan 0.95s cubic-bezier(0.4, 0, 0.2, 1); }
  @keyframes dx-scan {
    0% { left: -45%; opacity: 0; }
    14% { opacity: 1; }
    86% { opacity: 1; }
    100% { left: 105%; opacity: 0; }
  }

  /* The defects (drifted radius, color, spacing, type, contrast) always
     render — the toggle only reveals or hides the dashed call-out marks. */

  /* ============ issues panel ============ */
  .dx-issues {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.1rem 1.2rem;
  }
  .dx-issues-count {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--accent);
    margin: 0 0 0.6rem;
  }
  .dx-issues-count span {
    background: var(--accent);
    color: var(--paper);
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: 999px;
    margin-right: 0.2rem;
  }
  .dx-issues ol {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 0.7rem;
  }
  .dx-issues li {
    display: flex; gap: 0.7rem;
    padding: 0.55rem 0.7rem;
    background: var(--raised);
    border: 1px solid var(--line);
    border-left-width: 3px;
    border-radius: 10px;
    cursor: default;
    transition:
      background 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
  }
  /* Severity ramp: critical (accent) -> minor (muted -> faint line). */
