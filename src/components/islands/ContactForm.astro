---
import Field from '~/components/form/Field.astro';
import Input from '~/components/form/Input.astro';
import Textarea from '~/components/form/Textarea.astro';
import FormAlert from '~/components/form/FormAlert.astro';
import SubmitButton from '~/components/form/SubmitButton.astro';


---

<form
  id="contact-form"
  novalidate
  class="flex flex-col gap-5"
  data-portal-id="245615253"
  data-form-guid="e7cbc2bc-27f0-4a84-b8c4-79e4d3657b39"
  data-fallback-email="josh@thebrileys.com"
>
  <FormAlert variant="success" id="form-alert-success">
    <p class="font-heading font-semibold text-ink">Message sent.</p>
    <p class="mt-1 text-ink-muted">I’ll reply by email.</p>
  </FormAlert>
  <FormAlert variant="error" id="form-alert-error">
    <p class="font-heading font-semibold text-ink">Your message didn’t send.</p>
    <p class="mt-1 text-ink-muted"><span id="form-alert-error-reason"></span></p>
  </FormAlert>

  <div class="grid sm:grid-cols-2 gap-5">
    <Field label="First name" name="first-name" required>
      <Input name="first-name" describedBy="field-first-name-error" autocomplete="given-name" required />
    </Field>
    <Field label="Last name" name="last-name" required>
      <Input name="last-name" describedBy="field-last-name-error" autocomplete="family-name" required />
    </Field>
  </div>

  <div class="grid sm:grid-cols-2 gap-5">
    <Field label="Email" name="email" required hint="I’ll use it only to reply.">
      <Input name="email" describedBy="field-email-hint field-email-error" type="email" autocomplete="email" inputmode="email" required />
    </Field>
    <Field label="Phone (optional)" name="phone">
      <Input name="phone" describedBy="field-phone-error" type="tel" autocomplete="tel" inputmode="tel" />
    </Field>
  </div>

  <Field label="Message" name="message" required hint="Write your own message or start from a topic.">
    <Textarea name="message" describedBy="field-message-hint field-message-error" rows={5} required />
  </Field>

  <SubmitButton label="Send message" loadingLabel="Sending…" />
</form>

<script>
  import '~/scripts/contact-form';
</script>
