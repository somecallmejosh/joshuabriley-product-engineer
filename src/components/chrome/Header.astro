---
import Container from '~/components/layout/Container.astro';
import Logo from '~/components/primitives/Logo.astro';
import DesktopNav from '~/components/chrome/DesktopNav.astro';
import MobileNav from '~/components/chrome/MobileNav.astro';
import { cx } from '~/lib/cx';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<header
  class={cx(
    'site-header sticky top-0 z-40 border-b',
    className,
  )}
>
  <Container as="div" width="wide" class="flex items-center justify-between gap-6 relative">
    <Logo href="/" size="md" class="shrink-0" />

    <div class="hidden md:flex items-center gap-8 shrink-0">
      <DesktopNav />
      <a href="/contact/" class="header-contact" aria-current={Astro.url.pathname.startsWith('/contact') ? 'page' : undefined}>Contact me<span class="link-dot" aria-hidden="true"></span></a>
    </div>

    <MobileNav />
  </Container>
</header>

<script>
  // The bottom rule only appears once the page has scrolled under the header.
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 0);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
