---
import Container from '~/components/layout/Container.astro';
import Logo from '~/components/primitives/Logo.astro';
import Link from '~/components/primitives/Link.astro';
import MobileNav from '~/components/chrome/MobileNav.astro';
import { PRIMARY_NAV, navCurrent } from '~/lib/nav';
import { cx } from '~/lib/cx';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<header class={cx('site-header sticky top-0 z-40', className)} data-site-header>
  <Container as="div" width="wide" class="flex items-center justify-between gap-6 relative">
    <Logo href="/" size="md" class="shrink-0" />

    <!-- The wordmark is the way home, so Home isn't repeated here. -->
    <nav class="desktop-nav hidden md:flex items-center gap-7" aria-label="Primary">
      {PRIMARY_NAV.filter((l) => l.href !== '/').map((link) => (
        <Link href={link.href} variant="nav" current={navCurrent(Astro.url.pathname, link) ?? false} class="whitespace-nowrap">{link.label}</Link>
      ))}
    </nav>

    <MobileNav />
  </Container>
</header>

<script>
  // The bar sits flush with the page at the top and only draws its hairline
  // once content scrolls beneath it.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const update = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
