---
import Container from '~/components/layout/Container.astro';
import Logo from '~/components/primitives/Logo.astro';
import Link from '~/components/primitives/Link.astro';
import MobileNav from '~/components/chrome/MobileNav.astro';
import { PRIMARY_NAV } from '~/lib/nav';
import { cx } from '~/lib/cx';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<header
  class={cx(
    'sticky top-0 z-40 bg-white/70 backdrop-blur-md border-b border-line',
    className,
  )}
>
  <Container as="div" width="wide" class="flex items-center justify-between gap-6 py-3.5 relative">
    <Logo href="/" size="md" class="shrink-0" />

    <nav class="hidden md:flex items-center gap-7 shrink-0" aria-label="Primary">
      {PRIMARY_NAV.filter((l) => l.href !== '/contact/').map((link) => (
        <Link href={link.href} variant="nav" class="whitespace-nowrap">{link.label}</Link>
      ))}
    </nav>

    <div class="hidden md:flex items-center gap-5 shrink-0">
      <a
        href="/contact/"
        class="inline-flex shrink-0 items-center gap-2 whitespace-nowrap rounded-[5px] bg-ink px-4 py-2 font-sans text-[0.85rem] font-medium tracking-tight text-paper transition-[background-color,transform] duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-ink-soft hover:-translate-y-px active:scale-[0.97] active:translate-y-0"
      >Get in touch</a>
    </div>

    <MobileNav links={PRIMARY_NAV} />
  </Container>
</header>
