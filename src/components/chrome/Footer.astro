---
import Container from '~/components/layout/Container.astro';
import Icon from '~/components/primitives/Icon.astro';
import Logo from '~/components/primitives/Logo.astro';
import { FOOTER_NAV } from '~/lib/nav';
import { cx } from '~/lib/cx';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const year = new Date().getFullYear();
---

<footer class={cx('bg-ink text-paper/60 border-t border-paper/10', className)}>
  <Container width="wide" class="py-16 md:py-20">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <Logo tone="inverse" size="lg" />
        <p class="footer-description mt-6 text-sm leading-relaxed text-paper/70">
          Design systems &amp; UI engineering. Accessible components, considered interactions, and documentation that helps teams ship.
        </p>
      </div>

      <div class="lg:col-span-6 grid grid-cols-2 gap-8 sm:gap-12">
        {FOOTER_NAV.map((col) => (
          <nav aria-label={col.heading}>
            <h2 class="mono-label !text-paper/60">{col.heading}</h2>
            <ul class="mt-4 flex flex-col gap-2.5">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[0.95rem] text-paper/70 transition-colors hover:text-paper hover:underline underline-offset-4"
                  >{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-paper/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-col gap-x-5 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-paper/55 sm:flex-row sm:items-center">
        <span class="inline-flex items-center min-h-[24px]">© {year} Joshua Briley</span>
        <a href="/privacy/" class="inline-flex items-center min-h-[24px] transition-colors hover:text-paper/70 hover:underline underline-offset-4">Privacy</a>
        <a href="/terms/" class="inline-flex items-center min-h-[24px] transition-colors hover:text-paper/70 hover:underline underline-offset-4">Terms</a>
      </div>
      <div class="flex items-center gap-5 font-mono text-[0.7rem] uppercase tracking-[0.12em]">
        <a
          href="https://www.linkedin.com/in/joshuabriley/"
          rel="noopener noreferrer"
          target="_blank"
          class="inline-flex items-center gap-1.5 text-paper/55 transition-colors hover:text-paper hover:underline underline-offset-4"
        >LinkedIn <Icon name="ph:arrow-up-right" size={12} /></a>
        <a
          href="https://github.com/somecallmejosh"
          rel="noopener noreferrer"
          target="_blank"
          class="inline-flex items-center gap-1.5 text-paper/55 transition-colors hover:text-paper hover:underline underline-offset-4"
        >GitHub <Icon name="ph:arrow-up-right" size={12} /></a>
      </div>
    </div>

    <p class="mt-8 font-mono text-[0.66rem] leading-relaxed tracking-[0.1em] text-paper/50">
      Designed and built by Joshua Briley in Astro. Yes, I care this much about the spacing.
    </p>
  </Container>
</footer>
