---
import Container from '~/components/layout/Container.astro';
import Logo from '~/components/primitives/Logo.astro';
import RoleIllustration from '~/components/patterns/RoleIllustration.astro';
import type { IllustratedRole } from '~/lib/role-illustrations';
import { HEADER_MENUS } from '~/lib/nav';
import { currentMatcher, getNavFeatures } from '~/lib/nav-features';
import { cx } from '~/lib/cx';

interface Props { class?: string; }
const { class: className } = Astro.props;
const year = new Date().getFullYear();
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = currentMatcher(Astro.url.pathname);
const { linkExists } = await getNavFeatures();
const current = (href: string) => (pathname === (href.replace(/\/$/, '') || '/') ? 'page' : undefined);

// Neighbouring job titles, read as entries in the same dictionary. `xref`
// links another entry inline, between its `before` and `after` text.
// `example` is the usage line a dictionary prints under a sense.
// Grouped as my role, then engineering, then design; within each group the
// roles run from the code toward the design.
const groups = [
  { id: 'mine', label: 'My role' },
  { id: 'engineering', label: 'Engineering' },
  { id: 'design', label: 'Design' },
] as const;
const entries: { id: IllustratedRole; group: (typeof groups)[number]['id']; term: string; ipa: string; sense: string; xref?: { id: IllustratedRole; before: string; after: string }; example?: string }[] = [
  { id: 'product-design-engineer', group: 'mine', term: 'product design engineer', ipa: '/ˈprɑːdʌkt dɪˈzaɪn ˌɛndʒəˈnɪr/', sense: 'Someone who does a little of every role on this list. Rarely the deepest expert in any one of them, but useful where product, design, and engineering meet.', example: 'This is my role.' },
  { id: 'front-end-developer', group: 'engineering', term: 'front-end developer', ipa: '/ˈfrʌnt ˌɛnd dɪˈvɛləpər/', sense: 'Someone who builds what runs in the browser: the markup, the styles, and the scripts that make an interface respond.' },
  { id: 'ui-engineer', group: 'engineering', term: 'UI engineer', ipa: '/ˌjuːˈaɪ ˌɛndʒəˈnɪr/', sense: 'Someone who turns visual design into the components and code of an interface, often as part of a design system.' },
  { id: 'ux-engineer', group: 'engineering', term: 'UX engineer', ipa: '/ˌjuːˈɛks ˌɛndʒəˈnɪr/', sense: 'Someone who turns interaction design into working prototypes and front-end code, so a design behaves the way it was meant to.' },
  { id: 'ui-designer', group: 'design', term: 'UI designer', ipa: '/ˌjuːˈaɪ dɪˈzaɪnər/', sense: 'Someone who designs how an interface looks: its layout, type, color, and the components it is built from.' },
  { id: 'ux-designer', group: 'design', term: 'UX designer', ipa: '/ˌjuːˈɛks dɪˈzaɪnər/', sense: 'Someone who studies how people use a product and shapes its flows, structure, and behavior around what they need.' },
];
const termFor = (id: string) => entries.find((entry) => entry.id === id)?.term;
---

<footer class={cx('site-footer bg-ink', className)}>
  <Container width="wide">
    {/* The page closes like a letter: a dictionary entry for the role, an index
         in the header menus' own words, then the signature and how to reply. */}
      <div class="footer-definition">
        {/* The intro and the role list lead into the entry as one header, so the
             list reads as the index of what the intro promises. */}
        <div class="footer-definition-header">
          <p class="footer-definition-intro" id="footer-definition-intro">Design and engineering job titles overlap, and companies use them differently. Here's what my title means, along with the roles people most often confuse it with.</p>
          <div class="footer-see-also" role="group" aria-labelledby="footer-definition-intro" hidden>
            {groups.map((group) => (
              <div class="footer-role-group" role="group" aria-labelledby={`footer-roles-${group.id}`}>
                <span class="footer-role-group-label" id={`footer-roles-${group.id}`}>{group.label}</span>
                <ul role="list">
                  {entries.filter((entry) => entry.group === group.id).map((entry) => (
                    <li><button type="button" data-show={entry.id} aria-controls="footer-entries" aria-pressed={entry.id === entries[0]?.id ? 'true' : 'false'}>{entry.term}</button></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
        {/* Every entry is pre-rendered so scoped styles reach all of them; only the
             current one is shown, and the footer takes its height. */}
        <div class="footer-entries" id="footer-entries">
          {entries.map((entry, i) => (
            <div class="footer-entry" data-entry={entry.id} data-current={i === 0 ? '' : undefined}>
              <div class="footer-entry-text">
                <p class="footer-term"><dfn>{entry.term.split(' ').slice(0, -1).join(' ')} <em>{entry.term.split(' ').at(-1)}</em></dfn></p>
                <p class="footer-grammar"><span aria-hidden="true">{entry.ipa}</span> noun</p>
                <p class="footer-sense">
                  {entry.sense}
                  {entry.xref && <>{' '}{entry.xref.before}{' '}<button type="button" class="footer-xref" data-show={entry.xref.id} aria-controls="footer-entries">{termFor(entry.xref.id)}</button>{' '}{entry.xref.after}</>}
                </p>
                {entry.example && <p class="footer-example">“{entry.example}”</p>}
              </div>
              <RoleIllustration role={entry.id} class="footer-illustration" />
            </div>
          ))}
        </div>
        <p class="sr-only" aria-live="polite" data-entry-status></p>
      </div>

    <div class="footer-index">
      {HEADER_MENUS.map((menu) => (
        <nav class="footer-group" aria-label={`Footer: ${menu.label}`}>
          <h2>{menu.label}</h2>
          <ul role="list">
            {menu.links.filter((link) => linkExists(link.href)).map((link) => (
              <li>
                <a class="footer-link" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                  <span class="footer-link-name">{link.label}</span>
                  <span class="footer-link-description">{link.description}</span>
                </a>
              </li>
            ))}
          </ul>
          {menu.overview && <a class="footer-all" href={menu.overview.href} aria-current={current(menu.overview.href)}>{menu.overview.label} <span aria-hidden="true" data-link-arrow="right">→</span></a>}
        </nav>
      ))}
    </div>

    <div class="footer-signoff">
      <div class="footer-signature">
        <Logo href="/" size="lg" tone="inverse" />
        <p>Based in Connecticut</p>
        <nav class="footer-reach" aria-label="Footer: Get in touch">
          <a class="footer-contact" href="/contact/" aria-current={current('/contact/')}>Contact me <svg class="hover-arrow" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path class="hover-arrow-stem" d="M0 5h7" /><path class="hover-arrow-head" d="M1 1l4 4-4 4" /></svg></a>
          <a href="mailto:josh@thebrileys.com">josh@thebrileys.com</a>
          <a href="https://www.linkedin.com/in/joshuabriley/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true" data-link-arrow="up-right">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
          <a href="https://github.com/somecallmejosh" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true" data-link-arrow="up-right">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
        </nav>
      </div>
      <div class="footer-colophon">
        <nav aria-label="Footer: Site information">
          <a href="/style-guide/" aria-current={current('/style-guide/')}>How this site is designed</a>
          <a href="/privacy/" aria-current={current('/privacy/')}>Privacy</a>
          <a href="/terms/" aria-current={current('/terms/')}>Terms</a>
          <a class="footer-top" href="#main">Back to top <span aria-hidden="true" data-link-arrow="up">↑</span></a>
        </nav>
        <p>© {year} Joshua Briley</p>
      </div>
    </div>
  </Container>
</footer>

<style>
  /* Three moments separated by space alone: the definition, the index (the
     header menus' links and descriptions), and the signature with ways to
     reply and the colophon. */
  .site-footer {
    --footer-muted: #bfc8d1;
    --footer-accent: #a3c1dd;
    --footer-line: rgb(250 251 252 / .2);
    color: var(--paper);
    padding-top: var(--space-section);
  }
  .site-footer :global(.brand-dot) { color: var(--footer-accent); }

  .footer-definition-header { display: grid; gap: 1rem; margin-bottom: 3rem; }
  .footer-definition-intro { max-width: 46ch; font-size: 1.05rem; line-height: 1.55; color: var(--footer-muted); text-wrap: pretty; }

  /* Only the current entry is shown, so the section fits whichever is active. */
  .footer-entry { display: grid; gap: 2rem; align-items: end; }
  .footer-entry:not([data-current]) { display: none; }
  .footer-entry[data-current] { animation: footer-entry-in .3s var(--ease-out); }
  @keyframes footer-entry-in { from { opacity: 0; } }
  .footer-entry :global(.footer-illustration) { max-width: 22rem; }
  /* The term is set like the hero headlines: heavy, tight sans with the last
     word in the display serif, as the headlines carry their <em>. */
  .footer-term { max-width: 16ch; font-size: clamp(2.6rem, 5.4vw, 4.75rem); font-weight: 800; line-height: .99; letter-spacing: -.065em; text-wrap: balance; }
  .footer-term dfn { font-style: normal; }
  .footer-term em { font-family: var(--font-fraunces), Georgia, serif; font-weight: 400; letter-spacing: -.055em; color: var(--footer-accent); }
  .footer-grammar { display: flex; flex-wrap: wrap; gap: 0 1rem; margin-top: .75rem; font-size: .95rem; color: var(--footer-muted); }
  .footer-sense { max-width: 34ch; margin-top: 1.5rem; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.4; letter-spacing: -.015em; color: var(--footer-muted); text-wrap: balance; }
  .footer-xref { color: var(--paper); text-decoration: underline; text-decoration-color: var(--footer-line); text-underline-offset: 5px; transition: color .2s, text-decoration-color .2s; }
  .footer-example { margin-top: 1.25rem; font-family: var(--font-fraunces), Georgia, serif; font-size: clamp(1.15rem, 1.6vw, 1.35rem); font-style: italic; color: var(--footer-muted); }
  .footer-xref:is(:hover, :focus-visible) { color: var(--footer-accent); text-decoration-color: currentColor; }

  /* Each group is a small label over its roles; the groups sit side by side
     and wrap to stack on narrow screens. */
  .footer-see-also:not([hidden]) { display: flex; flex-wrap: wrap; gap: 1.25rem 3rem; }
  .footer-role-group-label { display: block; font-size: .8rem; font-weight: 500; color: var(--footer-muted); }
  .footer-see-also ul { display: flex; flex-wrap: wrap; gap: 0 1.25rem; margin: 0; padding: 0; list-style: none; }
  .footer-see-also button { min-height: 2.25rem; font-size: .9rem; color: var(--footer-muted); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 5px; transition: color .2s, text-decoration-color .2s; }
  .footer-see-also button:is(:hover, :focus-visible) { color: var(--footer-accent); text-decoration-color: currentColor; }
  .footer-see-also button[aria-pressed='true'] { color: var(--paper); text-decoration-color: var(--footer-accent); }

  .footer-reach { display: flex; flex-wrap: wrap; gap: 0 2rem; margin-top: 1.25rem; }
  .footer-reach a { display: inline-flex; align-items: center; gap: .6rem; min-height: 44px; font-size: .95rem; color: var(--footer-muted); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 5px; transition: color .2s, text-decoration-color .2s; }
  .footer-reach a > span[aria-hidden] { color: var(--footer-accent); }
  .footer-reach .footer-contact { font-weight: 600; color: var(--paper); text-decoration-color: var(--footer-line); }
  .footer-reach a:is(:hover, :focus-visible, [aria-current='page']) { color: var(--footer-accent); text-decoration-color: currentColor; }

  .footer-index { display: grid; gap: 3rem; margin-top: 4.5rem; }
  .footer-group h2 { font-size: .8rem; font-weight: 500; color: var(--footer-muted); }
  .footer-group ul { display: grid; gap: .25rem; margin: .75rem 0 0; padding: 0; list-style: none; }
  .footer-link { display: flex; flex-direction: column; gap: .2rem; padding: .625rem .75rem; margin-inline: -.75rem; transition: background-color .2s; }
  .footer-link:is(:hover, :focus-visible) { background: rgb(var(--accent-rgb) / .1); }
  .footer-link-name { font-size: .9375rem; font-weight: 600; letter-spacing: -.01em; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px; transition: color .2s, text-decoration-color .2s; }
  .footer-link:is(:hover, :focus-visible, [aria-current='page']) .footer-link-name { color: var(--footer-accent); text-decoration-color: currentColor; }
  .footer-link-description { max-width: 19rem; font-size: .8125rem; line-height: 1.45; color: var(--footer-muted); }
  .footer-all { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; margin-top: .5rem; font-size: .875rem; font-weight: 600; text-decoration: underline; text-decoration-color: var(--footer-line); text-underline-offset: 6px; transition: color .2s, text-decoration-color .2s; }
  .footer-all:is(:hover, :focus-visible, [aria-current='page']) { color: var(--footer-accent); text-decoration-color: currentColor; }

  .footer-signoff { display: grid; gap: 2.5rem; margin-top: var(--space-section); padding-bottom: 2.5rem; }
  /* The script wordmark signs the page, set well above its header size. */
  .footer-signature > :global(a) { font-size: clamp(2.5rem, 4.5vw, 3.5rem); }
  .footer-signature p { margin-top: .75rem; font-size: .85rem; color: var(--footer-muted); }
  .footer-colophon { display: grid; gap: .5rem; font-size: .85rem; color: var(--footer-muted); }
  .footer-colophon nav { display: flex; flex-wrap: wrap; gap: 0 2rem; }
  .footer-colophon a { display: inline-flex; align-items: center; gap: .6rem; min-height: 44px; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px; transition: color .2s, text-decoration-color .2s; }
  .footer-colophon a:is(:hover, [aria-current='page']) { color: var(--footer-accent); text-decoration-color: currentColor; }
  .footer-colophon .footer-top { color: var(--paper); font-weight: 600; }

  .site-footer :is(a, button):focus-visible { outline: 3px solid var(--footer-accent); outline-offset: 4px; }

  /* With script and motion allowed, the signature writes itself in from the
     left once it scrolls into view, and the dot lands after the last stroke. */
  .footer-signature[data-signing] > :global(a) { clip-path: inset(-25% 100% -25% -5%); transition: clip-path 1.5s cubic-bezier(.65, 0, .35, 1); }
  /* The open edges leave room for the dot's ping to spread past the wordmark. */
  .footer-signature[data-signing='done'] > :global(a) { clip-path: inset(-60% -30% -60% -5%); }
  .footer-signature[data-signing] :global(.brand-dot) { animation: none; opacity: 0; }
  .footer-signature[data-signing='done'] :global(.brand-dot) { position: relative; animation: brand-dot-draw .6s var(--ease-out) 1.35s both; }
  /* Once the dot lands, a single ring pings out from it, like sonar. */
  .footer-signature[data-signing='done'] :global(.brand-dot::after) {
    content: ''; position: absolute; left: calc(50% + .08em); top: 66%; width: .2em; height: .2em; margin: -.1em 0 0 -.1em;
    border: 1.5px solid currentColor; border-radius: 50%; opacity: 0; pointer-events: none;
    animation: footer-sonar .9s cubic-bezier(.2, .6, .35, 1) 1.9s;
  }
  @keyframes footer-sonar {
    0% { opacity: .9; transform: scale(1); }
    100% { opacity: 0; transform: scale(5); }
  }

  @media (min-width: 640px) {
    .footer-index { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem 4rem; }
  }
  @media (min-width: 1024px) {
    /* The drawing takes the index's third column, over Writing. */
    .footer-entry { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4rem; }
    .footer-entry-text { grid-column: span 2; }
    .footer-entry :global(.footer-illustration) { max-width: none; }
    .footer-index { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4rem; }
    .footer-signoff { grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 4rem; }
    .footer-colophon { justify-items: end; text-align: right; }
    .footer-colophon nav { justify-content: end; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-footer :is(a, button), .footer-link, .footer-link-name { transition: none; }
    .footer-entry[data-current] { animation: none; }
  }
</style>

<script>
  // The see-also list is only useful with script, so it stays hidden until here.
  const definition = document.querySelector<HTMLElement>('.footer-definition');
  if (definition) {
    const seeAlso = definition.querySelector<HTMLElement>('.footer-see-also');
    const status = definition.querySelector<HTMLElement>('[data-entry-status]');
    const show = (id: string) => {
      let shown: HTMLElement | undefined;
      definition.querySelectorAll<HTMLElement>('[data-entry]').forEach((entry) => {
        const isCurrent = entry.dataset.entry === id;
        entry.toggleAttribute('data-current', isCurrent);
        if (isCurrent) shown = entry;
      });
      seeAlso?.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.show === id));
      });
      if (shown && status) status.textContent = `${shown.querySelector('dfn')?.textContent}, noun. ${shown.querySelector('.footer-sense')?.textContent?.trim().replace(/\s+/g, ' ')} ${shown.querySelector('.footer-example')?.textContent ?? ''}`.trim();
    };
    if (seeAlso) seeAlso.hidden = false;
    definition.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-show]');
      if (!button?.dataset.show) return;
      show(button.dataset.show);
      // A cross-reference sits inside the entry it hides, so hand focus to its see-also button.
      if (button.classList.contains('footer-xref')) seeAlso?.querySelector<HTMLButtonElement>(`button[data-show="${button.dataset.show}"]`)?.focus();
    });
  }

  const signature = document.querySelector<HTMLElement>('.footer-signature');
  if (signature && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    signature.dataset.signing = '';
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry?.isIntersecting) return;
      signature.dataset.signing = 'done';
      observer.disconnect();
    }, { threshold: .6 });
    observer.observe(signature);
  }
</script>
