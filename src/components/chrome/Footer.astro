---
import Container from '~/components/layout/Container.astro';
import Logo from '~/components/primitives/Logo.astro';
import { FOOTER_NAV } from '~/lib/nav';
import { cx } from '~/lib/cx';

interface Props { class?: string; }
const { class: className } = Astro.props;
const year = new Date().getFullYear();
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<footer class={cx('site-footer bg-ink', className)}>
  <Container width="wide">
    <div class="footer-main">
      <div class="footer-identity">
        <Logo href="/" size="lg" tone="inverse" class="min-h-[44px] py-1.5" />
        <p class="footer-description">I partner with product, design, and engineering teams to turn the right problem into an accessible, shipped product.</p>
        <p class="footer-location">Connecticut, USA</p>
        <nav class="footer-socials" aria-label="Footer: Elsewhere">
          <a href="https://www.linkedin.com/in/joshuabriley/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true" data-link-arrow="up-right">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
          <a href="https://github.com/somecallmejosh" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true" data-link-arrow="up-right">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
        </nav>
      </div>

      {FOOTER_NAV.map((group, index) => (
        <nav class:list={['footer-nav', { 'footer-nav--lead': index === 0 }]} aria-label={`Footer: ${group.heading}`}>
          <h2>{group.heading}</h2>
          <ul>{group.links.map((link) => (
            <li><a href={link.href} aria-current={pathname === link.href.replace(/\/$/, '') ? 'page' : undefined}>
              <span>{link.label}</span>{index === 0 && <span class="footer-nav-arrow" aria-hidden="true" data-link-arrow="up-right">↗</span>}
            </a></li>
          ))}</ul>
        </nav>
      ))}
    </div>

    <div class="footer-bottom">
      <p>© {year} Joshua Briley</p>
      <nav aria-label="Footer: Site information">
        <a href="/style-guide/" aria-current={pathname === '/style-guide' ? 'page' : undefined}>How this site is designed</a>
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
      </nav>
      <a class="footer-top" href="#main">Back to top <span aria-hidden="true" data-link-arrow="up">↑</span></a>
    </div>
  </Container>
</footer>

<style>
  /* Three groups, each answering one question: who (identity, location,
     profiles), where to go (the two navs), and about this site (the colophon).
     Spacing follows the site rhythm: --space-section above, --space-block
     between groups, tighter steps inside a group. */
  .site-footer {
    --footer-muted: #bfc8d1;
    --footer-accent: #a3c1dd;
    --footer-line: rgb(250 251 252 / .2);
    color: var(--paper);
    padding-top: var(--space-section);
  }
  .site-footer :global(.brand-dot) { color: var(--footer-accent); }
  .footer-main { display: grid; gap: var(--space-block); padding-bottom: var(--space-section); }
  .footer-main > * { min-width: 0; }
  .footer-description { max-width: 30ch; color: var(--footer-muted); font-size: 1rem; line-height: 1.65; margin-top: 1.75rem; }
  .footer-location { color: var(--footer-muted); font-size: .85rem; margin-top: 1rem; }
  .footer-socials { display: flex; flex-wrap: wrap; gap: .25rem 2rem; margin-top: 2rem; }
  .footer-socials a { display: inline-flex; align-items: center; gap: .9rem; min-height: 44px; font-size: .95rem; font-weight: 600; text-decoration: underline; text-decoration-color: var(--footer-line); text-underline-offset: 5px; transition: color .2s, text-decoration-color .2s; }
  .footer-socials a > span[aria-hidden] { color: var(--footer-accent); }
  .footer-socials a:hover { color: var(--footer-accent); text-decoration-color: currentColor; }
  .footer-nav h2 { font-size: .85rem; font-weight: 500; color: var(--footer-muted); }
  .footer-nav ul { list-style: none; margin: 1.25rem 0 0; padding: 0; }
  .footer-nav li { margin: 0; }
  .footer-nav a { display: flex; align-items: center; min-height: 44px; padding-block: .4rem; font-size: 1rem; line-height: 1.4; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 5px; transition: color .2s, text-decoration-color .2s; }
  .footer-nav a:hover, .footer-nav a[aria-current='page'] { color: var(--footer-accent); text-decoration-color: currentColor; }
  .footer-nav--lead ul { margin-top: .75rem; }
  .footer-nav--lead a { justify-content: space-between; gap: 1rem; padding: .7rem 0; font-size: clamp(2.25rem, 3.8vw, 3.4rem); line-height: 1.05; font-weight: 800; letter-spacing: -.05em; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .footer-nav-arrow { color: var(--footer-accent); font-size: .55em; font-weight: 400; }
  .footer-bottom { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem 2.5rem; padding-bottom: 2.5rem; color: var(--footer-muted); font-size: .85rem; }
  .footer-bottom nav { display: flex; flex-wrap: wrap; gap: .25rem 2rem; }
  .footer-bottom a { display: inline-flex; align-items: center; gap: .75rem; min-height: 44px; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px; transition: color .2s, text-decoration-color .2s; }
  .footer-bottom a:hover, .footer-bottom a[aria-current='page'] { color: var(--footer-accent); text-decoration-color: currentColor; }
  .footer-top { margin-left: auto; color: var(--paper); font-weight: 600; }
  .site-footer a:focus-visible { outline: 3px solid var(--footer-accent); outline-offset: 5px; }
  @media (min-width: 640px) {
    .footer-main { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-block) 4rem; }
    .footer-identity { grid-column: 1 / -1; }
    .footer-description { max-width: 44ch; }
  }
  @media (min-width: 1024px) {
    .footer-main { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1.25fr) minmax(0, .9fr); gap: 7rem; }
    .footer-identity { grid-column: auto; }
    .footer-description { max-width: 30ch; }
  }
  @media (max-width: 639px) {
    .footer-bottom { flex-direction: column; align-items: start; }
    .footer-bottom p { order: 1; padding-top: .75rem; }
    .footer-top { order: -1; margin: 0 0 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-footer a { transition: none; }
  }
</style>
