---
import Icon from '~/components/primitives/Icon.astro';
import { FOOTER_NAV, navCurrent, type NavLink } from '~/lib/nav';
import { cx } from '~/lib/cx';

interface Props { class?: string; }
const { class: className } = Astro.props;
// Mirror the footer: its lead group is the large list, the rest are supporting links.
const [leadGroup, ...supportingGroups] = FOOTER_NAV;
const primaryLinks = leadGroup.links;
const current = (link: NavLink) => navCurrent(Astro.url.pathname, link);
---

<button
  id="mobile-menu-toggle"
  type="button"
  class={cx('mobile-menu-toggle', className)}
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="mobile-menu"
>
  Menu <Icon name="ph:list-bold" size={22} />
</button>

<dialog id="mobile-menu" class="mobile-menu" aria-modal="true" aria-labelledby="mobile-menu-title">
  <div class="mobile-menu-panel">
    <div class="mobile-menu-heading">
      <h2 id="mobile-menu-title">Explore</h2>
      <button class="mobile-menu-close" type="button" autofocus>Close <Icon name="ph:x" size={22} /></button>
    </div>
    <div class="mobile-menu-content">
      <nav aria-label="Mobile primary">
        <ul class="mobile-primary" role="list">
          {primaryLinks.map(link => <li><a href={link.href} aria-current={current(link)}>{link.label}</a></li>)}
        </ul>
      </nav>
      {supportingGroups.map((group, index) => (
        <nav class="mobile-more" aria-labelledby={`mobile-more-title-${index}`}>
          <h3 id={`mobile-more-title-${index}`}>{group.heading}</h3>
          <ul class="mobile-supporting" role="list">
            {group.links.map(link => <li><a href={link.href} aria-current={current(link)}>{link.label}</a></li>)}
          </ul>
        </nav>
      ))}
      <a class="editorial-link mobile-contact" href="/contact/" aria-current={current({ href: '/contact/', label: 'Contact me' })}>Contact me <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
    </div>
  </div>
</dialog>

<style>
  .mobile-menu-toggle, .mobile-menu-close { display: inline-flex; align-items: center; justify-content: center; gap: .65rem; min-height: 44px; padding: .5rem .25rem; color: var(--ink); font-size: .875rem; font-weight: 500; }
  .mobile-menu-toggle:hover, .mobile-menu-close:hover { color: var(--portfolio-blue); }
  .mobile-menu { width: calc(100% - 2rem); max-width: 36rem; max-height: calc(100dvh - 2rem); margin: 1rem auto auto; padding: 0; border: 1px solid var(--line); background: var(--paper); color: var(--ink); overflow: hidden; }
  .mobile-menu::backdrop { background: rgb(26 27 30 / .48); }
  .mobile-menu-panel { display: flex; flex-direction: column; max-height: calc(100dvh - 2rem - 5px); }
  .mobile-menu-heading { display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; gap: 1rem; padding: 1rem 1.5rem .75rem; }
  .mobile-menu-heading h2 { font-size: .9rem; font-weight: 500; color: var(--ink-muted); }
  .mobile-menu-content { min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 0 1.5rem 1.5rem; }
  .mobile-primary, .mobile-supporting { margin: 0; padding: 0; list-style: none; }
  /* The one place the chrome uses display type: large and light, like the homepage. */
  .mobile-primary a { display: flex; align-items: center; min-height: 56px; padding: .35rem 0; font-size: clamp(2.1rem, 9vw, 2.75rem); font-weight: 300; line-height: 1.05; letter-spacing: -.045em; }
  .mobile-more { padding-top: 1.75rem; container-type: inline-size; }
  .mobile-more h3 { font-size: .8rem; font-weight: 500; color: var(--ink-muted); }
  .mobile-supporting { display: grid; gap: .375rem; margin-top: .75rem; }
  @container (min-width: 19rem) { .mobile-supporting { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .mobile-supporting a { display: flex; align-items: center; min-height: 44px; font-size: .9375rem; color: var(--ink-muted); transition: color 200ms; }
  .mobile-supporting a:hover, .mobile-supporting a[aria-current] { color: var(--ink); }
  .mobile-supporting a[aria-current] { text-decoration-color: currentColor; text-decoration-thickness: 2px; }
  .mobile-primary a { transition: color 200ms; }
  .mobile-primary a:hover, .mobile-primary a[aria-current] { color: var(--accent); }
  /* The current page or section keeps its underline, so it never relies on colour alone. */
  .mobile-primary a[aria-current] { text-decoration-color: currentColor; text-decoration-thickness: 2px; }
  .mobile-contact { margin-top: 2rem; width: 100%; justify-content: flex-start; }
  .mobile-contact[aria-current] { color: var(--accent); text-decoration-color: currentColor; }
  .mobile-menu-toggle:focus-visible, .mobile-menu :is(a, button):focus-visible { outline: 3px solid var(--portfolio-blue); outline-offset: 4px; }
  :global(html.nav-open), :global(html.nav-open body) { overflow: hidden; }
  @media (min-width: 768px) { .mobile-menu-toggle { display: none; } }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu[open] { animation: mobile-menu-enter 180ms var(--ease-out); }
  }
  @keyframes mobile-menu-enter { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle instanceof HTMLButtonElement && menu instanceof HTMLDialogElement) {
    const closeButton = menu.querySelector<HTMLButtonElement>('.mobile-menu-close');
    const desktop = window.matchMedia('(min-width: 768px)');
    let restoreFocus = true;
    let pointerStartedOutside = false;
    let pagePosition = { left: 0, top: 0 };
    const restorePagePosition = () => window.scrollTo({ ...pagePosition, behavior: 'instant' });
    const outside = (event: MouseEvent) => {
      const rect = menu.getBoundingClientRect();
      return event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom;
    };
    const close = (restore = true) => {
      if (!menu.open) return;
      restoreFocus = restore;
      menu.close();
      toggle.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('nav-open');
      restorePagePosition();
    };
    toggle.addEventListener('click', () => {
      if (menu.open) { close(); return; }
      if (desktop.matches) return;
      restoreFocus = true;
      pointerStartedOutside = false;
      pagePosition = { left: window.scrollX, top: window.scrollY };
      document.documentElement.classList.add('nav-open');
      menu.showModal();
      restorePagePosition();
      toggle.setAttribute('aria-expanded', 'true');
    });
    closeButton?.addEventListener('click', () => close());
    menu.addEventListener('pointerdown', event => { pointerStartedOutside = outside(event); });
    menu.addEventListener('click', event => {
      if (pointerStartedOutside && outside(event)) { close(); return; }
      if ((event.target as Element).closest('a[href]')) close(false);
    });
    menu.addEventListener('keydown', event => {
      if (event.key !== 'Tab') return;
      const targets = Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not(:disabled)'));
      const first = targets[0];
      const last = targets[targets.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    });
    window.addEventListener('resize', () => {
      if (!menu.open) return;
      requestAnimationFrame(() => {
        const active = document.activeElement;
        if (menu.open && active instanceof HTMLElement && menu.contains(active)) active.scrollIntoView({ block: 'nearest' });
      });
    });
    menu.addEventListener('close', () => {
      if (menu.open) return;
      toggle.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('nav-open');
      if (restoreFocus && !desktop.matches) toggle.focus({ preventScroll: true });
      restorePagePosition();
    });
    desktop.addEventListener('change', () => {
      if (desktop.matches && menu.open) {
        close(false);
        document.querySelector<HTMLAnchorElement>('.desktop-nav a[aria-current], .desktop-nav a')?.focus({ preventScroll: true });
      }
    });
  }
</script>
