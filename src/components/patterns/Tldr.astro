---
import Container from '~/components/layout/Container.astro';
interface Alternative { name: string; body: string; }
interface Props {
  situation?: string;
  problem: string;
  alternativeA: Alternative;
  alternativeB: Alternative;
  decision: string;
  implementation: string;
  evidence: string;
  reflection: string;
  class?: string;
}
const { situation, problem, alternativeA, alternativeB, decision, implementation, evidence, reflection, class: className } = Astro.props;
---
<section id="tldr" class:list={['project-summary', className]} aria-labelledby="project-summary-title">
  <Container width="wide">
    <div class="project-summary-grid">
      <h2 id="project-summary-title">Project <em>summary.</em></h2>
      <div class="project-summary-main">
        {situation && <p class="summary-situation" set:html={situation} />}
        <p class="summary-problem" set:html={problem} />
        <dl class="summary-decisions">
          <div><dt>The decision</dt><dd class="summary-decision" set:html={decision} /></div>
          <div><dt>The result</dt><dd set:html={evidence} /></div>
        </dl>
        <details class="summary-more">
          <summary>Alternatives, implementation, and lessons <span aria-hidden="true">+</span></summary>
          <div class="summary-expanded">
            <div class="summary-alternatives">{[alternativeA, alternativeB].map(alternative => <div><h3>{alternative.name}</h3><p set:html={alternative.body} /></div>)}</div>
            <h3>How it was built</h3><p set:html={implementation} />
            <h3>What I would improve</h3><p set:html={reflection} />
          </div>
        </details>
      </div>
    </div>
  </Container>
</section>
