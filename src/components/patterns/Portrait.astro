---
interface Props { eager?: boolean; class?: string; }
const { eager = false, class: className } = Astro.props;
---
<picture class={className}>
  <source type="image/avif" srcset="/images/about/josh-casual-portrait-400.avif 400w, /images/about/josh-casual-portrait-640.avif 640w, /images/about/josh-casual-portrait-1000.avif 1000w" sizes="(min-width: 1024px) 35vw, (min-width: 640px) 50vw, 100vw" />
  <source type="image/webp" srcset="/images/about/josh-casual-portrait-400.webp 400w, /images/about/josh-casual-portrait-640.webp 640w, /images/about/josh-casual-portrait-1000.webp 1000w" sizes="(min-width: 1024px) 35vw, (min-width: 640px) 50vw, 100vw" />
  <img src="/images/about/josh-casual-portrait-640.jpg" alt="Joshua Briley, smiling in a gray T-shirt on a couch in front of a bookshelf" width="1000" height="1250" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
</picture>
