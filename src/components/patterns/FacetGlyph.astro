---
import { cx } from '~/lib/cx';

/**
 * FacetGlyph — the small drawing above each facet in "What I bring to a
 * product team" on the home page.
 *
 * Same contract as PrincipleGlyph and ToolGlyph: fixed 3:2 viewBox, structure
 * drawn in `currentColor` at low opacity, and the one load-bearing element in
 * `var(--accent)`. Surface-aware (see the accent block in site.css), so the
 * same markup reads correctly on paper and on ink without a variant prop.
 *
 * Each mark is a recognizable piece of UI, so it reads without its title:
 * the accessible glyph is a Tab key moving focus to a button with a visible
 * focus ring; the finish glyph is a form field in its error state, with the
 * message that tells someone how to recover; the foundation glyph is a
 * design-system kit of type, color swatches, and components.
 *
 * No hover motion here, matching PrincipleGlyph: these cells aren't links,
 * and the repo rule is that non-link elements get no hover effects.
 *
 * Decorative by contract: every placement sits directly above the facet's
 * title, so the glyph is aria-hidden and adds nothing for AT to read twice.
 */

type GlyphName = 'accessible' | 'finish' | 'foundation';

interface Props {
  name: GlyphName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  viewBox="0 0 96 64"
  fill="none"
  aria-hidden="true"
  focusable="false"
  class={cx('h-auto w-24', className)}
>
  {name === 'accessible' && (
    /* A Tab keycap, an arrow, and the button it moved focus to, wearing an
       offset focus ring in accent. */
    <g>
      <rect x="6" y="20" width="28" height="22" rx="3" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.25" />
      <line x1="9" y1="38.5" x2="31" y2="38.5" stroke="currentColor" stroke-opacity="0.18" stroke-width="1" />
      <text x="20" y="33" text-anchor="middle" class="font-mono" font-size="8" fill="currentColor" fill-opacity="0.7">Tab</text>
      <path
        d="M39 31 L49 31 M45.5 27.5 L49 31 L45.5 34.5"
        stroke="currentColor"
        stroke-opacity="0.4"
        stroke-width="1.25"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <rect x="54" y="20" width="36" height="22" rx="4" stroke="var(--accent)" stroke-width="1.75" />
      <rect x="58" y="24" width="28" height="14" rx="2" fill="currentColor" fill-opacity="0.75" />
      <line x1="65" y1="31" x2="79" y2="31" stroke="var(--paper, #fff)" stroke-width="1.5" stroke-linecap="round" />
    </g>
  )}

  {name === 'finish' && (
    /* A labeled text field in its error state: accent border, a warning
       mark, and the message line that explains the fix. */
    <g>
      <line x1="8" y1="12" x2="30" y2="12" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5" stroke-linecap="round" />
      <rect x="8" y="18" width="80" height="18" rx="2.5" stroke="var(--accent)" stroke-width="1.5" />
      <line x1="14" y1="27" x2="42" y2="27" stroke="currentColor" stroke-opacity="0.3" stroke-width="1.5" stroke-linecap="round" />
      <line x1="44.5" y1="22.5" x2="44.5" y2="31.5" stroke="currentColor" stroke-opacity="0.6" stroke-width="1" />
      <circle cx="13" cy="47" r="5" fill="var(--accent)" />
      <line x1="13" y1="44.25" x2="13" y2="47.5" stroke="var(--paper, #fff)" stroke-width="1.4" stroke-linecap="round" />
      <circle cx="13" cy="50" r="0.8" fill="var(--paper, #fff)" />
      <line x1="22" y1="47" x2="70" y2="47" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" />
    </g>
  )}

  {name === 'foundation' && (
    /* A component kit: a type specimen, a row of color swatches, and two
       components (button and switch) built from them. */
    <g>
      <text x="8" y="31" class="font-serif" font-size="22" font-weight="600" fill="currentColor" fill-opacity="0.8">Aa</text>
      <circle cx="58" cy="20" r="6" fill="currentColor" fill-opacity="0.8" />
      <circle cx="72" cy="20" r="6" fill="currentColor" fill-opacity="0.3" />
      <circle cx="86" cy="20" r="6" fill="var(--accent)" />
      <rect x="8" y="42" width="38" height="14" rx="3" fill="var(--accent)" />
      <line x1="18" y1="49" x2="36" y2="49" stroke="var(--paper, #fff)" stroke-width="1.5" stroke-linecap="round" />
      <rect x="58" y="42" width="26" height="14" rx="7" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.25" />
      <circle cx="77" cy="49" r="4.5" fill="currentColor" fill-opacity="0.6" />
    </g>
  )}
</svg>
