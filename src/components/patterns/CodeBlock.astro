---
import { cx } from '~/lib/cx';
import Icon from '~/components/primitives/Icon.astro';
import CopyButton from '~/components/islands/CopyButton.astro';

/**
 * Technical-proof register — an annotated code artifact.
 *
 * The warm scrapbook components prove taste; this proves engineering. Use it to
 * show a real component API, a type signature, or a config so visitors *see*
 * React/TypeScript depth instead of reading the words "React, Next.js".
 *
 * Deliberately NOT a fake macOS terminal (the traffic-light-dots cliché). It's
 * framed like the rest of the site's technical register: an editorial mono
 * header, the brand accent spine down the left edge (same motif as the case-study
 * pull-quotes), and a real line-number gutter that ties into the numeric
 * spec/"Receipts" language. Dependency-free: no syntax highlighter.
 *
 * Surface: the panel is `bg-ink`, the canonical dark surface — which carries the
 * surface-aware token overrides in site.css, so text-selection lands as a solid
 * sky-denim highlight (#1a1b1e on #6BA6D8 = 6.6:1, WCAG AA) instead of the
 * near-invisible light-paper tint the raw `bg-navy` utility used to inherit.
 */

interface Props {
  /** The code. Passed as a prop (not a slot) so it can be copied verbatim. */
  code: string;
  /** Filename shown in the header, e.g. "Modal.tsx". */
  filename?: string;
  /** Language label, e.g. "tsx", "ts", "bash". */
  lang?: string;
  /** Caption rendered under the artifact in muted text. */
  caption?: string;
  /** Show the copy-to-clipboard button (default true). */
  copy?: boolean;
  class?: string;
}

const { code, filename, lang, caption, copy = true, class: className } = Astro.props;
const body = code.replace(/^\n+|\n+$/g, '');

// One row per source line, so long lines wrap inside their row and the
// non-selectable line number stays beside the line it belongs to. Wrapping
// instead of a horizontal scroller keeps every line readable at any width.
const lines = body.split('\n');

// Header label: filename wins; otherwise fall back to the language name.
const headerLabel = filename ?? (lang ? `${lang} snippet` : 'Code');
---

<figure class={cx('not-prose', className)}>
  <div class="overflow-hidden rounded-2xl border border-ink/10 border-l-2 border-l-accent bg-ink shadow-[0_18px_40px_-22px_rgba(45,43,85,0.6)]">
    <div class="flex items-center gap-2.5 border-b border-white/10 px-4 py-2.5">
      <Icon name="ph:code" size={14} class="shrink-0 text-accent" />
      <span class="truncate font-mono text-xs text-white/85">{headerLabel}</span>
      <span class="ml-auto flex items-center gap-3">
        {lang && (
          <span class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-white/55">{lang}</span>
        )}
        {copy && <CopyButton text={body} label="Copy code" tone="onDark" />}
      </span>
    </div>

    <pre
      role="region"
      aria-label={filename ? `Code: ${filename}` : 'Code sample'}
      class="py-4 font-mono text-[0.8rem] leading-relaxed md:py-5 md:text-sm"
    ><code class="block text-[#E7E5F7]">{lines.map((line, i) => (
      <span class="flex"><span aria-hidden="true" class="w-[2.5rem] shrink-0 select-none border-r border-white/10 pr-3 text-right text-white/50 md:w-[3rem]">{i + 1}</span><span class="min-w-0 flex-1 whitespace-pre-wrap break-words pl-4 pr-4 md:pr-5">{line || ' '}</span></span>
    ))}</code></pre>
  </div>
  {caption && (
    <figcaption class="mt-3 font-body text-sm text-ink-muted">{caption}</figcaption>
  )}
</figure>
