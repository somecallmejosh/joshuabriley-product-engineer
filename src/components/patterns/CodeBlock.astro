---
import { Code } from 'astro:components';
import type { ComponentProps } from 'astro/types';
import { cx } from '~/lib/cx';
import Icon from '~/components/primitives/Icon.astro';
import CopyButton from '~/components/islands/CopyButton.astro';

/** Syntax-highlighted code artifact with source-faithful copy and line numbers. */

interface Props {
  /** The code. Passed as a prop (not a slot) so it can be copied verbatim. */
  code: string;
  /** Filename shown in the header, e.g. "Modal.tsx". */
  filename?: string;
  /** Language label, e.g. "tsx", "ts", "bash". */
  lang?: ComponentProps<typeof Code>['lang'];
  /** Caption rendered under the artifact in muted text. */
  caption?: string;
  /** Show the copy-to-clipboard button (default true). */
  copy?: boolean;
  class?: string;
}

const { code, filename, lang, caption, copy = true, class: className } = Astro.props;
const body = code.replace(/^\n+|\n+$/g, '');

// Highlight the whole snippet so multiline strings and comments retain context.
// Wrap each highlighted line without changing its tokens or copyable source.
const transformers: NonNullable<ComponentProps<typeof Code>['transformers']> = [{
  line(node, line) {
    const tokens = node.children;
    node.children = [
      { type: 'element', tagName: 'span', properties: { className: ['code-line-number'], 'aria-hidden': 'true' }, children: [{ type: 'text', value: String(line) }] },
      { type: 'element', tagName: 'span', properties: { className: ['code-line-content'] }, children: tokens },
    ];
  },
}];

// Header label: filename wins; otherwise fall back to the language name.
const headerLabel = filename ?? (lang ? `${lang} snippet` : 'Code');
---

<figure class={cx('code-artifact not-prose', className)}>
  <div class="overflow-hidden rounded-2xl border border-ink/10 border-l-2 border-l-accent bg-ink shadow-[0_18px_40px_-22px_rgba(45,43,85,0.6)]">
    <div class="flex items-center gap-2.5 border-b border-white/10 px-4 py-2.5">
      <Icon name="ph:code" size={14} class="shrink-0 text-accent" />
      <span class="truncate font-mono text-xs text-white/85">{headerLabel}</span>
      <span class="ml-auto flex items-center gap-3">
        {lang && (
          <span class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-white/55">{lang}</span>
        )}
        {copy && <CopyButton text={body} label="Copy code" tone="onDark" />}
      </span>
    </div>

    <Code
      code={body}
      lang={lang}
      theme="github-dark"
      wrap={true}
      transformers={transformers}
      role="region"
      aria-label={filename ? `Code: ${filename}` : 'Code sample'}
      tabindex="0"
      class="project-code"
    />
  </div>
  {caption && (
    <figcaption class="mt-3 font-body text-sm text-ink-muted">{caption}</figcaption>
  )}
</figure>

<style>
  .code-artifact :global(.project-code) { margin: 0; padding: 1rem 0; font-family: var(--font-geist-mono), ui-monospace, monospace; font-size: .8rem; line-height: 1.7; }
  .code-artifact :global(.project-code code) { display: block; white-space: normal; }
  .code-artifact :global(.project-code .line) { display: flex; }
  .code-artifact :global(.code-line-number) { width: 2.5rem; flex-shrink: 0; user-select: none; border-right: 1px solid rgb(255 255 255 / .1); padding-right: .75rem; color: #a3b2bf; text-align: right; }
  .code-artifact :global(.code-line-content) { min-width: 0; flex: 1; padding-inline: 1rem; white-space: pre-wrap; overflow-wrap: anywhere; }
  .code-artifact :global(.project-code:focus-visible) { outline: 3px solid #a3c1dd; outline-offset: -3px; }
  @media (min-width: 768px) {
    .code-artifact :global(.project-code) { padding-block: 1.25rem; font-size: .875rem; }
    .code-artifact :global(.code-line-number) { width: 3rem; }
    .code-artifact :global(.code-line-content) { padding-right: 1.25rem; }
  }
</style>
