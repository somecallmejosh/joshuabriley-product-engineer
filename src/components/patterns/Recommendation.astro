---
import type { CollectionEntry } from 'astro:content';
interface Props { testimonial: CollectionEntry<'testimonials'>; featured?: boolean; }
const { testimonial, featured = false } = Astro.props;
const { quote, name, role, company, image, initials } = testimonial.data;
---
<figure class:list={['recommendation', { 'recommendation--featured': featured }]}>
  <blockquote>{featured && <span class="recommendation-quote-mark" aria-hidden="true">“</span>}<p>{quote}</p></blockquote>
  <figcaption>
    <span class="offset-frame recommendation-avatar">{image ? <img src={image} alt="" width="80" height="80" loading="lazy" decoding="async" /> : <span class="recommendation-initials" aria-hidden="true">{initials}</span>}</span>
    <div class="recommendation-person"><p class="recommendation-name">{name}</p><p class="recommendation-role">{role}</p><p class="recommendation-company">{company}</p></div>
  </figcaption>
</figure>
<style>
  .recommendation { margin: 0; padding-top: 1.5rem; }
  blockquote p { font-size: clamp(1.2rem, 1.65vw, 1.55rem); font-weight: 600; letter-spacing: -.025em; line-height: 1.4; text-wrap: pretty; }
  figcaption { display: flex; align-items: start; gap: 1rem; margin-top: 1.6rem; }
  .recommendation-avatar { --frame-size: 48px; --frame-offset: 5px; }
  .recommendation-initials { display: grid; place-items: center; background: var(--portfolio-tint); color: var(--portfolio-blue); font-size: .9rem; font-weight: 600; }
  .recommendation-person { min-width: 0; }
  .recommendation-name { font-size: 1rem; line-height: 1.35; font-weight: 650; letter-spacing: -.015em; }
  .recommendation-role, .recommendation-company { font-size: .83rem; line-height: 1.5; color: var(--ink-muted); }
  .recommendation-role { margin-top: .35rem; }
  /* Featured: the quote is set in the display serif, one column, with the
     person underneath, so it reads as a pull quote. */
  .recommendation--featured { display: grid; gap: 2.5rem; border: 0; padding-top: 0; }
  .recommendation--featured blockquote { position: relative; }
  .recommendation-quote-mark { display: block; color: #a3c1dd; font-family: var(--font-fraunces), Georgia, serif; font-size: 4rem; line-height: .7; height: 2rem; margin-bottom: .5rem; }
  .recommendation--featured blockquote p { font-family: var(--font-fraunces), Georgia, serif; font-size: clamp(2rem, 4.2vw, 3.75rem); font-weight: 400; line-height: 1.12; letter-spacing: -.025em; color: var(--paper); max-width: 28ch; text-wrap: balance; }
  .recommendation--featured figcaption { margin-top: 0; align-items: center; }
  .recommendation--featured .recommendation-avatar { --frame-size: 64px; --frame-offset: 6px; }
  .recommendation--featured .recommendation-name { color: var(--paper); font-size: 1.15rem; }
  .recommendation--featured .recommendation-role, .recommendation--featured .recommendation-company { color: #d0dce7; font-size: .9rem; }
  /* Wide screens hang the opening mark in the margin so the text edge stays straight. */
  @media (min-width: 1024px) {
    .recommendation-quote-mark { position: absolute; left: -.5em; top: .05em; margin: 0; font-size: clamp(3.5rem, 7vw, 6rem); height: auto; line-height: 1; }
  }
</style>
