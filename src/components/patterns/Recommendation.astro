---
import type { CollectionEntry } from 'astro:content';
interface Props { testimonial: CollectionEntry<'testimonials'>; featured?: boolean; }
const { testimonial, featured = false } = Astro.props;
const { quote, name, role, company, image, initials } = testimonial.data;
---
<figure class:list={['recommendation', { 'recommendation--featured': featured }]}>
  <blockquote><p>{quote}</p></blockquote>
  <figcaption>
    {image ? <img src={image} alt="" width="80" height="80" loading="lazy" decoding="async" /> : <span class="recommendation-initials" aria-hidden="true">{initials}</span>}
    <div class="recommendation-person"><p class="recommendation-name">{name}</p><p class="recommendation-role">{role}</p><p class="recommendation-company">{company}</p></div>
  </figcaption>
</figure>
<style>
  /* The words lead in ink; the person follows quietly. The featured quote is the
     same thing larger and centred, on paper. */
  .recommendation { margin: 0; }
  blockquote p { font-size: clamp(1.15rem, 1.5vw, 1.35rem); font-weight: 400; letter-spacing: -.02em; line-height: 1.5; color: var(--ink); text-wrap: pretty; }
  figcaption { display: flex; align-items: center; gap: .9rem; margin-top: 1.25rem; }
  figcaption img, .recommendation-initials { flex-shrink: 0; width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
  .recommendation-initials { display: grid; place-items: center; background: var(--portfolio-tint); color: var(--ink-muted); font-size: .85rem; font-weight: 500; }
  .recommendation-person { min-width: 0; }
  .recommendation-name { font-size: .95rem; line-height: 1.35; font-weight: 500; }
  .recommendation-role, .recommendation-company { font-size: .85rem; line-height: 1.45; color: var(--ink-muted); }
  .recommendation-role { margin-top: .15rem; }
  .recommendation--featured { text-align: center; }
  .recommendation--featured blockquote p { max-width: 30ch; margin-inline: auto; font-size: clamp(1.8rem, 3.4vw, 3rem); font-weight: 300; line-height: 1.2; letter-spacing: -.04em; text-wrap: balance; }
  .recommendation--featured figcaption { flex-direction: column; gap: .75rem; margin-top: 2.5rem; }
  .recommendation--featured figcaption img, .recommendation--featured .recommendation-initials { width: 64px; height: 64px; }
</style>
