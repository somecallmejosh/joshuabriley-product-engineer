---
import { cx } from '~/lib/cx';

/**
 * ProjectGlyph — the small drawing beside each project result, in "Selected projects"
 * on the home page and on the projects index.
 *
 * Same contract as FacetGlyph: fixed 3:2 viewBox, structure in `currentColor`
 * at low opacity, and the one load-bearing element in `var(--accent)`.
 * Surface-aware and drawn without knockout fills, so it reads on paper and ink
 * without a variant prop.
 *
 * Each mark draws the mechanism behind the project's result: IVFCRYO's
 * readiness gate (five parties confirm before a shipment is scheduled) and
 * Logatot's voice log (speech turns into a new entry in the day's record).
 *
 * Decorative by contract: it sits beside the project's name and description
 * inside the same link, so it's aria-hidden.
 */

type GlyphName = 'ivfcryo' | 'logatot';

interface Props {
  name: GlyphName;
  class?: string;
}

const { name, class: className } = Astro.props;

const parties = [6, 19, 32, 45, 58];
const wave = [6, 12, 20, 14, 24, 10, 16, 8];
---

<svg
  viewBox="0 0 96 64"
  fill="none"
  aria-hidden="true"
  focusable="false"
  class={cx('h-auto w-24', className)}
>
  {name === 'ivfcryo' && (
    /* Five checked parties feeding one gate; past it, the scheduled
       shipment in accent. */
    <g>
      <g stroke="currentColor" stroke-opacity="0.25" stroke-width="1">
        {parties.map((y) => <path d={`M15 ${y} C 36 ${y}, 36 32, 54 32`} />)}
      </g>
      {parties.map((y) => (
        <g>
          <circle cx="10" cy={y} r="4.25" stroke="currentColor" stroke-opacity="0.5" stroke-width="1" />
          <path
            d={`M8.2 ${y} l1.3 1.3 l2.5 -2.7`}
            stroke="currentColor"
            stroke-opacity="0.85"
            stroke-width="1.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </g>
      ))}
      <line x1="56" y1="20" x2="56" y2="44" stroke="currentColor" stroke-opacity="0.6" stroke-width="2" stroke-linecap="round" />
      <line x1="60" y1="32" x2="66" y2="32" stroke="var(--accent)" stroke-width="1.25" stroke-linecap="round" />
      <rect x="68" y="23" width="22" height="18" rx="2" fill="var(--accent)" fill-opacity="0.2" stroke="var(--accent)" stroke-width="1.5" />
      <line x1="68" y1="29" x2="90" y2="29" stroke="var(--accent)" stroke-width="1.25" />
    </g>
  )}

  {name === 'logatot' && (
    /* A voice waveform turning into the day's log: two existing rows and
       the new entry it just wrote, in accent. */
    <g>
      <g stroke="currentColor" stroke-opacity="0.6" stroke-width="2" stroke-linecap="round">
        {wave.map((h, i) => <line x1={6 + i * 4} y1={32 - h / 2} x2={6 + i * 4} y2={32 + h / 2} />)}
      </g>
      <path
        d="M42 32 L50 32 M47 29 L50 32 L47 35"
        stroke="currentColor"
        stroke-opacity="0.4"
        stroke-width="1.25"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <g stroke="currentColor" stroke-opacity="0.3" stroke-width="1.25" stroke-linecap="round">
        <line x1="56" y1="14" x2="62" y2="14" />
        <line x1="66" y1="14" x2="88" y2="14" />
        <line x1="56" y1="26" x2="62" y2="26" />
        <line x1="66" y1="26" x2="82" y2="26" />
      </g>
      <rect x="53" y="34" width="38" height="14" rx="2" fill="var(--accent)" fill-opacity="0.2" stroke="var(--accent)" stroke-width="1.5" />
      <g stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round">
        <line x1="57" y1="41" x2="62" y2="41" />
        <line x1="66" y1="41" x2="85" y2="41" />
      </g>
    </g>
  )}
</svg>
