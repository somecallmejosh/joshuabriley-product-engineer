---
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';

/**
 * The last section before the gallery link: what didn't work or wasn't
 * checked, and what I'd do next. Every case study has one. Content comes from
 * Josh; never invent a limitation.
 */
interface Item { icon: string; title: string; body: string; }
interface Props {
  items: Item[];
  /** One sentence tying the items together, when they share a cause. */
  lead?: string;
  /** A second group, e.g. what a later redesign left open. */
  later?: { label: string; items: Item[] };
}
const { items, lead, later } = Astro.props;
const groups = [{ label: undefined as string | undefined, items }, ...(later ? [later] : [])];
---
<Section tone="paper" padding="default" id="edges" class="scroll-mt-24">
  <Container width="content">
    <Heading level={2} visual="h2" tone="ink" class={lead ? 'mb-3' : 'mb-10'}>Limitations</Heading>
    {lead && <p class="case-lede measure mb-10">{lead}</p>}
    {groups.map((group, i) => (
      <>
        {group.label && <Heading level={3} visual="h2" tone="ink" class={i > 0 ? 'mb-6 mt-16' : 'mb-6'}>{group.label}</Heading>}
        <ul class="grid grid-cols-1 gap-x-10 gap-y-12 md:grid-cols-2">
          {group.items.map((e) => (
            <li class="pt-5">
              <Icon name={e.icon} size={24} class="mb-3 text-ink-muted" />
              <Heading level={group.label ? 4 : 3} visual="h3" tone="ink" class="mb-2">{e.title}</Heading>
              <Text size="sm" tone="muted"><Fragment set:html={e.body} /></Text>
            </li>
          ))}
        </ul>
      </>
    ))}
  </Container>
</Section>
