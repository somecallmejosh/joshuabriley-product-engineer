---
import { caseResearch, type CaseProject } from '~/lib/case-research';

/**
 * Ties a design decision back to the personas and journey stage it serves,
 * with links to both. Ids that don't exist fail the build.
 *
 * It borrows the Personas block's look (the persona portraits and the tinted
 * band with an accent edge that holds their needs), so a reader can tell at a
 * glance that it points back to the research rather than being body copy.
 */
interface Props {
  project: CaseProject;
  personas: string[];
  stage: string;
}
const { project, personas: ids, stage: stageId } = Astro.props;
const { personas, journey } = caseResearch[project];
const people = ids.map((id) => {
  const person = personas.find((p) => p.id === id);
  if (!person) throw new Error(`CaseFor: no persona "${id}" in ${project}`);
  return person;
});
const stage = journey.find((s) => s.id === stageId);
if (!stage) throw new Error(`CaseFor: no journey stage "${stageId}" in ${project}`);
const joiner = (i: number) => (i === people.length - 1 ? '' : i === people.length - 2 ? ' and ' : ', ');
---
<aside class="case-for" aria-label="Personas this decision serves">
  <span class="case-for__faces" aria-hidden="true">
    {people.map((p) => (
      <img src={`/images/personas/${p.id}.jpg`} alt="" width="40" height="40" loading="lazy" decoding="async" />
    ))}
  </span>
  <p class="text-sm leading-relaxed">
    <span class="block font-semibold text-ink">
      Designed for {people.map((p, i) => (<Fragment><a href={`#persona-${p.id}`} class="hero-link">{p.name.split(' ')[0]}</a>{joiner(i)}</Fragment>))}
    </span>
    <span class="block text-ink-muted">
      Journey stage: <a href={`#journey-${stage.id}`} class="hero-link">{stage.stage}</a>
    </span>
  </p>
</aside>

<style>
  .case-for {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    padding: 0.875rem 1.125rem;
    background: rgb(var(--accent-rgb) / 0.06);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .case-for__faces {
    display: flex;
    flex-shrink: 0;
    gap: 0.25rem;
  }
  .case-for__faces img {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: cover;
  }
</style>
