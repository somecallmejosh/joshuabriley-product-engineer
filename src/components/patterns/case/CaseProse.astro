---
import Container from '~/components/layout/Container.astro';

/**
 * Body paragraphs in a case study. Inside a CaseSection body, use it bare.
 * Between plates in the `media` slot, pass `continued` so the text lines up
 * with the body column above it.
 *
 * Paragraphs are body text. Pass `lede` to set the first paragraph as the
 * section's lede. A lede is optional, and a section gets at most one
 * (tests/e2e/case-studies.spec.ts checks this).
 */
interface Props {
  continued?: boolean;
  lede?: boolean;
  class?: string;
}
const { continued = false, lede = false, class: className } = Astro.props;
---
{continued ? (
  <Container width="content" class="mt-16">
    <div class:list={['case-layout-cont case-prose measure space-y-7', lede && 'case-prose--lede']}>
      <slot />
    </div>
  </Container>
) : (
  <div class:list={['case-prose mt-8 measure space-y-7', lede && 'case-prose--lede', className]}>
    <slot />
  </div>
)}
