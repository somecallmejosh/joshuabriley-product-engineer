---
import Heading from '~/components/primitives/Heading.astro';
import Icon from '~/components/primitives/Icon.astro';
import type { JourneyStage } from '~/lib/case-research';

/**
 * A journey map as live text, so it stays readable at any width. A route of
 * stage markers runs down the left edge, and the line between markers draws in
 * when the map scrolls into view. On large screens each stage is a band with
 * Activity, Problem, and Design response side by side. The design response
 * links to the decision it led to. Each stage repeats its row labels so it can
 * be read alone.
 */
interface Props {
  title: string;
  stages: JourneyStage[];
}
const { title, stages } = Astro.props;
---
<Heading level={3} visual="h2" class="mb-12">{title}</Heading>
<ol class="journey">
  {stages.map((s, i) => (
    <li id={`journey-${s.id}`} class="journey-stage scroll-mt-32" style={`--i: ${i}`}>
      <span class="journey-node" aria-hidden="true">
        <Icon name={s.icon} size={20} class="text-accent" />
      </span>
      <Heading level={4} visual="h3" tone="ink">{s.stage}</Heading>
      <div>
        <Heading level={5} visual="h4" class="mb-2">Activity</Heading>
        <p class="journey-text text-ink-muted">{s.doing}</p>
      </div>
      <div>
        <Heading level={5} visual="h4" class="mb-2">Problem</Heading>
        <p class="journey-text text-ink-muted">{s.problem}</p>
      </div>
      <a class="journey-response" href={s.href}>
        <Heading level={5} visual="h4" class="mb-2">Design response</Heading>
        <span class="journey-text journey-response-text text-ink">{s.design} <span aria-hidden="true" class="journey-arrow" data-link-arrow="down">↓</span></span>
      </a>
    </li>
  ))}
</ol>

<style>
  .journey {
    --node: 2.75rem;
    --stage-gap: 3.5rem;
    --pad: 1rem;
    --route: rgb(var(--accent-rgb) / 0.5);
    display: grid;
    row-gap: var(--stage-gap);
  }

  /* Each stage is a band beside the route, which runs down the left edge. */
  .journey-stage {
    position: relative;
    display: grid;
    grid-template-columns: var(--node) minmax(0, 1fr);
    column-gap: 1.5rem;
    row-gap: 1.75rem;
    align-content: start;
  }
  .journey-stage > :not(.journey-node) {
    grid-column: 2;
  }
  .journey-node {
    grid-column: 1;
    grid-row: 1 / span 4;
    align-self: start;
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    border-radius: 9999px;
    border: 1px solid var(--line-strong);
    background: var(--paper);
  }
  .journey-stage:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(var(--node) / 2);
    top: var(--node);
    bottom: calc(-1 * var(--stage-gap));
    width: 1px;
    background: var(--route);
    transform-origin: top;
  }
  .journey-stage > :global(h4) {
    align-self: center;
    min-height: var(--node);
    display: flex;
    align-items: center;
  }
  .journey-text {
    display: block;
    font-size: var(--type-small);
    line-height: 1.65;
    max-width: 44ch;
  }

  /* The design response is a link to the decision it led to. Its padding hangs
     outside the column, so its text lines up with Activity and Problem. */
  .journey-response {
    display: block;
    margin: calc(-1 * var(--pad));
    margin-bottom: 0;
    padding: var(--pad);
    background: rgb(var(--accent-rgb) / 0.08);
    box-shadow: inset 0 2px 0 var(--accent);
    transition: background-color 0.2s;
  }
  .journey-arrow { margin-left: 0.15em; color: var(--accent); }
  .journey-response:is(:hover, :focus-visible) { background: rgb(var(--accent-rgb) / 0.16); }
  .journey-response:is(:hover, :focus-visible) .journey-response-text {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }
  .journey-response:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

  /* Large screens: the stage title runs across the band and the three rows sit
     side by side under it. */
  @media (min-width: 1024px) {
    .journey { --stage-gap: 4.5rem; --pad: 1.25rem; }
    .journey-stage {
      grid-template-columns: var(--node) repeat(3, minmax(0, 1fr));
      column-gap: 3.5rem;
      row-gap: 1.25rem;
    }
    .journey-stage > :global(h4) { grid-column: 2 / -1; }
    .journey-stage > div:nth-of-type(1) { grid-column: 2; grid-row: 2; }
    .journey-stage > div:nth-of-type(2) { grid-column: 3; grid-row: 2; }
    .journey-stage > .journey-response { grid-column: 4; grid-row: 2; align-self: start; }
    .journey-node { grid-row: 1 / span 2; }
  }

</style>
