---
import Heading from '~/components/primitives/Heading.astro';
import Icon from '~/components/primitives/Icon.astro';
import type { JourneyStage } from '~/lib/case-research';

/**
 * A journey map as live text, so it stays readable at any width. A route of
 * stage markers runs across the top on large screens (down the left edge on
 * small ones), and the line between markers draws in when the map scrolls
 * into view. Rows align by subgrid so the design responses read as one band.
 * Each stage repeats its row labels so it can be read alone.
 */
interface Props {
  title: string;
  stages: JourneyStage[];
}
const { title, stages } = Astro.props;
---
<Heading level={3} visual="h2" class="mb-8">{title}</Heading>
<ol class="journey" style={`--stages: ${stages.length}`} data-reveal>
  {stages.map((s, i) => (
    <li id={`journey-${s.id}`} class="journey-stage scroll-mt-32" style={`--i: ${i}`}>
      <span class="journey-node" aria-hidden="true">
        <Icon name={s.icon} size={20} class="text-accent" />
      </span>
      <Heading level={4} visual="h3" tone="ink">{s.stage}</Heading>
      <div>
        <Heading level={5} visual="h4" class="mb-2">Activity</Heading>
        <p class="text-sm leading-relaxed text-ink-muted">{s.doing}</p>
      </div>
      <div>
        <Heading level={5} visual="h4" class="mb-2">Problem</Heading>
        <p class="text-sm leading-relaxed text-ink-muted">{s.problem}</p>
      </div>
      <div class="journey-response">
        <Heading level={5} visual="h4" class="mb-2">Design response</Heading>
        <p class="text-sm leading-relaxed text-ink"><a href={s.href} class="hero-link">{s.design}</a></p>
      </div>
    </li>
  ))}
</ol>

<style>
  .journey {
    --node: 2.75rem;
    --route: rgb(var(--accent-rgb) / 0.5);
    display: grid;
    row-gap: 2.5rem;
  }

  /* Small screens: the route runs down the left edge. */
  .journey-stage {
    position: relative;
    display: grid;
    grid-template-columns: var(--node) minmax(0, 1fr);
    column-gap: 1.25rem;
    row-gap: 1.25rem;
    align-content: start;
  }
  .journey-stage > :not(.journey-node) {
    grid-column: 2;
  }
  .journey-node {
    grid-column: 1;
    grid-row: 1 / span 4;
    align-self: start;
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    border-radius: 9999px;
    border: 1px solid var(--line-strong);
    background: var(--paper);
  }
  .journey-stage:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(var(--node) / 2);
    top: var(--node);
    bottom: -2.5rem;
    width: 1px;
    background: var(--route);
    transform-origin: top;
  }
  .journey-stage > :global(h4) {
    align-self: center;
    min-height: var(--node);
    display: flex;
    align-items: center;
  }

  .journey-response {
    padding: 1rem 1.125rem 1.125rem;
    background: rgb(var(--accent-rgb) / 0.06);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  /* Large screens: stages side by side, route across the top. */
  @media (min-width: 1024px) {
    .journey {
      grid-template-columns: repeat(var(--stages), minmax(0, 1fr));
      grid-template-rows: repeat(5, auto);
      column-gap: 2rem;
      row-gap: 0;
    }
    .journey-stage {
      grid-row: span 5;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: subgrid;
      column-gap: 0;
    }
    .journey-stage > :not(.journey-node) {
      grid-column: 1;
    }
    .journey-node {
      grid-row: 1;
      margin-bottom: 0.25rem;
    }
    .journey-stage > :global(h4) {
      align-self: start;
      min-height: 0;
    }
    .journey-response {
      padding-inline: 0.875rem;
      box-shadow: inset 0 2px 0 var(--accent);
    }
    .journey-stage:not(:last-child)::before {
      left: var(--node);
      top: calc(var(--node) / 2);
      bottom: auto;
      width: calc(100% - var(--node) + 2rem);
      height: 1px;
      transform-origin: left;
    }
  }

  /* The route draws stage by stage as the map scrolls in. Without the reveal
     script (reduced motion, no JS) everything is simply drawn. */
  @media (prefers-reduced-motion: no-preference) {
    .journey-node {
      transition:
        transform 0.5s cubic-bezier(0.34, 1.4, 0.64, 1),
        opacity 0.4s ease-out;
      transition-delay: calc(var(--i) * 220ms + 150ms);
    }
    .journey-stage::before {
      transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
      transition-delay: calc(var(--i) * 220ms + 300ms);
    }
    .journey.scroll-reveal:not(.is-visible) .journey-node {
      transform: scale(0.6);
      opacity: 0;
    }
    .journey.scroll-reveal:not(.is-visible) .journey-stage::before {
      transform: scaleY(0);
    }
    @media (min-width: 1024px) {
      .journey.scroll-reveal:not(.is-visible) .journey-stage::before {
        transform: scaleX(0);
      }
    }
  }
</style>
