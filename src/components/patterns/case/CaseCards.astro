---
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';

/**
 * A grid of short, titled points: who the product serves, design decisions,
 * research findings. Each item is an icon, a plain-language title, and one or
 * two sentences. `body` may contain inline HTML (<code>, <strong>). An item
 * with `needs` gets a checklist under its body (used for audience columns).
 */
interface Item {
  icon?: string;
  title: string;
  body: string;
  needs?: string[];
}
interface Props {
  items: Item[];
  /** Heading above the grid, e.g. "Foundations". Omit when the section heading is enough. */
  label?: string;
  class?: string;
}
const { items, label, class: className } = Astro.props;
---
<div class:list={['mt-12', className]}>
  {label && <Heading level={3} visual="h2" class="mb-6">{label}</Heading>}
  <ul class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2">
    {items.map((item) => (
      <li class="pt-5">
        {item.icon && <Icon name={item.icon} size={20} class="mb-3 text-ink-muted" />}
        <Heading level={label ? 4 : 3} visual="h3" tone="ink" class="mb-2">{item.title}</Heading>
        <Text size="sm" tone="muted"><Fragment set:html={item.body} /></Text>
        {item.needs && (
          <ul class="mt-5 space-y-3">
            {item.needs.map((n) => (
              <li class="flex items-start gap-2 text-sm text-ink-muted leading-relaxed">
                <Icon name="ph:check" size={14} class="mt-1 shrink-0 text-accent" />
                <span>{n}</span>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</div>
