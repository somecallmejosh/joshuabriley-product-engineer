---
import Heading from '~/components/primitives/Heading.astro';
import Icon from '~/components/primitives/Icon.astro';
import Metric from '~/components/patterns/Metric.astro';

/**
 * The Results block: up to two headline metrics, then what changed, grouped
 * by who it changed for ("For operators", "For the team", "For the business").
 * `note` says how the results were measured, and is required when they come
 * from my own review rather than users or the client.
 */
interface Bar { label: string; /** 0 to 1, the bar's share of the full track. */ value: number; }
interface Props {
  /** `compare` draws a before and after bar under the figure. Use it only when
      both values come from the same measure the figure states. */
  metrics?: { value: string; label: string; caption?: string; compare?: { before: Bar; after: Bar } }[];
  groups: { label: string; items: string[] }[];
  note?: string;
}
const { metrics = [], groups, note } = Astro.props;
const cols = groups.length >= 3 ? 'sm:grid-cols-3' : groups.length === 2 ? 'sm:grid-cols-2' : '';
---
{note && <p class="case-lede mt-8 measure">{note}</p>}

{metrics.length > 0 && (
  <div class:list={['results-figures', { 'results-figures--single': metrics.length === 1 }]}>
    {metrics.map((m) => (
      <div class="results-figure">
        <Metric value={m.value} label={m.label} caption={m.caption} />
        {m.compare && (
          <div class="results-compare" role="img" aria-label={`${m.compare.before.label}. ${m.compare.after.label}.`}>
            {[['before', m.compare.before], ['after', m.compare.after]].map(([key, bar]) => (
              <div class:list={['results-bar', `results-bar--${key}`]} aria-hidden="true">
                <span class="results-bar__label">{(bar as Bar).label}</span>
                <span class="results-bar__track"><span class="results-bar__fill" style={`--fill: ${(bar as Bar).value}`}></span></span>
              </div>
            ))}
          </div>
        )}
      </div>
    ))}
  </div>
)}

<div class:list={['results-groups mt-12 grid grid-cols-1 gap-x-8 gap-y-12', cols]}>
  {groups.map((group) => (
    <div class="pt-4">
      <Heading level={3} visual="h3" class="mb-3">{group.label}</Heading>
      <ul class="space-y-3">
        {group.items.map((item) => (
          <li class="flex items-start gap-2 text-sm text-ink-muted leading-relaxed">
            <Icon name="ph:check" size={14} class="mt-1 shrink-0 text-accent" />
            <span set:html={item} />
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
