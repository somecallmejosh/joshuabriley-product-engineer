---
import Heading from '~/components/primitives/Heading.astro';
import Icon from '~/components/primitives/Icon.astro';

/**
 * Nielsen's ten heuristics, scored 0–10, with the change that moved each one.
 * `after` is optional: leave it out until a re-score has actually been done.
 * `left` is what still keeps a heuristic from a 10.
 *
 * Each heuristic gets a 0–10 score bar: the starting score in a light tint of
 * the accent, the gain in the accent. Bars fill on scroll-in; without the
 * reveal script (reduced motion, no JS) they're simply drawn.
 */
interface Row {
  n: number;
  name: string;
  before: number;
  after?: number;
  fix: string;
  left?: string;
}
interface Props {
  items: Row[];
  caption: string;
  /** Heading level for the section title; each heuristic is one level below. */
  level?: 3 | 4;
}
const { items, caption, level = 3 } = Astro.props;
const itemLevel = (level + 1) as 4 | 5;
const rescored = items.some((h) => h.after !== undefined);
---
<div class="mt-16">
  <Heading level={level} visual="h2">Score by heuristic</Heading>
  <p class="mt-2 text-sm text-ink-muted">{caption}</p>

  {rescored && (
    <p class="heur-legend mt-6" aria-hidden="true">
      <span class="heur-legend-item"><span class="heur-swatch heur-swatch--before"></span>Before</span>
      <span class="heur-legend-item"><span class="heur-swatch heur-swatch--gain"></span>Gained</span>
    </p>
  )}

  <ol class="heur-list mt-10">
    {items.map((h, i) => {
      const end = h.after ?? h.before;
      return (
        <li style={`--b: ${h.before}; --a: ${end}; --i: ${i}`}>
          <div class="flex items-end justify-between gap-x-6">
            <Heading level={itemLevel} visual="h4">{h.name}</Heading>
            {h.after !== undefined ? (
              <p class="flex shrink-0 items-baseline gap-2" aria-label={`from ${h.before} to ${h.after} out of 10`}>
                <span class="font-display text-lg text-ink-muted line-through decoration-accent/50">{h.before}</span>
                <Icon name="ph:arrow-right" size={14} class="self-center text-ink-muted" />
                <span class="font-display text-2xl font-semibold leading-none tracking-tight text-ink">{h.after}</span>
                <span class="font-mono text-xs text-ink-muted">/10</span>
              </p>
            ) : (
              <p class="flex shrink-0 items-baseline gap-1" aria-label={`scored ${h.before} out of 10`}>
                <span class="font-display text-2xl font-semibold leading-none tracking-tight text-ink">{h.before}</span>
                <span class="font-mono text-xs text-ink-muted">/10</span>
              </p>
            )}
          </div>

          <div class="heur-bar" aria-hidden="true">
            <span class:list={['heur-before', h.after === undefined && 'heur-before--only']}></span>
            {h.after !== undefined && <span class="heur-gain"></span>}
          </div>

          <p class="measure text-sm leading-relaxed text-ink-muted">{h.fix}</p>
          {h.left && (
            <p class="measure mt-2 text-sm leading-relaxed text-ink-muted">
              <span class="font-medium text-ink">Still open:</span> {h.left}
            </p>
          )}
        </li>
      );
    })}
  </ol>
</div>

<style>
  .heur-legend {
    display: flex;
    gap: 1.5rem;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: var(--type-caption);
    color: var(--ink-muted);
  }
  .heur-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .heur-swatch {
    width: 1.25rem;
    height: 0.5rem;
  }

  /* Open space, not rules, separates the heuristics: much more room between
     them than inside one. */
  .heur-list {
    display: grid;
    row-gap: 4rem;
  }

  /* A 0–10 score bar, the same as the flow-score bars: the starting score in
     grey, the gain in the accent. */
  .heur-bar {
    position: relative;
    height: 0.5rem;
    margin-block: 0.75rem 1rem;
    background: var(--line);
    overflow: hidden;
  }
  .heur-before,
  .heur-gain {
    position: absolute;
    inset-block: 0;
  }
  .heur-before,
  .heur-swatch--before {
    background: rgb(var(--accent-rgb) / 0.3);
  }
  .heur-before {
    left: 0;
    width: calc(var(--b) * 10%);
  }
  .heur-before--only {
    background: var(--accent);
  }
  .heur-gain,
  .heur-swatch--gain {
    background: var(--accent);
  }
  .heur-gain {
    left: calc(var(--b) * 10%);
    width: calc((var(--a) - var(--b)) * 10%);
    transform-origin: left;
  }

</style>
