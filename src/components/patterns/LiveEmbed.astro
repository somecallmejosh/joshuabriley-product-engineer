---
import Icon from '~/components/primitives/Icon.astro';
import { cx } from '~/lib/cx';

/**
 * LiveEmbed — a *live viewfinder*, deliberately unlike the static editorial plates
 * (SiteShot / ScrollShot). Where a plate is a calm mounted specimen, this signals
 * "alive and interactive": four corner registration brackets frame the stage, a
 * pulsing LIVE · INTERACTIVE tag sits over it, and the controls live in a spec
 * rail below. A poster screenshot swaps to a real <iframe> on demand. The iframe
 * is pre-rendered with NO src (zero network until clicked) so it loads lazily AND
 * keeps Astro's scoped styles — runtime-injected nodes would miss them.
 */

interface Props {
  /** Poster screenshot, root-relative. */
  posterSrc: string;
  posterAlt: string;
  /** The iframe URL — loaded only on activation. */
  embedSrc: string;
  /** Full URL for the "open" affordance (opens in a new tab). */
  href: string;
  /** Short title shown in the spec rail + used for the iframe a11y title. */
  title: string;
  /** CSS aspect-ratio for the stage, matching the poster. */
  ratio?: string;
  /** Small caps note under the load pill, e.g. "the real Storybook story". */
  ctaNote?: string;
  class?: string;
}

const {
  posterSrc,
  posterAlt,
  embedSrc,
  href,
  title,
  ratio = '1600 / 1039',
  ctaNote = 'the real Storybook story',
  class: className,
} = Astro.props;
---

<figure class={cx('live-embed', className)} data-live-embed data-view="desktop">
  <div class="live-embed-frame">
    <span class="live-embed-corner live-embed-corner--tl" aria-hidden="true"></span>
    <span class="live-embed-corner live-embed-corner--tr" aria-hidden="true"></span>
    <span class="live-embed-corner live-embed-corner--bl" aria-hidden="true"></span>
    <span class="live-embed-corner live-embed-corner--br" aria-hidden="true"></span>

    <span class="live-embed-tag">
      <span class="live-embed-tag-dot" aria-hidden="true"></span>
      live <span class="live-embed-tag-sep" aria-hidden="true">·</span> interactive
    </span>

    <div class="live-embed-stage" style={`--ratio:${ratio}`}>
      <div class="live-embed-viewport">
        <img class="live-embed-poster" src={posterSrc} alt={posterAlt} loading="lazy" decoding="async" />

        <button type="button" class="live-embed-cta" data-embed-trigger aria-label={`Load the interactive ${title} demo`}>
          <span class="live-embed-cta-pill">
            <Icon name="ph:play-fill" size={15} />
            Load live demo
          </span>
          <span class="live-embed-cta-note">{ctaNote}</span>
        </button>

        <iframe
          class="live-embed-iframe"
          data-embed-frame
          data-src={embedSrc}
          title={`${title}: live interactive demo`}
          loading="lazy"
          sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
          allow="fullscreen"
        ></iframe>
      </div>
    </div>
  </div>

  <figcaption class="live-embed-rail">
    <span class="live-embed-title">{title}</span>

    <div class="live-embed-controls">
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class="live-embed-open"
        aria-label={`Open ${title} (new tab)`}
      >open <Icon name="ph:arrow-up-right" size={12} /></a>
    </div>
  </figcaption>
</figure>

<style>
  .live-embed { margin: 0; }

  /* Viewfinder frame — holds the stage and the four registration brackets. The
     brackets sit just outside the stage's rounded corners. */
  .live-embed-frame {
    position: relative;
    padding: 10px;
  }

  .live-embed-corner {
    position: absolute;
    width: 20px;
    height: 20px;
    border: 1.5px solid var(--accent);
    pointer-events: none;
    opacity: 0.85;
  }
  .live-embed-corner--tl { top: 0; left: 0; border-right: 0; border-bottom: 0; border-radius: 4px 0 0 0; }
  .live-embed-corner--tr { top: 0; right: 0; border-left: 0; border-bottom: 0; border-radius: 0 4px 0 0; }
  .live-embed-corner--bl { bottom: 0; left: 0; border-right: 0; border-top: 0; border-radius: 0 0 0 4px; }
  .live-embed-corner--br { bottom: 0; right: 0; border-left: 0; border-top: 0; border-radius: 0 0 4px 0; }

  /* Before load, the brackets breathe to invite interaction; they settle once
     the live frame is up. */
  @media (prefers-reduced-motion: no-preference) {
    .live-embed:not([data-loaded]) .live-embed-corner {
      animation: live-embed-bracket 3s ease-in-out infinite;
    }
  }
  @keyframes live-embed-bracket {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 0.95; }
  }

  .live-embed-tag {
    position: absolute;
    top: 1.15rem;
    left: 1.15rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    padding: 0.34rem 0.7rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }
  .live-embed-tag-sep { opacity: 0.55; }
  .live-embed-tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(var(--accent-rgb), 0.55);
    animation: live-embed-pulse 2.4s ease-in-out infinite;
  }
  @keyframes live-embed-pulse {
    0% { box-shadow: 0 0 0 0 rgba(var(--accent-rgb), 0.5); }
    70% { box-shadow: 0 0 0 7px rgba(var(--accent-rgb), 0); }
    100% { box-shadow: 0 0 0 0 rgba(var(--accent-rgb), 0); }
  }

  .live-embed-stage {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    background: var(--raised);
    box-shadow:
      0 1px 2px rgba(27, 26, 23, 0.04),
      0 18px 50px -28px rgba(27, 26, 23, 0.3);
    aspect-ratio: var(--ratio, 1600 / 1039);
  }

  .live-embed-viewport { position: absolute; inset: 0; }

  .live-embed-poster,
  .live-embed-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .live-embed-poster {
    object-fit: cover;
    object-position: top center;
    transition: opacity 0.5s var(--ease-out), filter 0.4s var(--ease-out);
  }
  .live-embed-iframe {
    border: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s var(--ease-out);
  }

  /* Load affordance — a dark pill centered over a faint scrim. */
  .live-embed-cta {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    cursor: pointer;
    border: 0;
    background: radial-gradient(60% 60% at 50% 50%, rgba(27, 26, 23, 0.06), rgba(27, 26, 23, 0.02));
    transition: background 0.4s var(--ease-out);
  }
  .live-embed-cta:hover { background: radial-gradient(60% 60% at 50% 50%, rgba(27, 26, 23, 0.12), rgba(27, 26, 23, 0.04)); }

  .live-embed-cta-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.3rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1;
    box-shadow: 0 10px 30px -12px rgba(27, 26, 23, 0.5);
    transition: transform 0.35s var(--ease-out);
  }
  .live-embed-cta:hover .live-embed-cta-pill { transform: translateY(-2px) scale(1.02); }
  .live-embed-cta:active .live-embed-cta-pill { transform: scale(0.97); }
  .live-embed-cta-note {
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-muted);
  }

  /* Activated: poster + CTA bow out, live story fades in. */
  .live-embed[data-loaded] .live-embed-poster { opacity: 0; pointer-events: none; }
  .live-embed[data-loaded] .live-embed-cta { display: none; }
  .live-embed[data-loaded] .live-embed-iframe { opacity: 1; pointer-events: auto; }

  /* Spec rail — beneath the viewfinder. Title left; controls right. */
  .live-embed-rail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.85rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
  }
  .live-embed-title {
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-muted);
  }
  .live-embed-controls { display: inline-flex; align-items: center; gap: 0.85rem; }

  .live-embed-views {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--raised);
  }
  .live-embed-view {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-muted);
    transition: color 0.2s var(--ease-out), background 0.2s var(--ease-out);
  }
  .live-embed-view span { display: none; }
  @media (min-width: 480px) { .live-embed-view span { display: inline; } }
  .live-embed-view:hover { color: var(--ink); }
  .live-embed-view[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  .live-embed-open {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-muted);
    transition: color 0.2s var(--ease-out);
  }
  .live-embed-open:hover { color: var(--accent); }

  /* Mobile preview — the stage becomes a device backdrop holding a centered
     phone. Brackets step aside so the phone reads cleanly. */
  .live-embed[data-view='mobile'] .live-embed-corner { opacity: 0; }
  .live-embed[data-view='mobile'] .live-embed-stage {
    aspect-ratio: auto;
    height: clamp(560px, 78vh, 760px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.75rem 1rem;
    background:
      radial-gradient(120% 120% at 50% 0%, rgba(27, 26, 23, 0.05), transparent 60%),
      var(--raised);
  }
  .live-embed[data-view='mobile'] .live-embed-viewport {
    position: relative;
    inset: auto;
    height: 100%;
    aspect-ratio: 390 / 760;
    max-width: 100%;
    border-radius: 30px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    box-shadow: 0 22px 60px -24px rgba(27, 26, 23, 0.5);
  }

  @media (prefers-reduced-motion: reduce) {
    .live-embed-poster, .live-embed-iframe, .live-embed-cta-pill { transition: none; }
    .live-embed-tag-dot { animation: none; }
  }
</style>

<script>
  // Activate on click: set the iframe's real src (it was rendered src-less, so
  // nothing loaded until now), then flag the figure so CSS swaps poster → frame.
  document.querySelectorAll('[data-embed-trigger]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = btn.closest('[data-live-embed]') as HTMLElement | null;
      const frame = root?.querySelector('[data-embed-frame]') as HTMLIFrameElement | null;
      if (!root || !frame || root.dataset.loaded) return;
      if (frame.dataset.src) frame.src = frame.dataset.src;
      root.dataset.loaded = 'true';
    });
  });

  // Viewport switch: flip the figure's data-view (CSS reflows the frame). No
  // network — an already-loaded iframe just re-renders at the new width.
  document.querySelectorAll('[data-live-embed]').forEach((root) => {
    const host = root as HTMLElement;
    const btns = host.querySelectorAll<HTMLButtonElement>('[data-view-btn]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        host.dataset.view = btn.dataset.viewBtn ?? 'desktop';
        btns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      });
    });
  });
</script>
