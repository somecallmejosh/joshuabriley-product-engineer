---
import Icon from '~/components/primitives/Icon.astro';
import { cx } from '~/lib/cx';

/**
 * ScrollShot — a full-page capture, shown as a tall editorial plate.
 *
 * These are a different asset class from the design sheets in `Plate.astro`.
 * A sheet is a document meant to be read whole; a full-page capture is an
 * entire page's scroll flattened into one image, and some of them are extreme
 * (the style-guide tables capture is 1600x11531, a 7:1 ratio — at band width
 * that single image would be nearly 9000px tall). They genuinely cannot render
 * whole by default.
 *
 * So this one keeps a bound, but not a scrollbar. A nested scroll region inside
 * a scrolling page traps the wheel on the way past, which is the single most
 * uncomfortable thing a long case study can do. Instead the capture is clipped
 * to `maxH` and an explicit control expands it in place to its full height.
 * One honest click, no trap, and the collapsed page length is unchanged.
 *
 * Pass `href` to link the source domain out to the live site.
 */

interface Props {
  src: string;
  alt: string;
  /** Source label in the caption rail, e.g. "berxi.com" or "Buttons". */
  label: string;
  /** Optional caption under the plate. */
  caption?: string;
  /** Optional outbound link — turns the source label into a link to the live site. */
  href?: string;
  /** Optional plate index, e.g. "01" — renders a "Plate / 01" figure tag above. */
  index?: string;
  /** Kind label shown at the caption rail's left. */
  kind?: string;
  /** Visible height while collapsed. */
  maxH?: string;
  class?: string;
}

const {
  src,
  alt,
  label,
  caption,
  href,
  index,
  kind = 'Full page',
  maxH = '70vh',
  class: className,
} = Astro.props;

const uid = `shot-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<figure class={cx('scroll-shot', className)}>
  {index && (
    <p class="scroll-shot-index">Plate <span aria-hidden="true">/</span> {index}</p>
  )}

  <div class="scroll-shot-mount">
    <div class="scroll-shot-stage" id={uid} style={`--shot-max:${maxH}`}>
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    </div>
    <span class="scroll-shot-fade" aria-hidden="true"></span>
    <button
      type="button"
      class="scroll-shot-toggle"
      data-shot-toggle
      aria-controls={uid}
      aria-expanded="false"
    >
      <Icon name="ph:arrows-out-line-vertical" size={12} />
      <span data-shot-toggle-text>Expand</span>
    </button>
  </div>

  <figcaption class="scroll-shot-cap">
    <div class="scroll-shot-rail">
      <span class="scroll-shot-kind">{kind}</span>
      {href ? (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="scroll-shot-url scroll-shot-url--link"
          aria-label={`Open ${label} in a new tab`}
        >{label} <Icon name="ph:arrow-up-right" size={12} /></a>
      ) : (
        <span class="scroll-shot-url">{label}</span>
      )}
    </div>
    {caption && <p class="scroll-shot-note">{caption}</p>}
  </figcaption>
</figure>

<style>
  .scroll-shot { margin: 0; }

  .scroll-shot-index {
    margin: 0 0 0.75rem;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--ink-muted);
  }
  .scroll-shot-index span { margin: 0 0.35em; opacity: 0.6; }

  /* Mount — the mounted specimen, holding a scroll stage. */
  .scroll-shot-mount {
    position: relative;
    padding: 8px;
    border-radius: 16px;
    background: var(--raised);
    border: 1px solid var(--line);
    box-shadow:
      0 1px 2px rgba(27, 26, 23, 0.04),
      0 18px 50px -28px rgba(27, 26, 23, 0.3);
  }

  /* Clipped, never scrolled. The wheel belongs to the page. */
  .scroll-shot-stage {
    overflow: hidden;
    max-height: var(--shot-max, 70vh);
    border-radius: 9px;
    border: 1px solid var(--line);
    background: var(--raised);
  }
  .scroll-shot[data-expanded] .scroll-shot-stage { max-height: none; }
  .scroll-shot-stage img { width: 100%; height: auto; display: block; }

  /* The fade and the control are claims that there is more capture below. They
     only render when that is actually true — the script clears the flag on a
     capture that already fits, and an expand button on a fully-visible image is
     just a lie. */
  .scroll-shot-fade,
  .scroll-shot-toggle {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s var(--ease-out);
  }
  .scroll-shot[data-overflow] .scroll-shot-fade { opacity: 1; }
  .scroll-shot[data-overflow] .scroll-shot-toggle {
    opacity: 1;
    pointer-events: auto;
  }

  .scroll-shot-fade {
    position: absolute;
    left: 9px;
    right: 9px;
    bottom: 9px;
    height: 96px;
    border-radius: 0 0 9px 9px;
    background: linear-gradient(to bottom, transparent, var(--raised));
  }
  /* Once expanded there is nothing left below to fade toward. */
  .scroll-shot[data-expanded] .scroll-shot-fade { opacity: 0; }

  .scroll-shot-toggle {
    position: absolute;
    left: 50%;
    bottom: 1.15rem;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.42rem 0.85rem;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    white-space: nowrap;
    color: var(--ink-muted);
    cursor: pointer;
    transition:
      opacity 0.2s var(--ease-out),
      color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out);
  }
  .scroll-shot-toggle:hover { color: var(--ink); border-color: var(--ink-faint); }
  .scroll-shot-toggle:focus-visible {
    opacity: 1;
    pointer-events: auto;
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* Expanded, the control moves out of the artwork and sits under it, so it is
     not floating over 9000px of screenshot. */
  .scroll-shot[data-expanded] .scroll-shot-toggle {
    position: static;
    transform: none;
    margin: 0.85rem auto 0;
    display: flex;
    width: fit-content;
  }

  /* Caption — spec rail (kind + source) then optional note. */
  .scroll-shot-cap { margin-top: 0.85rem; }
  .scroll-shot-rail {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.7rem;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
  }
  .scroll-shot-kind {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .scroll-shot-url {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-width: 0;
    color: var(--ink-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  a.scroll-shot-url--link { transition: color 0.25s var(--ease-out); }
  a.scroll-shot-url--link:hover { color: var(--accent); }

  .scroll-shot-note {
    margin: 0.85rem 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--ink-muted);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.scroll-shot').forEach((shot) => {
    const stage = shot.querySelector<HTMLElement>('.scroll-shot-stage');
    const btn = shot.querySelector<HTMLButtonElement>('[data-shot-toggle]');
    const btnText = shot.querySelector<HTMLElement>('[data-shot-toggle-text]');
    const img = stage?.querySelector('img');
    if (!stage || !btn || !btnText || !img) return;

    // Only offer the control when the capture is genuinely taller than its
    // collapsed window. Measured against scrollHeight because the stage is
    // clipped, not scrolled.
    const sync = () => {
      if (shot.hasAttribute('data-expanded')) return;
      shot.toggleAttribute('data-overflow', stage.scrollHeight > stage.clientHeight + 4);
    };

    if (img.complete) sync();
    else img.addEventListener('load', sync, { once: true });
    new ResizeObserver(sync).observe(shot);

    btn.addEventListener('click', () => {
      const open = shot.toggleAttribute('data-expanded');
      btn.setAttribute('aria-expanded', String(open));
      btnText.textContent = open ? 'Collapse' : 'Expand';
      if (!open) {
        // Collapsing from far down the image would otherwise strand the reader
        // below the plate with no context.
        shot.scrollIntoView({
          block: 'nearest',
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
            ? 'auto'
            : 'smooth',
        });
        sync();
      }
    });
  });
</script>
