---
import '~/styles/illustration.css';

/**
 * The hero drawing for /personal-projects/: a ticket no real job would file.
 * Same mat, frame and tilt as the Play drawings (see illustration.css).
 * The ship is the Token Adventure player's, drawn on a pixel grid.
 */
const description =
  'A project ticket titled Arcade game about JSON. Requested by nobody, no deadline, priority fun. It is stamped Just Because, and a small pixel spaceship flies off its corner.';

// One path per color, so neighboring pixels don't show seams once the drawing tilts.
const PIXEL = 8;
const pixels = (rows: string[]) =>
  rows.flatMap((row, y) => [...row].flatMap((cell, x) => (cell === '#' ? [`M${x * PIXEL} ${y * PIXEL}h${PIXEL}v${PIXEL}h-${PIXEL}z`] : []))).join('');
const hull = pixels(['...#...', '..###..', '.#####.', '#######', '.##.##.', '..###..']);
const flames = pixels(['.......', '.......', '.......', '.......', '.......', '.......', '.#...#.']);
---
<span class="illustration illustration--play" data-surface="light">
  <span class="illustration-frame">
    <svg viewBox="0 0 480 360" fill="none" role="img" aria-label={description} class="illustration-drawing">
      <text x="40" y="56" class="label">TICKET · NOT ON ANY ROADMAP</text>

      <g transform="translate(372 18)">
        <path d={hull} class="accent" />
        <path d={flames} class="fade-3" />
      </g>

      <rect x="40.5" y="84.5" width="399" height="182" class="frame" />
      <text x="62" y="124" class="title">Arcade game about JSON</text>
      <line x1="62" y1="142" x2="418" y2="142" class="rule" />

      <text x="62" y="174" class="label">REQUESTED BY</text>
      <text x="176" y="175" class="body">Nobody</text>
      <text x="62" y="206" class="label">DEADLINE</text>
      <text x="176" y="207" class="body">None</text>
      <text x="62" y="238" class="label">PRIORITY</text>
      <text x="176" y="239" class="body accent-text">Fun</text>

      <g transform="rotate(-9 332 214)">
        <rect x="232" y="192" width="200" height="44" rx="3" class="accent-stroke" stroke-width="2.5" />
        <text x="332" y="221" text-anchor="middle" class="stamp accent-text">JUST BECAUSE</text>
      </g>

      <text x="40" y="318" class="result">Approved by me</text>
    </svg>
  </span>
</span>
