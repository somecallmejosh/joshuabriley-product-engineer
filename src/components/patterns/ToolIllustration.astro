---
import { cx } from '~/lib/cx';
import { TOTAL_ITEMS } from '~/lib/scorecard';
import { DEFAULTS, WEEKS_PER_YEAR, computeRoi, formatCurrency } from '~/lib/roi';
import '~/styles/illustration.css';

interface Props {
  tool: 'ScorecardEngine' | 'RoiCalculator' | 'TokenPlayground' | 'Diagnostic';
  class?: string;
}
const { tool, class: className } = Astro.props;
const descriptions = {
  ScorecardEngine: 'A design system assessment turns answers about keyboard access, shared tokens, and component documentation into a recommendation to review documentation first.',
  RoiCalculator: 'An annual rework estimate multiplies team size, weekly rework per person, and working weeks, then prices the hours. The illustration shows a worked example.',
  TokenPlayground: 'A shared action-color token connects to a button, a selected tab, and a checkbox, so changing that one color updates all three components.',
  Diagnostic: 'An interface review flags low-contrast help text under a sign-up button and ranks it as a high-priority issue.',
};
const example = computeRoi(DEFAULTS);
const annualHours = DEFAULTS.team * DEFAULTS.reworkHours * WEEKS_PER_YEAR;
---

<!-- Styles live in illustration.css, shared with ArticleIllustration.
     data-surface="light" keeps the accent navy inside dark sections. -->
<span class={cx('illustration', className)} data-surface="light">
<span class="illustration-frame">
<svg
  viewBox="0 0 480 360"
  fill="none"
  role="img"
  aria-label={descriptions[tool]}
  class={cx('illustration-drawing', `illustration-drawing--${tool}`)}
>

  {tool === 'ScorecardEngine' && (
    <g>
      <text x="40" y="56" class="label">ASSESSMENT · {TOTAL_ITEMS} PROMPTS</text>
      <path class="rule" d="M40 76H440M40 126H440M40 176H440M40 226H440" />
      <text x="40" y="108" class="body">Keyboard access</text>
      <circle cx="372" cy="101" r="5" class="accent" />
      <text x="388" y="108" class="small">Yes</text>
      <text x="40" y="158" class="body">Shared tokens</text>
      <circle cx="372" cy="151" r="5" class="accent" />
      <text x="388" y="158" class="small">Yes</text>
      <text x="40" y="208" class="body">Component docs</text>
      <circle cx="372" cy="201" r="4.5" class="accent-stroke" stroke-width="1.5" />
      <text x="388" y="208" class="small">Partial</text>
      <text x="40" y="276" class="label">PRIORITY</text>
      <text x="40" y="314" class="result">Review documentation</text>
    </g>
  )}

  {tool === 'RoiCalculator' && (
    <g>
      <text x="40" y="56" class="label">ANNUAL REWORK · EXAMPLE</text>
      <text x="40" y="122" class="number">{DEFAULTS.team}</text>
      <text x="40" y="148" class="small">people</text>
      <text x="122" y="118" class="op">×</text>
      <text x="164" y="122" class="number">{DEFAULTS.reworkHours} h</text>
      <text x="164" y="148" class="small">per week</text>
      <text x="282" y="118" class="op">×</text>
      <text x="324" y="122" class="number">{WEEKS_PER_YEAR}</text>
      <text x="324" y="148" class="small">weeks</text>
      <path class="rule" d="M40 190H440" />
      <text x="40" y="262" class="total">{annualHours.toLocaleString('en-US')}<tspan class="result" dx="12">hours</tspan></text>
      <path class="accent-stroke" d="M40 282H152" stroke-width="2" />
      <text x="40" y="314" class="small">{formatCurrency(example.withoutSystem)} at ${DEFAULTS.rate}/hour</text>
    </g>
  )}

  {tool === 'TokenPlayground' && (
    <g>
      <text x="40" y="56" class="label">ONE TOKEN · THREE COMPONENTS</text>
      <circle cx="84" cy="196" r="30" class="accent" />
      <text x="40" y="262" class="code">color.action</text>
      <path class="connector" d="M126 196H196M196 116V276M196 116H252M196 196H252M196 276H252" />
      <rect x="268" y="94" width="148" height="44" rx="4" class="accent" />
      <text x="342" y="122" text-anchor="middle" class="button">Save</text>
      <text x="268" y="196" class="body">Overview</text>
      <path class="accent-stroke" d="M268 210H352" stroke-width="2" />
      <rect x="268" y="264" width="22" height="22" rx="3" class="accent" />
      <path d="m273.5 275 4 4 7.5-9" class="check" stroke-width="2" />
      <text x="302" y="282" class="body">Selected</text>
    </g>
  )}

  {tool === 'Diagnostic' && (
    <g>
      <text x="40" y="56" class="label">INSPECT AN INTERFACE</text>
      <rect x="40.5" y="80.5" width="219" height="219" class="frame" />
      <text x="64" y="132" class="title">Get started</text>
      <rect x="64" y="152" width="160" height="40" rx="4" class="ink" />
      <text x="144" y="178" text-anchor="middle" class="button">Create account</text>
      <text x="64" y="235" class="small faint">No credit card required.</text>
      <rect x="56.5" y="212.5" width="192" height="34" class="accent-stroke" stroke-dasharray="4 4" />
      <path class="connector" d="M249 230H288" />
      <text x="296" y="214" class="label accent-text">HIGH PRIORITY</text>
      <text x="296" y="242" class="result result--sm">Text contrast</text>
      <text x="296" y="266" class="small">Help text is faint.</text>
    </g>
  )}
</svg>
</span>
</span>

