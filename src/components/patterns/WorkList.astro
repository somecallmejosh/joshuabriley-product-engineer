---
import { selectedWork } from '~/lib/selected-work';
interface Props { items?: typeof selectedWork; }
const { items = selectedWork } = Astro.props;
---
<!-- An index of the work: every project in the same window, the same order of
     facts, so they compare at a glance. The plate repeats the title link, so it
     is hidden from assistive tech and the tab order. -->
<div class="work-grid">
  {items.map((work) => (
    <article class="work-card">
      <a href={work.href} class="home-plate work-card-plate" tabindex="-1" aria-hidden="true">
        <img src={work.image} alt="" width="1400" height="900" loading="lazy" decoding="async" />
      </a>
      <p class="work-card-kind">{work.kind}</p>
      <h2 class="work-card-title"><a href={work.href}><strong>{work.name}.</strong> {work.title}</a></h2>
      <p class="work-card-result"><strong>{work.result}</strong> {work.resultNote}.</p>
      <dl class="work-card-facts">
        <div><dt>My role</dt><dd>{work.ownership}</dd></div>
        <div><dt>Look for</dt><dd>{work.evidence}</dd></div>
      </dl>
      <a href={work.href} class="editorial-link">{work.action} <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>
    </article>
  ))}
</div>
