---
import ProjectIllustration from '~/components/patterns/ProjectIllustration.astro';
import ProjectScreenshot from '~/components/patterns/ProjectScreenshot.astro';
import { projectTeasers } from '~/lib/project-teasers';
import { selectedWork } from '~/lib/selected-work';
interface Props {
  compact?: boolean;
  /** Home page staging: the first project leads at full size, the rest follow smaller. */
  feature?: boolean;
  items?: typeof selectedWork;
}
const { compact = false, feature = false, items = selectedWork } = Astro.props;
const shotSizes = (i: number) => feature && i === 0 ? '(min-width: 64em) 100vw, 175vw' : compact ? '(min-width: 64em) 55vw, 175vw' : undefined;
---
<div class:list={['work-list', { 'work-list--compact': compact, 'work-list--feature': feature }]}>
  {items.map((work, i) => (
    <article class="work-entry" data-reveal>
      <a href={work.href} class="work-image" aria-label={`View ${work.name}`}>
        {projectTeasers[work.href]
          ? <ProjectScreenshot {...projectTeasers[work.href]} caption={work.caption} sizes={shotSizes(i)} />
          : <ProjectIllustration project={work.illustration} />}
      </a>
      <div class="work-copy">
        <h3><a href={work.href}><span class="title-text">{work.name}</span><span class="link-dot" aria-hidden="true"></span></a></h3>
        <p class="work-kind">{work.kind}</p>
        <p class="work-title">{work.title}</p>
        {/* Compact lists show the headline and result only; the image and name already link through. */}
        {!compact && <p class="work-summary">{work.summary}</p>}
        {!compact && (
          <dl class="work-facts">
            <div><dt>My role</dt><dd>{work.ownership}</dd></div>
            <div><dt>Topics</dt><dd>{work.evidence}</dd></div>
          </dl>
        )}
        <p class="work-result"><strong>{work.result}</strong><span>{work.resultNote}</span></p>
        {!compact && <a class="editorial-link" href={work.href}>{work.action}</a>}
      </div>
    </article>
  ))}
  {feature && (
    /* The route that ties the projects together, the same line and dots as the
       résumé's Approach. Drawn by the script below from the measured layout,
       since the entries' heights vary. Decorative. */
    <svg class="work-route" aria-hidden="true" focusable="false">
      <path class="work-route-line" />
      <circle class="work-route-dot" r="3.5" />
      <circle class="work-route-dot" r="3.5" />
      <circle class="work-route-dot" r="3.5" />
    </svg>
  )}
</div>

<script>
  // Route for the featured home list: a dot above each project, a line down the
  // left margin from the lead to the second project, then along the top of the
  // second, down the gap, and across to the third. Uses offset positions, which
  // ignore the reveal transforms, and redraws when the layout changes size.
  const GUTTER = 24;
  const LIFT = 24;
  document.querySelectorAll<HTMLElement>('.work-list--feature').forEach((list) => {
    const svg = list.querySelector<SVGSVGElement>('.work-route');
    const entries = Array.from(list.querySelectorAll<HTMLElement>(':scope > .work-entry'));
    if (!svg || entries.length < 3) return;
    const path = svg.querySelector('path')!;
    const dots = Array.from(svg.querySelectorAll('circle'));
    const draw = () => {
      const [a, b, c] = entries;
      const x0 = -GUTTER;
      const ya = a.offsetTop - LIFT;
      const yb = b.offsetTop - LIFT;
      const yc = c.offsetTop - LIFT;
      const xc = c.offsetLeft;
      const xGap = (b.offsetLeft + b.offsetWidth + c.offsetLeft) / 2;
      path.setAttribute('d', `M ${x0} ${ya} V ${yb} H ${xGap} V ${yc} H ${xc}`);
      [[x0, ya], [x0, yb], [xc, yc]].forEach(([x, y], i) => {
        dots[i].setAttribute('cx', String(x));
        dots[i].setAttribute('cy', String(y));
      });
    };
    draw();
    new ResizeObserver(draw).observe(list);
  });
</script>
