---
import ProjectIllustration from '~/components/patterns/ProjectIllustration.astro';
import { selectedWork } from '~/lib/selected-work';
interface Props { compact?: boolean; items?: typeof selectedWork; }
const { compact = false, items = selectedWork } = Astro.props;
---
<div class:list={['work-list', { 'work-list--compact': compact }]}>
  {items.map((work) => (
    <article class="work-entry" data-reveal>
      <a href={work.href} class="work-image" aria-label={`View ${work.name}`}>
        <ProjectIllustration project={work.illustration} />
        <span class="work-image-arrow" aria-hidden="true"><span data-link-arrow="up-right">↗</span></span>
      </a>
      <div class="work-copy">
        <p class="work-kind">{work.kind}</p>
        <h3><a href={work.href}>{work.name}<span aria-hidden="true" data-link-arrow="up-right"> ↗</span></a></h3>
        <p class="work-title">{work.title}</p>
        {/* Compact lists show the headline and result only; the image and name already link through. */}
        {!compact && <p class="work-summary">{work.summary}</p>}
        {!compact && (
          <dl class="work-facts">
            <div><dt>My role</dt><dd>{work.ownership}</dd></div>
            <div><dt>Look for</dt><dd>{work.evidence}</dd></div>
          </dl>
        )}
        <p class="work-result"><strong>{work.result}</strong><span>{work.resultNote}</span></p>
        {!compact && <a class="editorial-link" href={work.href}>{work.action} <span aria-hidden="true" data-link-arrow="up-right">↗</span></a>}
      </div>
    </article>
  ))}
</div>
