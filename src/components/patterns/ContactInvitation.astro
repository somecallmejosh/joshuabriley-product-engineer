---
import Container from '~/components/layout/Container.astro';
---
<section class="contact-invitation bg-ink" aria-labelledby="invitation-title">
  <Container width="wide">
    <div class="invitation-layout">
      <h2 id="invitation-title">Your UI has a lot<br />of people to <em>please.</em></h2>
      <div>
        <p>Users, designers, engineers. I help teams build shared interfaces that work for all three.</p>
        <a class="editorial-link editorial-link--light" href="/contact/">Talk about your team <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </Container>
</section>
