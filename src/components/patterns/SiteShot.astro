---
import Icon from '~/components/primitives/Icon.astro';
import { cx } from '~/lib/cx';

/**
 * SiteShot — a screenshot of a live site presented as an *editorial plate*, not a
 * browser window. No traffic-light chrome: the capture is mounted inside a
 * hairline paper frame (a mounted specimen), tagged with an optional plate index
 * above, and captioned by a mono spec rail below (LIVE SITE ...... domain ↗).
 * The whole plate links out to the real site; a gentle hover lifts the mount and
 * slides up a "Visit site" tab. This reads as an archival figure — deliberately
 * distinct from the live, interactive <iframe> in LiveEmbed.
 */

interface Props {
  /** Root-relative screenshot path, e.g. /images/projects/americas-test-kitchen/atk-live.webp */
  src: string;
  alt: string;
  /** Live URL the frame links to. */
  href: string;
  /** Display URL shown in the caption rail, e.g. americastestkitchen.com */
  label: string;
  /** Optional plate index, e.g. "01" — renders a "Plate / 01" figure tag above. */
  index?: string;
  /** Kind label shown at the caption rail's left, e.g. "Live site". */
  kind?: string;
  class?: string;
}

const { src, alt, href, label, index, kind = 'Live site', class: className } = Astro.props;
---

<figure class={cx('site-shot', className)}>
  {index && (
    <p class="site-shot-index">Plate <span aria-hidden="true">/</span> {index}</p>
  )}

  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="site-shot-mount group/shot"
    aria-label={`Visit ${label} (opens in a new tab)`}
  >
    <span class="site-shot-stage">
      <img src={src} alt={alt} width="1600" height="1005" loading="lazy" decoding="async" />
      <span class="site-shot-visit" aria-hidden="true">
        Visit site <Icon name="ph:arrow-up-right" size={14} />
      </span>
    </span>
  </a>

  <figcaption class="site-shot-cap">
    <span class="site-shot-kind">{kind}</span>
    <span class="site-shot-url">
      {label} <Icon name="ph:arrow-up-right" size={12} />
    </span>
  </figcaption>
</figure>

<style>
  .site-shot { margin: 0; }

  /* Figure tag — a quiet plate index above the mount. */
  .site-shot-index {
    margin: 0 0 0.75rem;
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-size: 0.8rem;
    color: var(--ink-muted);
  }
  .site-shot-index span { margin: 0 0.35em; opacity: 0.6; }

  /* Mount — a mounted specimen: hairline paper frame with a small margin so the
     capture reads as a plated figure, not a raw image or a browser window. */
  .site-shot-mount {
    display: block;
    padding: 8px;
    border-radius: 16px;
    background: var(--raised);
    border: 1px solid var(--line);
    box-shadow:
      0 1px 2px rgba(27, 26, 23, 0.04),
      0 18px 50px -28px rgba(27, 26, 23, 0.3);
    transform: translateY(0);
    transition:
      transform 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out);
    will-change: transform;
  }
  .site-shot-mount:hover {
    transform: translateY(-3px);
    box-shadow:
      0 1px 2px rgba(27, 26, 23, 0.05),
      0 28px 60px -26px rgba(27, 26, 23, 0.38);
  }

  .site-shot-stage {
    position: relative;
    display: block;
    line-height: 0;
    border-radius: 9px;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .site-shot-stage img { width: 100%; height: auto; display: block; }

  .site-shot-visit {
    position: absolute;
    right: 0.85rem;
    bottom: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.4s var(--ease-out),
      transform 0.4s var(--ease-out);
  }
  .group\/shot:hover .site-shot-visit,
  .group\/shot:focus-visible .site-shot-visit {
    opacity: 1;
    transform: translateY(0);
  }

  /* Caption rail — a spec-sheet line under the plate. Kind label left, source
     domain right; the whole plate is the link, so this is a printed echo. */
  .site-shot-cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.85rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
  }
  .site-shot-kind {
    color: var(--ink-muted);
  }
  .site-shot-url {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--ink-muted);
    transition: color 0.25s var(--ease-out);
  }
  .site-shot:hover .site-shot-url { color: var(--accent); }

  @media (prefers-reduced-motion: reduce) {
    .site-shot-mount, .site-shot-mount:hover { transform: none; }
    .site-shot-visit { transition: none; }
  }
</style>
