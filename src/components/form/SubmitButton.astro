---
import Icon from '~/components/primitives/Icon.astro';
import { cx } from '~/lib/cx';

/**
 * Uses the shared primary action style. The submission handler controls
 * disabled and aria-busy; the visible label and icons follow the busy state.
 */

interface Props {
  label: string;
  /** Also used for the server-rendered disabled and busy examples. */
  disabled?: boolean;
  busy?: boolean;
  loadingLabel?: string;
  iconLeft?: string;
  iconRight?: string;
  size?: 'md' | 'lg';
  class?: string;
  id?: string;
  form?: string;
}

const {
  label,
  disabled = false,
  busy = false,
  loadingLabel = 'Sending…',
  iconLeft,
  iconRight = 'ph:arrow-up-right',
  size = 'lg',
  class: className,
  id,
  form,
} = Astro.props;

---

<button
  type="submit"
  disabled={disabled || busy}
  aria-busy={busy ? 'true' : undefined}
  id={id}
  form={form}
  data-submit
  data-size={size}
  class={cx(
    'action-link submit-button group self-start disabled:opacity-50 disabled:cursor-not-allowed aria-busy:cursor-wait',
    className,
  )}
>
  {iconLeft && (
    <span data-submit-icon aria-hidden="true" class="group-aria-busy:hidden">
      <Icon name={iconLeft} size={20} />
    </span>
  )}
  <span data-submit-label class="group-aria-busy:hidden">{label}</span>
  <span data-submit-spinner aria-hidden="true" class="hidden group-aria-busy:inline-flex">
    <Icon name="ph:circle-notch" size={20} class="animate-spin" />
  </span>
  <span data-submit-loading-label class="hidden group-aria-busy:inline">{loadingLabel}</span>
  {iconRight && !iconLeft && (
    <span data-submit-icon aria-hidden="true" class="group-aria-busy:hidden">
      <Icon name={iconRight} size={20} />
    </span>
  )}
</button>

<style>
  .submit-button[data-size='md'] { min-height: 44px; padding: .5rem 1rem; font-size: .9rem; gap: 1rem; }
  .submit-button:disabled { background: var(--portfolio-blue); }
</style>
