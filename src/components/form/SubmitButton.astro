---
import Icon from '~/components/primitives/Icon.astro';
import { cx } from '~/lib/cx';

/**
 * Uses the shared primary action style. The submission handler controls
 * disabled and aria-busy; the visible label and icons follow the busy state,
 * and while busy the action's corner dot pulses in place of a spinner.
 */

interface Props {
  label: string;
  /** Also used for the server-rendered disabled and busy examples. */
  disabled?: boolean;
  busy?: boolean;
  loadingLabel?: string;
  iconLeft?: string;
  iconRight?: string;
  size?: 'md' | 'lg';
  class?: string;
  id?: string;
  form?: string;
}

const {
  label,
  disabled = false,
  busy = false,
  loadingLabel = 'Sending…',
  iconLeft,
  iconRight,
  size = 'lg',
  class: className,
  id,
  form,
} = Astro.props;

---

<button
  type="submit"
  disabled={disabled || busy}
  aria-busy={busy ? 'true' : undefined}
  id={id}
  form={form}
  data-submit
  data-size={size}
  class={cx(
    'action-link submit-button group self-start disabled:cursor-not-allowed aria-busy:cursor-wait',
    className,
  )}
>
  {iconLeft && (
    <span data-submit-icon aria-hidden="true" class="group-aria-busy:hidden">
      <Icon name={iconLeft} size={20} />
    </span>
  )}
  <span data-submit-label class="group-aria-busy:hidden">{label}</span>
  <span data-submit-loading-label class="hidden group-aria-busy:inline">{loadingLabel}</span>
  {iconRight && !iconLeft && (
    <span data-submit-icon aria-hidden="true" class="group-aria-busy:hidden">
      <Icon name={iconRight} size={20} />
    </span>
  )}
</button>

<style>
  .submit-button[data-size='md'] { min-height: 44px; padding: .5rem 1rem; font-size: .9rem; gap: 1rem; }
  .submit-button:disabled { --action-fill-hover: var(--action-fill); }
  /* Busy keeps full strength so the pulsing dot reads; only a true disabled state dims. */
  .submit-button:disabled:not([aria-busy='true']) { opacity: .5; }
</style>
