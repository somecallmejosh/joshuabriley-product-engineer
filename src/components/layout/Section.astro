---
import { cx } from '~/lib/cx';

interface Props {
  tone?: 'paper' | 'ink' | 'raised';
  padding?: 'tight' | 'default' | 'loose';
  id?: string;
  class?: string;
  /** Apply `relative overflow-hidden` so absolutely-positioned blobs clip safely. */
  decorated?: boolean;
}

const {
  tone = 'paper',
  padding = 'default',
  id,
  class: className,
  decorated = false,
} = Astro.props;

const tones: Record<NonNullable<Props['tone']>, string> = {
  paper: 'bg-paper text-ink',
  ink: 'bg-ink text-paper',
  raised: 'bg-raised text-ink',
};

const paddings: Record<NonNullable<Props['padding']>, string> = {
  tight: 'py-16 md:py-20 lg:py-24',
  // Mirrors --space-section in redesign.css so Section bands and editorial
  // sections share one rhythm.
  default: 'py-20 md:py-28 lg:py-36',
  loose: 'py-24 md:py-36 lg:py-44',
};
---

<section
  id={id}
  data-source={`Section · tone=${tone} · padding=${padding}${decorated ? ' · decorated' : ''}`}
  class={cx(
    tones[tone],
    paddings[padding],
    decorated && 'relative overflow-hidden',
    className,
  )}
>
  <slot />
</section>
