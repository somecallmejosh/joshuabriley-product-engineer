---
import { cx } from '~/lib/cx';
import Icon from './Icon.astro';

/**
 * Inline / arrow / nav link. The `nav` variant auto-detects the active page
 * via Astro.url.pathname and emits `aria-current="page"`, replacing the
 * runtime `nav-active.js` script with build-time matching.
 */

type Variant = 'inline' | 'arrow' | 'nav' | 'unstyled';

interface Props {
  href: string;
  variant?: Variant;
  /** Override active matching for the `nav` variant. */
  current?: boolean;
  /** Icon shown after the label (default for `arrow` is ph:arrow-right). */
  iconRight?: string;
  class?: string;
  rel?: string;
  target?: string;
}

const {
  href,
  variant = 'inline',
  current,
  iconRight,
  class: className,
  rel,
  target,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const linkPath = href.replace(/\/+$/, '') || '/';
// A nav link is active for its own page and any descendant route (e.g. the
// Tools link stays active on /tools/audit-findings/). Guard against '/'
// matching everything.
const isActive =
  current ??
  (variant === 'nav' &&
    (linkPath === pathname ||
      (linkPath !== '/' && pathname.startsWith(linkPath + '/'))));

// Inline links read as ink with an accent underline. The arrow variant stays
// quiet — ink label, accent on hover, arrow motion comes from the shared link-motion styles.
const variants: Record<Variant, string> = {
  inline:
    'text-ink underline decoration-line-strong decoration-1 underline-offset-[3px] transition-colors hover:decoration-accent hover:text-accent',
  arrow:
    'group/lnk inline-flex items-center gap-2 font-sans font-medium text-[0.9rem] text-ink transition-colors hover:text-accent',
  nav:
    'font-sans text-[0.9rem] font-medium text-ink-muted transition-colors',
  unstyled: '',
};

const isExternal = /^https?:/.test(href);
const externalAttrs = isExternal
  ? { rel: rel ?? 'noopener noreferrer', target: target ?? '_blank' }
  : { rel, target };

const finalIconRight = variant === 'arrow' ? (iconRight ?? 'ph:arrow-right') : iconRight;
---

<a
  href={href}
  class={cx(variants[variant], className)}
  aria-current={isActive ? 'page' : undefined}
  {...externalAttrs}
>
  <slot />
  {finalIconRight && (
    <Icon
      name={finalIconRight}
      size={15}
    />
  )}
</a>
