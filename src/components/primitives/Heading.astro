---
import { cx } from '~/lib/cx';

/**
 * Polymorphic heading. `level` controls the semantic tag (h1–h6); `visual`
 * controls size/weight independently so visual hierarchy never breaks the
 * document outline.
 */
type HeadingLevel = 1 | 2 | 3 | 4 | 5 | 6;
type HeadingVisual = 'display-xl' | 'display-lg' | 'display-md' | 'h1' | 'h2' | 'h3' | 'h4' | 'eyebrow';

interface Props {
  level: HeadingLevel;
  visual?: HeadingVisual;
  tone?: 'navy' | 'white' | 'plum' | 'coral' | 'ink' | 'paper' | 'accent' | 'muted';
  align?: 'left' | 'center';
  balance?: boolean;
  class?: string;
  id?: string;
}

const {
  level,
  visual,
  tone = 'navy',
  align = 'left',
  balance = false,
  class: className,
  id,
} = Astro.props;

const resolvedVisual: HeadingVisual = visual ?? (`h${level}` as HeadingVisual);
const Tag: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' = `h${level}` as any;

// Bold display type carries hierarchy; editorial italics add character within a heading.
const visualStyles: Record<HeadingVisual, string> = {
  'display-xl':
    'font-heading text-[2.75rem] leading-[1.02] sm:text-6xl md:text-[4.25rem] font-extrabold tracking-[-0.055em] text-balance',
  'display-lg':
    'font-heading text-4xl sm:text-5xl md:text-6xl font-extrabold leading-[1.02] tracking-[-0.05em] text-balance',
  'display-md':
    'font-heading text-3xl sm:text-4xl md:text-[2.75rem] font-bold leading-[1.08] tracking-[-0.04em] text-pretty',
  h1: 'font-heading text-4xl md:text-5xl font-bold leading-[1.08] tracking-[-0.04em]',
  h2: 'font-heading text-2xl md:text-[2rem] font-semibold leading-tight tracking-[-0.015em] text-pretty',
  h3: 'font-heading text-lg md:text-xl font-semibold leading-snug tracking-[-0.015em] text-pretty',
  h4: 'font-heading text-base font-semibold leading-snug tracking-[-0.01em] text-pretty',
  eyebrow:
    'font-mono text-[0.6875rem] font-medium uppercase tracking-[0.16em]',
};

const tones: Record<NonNullable<Props['tone']>, string> = {
  navy: 'text-ink',
  white: 'text-paper',
  plum: 'text-ink',
  coral: 'text-accent',
  ink: 'text-ink',
  paper: 'text-paper',
  accent: 'text-accent',
  muted: 'text-ink-muted',
};
---

<Tag
  id={id}
  class={cx(
    visualStyles[resolvedVisual],
    tones[tone],
    align === 'center' && 'text-center',
    balance && 'text-balance',
    className
  )}
>
  <slot />
</Tag>
