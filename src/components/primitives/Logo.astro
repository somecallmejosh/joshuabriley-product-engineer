---
import { cx } from '~/lib/cx';

/**
 * Brand wordmark — the name set in the signature script, and nothing else.
 * Real, selectable text, so it carries the accessible name without an image.
 *
 * Sizing note: the script carries far less optical weight per point than the
 * grotesk, so this scale runs well above the equivalent sans size. Do not
 * "fix" these numbers back down to the type scale.
 */

interface Props {
  size?: 'sm' | 'md' | 'lg';
  /** Color treatment — paper surfaces vs. ink (dark) surfaces. */
  tone?: 'default' | 'inverse';
  href?: string;
  label?: string;
  class?: string;
}

const {
  size = 'md',
  tone = 'default',
  href,
  label = 'Joshua Briley',
  class: className,
} = Astro.props;

const wordmarkSize: Record<NonNullable<Props['size']>, string> = {
  sm: 'text-[1.5rem]',
  md: 'text-[1.9rem]',
  lg: 'text-[2.1rem]',
};

const wordmarkTone: Record<NonNullable<Props['tone']>, string> = {
  default: 'text-ink',
  inverse: 'text-paper',
};

const Tag = href ? 'a' : 'span';
---

<Tag
  href={href}
  aria-label={label}
  role={href ? undefined : 'img'}
  class={cx(
    // The script has a tall ascender and a deep descender, so leading-none
    // clips the J and the y. Reserve the space inside the glyph box with real
    // leading, then pull the layout box back in so the wordmark does not
    // inflate the header row.
    'inline-block font-script font-normal leading-[1.05] tracking-normal [text-rendering:optimizeLegibility] -my-[0.16em]',
    wordmarkSize[size],
    wordmarkTone[tone],
    // As a link, the wordmark reveals a thin underline on hover and focus like
    // every other text link.
    href && 'underline decoration-transparent decoration-1 underline-offset-[0.12em] transition-colors hover:decoration-current focus-visible:decoration-current',
    className,
  )}
>JoshuaBriley<span class="brand-dot text-accent">.</span></Tag>
